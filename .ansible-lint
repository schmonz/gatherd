skip_list:
  # machine_facts vars are intentionally cross-role shared state (play-scoped facts)
  - var-naming[no-role-prefix]
  # all git clones use update: false, so HEAD is cloned once and never re-fetched
  - latest[git]
  # some browser preference JSON values are unavoidably long single-line strings
  - yaml[line-length]
  # args[module] false positives from ansible.posix/community.general version conflict
  # between .ansible/collections/ and system site-packages
  - args[module]

exclude_paths:
  # macOS AppleDouble sidecars from the NFS working copy; not UTF-8, not YAML,
  # and gitignored — but ansible-lint still tries to parse them by extension.
  - "._*"
  - "**/._*"

mock_modules:
  # collections not installed in the lint environment
  - ansible.posix.authorized_key
  - community.general.pacman
  - community.general.git_config
  - community.general.ini_file
  - ansible.posix.firewalld
