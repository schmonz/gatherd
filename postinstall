#!/usr/bin/env bash
#
# Calamares shellprocess hook: runs inside the installer chroot.
# Installs Ansible, clones this repo, and registers the first-boot service.
# Everything else runs via ansible-playbook on first boot — except a couple of
# GRUB kernel-cmdline fixes (see preseed_grub_cmdline_fixes) that must be baked
# in *before* the first boot, or the first session is already degraded on the
# broken config. /proc and /sys are bind-mounted into the chroot, so hardware
# detection here sees the real machine.
#
set -euo pipefail

GATHERD_HOME="/usr/local/lib/gatherd"

detect_target_user() {
    awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }' /etc/passwd
}

setup_sway_community_edition() {
    curl -fsSL "https://raw.githubusercontent.com/EndeavourOS-Community-Editions/sway/main/setup_sway_isomode.bash" | bash -s -- "$1"
}

install_prerequisites() {
    pacman -S --noconfirm --needed ansible git rate-mirrors
}

install_gatherd() {
    [[ -d "$GATHERD_HOME/.git" ]] || git clone "https://github.com/schmonz/gatherd.git" "$GATHERD_HOME"
}

select_fastest_mirrors() {
    local flavor
    flavor=$([ "$(uname -m)" = "aarch64" ] && echo archarm || echo arch)
    sudo -u "$1" rate-mirrors --per-mirror-timeout 1500 "$flavor" > /etc/pacman.d/mirrorlist
}

sync_db_to_new_mirrors() {
    # rate-mirrors just rewrote the mirrorlist, but the sync db still reflects
    # whatever the install ISO froze — by repave time some of those package
    # versions have rotated out of the pools the freshly-ranked mirrors serve,
    # so a later bare `pacman -S` 404s on a dependency that no longer exists
    # upstream (first boot's slow play hit exactly this on libidn). Refresh and
    # fully upgrade now, against the new mirrors, so first boot installs from a
    # db that matches the pools. -Syu, not a bare -Sy, so this isn't a partial
    # upgrade. This is the one re-rank where the db is dangerously stale; the
    # later pacman-mirrorlist hook re-ranks during the user's own -Syu runs, so
    # their db is already current there (and pacman can't run inside that hook).
    pacman -Syu --noconfirm
}

register_boot_services() {
    ln -sf "$GATHERD_HOME/services/system/gatherd.service" /etc/systemd/system/gatherd.service
    systemctl enable gatherd.service
}

mask_conflicting_services() {
    # power-profiles-daemon starts (and fails) before Ansible can mask it,
    # leaving systemd in a state that can hang TLP's startup.
    systemctl mask power-profiles-daemon.service systemd-rfkill.service systemd-rfkill.socket
}

add_grub_cmdline() {
    # Idempotently append params to a GRUB_CMDLINE_* var in /etc/default/grub.
    # $1 = var name, $2 = params; the first token of $2 is the present-check, so
    # this mirrors the negative-lookahead guard in the matching Ansible task and
    # a later gatherd run sees the param already there and makes no change.
    local var="$1" params="$2" grub=/etc/default/grub
    local marker="${params%% *}"
    # Match either quote style: Calamares writes GRUB_CMDLINE_LINUX_DEFAULT with
    # single quotes on current EndeavourOS (other vars stay double-quoted), and a
    # double-quote-only pattern silently no-ops — which is exactly how zswap kept
    # missing the cmdline on low-RAM single-quoted installs. Capture the quote
    # char and reuse it via the \2 backreference so the original style is kept.
    grep -qE "^${var}=[\"'].*${marker}" "$grub" && return 0
    sed -i -E "s|^(${var}=([\"']).*)\2[[:space:]]*\$|\1 ${params}\2|" "$grub"
}

preseed_grub_cmdline_fixes() {
    # First-boot usability fixes that live in the kernel cmdline, so they must be
    # in place before the very first boot (gatherd's first-boot run is too late —
    # it would only apply them after a grub rebuild + reboot, with the first
    # session already degraded). Each fix is the bash twin of an idempotent
    # gatherd task; keep the params in sync with the cross-referenced files.
    local grub=/etc/default/grub
    [[ -f "$grub" ]] || return 0  # no GRUB (e.g. extlinux): first-boot Ansible handles it

    # MacBookPro5,2 phantom LVDS-2 internal display — interferes with the first
    # session. Sync with roles/hardware/tasks/phantom_display.yml.
    if [[ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" == "MacBookPro5,2" ]]; then
        add_grub_cmdline GRUB_CMDLINE_LINUX 'video=LVDS-2:d'
    fi

    # zswap on < 8 GB RAM — the first boot is the heaviest run (all the AUR
    # builds), exactly when a low-RAM machine most needs it. Sync with
    # roles/hardware/tasks/zswap.yml.
    if [[ "$(awk '/^MemTotal:/ {print ($2 < 8*1024*1024)}' /proc/meminfo)" == 1 ]]; then
        add_grub_cmdline GRUB_CMDLINE_LINUX_DEFAULT \
            'zswap.enabled=1 zswap.compressor=zstd zswap.zpool=z3fold zswap.max_pool_percent=20'
    fi

    # Regenerate only if grub.cfg already exists (Calamares ran its bootloader
    # step before this shellprocess). If it doesn't yet, Calamares will generate
    # it from the /etc/default/grub we just edited, so there's nothing to do.
    # Never fatal: a fresh install must not abort if regeneration hiccups.
    if [[ -f /boot/grub/grub.cfg ]]; then
        grub-mkconfig -o /boot/grub/grub.cfg || true
    fi
}

main() {
    local target_user
    target_user=$(detect_target_user)

    setup_sway_community_edition "$target_user"
    install_prerequisites
    install_gatherd
    select_fastest_mirrors "$target_user"
    sync_db_to_new_mirrors
    register_boot_services
    mask_conflicting_services
    preseed_grub_cmdline_fixes
}

main "$@"
exit $?
