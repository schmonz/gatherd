# Managed by gatherd. Sourced by gatherd-tablet-mode and gatherd-music-stand.
transform={{ tablet_mode_transform }}
root={{ music_stand_root }}
viewer={{ music_stand_viewer }}
viewer_flag={{ music_stand_viewer_flag }}
# Space-separated KEY=VALUE assignments, applied via env(1) at launch.
viewer_env={{ music_stand_viewer_env }}
# Which window to fullscreen while folded. Same app_id the idle-inhibit
# for_window rule matches; see music_stand_app_id in group_vars for why it is
# the interpreter's name rather than the application's.
viewer_app_id={{ music_stand_app_id }}
fold_enter_deg={{ tablet_mode_fold_enter_deg }}
fold_exit_deg={{ tablet_mode_fold_exit_deg }}
poll_interval={{ tablet_mode_hinge_poll_interval }}
# The rate while nothing is moving, and what counts as moving. A machine
# sitting still cannot need a decision, so it is sampled slowly until it does.
poll_interval_idle={{ tablet_mode_hinge_poll_interval_idle }}
motion_theta_deg={{ tablet_mode_hinge_motion_theta_deg }}
motion_rotation_deg={{ tablet_mode_hinge_motion_rotation_deg }}
motion_hold_seconds={{ tablet_mode_hinge_motion_hold_seconds }}
median_window={{ tablet_mode_hinge_median_window }}
rotation_reference_deg={{ tablet_mode_rotation_reference_deg }}
# A multiple of foot_font_size, not a constant: it derives from the panel's
# EDID (see gatherd-font-size), so the touch targets in the tablet escape menu
# and the music-stand picker stay comfortably tappable on any other machine
# gatherd converges, not just the one this multiple (22/10) was confirmed on
# by hand. The whole fontconfig string lives here, not just a bare size, so
# gatherd-power-button and gatherd-music-stand do no parsing and the family
# can be overridden too.
menu_font=JetBrainsMono-Regular:size={{ (22 * foot_font_size / 10) | round | int }}
