// Managed by gatherd. Profile for the {{ item.name }} web app.
//
// Duolingo decides whether to offer speaking exercises by parsing the UA string
// -- bowser: getBrowserName() === "Chrome" && !navigator.brave -- with no feature
// detection at all. Overriding the UA is therefore the whole trick. The
// per-domain form (general.useragent.override.<domain>) did NOT take effect when
// tested; this profile serves one site, so overriding globally is both simpler
// and the one that works.
user_pref("general.useragent.override", "{{ waterfox_chrome_user_agent }}");

// An extension dropped into the profile's own extensions/ directory is disabled
// by default. 0 means auto-disable nothing, so the polyfill is live at first run.
user_pref("extensions.autoDisableScopes", 0);

// Keep storage.local in its legacy JSON file rather than IndexedDB, which is what
// lets the playbook seed the extension's settings as an ordinary file
// (browser-extension-data/<id>/storage.js). Without this the only way to
// configure the add-on is to drive a browser and click through its options page.
user_pref("extensions.webextensions.ExtensionStorageIDB.enabled", false);

// Read chrome/userChrome.css, which is what strips the tab strip, address bar and
// sidebar. Firefox-family browsers have no --app mode, so this is the only way to
// make a web app window stop looking like a browser.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);

// Waterfox's revamped sidebar and vertical tabs, off at the source as well as in
// CSS -- hidden-but-running still steals a first paint and a keyboard shortcut.
user_pref("sidebar.revamp", false);
user_pref("sidebar.verticalTabs", false);

// Waterfox restores the previous session by default where Firefox does not, and
// the launcher passes the URL on the command line every time -- so each launch
// reopened yesterday's tab AND opened a new one, and the count grew by one per
// launch (observed 1, then 2, then 3 in sessionstore-backups). 1 = open the
// homepage, which the command-line URL then supersedes: exactly one tab, always.
user_pref("browser.startup.page", 1);
user_pref("browser.sessionstore.resume_from_crash", false);

// The speaking exercises need the microphone, and the permission doorhanger is
// anchored inside #nav-bar -- which userChrome.css collapses to make this look
// like an app. The panel therefore opens against a box with no layout, closes
// again, and the page retries: an infinite flap with no way to click Allow.
// Measured here rather than assumed: a getUserMedia({audio:true}) page in a copy
// of this profile never settles (title stayed RESULT:pending), and settles to
// RESULT:ok with this pref. It short-circuits ahead of the permission manager,
// so it covers a stored PROMPT_ACTION row for the site as well as the absence of
// one -- both resolve to "ask", which is the state this removes. Sound only
// because the profile serves exactly one site; do NOT copy it to a general
// browser profile, where it would grant the mic to anything that asks.
user_pref("media.navigator.permission.disabled", true);

// A single-purpose profile has no use for the usual first-run furniture.
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("toolkit.telemetry.enabled", false);
user_pref("browser.startup.homepage", "{{ item.url }}");
