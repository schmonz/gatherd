# {{ ansible_managed }}
#
# The credential house style. The fuzzel launcher's indigo 08052b is
# channel-swapped to crimson 2b0508 -- the same colours, red-shifted -- so this
# box reads as kin to the launcher while being impossible to mistake for it
# when you are about to type a root password. The heavy salmon border finishes
# the separation.
#
# In ~/.config rather than /etc: wayprompt's getConfigPath() is an else-if
# chain on environment variables (src/Config.zig), not a search over
# locations -- it reads $XDG_CONFIG_HOME/wayprompt/config.ini, else
# $HOME/.config/wayprompt/config.ini, else /etc/wayprompt/config.ini, and
# stops at the first branch that matches. /etc is only reached when both
# XDG_CONFIG_HOME and HOME are unset, which never happens in a desktop
# session -- the man page's "checked in this order" implies a fallback
# search that the code doesn't actually do. Every caller of
# gatherd-askpass runs as the target user (sudo invokes the askpass helper
# as the invoking user, not root; the polkit agent and ssh likewise), so
# the user path is the one that's actually consulted.
[general]
# fcft, the same font library fuzzel and foot use, so this is the same syntax
# already templated into fuzzel.ini and foot.ini.
font-regular = JetBrainsMono-Regular:size={{ foot_font_size }};
font-large = JetBrainsMono-Regular:size={{ (13 * foot_font_size / 10) | round | int }};
border = 4;
corner-radius = 10;

[colours]
background = 0x2b0508;
border = 0xff7f7f;
text = 0xe3e3ea;
error-text = 0xff7f7f;
pin-background = 0x1a0305;
pin-border = 0xff7f7f;
pin-square = 0xff7f7f;
ok-button = 0x2b0508;
ok-button-border = 0xff7f7f;
ok-button-text = 0xe3e3ea;
not-ok-button = 0x2b0508;
not-ok-button-border = 0xff7f7f;
not-ok-button-text = 0xe3e3ea;
cancel-button = 0x2b0508;
cancel-button-border = 0xff7f7f;
cancel-button-text = 0xe3e3ea;
