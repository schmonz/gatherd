#!/bin/sh
# The one credential prompt: sudo -A, ssh, git, polkit and our own prompts all
# arrive here, and all leave through nowayprompt. One renderer is the point --
# "the crimson box is what asks for my password" is only a useful instinct if
# it is true of every prompt, including the ssh host-key decision, which used
# to be a separately-styled foot window.
#
# Contract, unchanged so callers need no edits: argv[1] is the prompt, argv[2]
# is an optional pre-computed context line for callers that know more than a
# /proc walk could recover, stdout is the secret, non-zero exit is a cancel.

wayprompt="${GATHERD_WAYPROMPT:-nowayprompt}"
prompt="${1:-Password:}"

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/gatherd"

note() {
    mkdir -p "$log_dir" 2>/dev/null
    printf '%s %s\n' "$(date '+%F %T')" "$1" >> "$log_dir/askpass.log" 2>/dev/null
}

# nowayprompt is built from a vendored PKGBUILD (it isn't in the AUR), so it
# does not exist until REST has run. Cancel cleanly rather than falling back:
# falling back to fuzzel would resurrect the second look this design exists to
# delete, and falling back to systemd-ask-password would owe the Artix/s6 port
# a second answer. Every caller already reads a non-zero exit as a cancel and
# does the right thing with it -- gatherd-prompt-vault leaves its loop, polkit
# denies, sudo aborts.
if ! command -v "$wayprompt" >/dev/null 2>&1; then
    note "nowayprompt missing; cancelled prompt=$prompt"
    exit 1
fi

# ssh's first-contact host-key check reaches an askpass too, but it is a
# multi-line security decision rather than a password: "... ED25519 key
# fingerprint is SHA256:... Are you sure you want to continue connecting
# (yes/no/[fingerprint])?". Masking that hides the typed "yes" and truncates
# the fingerprint -- useless for the one prompt where reading the key is the
# whole point. Only the host-key prompt contains "(yes/no"; no password,
# passphrase, polkit or vault prompt does, so the match is exact.
#
# OpenSSH takes the answer from our stdout and treats a non-zero exit or empty
# output as "abort", so buttons map straight onto it.
case "$prompt" in
*'(yes/no'*)
    # This text embeds a hostname or key path ssh assembled from whatever we
    # connected to (a crafted ssh://<host>/ in a repo or CI config reaches
    # here), so it is caller-influenceable like every other string that
    # reaches wayprompt and needs the same allowlist. --sanitize-long, not
    # --sanitize: the fingerprint is legitimately multi-line and over 60
    # characters, and reading it in full is the entire point of this prompt
    # (see the comment above), so the 2-line cap and 60-character truncation
    # that protect a context line would be wrong here.
    description=$(printf '%s\n' "$prompt" | gatherd-prompt-context --sanitize-long 2>/dev/null)
    [ -n "$description" ] || description=$prompt
    "$wayprompt" \
        --title 'SSH host key verification' \
        --description "$description" \
        --button-ok 'Yes' \
        --button-not-ok 'No' \
        --button-cancel 'Abort' >/dev/null 2>&1
    case $? in
    0)  printf 'yes\n'; exit 0 ;;
    20) printf 'no\n'; exit 0 ;;
    *)  exit 1 ;;
    esac
    ;;
esac

# sudo's default prompt is "[sudo] password for <user>:", which we keep verbose
# on the terminal (no sudoers passprompt override). In the box that long form
# is noise, so collapse it to the bare tag the way [vault] and [polkit] read.
case "$prompt" in
'[sudo]'*) prompt='[sudo]' ;;
esac

# A caller that passes argv[2] is authoritative, even when it is empty --
# gatherd-polkit-agent passes "" when cmd-polkit could not resolve the action.
# Falling back to the /proc walk there would name cmd-polkit-agent, i.e. the
# plumbing, which is the exact misattribution the polkit path exists to avoid.
if [ "$#" -ge 2 ]; then
    context=$2
    # The /proc path is already sanitized by gatherd-prompt-context; this path
    # is caller-supplied and unbounded, so it needs the same allowlist before
    # it reaches the renderer. Run only here -- running it twice on the /proc
    # branch could double an "[elided]" marker.
    context=$(printf '%s\n' "$context" | gatherd-prompt-context --sanitize 2>/dev/null)
else
    context=$(gatherd-prompt-context "$PPID" 2>/dev/null)
fi
# Never fatal: a prompt that cannot be annotated must still be shown.
[ -n "$context" ] || context='context unavailable'

# The prompt tag reaching here is also caller-influenceable -- an ssh
# passphrase prompt embeds a key path -- so it needs the same allowlist as
# everything else that reaches wayprompt. Unlike the host-key description,
# this is always short (a bare tag, or "Enter passphrase for key '<path>':"),
# so the truncating mode is the right one: it catches a pathologically long
# forged prompt, and on a normal one-line tag the 2-line cap and the
# elevating:/requested-by neutralising in that mode are simply inert.
box_prompt=$(printf '%s\n' "$prompt" | gatherd-prompt-context --sanitize 2>/dev/null)
[ -n "$box_prompt" ] || box_prompt=$prompt

# Line 2 is "pin: <secret>", per nowayprompt(1). Anchor the strip to the start
# of that line rather than substituting anywhere: an unanchored s/pin: //
# corrupts any password containing that string, which is how wayprompt's own
# shell ssh-askpass got it wrong. printf rather than echo, so a secret starting
# with "-n" is not eaten.
out=$("$wayprompt" \
    --title 'gatherd' \
    --description "$context" \
    --prompt "$box_prompt" \
    --button-ok 'OK' \
    --button-cancel 'Cancel' \
    --get-pin 2>/dev/null)
rc=$?

if [ "$rc" -ne 0 ]; then
    note "prompt=$prompt exit=$rc"
    exit "$rc"
fi

printf '%s\n' "$out" | sed -n '2s/^pin: //p'
