#!/bin/bash
# Fail fast, and by name, when an AUR build is about to miss a dependency.
#
# aur sync builds with PACMAN_AUTH=/bin/false, so makepkg cannot install a
# missing dependency. What it does instead is build every package that IS
# satisfiable first and die on the one that is not, so the operator sees
#
#     ==> ERROR: 'pacman' failed to install missing dependencies.
#
# fourteen minutes in, with the name of the actual culprit ("Missing
# dependencies: -> gsl") buried in stdout above it. This asks the same question
# aurutils would, before any of that: resolve the targets' dependencies, drop
# the ones this same sync builds, and let pacman say which of the rest are
# absent.
#
# Run immediately before the aur sync it guards. That placement is the whole
# trick -- it inspects the machine at the one moment that matters, so it needs
# no model of which tier installs what when.
#
# Fails OPEN when the AUR cannot answer, and CLOSED when it answers that a
# target does not exist: an unreachable AUR is weather, but a target the AUR has
# never heard of is this repo naming a package wrong, which is a mistake it has
# made twice (rclone left for [extra]; captive-browser is only a provides of
# captive-browser-git). Treating that as "skipping the check" would turn the
# guard into a permanent no-op and blame the network for it.
#
# Usage: gatherd-assert-aur-deps <pkgbase>...   (exit 0 clean, 1 with the list)

set -uo pipefail

[ $# -gt 0 ] || { echo "usage: $0 <pkgbase>..." >&2; exit 2; }

ERR=$(mktemp) || exit 2
trap 'rm -f "$ERR"' EXIT

open() { echo "gatherd-assert-aur-deps: $1; skipping the check" >&2; exit 0; }

# aurutils shells out to `curl -A aurutils -fgLsSq` with neither
# --connect-timeout nor --max-time (AUR/Query.pm), and gatherd-async.service
# sets no TimeoutStartSec, so a black-holed route hangs the converge forever
# rather than failing. A refusal or a 429 already returns promptly.
TABLE=$(timeout 60 aur depends --table "$@" 2>"$ERR")
RC=$?

# A missing target is reported on stderr and does NOT set the exit status when
# other targets resolved, so the status alone would let a stale name silently
# drop out of the check.
if grep -q 'target not found' "$ERR"; then
    echo "Named as an AUR package, but the AUR has no such target:" >&2
    sed -n 's/.*target not found: /  /p' "$ERR" >&2
    echo >&2
    echo "Building: $*" >&2
    echo "Check the pkgbase: a plain name is often only a provides of a -git or" >&2
    echo "-bin package, and packages do leave the AUR for the official repos." >&2
    exit 1
fi
[ "$RC" -eq 124 ] && open 'the AUR did not answer within 60s'
[ "$RC" -ne 0 ] && open 'cannot reach the AUR'

# Column 1 is the pkgname of every package this sync builds (column 3 is its
# pkgbase; for a split package the two differ, and it is the pkgname a
# dependency names). Anything built here is not required up front.
SIBLINGS=$(printf '%s\n' "$TABLE" | cut -f1 | sort -u)
# ...and neither is anything they provide: open-fprintd asks for
# fprintd-clients, which is a provides of the fprintd-clients-git built beside
# it. aur depends resolves targets by name only, so it cannot tell us this.
mapfile -t _siblings <<<"$SIBLINGS"
PROVIDES=$(timeout 60 aur query -t info "${_siblings[@]}" 2>/dev/null | python3 -c '
import json, sys
try:
    for r in json.load(sys.stdin)["results"]:
        for p in (r.get("Provides") or []):
            print(p.split("=")[0].split(">")[0].split("<")[0].strip())
except Exception:
    pass
' | sort -u)
BUILT=$(printf '%s\n%s\n' "$SIBLINGS" "$PROVIDES" | sed '/^$/d' | sort -u)

# Dependencies carry version bounds (open-fprintd>=0.6) that the sibling list
# does not, so compare on the bare name and hand pacman the original -- it is
# the one that understands bounds, sonames and virtuals.
WANTED=$(printf '%s\n' "$TABLE" | awk -F'\t' '$5 != "Self" { print $2 }' | sort -u |
    while IFS= read -r dep; do
        [ -n "$dep" ] || continue
        bare=${dep%%[<>=]*}
        grep -qxF "$bare" <<<"$BUILT" || printf '%s\n' "$dep"
    done)

[ -n "$WANTED" ] || exit 0

MISSING=$(printf '%s\n' "$WANTED" | xargs -r pacman -T)

[ -n "$MISSING" ] || exit 0

# `aur depends` answers from the AUR's RPC, which flattens depends_x86_64 and
# depends_aarch64 into one Depends list. makepkg honours only the suffix that
# matches this machine, so claude-desktop's aarch64 QEMU pair
# (qemu-system-aarch64, edk2-aarch64) reads as missing on every x86_64 machine
# and fails the slow AUR tier over two packages makepkg will never ask for.
# .SRCINFO is the one place the suffixes survive, so ask it -- as
# gatherd-check-aur-deps already does, though the two still differ on the
# aarch64 machine that does not exist yet: the gate carries those two names in
# its ALLOWED table, and this does not.
#
# Three rules make this subtraction safe, and each of them was wrong first:
#
#   Drop only what a FOREIGN suffix declares and no native list mentions. The
#   tempting shape -- keep what the native lists mention -- has the same answer
#   on every package we build and a silent failure on a name in neither list
#   (the RPC and .SRCINFO spelling a dependency differently, a body that parses
#   to nothing). This sits after pacman -T, where the only thing it can do is
#   turn a red green, so an unexplained name has to survive, not vanish.
#
#   Compare bare names on both sides. .SRCINFO writes bounds where it likes,
#   and `depends = qemu-system-aarch64>=8` with `depends_aarch64 =
#   qemu-system-aarch64` is one package named twice. Keep the raw strings and
#   the bounded native entry never cancels the bare foreign one, so a
#   dependency this architecture requires is dropped with no message and no
#   exit code. Measured: that fixture goes rc=1 to rc=0. The mirror image, with
#   the bound on the foreign line, is harmless -- raw strings can only shrink
#   foreign membership, which only makes the filter more conservative -- and
#   pinning that direction instead is how this went a round uncaught.
#
#   Ask only about the pkgbases that declare something in MISSING, cache the
#   answer under the AUR's own LastModified, and when one of them cannot be
#   read, keep ITS dependencies. A blanket skip on a cgit
#   outage throws away a verdict that was already correct: clight's graph has no
#   arch-suffixed list anywhere, so no answer from .SRCINFO could have changed
#   `gsl` from missing to present, and exiting 0 there is exactly the swallowed
#   dependency this script exists to prevent. Scoping also makes it one request
#   on the slow tier rather than nine, which matters because MISSING is
#   non-empty there on EVERY converge -- the aarch64 pair is permanently absent
#   from every x86_64 machine, so this path is the normal one, not the rare one.
#
# The cache is gatherd-check-aur-deps's -- same directory, same file names,
# <pkgbase>.<LastModified>.SRCINFO under XDG_CACHE_HOME/gatherd -- so the two
# populate each other, and the upstream mtime in the name means a stale entry
# can never be read as fresh. It is also what keeps a cgit outage from failing a
# tier on a converged machine: without it the slow tier's exit 1 is CERTAIN
# whenever cgit is down, because MISSING is never empty there, and the message
# would tell the operator to declare the one package they must not.
#
# The .SRCINFO URL follows AUR_LOCATION, and AUR_SRCINFO overrides it outright:
# the tests need to put this into states the network will not supply on demand,
# and a build's own aurutils config (XDG_CONFIG_HOME/aurutils/env) is not read
# here, so the two can in principle point at different hosts.
#
# uname -m is not strictly makepkg's authority -- it keys the suffixes off
# CARCH from /etc/makepkg.conf. The two agree on x86_64 and aarch64 and differ
# on 32-bit ARM (armv7l vs armv7h), which no gatherd machine is.
SRC=$(mktemp) || exit 2
PAIRS=$(mktemp) || exit 2
INFO=$(mktemp) || exit 2
trap 'rm -f "$ERR" "$SRC" "$PAIRS" "$INFO"' EXIT

printf '%s\n' "$TABLE" | awk -F'\t' '$5 != "Self" { print $2 "\t" $3 }' | sort -u > "$PAIRS"

# The pkgbases that declare something in MISSING, and their upstream mtimes,
# asked of the RPC that has already answered once -- so the cache key costs no
# new dependency on cgit. No answer just means no key: that pkgbase is fetched
# fresh, exactly as it was before the cache.
MISSING_BARE=$(printf '%s\n' "$MISSING" | sed 's/[<>=].*$//;/^$/d' | sort -u)
mapfile -t _needed < <(
    while IFS=$'\t' read -r dep base; do
        grep -qxF "${dep%%[<>=]*}" <<<"$MISSING_BARE" && printf '%s\n' "$base"
    done < "$PAIRS" | sort -u)

if [ ${#_needed[@]} -gt 0 ]; then
    # LastModified is a JSON number, hence str(): concatenating it raises, and
    # the whole point of the fallback below is that a key we cannot build is
    # simply a fetch we do not cache -- so the failure would have been silent.
    timeout 60 aur query -t info "${_needed[@]}" 2>/dev/null | python3 -c '
import json, sys
try:
    for result in json.load(sys.stdin)["results"]:
        for key in (result["Name"], result["PackageBase"]):
            print(key + "\t" + str(result["LastModified"]))
except Exception as failure:
    print("cannot key the .SRCINFO cache:", failure, file=sys.stderr)
' > "$INFO"
fi

KEPT=$(printf '%s\n' "$MISSING" | timeout 120 python3 -c '
import os, re, sys, urllib.parse, urllib.request
from pathlib import Path

arch, base_url, pairs_path, info_path = sys.argv[1:5]

def bare(name):
    return re.split(r"[<>=]", name, maxsplit=1)[0].strip()

# Which pkgbase declares which dependency, from the table the RPC already gave
# us, so a name no pkgbase declares has no unreadable pkgbase to be excused by.
declared = {}
with open(pairs_path) as pairs:
    for row in pairs:
        dep, _, pkgbase = row.rstrip("\n").partition("\t")
        if dep and pkgbase:
            declared.setdefault(bare(dep), set()).add(pkgbase)

modified = {}
with open(info_path) as info:
    for row in info:
        key, _, mtime = row.rstrip("\n").partition("\t")
        if key:
            modified[key] = mtime

cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "gatherd"

def srcinfo(pkgbase):
    """The raw .SRCINFO, from the cache when the AUR says it has not moved."""
    mtime = modified.get(pkgbase)
    name = urllib.parse.quote(pkgbase, safe="")
    cached = cache / (name + "." + mtime + ".SRCINFO") if mtime else None
    if cached is not None and cached.exists():
        return cached.read_text()
    with urllib.request.urlopen(base_url + name, timeout=20) as response:
        text = response.read().decode("utf-8", "replace")
    # A 404 raises; a 200 carrying something else (a cgit error page, a captive
    # portal, a proxy interstitial) parses to no keys at all, which is
    # indistinguishable from a package with no dependencies.
    if "pkgbase" not in text:
        raise ValueError("fetched something that is not a .SRCINFO")
    if cached is not None:
        cache.mkdir(parents=True, exist_ok=True)
        for stale in cache.glob(name + ".*.SRCINFO"):
            stale.unlink()
        cached.write_text(text)
    return text

missing = [row.rstrip("\n") for row in sys.stdin if row.strip()]
needed = set()
for dep in missing:
    needed |= declared.get(bare(dep), set())

suffixed = re.compile(r"^(?:depends|makedepends|checkdepends)_(.+)$")
native, foreign, unreadable = set(), set(), set()

for pkgbase in sorted(needed):
    try:
        text = srcinfo(pkgbase)
    except Exception as failure:
        print(f"{pkgbase}: cannot read .SRCINFO ({failure})", file=sys.stderr)
        unreadable.add(pkgbase)
        continue
    for row in text.splitlines():
        key, sep, value = row.partition("=")
        if not sep:
            continue
        key, value = key.strip(), bare(value)
        match = suffixed.match(key)
        if match:
            (foreign if match.group(1) != arch else native).add(value)
        elif key in ("depends", "makedepends", "checkdepends"):
            native.add(value)

for dep in missing:
    name = bare(dep)
    if name in foreign and name not in native and not declared.get(name, set()) & unreadable:
        continue
    print(dep)
' "$(uname -m)" \
    "${AUR_SRCINFO:-${AUR_LOCATION:-https://aur.archlinux.org}/cgit/aur.git/plain/.SRCINFO?h=}" \
    "$PAIRS" "$INFO" 2>"$SRC")
KEPT_RC=$?

# Only a bug in the filter itself leaves MISSING as it was; every network- and
# body-shaped failure is already decided per pkgbase above.
if [ "$KEPT_RC" -eq 0 ]; then
    MISSING=$KEPT
    [ -n "$MISSING" ] || exit 0
fi
[ -s "$SRC" ] && sed 's/^/  /' "$SRC" >&2

echo "Not installed, and makepkg cannot install them (PACMAN_AUTH=/bin/false):" >&2
printf '%s\n' "$MISSING" | sed 's/^/  /' >&2
echo >&2
echo "Building: $*" >&2
echo "Declare each in a *_packages var that converges BEFORE this build." >&2
exit 1
