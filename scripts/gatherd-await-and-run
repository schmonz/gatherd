#!/bin/sh
# gatherd-await-and-run — wait for a gatherd play's preconditions, then run it once.
#
# Started once at boot by the init system, this blocks until the first-boot
# gatherd run has finished -- and, only with --needs-vault, until a password that
# decrypts the vault is also present -- then runs the given playbook. The waiting
# happens inside this one process, so there is no file-watch / path unit to
# re-fire after the play finishes — which is what used to loop a oneshot into
# systemd's start limit and leave it 'failed'.
#
# Keeping the logic here (POSIX sh, no init-specific bits) is also what makes
# the eventual Artix port cheap: a runit/s6/OpenRC run script only has to exec
# this; nothing below depends on systemd.
#
# Usage: gatherd-await-and-run [--needs-vault] <sentinel> <playbook>
#
# --needs-vault is passed by exactly the units whose playbook declares
# `vars_files: vault/vault.yml`. It used to be unconditional, which made the REST
# tier hostage to a password site-async.yml never reads -- and REST is what
# installs nowayprompt, the renderer the in-session vault prompt needs, so on a
# fresh machine the password could not even be asked for. See
# docs/superpowers/specs/2026-09-07-first-login-cohort-design.md.
set -eu

needs_vault=no
case "${1:-}" in
--needs-vault) needs_vault=yes; shift ;;
esac

sentinel="$1"
playbook="$2"

# Overridable only so these paths can be pointed at a sandbox in tests.
gatherd_home="${GATHERD_HOME:-/usr/local/lib/gatherd}"
vault_pass="$gatherd_home/.vault_pass"
vault_file="$gatherd_home/vault/vault.yml"
complete="${GATHERD_CORE_COMPLETE:-/etc/gatherd/core-complete}"

# The barrier the session cohort waits on (scripts/gatherd-await-async) needs to
# know this run is OVER, which is a different question from whether it succeeded:
# site-async.yml writes its sentinel only when no tier failed, so a failed run is
# indistinguishable from one still going. This stamp answers the first question
# and the sentinel keeps answering the second.
stamp="${sentinel}-finished"

# HEAD as it stands when the run ENDS, which is not necessarily the HEAD the run
# used: a `git pull` landing mid-run stamps the new commit as finished by a run
# of the old tree. site-async.yml's own sentinel post_task has the identical
# shape, so the stamp and the sentinel at least agree with each other; the next
# boot's needs-run check is what actually catches up.
#
# The second line is the kernel's boot id, for gatherd-show-slow-progress: a
# stamp from THIS boot means this runner got past its waits and exited this boot
# -- the play ran, was skipped as converged, or the galaxy install failed --
# whatever HEAD it records, and
# after a `git pull` with no reboot this unit does not start again on its own
# until the next one. gatherd-needs-run reads only the first line, so the barrier
# is unaffected.
# An unreadable boot id leaves the line empty, which matches no boot.
boot_id_file="${GATHERD_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
mark_finished() {
    _head=$(git -C "$gatherd_home" -c safe.directory="$gatherd_home" rev-parse HEAD 2>/dev/null) || return 0
    _boot=$(cat "$boot_id_file" 2>/dev/null) || _boot=
    printf '%s\n%s\n' "$_head" "$_boot" > "$stamp" 2>/dev/null || true
}

# Deliberately no trap to call mark_finished on SIGTERM. A killed run leaves no
# stamp on purpose: gatherd-async.service restarts at the next boot and runs the
# play for real, and that run's own mark_finished is what should release the
# barrier. A stamp written on TERM would record this HEAD as finished for a run
# that never actually finished, so the next login's barrier would release
# immediately while the new run is still going -- a false release, the same
# class of bug an earlier version of this barrier was reverted for. The one case
# this leaves uncovered -- the unit stopped by hand and never restarted -- is the
# barrier's timeout doing its job, not a bug.

# Nothing to do if this play isn't deployed (e.g. no site-vault.yml).
[ -f "$playbook" ] || exit 0

# Block until the first-boot run has finished. Polling (rather than inotify)
# keeps this dependency-free and identical across inits; 2s latency is irrelevant
# for setup work.
while [ ! -f "$complete" ]; do
    sleep 2
done

# And, only for a play that actually reads the vault, until a password that
# decrypts it is present. A mistyped password is discarded right here so the
# prompt side re-asks; we never carry a bad password into the play, where the
# decryption failure would fail the unit permanently with no retry path.
if [ "$needs_vault" = yes ]; then
    while :; do
        while [ ! -f "$vault_pass" ]; do
            sleep 2
        done
        # No vault deployed → the password only needs to exist, not to decrypt.
        [ -f "$vault_file" ] || break
        if ansible-vault view --vault-password-file="$vault_pass" "$vault_file" >/dev/null 2>&1; then
            break
        fi
        rm -f "$vault_pass"
    done
fi

# Skip if this play already converged at the deployed git HEAD -- but stamp
# first, or a machine with nothing to do never releases the cohort.
#
# Only exit 1 means converged, the same rule gatherd-await-async applies to the
# same helper. A missing script exits 127 and a non-executable one 126, and `!`
# read either as converged: the play would be skipped AND stamped finished, so
# the barrier would release the cohort onto a machine that never ran REST at all.
"$gatherd_home/scripts/gatherd-needs-run" "$sentinel" && needs_run_rc=0 || needs_run_rc=$?
if [ "$needs_run_rc" -eq 1 ]; then
    mark_finished
    exit 0
fi

# ansible resolves ansible.cfg from the working directory.
cd "$gatherd_home"

ansible-galaxy collection install --requirements-file "$gatherd_home/requirements.yml" && rc=0 || rc=$?
if [ "$rc" -ne 0 ]; then
    mark_finished
    exit "$rc"
fi

# Hold off sleep during the long package run when the tooling is available
# (elogind ships systemd-inhibit on Artix too), but tolerate its absence. The
# inhibitor is passed as this function's argv rather than interpolated into a
# command string, so --why's spaces survive without unquoted word splitting.
play() {
    if [ "$needs_vault" = yes ]; then
        "$@" ansible-playbook --vault-password-file="$vault_pass" "$playbook"
    else
        "$@" ansible-playbook "$playbook"
    fi
}

if command -v systemd-inhibit >/dev/null 2>&1; then
    play systemd-inhibit --what=sleep --who=gatherd \
        --why="gatherd background work in progress" --mode=block && rc=0 || rc=$?
else
    play && rc=0 || rc=$?
fi

mark_finished
exit "$rc"
