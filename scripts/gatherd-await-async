#!/bin/sh
# Barrier for session helpers whose subject the REST tier installs. Blocks until
# the async run has finished -- converged or failed -- then always exits 0.
#
# Why: gatherd-session-helpers starts the cohort the instant sway starts, which
# on a repave is minutes before REST installs the things the cohort is about.
# Measured on the 2026-09-07 repave of this machine (session start 11:33:55,
# from `ps -o lstart=` on the supervisor; the rest from /var/log/pacman.log):
#
#     11:35:26  tailscale, conky, wayvnc
#     11:37:48  nowayprompt
#     11:44:16  1password
#     11:44:17  helium-browser-bin, arch-update, cmd-polkit-git, captive-browser-git
#
# Every helper that probed for its subject therefore found nothing and exited
# quietly: `pgrep -g` on the supervisor found zero surviving children afterwards.
# The freshly paved machine never opened the Tailscale or 1Password tabs the
# human had to act on, had no conky, no tray and no polkit agent, and nothing
# retried until the next login.
#
# A barrier, not a probe. Helpers keep their own readiness logic; this only stops
# them running it against a machine that has not finished installing. It returns
# immediately on every login after the first, so a converged machine pays nothing.
#
# Always exits 0. It is a wait, not a predicate -- a helper must never be
# suppressed because the barrier itself could not decide.
set -u

# Overridable only so the wait itself can be exercised in tests. On a converged
# machine the real sentinel is always present, so without this the one property
# that matters -- that it actually waits -- is the one no test can reach.
sentinel="${GATHERD_ASYNC_SENTINEL:-/etc/gatherd/async-complete}"
unit=gatherd-async.service

# Bounded so a hung or manually stopped run cannot hold the cohort for a whole
# session. Expiring is no worse than today's behaviour (the helpers all re-run at
# the next login); the bound exists only to keep the wait finite.
deadline=$(( $(date +%s) + ${GATHERD_AWAIT_ASYNC_TIMEOUT:-3600} ))

while [ ! -f "$sentinel" ]; do
    # A failed run never writes the sentinel, but its tiers are finished either
    # way, so release the cohort rather than wait out the bound. Same probe
    # gatherd-show-slow-progress uses, and it stays false while the unit is only
    # activating, so it cannot fire early. This is the one init-specific line in
    # the file, and it is guarded: an init without systemctl falls back to
    # sentinel-or-bound, which is correct, just slower to give up.
    if command -v systemctl >/dev/null 2>&1; then
        systemctl is-failed --quiet "$unit" 2>/dev/null && break
    fi
    [ "$(date +%s)" -lt "$deadline" ] || break
    sleep 2
done

exit 0
