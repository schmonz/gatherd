#!/bin/sh
# Barrier for session helpers whose subject the REST tier installs. Blocks until
# the REST run for the deployed commit is over -- converged, failed, or never
# going to start -- then always exits 0.
#
# Why: gatherd-session-helpers starts the cohort the instant sway starts, which
# on a repave is minutes before REST installs the things the cohort is about.
# Measured on the 2026-09-07 repave of this machine (session start 11:33:55, from
# `ps -o lstart=` on the supervisor; the rest from /var/log/pacman.log):
#
#     11:35:26  tailscale, conky, wayvnc
#     11:37:48  nowayprompt
#     11:44:16  1password
#     11:44:17  helium-browser-bin, arch-update, cmd-polkit-git, captive-browser-git
#     11:49:44  /etc/gatherd/async-complete
#
# Every helper that probed for its subject found nothing and exited quietly:
# `pgrep -g` on the supervisor found zero surviving children afterwards. The
# freshly paved machine never opened the Tailscale or 1Password tabs the human
# had to act on, and nothing retried until the next login.
#
# A barrier, not a probe. Helpers keep their own readiness logic; this only stops
# them running it against a machine that has not finished installing.
#
# Contains no systemctl call, deliberately. An earlier draft asked
# `systemctl is-failed`, which is wrong three measured ways -- `inactive` after a
# converged run, rc=4 for an unknown unit, and false while a CORE failure has the
# runner blocked before the playbook. Reading gatherd's own files instead is both
# correct and one less thing the Artix/s6 rebase has to answer.
#
# Not silent. A wait long enough to notice, and an expiry, each say so once via
# notify-send -- see announce() below.
#
# Always exits 0. It is a wait, not a predicate -- a helper must never be
# suppressed because the barrier itself could not decide.
set -u

gatherd_home="${GATHERD_HOME:-/usr/local/lib/gatherd}"

# Overridable only so the wait can be exercised in tests. On a converged machine
# the real files are always present, so without these the property that matters
# most -- that it actually waits -- is the one no test can reach.
sentinel="${GATHERD_ASYNC_SENTINEL:-/etc/gatherd/async-complete}"
core_marker="${GATHERD_CORE_MARKER:-/etc/gatherd/last-run}"
# Same variable name and default gatherd-await-and-run uses for the file whose
# existence gates it -- see below.
core_complete="${GATHERD_CORE_COMPLETE:-/etc/gatherd/core-complete}"
stamp="${sentinel}-finished"

# Spec section 6's principle, applied to this file: a helper that cannot do its
# job at the moment it is asked to must say so. Waiting minutes in silence is the
# same empty session the cohort fix exists to remove, only with the barrier as
# its cause instead of a lost helper.
#
# Guarded because the barrier must still always exit 0: libnotify is in
# tests/base-manifest.txt and gatherd-prompt-lastrun already notifies at login,
# so the path exists at the first login, but a notify-send that is missing, that
# fails, or that never returns must cost the cohort nothing.
#
# That last one is why the call is bounded. notify-send has no timeout of its
# own, and it can block indefinitely: measured on this machine against a unix
# socket that accepts the connection and then never speaks,
# `DBUS_SESSION_BUS_ADDRESS=unix:path=... notify-send x y` was still running
# when a `timeout 30` killed it (rc=124, 30006ms). It hangs in the D-Bus auth
# handshake, before any method call is made, so GDBus's own 25s call timeout
# never applies. announce() runs on the barrier's only thread, so a hang here
# holds the session cohort for the whole login -- the exact failure this file
# exists to prevent, reintroduced by the notification added to explain it.
#
# The realistic neighbours all return at once and need no bound: measured,
# unsetting DBUS_SESSION_BUS_ADDRESS gives rc=0 in 16ms and pointing it at a
# path nothing is listening on gives rc=1 in 10ms. Only the half-open bus hangs.
#
# When `timeout` is absent the notification is dropped rather than made
# unbounded: this function has one hard requirement (cost the cohort nothing)
# and one soft one (say something), and only the hard one is worth an unbounded
# call. The branch is unreachable in practice anyway -- `timeout` and the
# `date` this script already calls unconditionally are the same coreutils, which
# is in tests/base-manifest.txt.
announce() {
    command -v notify-send >/dev/null 2>&1 || return 0
    command -v timeout >/dev/null 2>&1 || return 0
    timeout 5 notify-send "$@" >/dev/null 2>&1 || true
}

# Freshness, not existence. site-async.yml overwrites the sentinel at the end of
# a run and never removes it at the start, so after a `git pull` the file is
# still on disk holding the OLD commit while REST re-runs the whole tier. A test
# for existence would return instantly on exactly the boots where a newly added
# helper most needs to wait.
#
# Only exit 1 means converged. A missing script exits 127 and a non-executable
# one 126 (measured: `sh -c '/no/such/file'` vs. the same path chmod 644'd),
# and treating either as converged would silently turn this barrier into a
# no-op.
current() {
    "$gatherd_home/scripts/gatherd-needs-run" "$1"
    [ "$?" -eq 1 ]
}

# A bound, so a hung run cannot hold the cohort for a whole session. Two hours
# rather than a tight fit around the one measured run: expiry releases the cohort
# into an install that is still going, so the cost of a bound that is too short
# is the exact failure this file exists to prevent, while the cost of one that is
# too long is a wait the human can now see (announce() above). The header's
# measured run wrote its sentinel at 11:49:44, about 16 minutes after the
# 11:33:55 session start; a slower machine or a big AUR compile has room here.
#
# Validated rather than trusted: `$(( ${VAR:-7200} ))` on a non-numeric value
# throws under `set -u`, which would break the always-exit-0 invariant this file
# states twice.
timeout=${GATHERD_AWAIT_ASYNC_TIMEOUT:-7200}
case "$timeout" in
'' | *[!0-9]*) timeout=7200 ;;
esac

# All-digit is not the same as safe. A leading zero makes `$(( ))` read the rest
# as octal: `08`/`019` contain a digit no octal number can, and error outright
# ("value too great for base") rather than fall back to anything, which would
# have hit the same `set -u`-adjacent crash the case above exists to avoid;
# `007` parses fine but silently means 7, which happens to equal decimal 7 here
# and would not for e.g. `017` (15). Stripped so every digit string is read the
# way it looks: in base 10.
while [ "${#timeout}" -gt 1 ]; do
    case "$timeout" in
    0*) timeout=${timeout#0} ;;
    *) break ;;
    esac
done

# And a value need not look wrong to break the arithmetic below: an
# unreasonably large one (a fat-fingered extra digit, or the literal max of
# whatever integer type the arithmetic uses) makes `$(( now + timeout ))`
# overflow past that type's max and wrap negative, so `[ "$(date +%s)" -lt
# "$deadline" ]` reads a deadline already in the past and releases at once on a
# machine that has not converged -- measured at 21ms with
# 9223372036854775807. One day is generous for even a stalled AUR tier and, at
# five digits, small enough that the clamp comparison below can never itself
# overflow.
max_timeout=86400
case "$timeout" in
[0-9] | [0-9][0-9] | [0-9][0-9][0-9] | [0-9][0-9][0-9][0-9] | [0-9][0-9][0-9][0-9][0-9])
    [ "$timeout" -gt "$max_timeout" ] && timeout=$max_timeout
    ;;
*) timeout=$max_timeout ;;
esac

# How long a wait has to last before it is worth interrupting the human about.
# Short enough to explain an empty session, long enough that a converged machine
# -- which returns from the loop below on its first pass -- never sees it.
# Overridable only so both notifications can be exercised in tests, the same
# reason the bound above is.
#
# Unlike the bound, this value is only ever compared with `[ -ge ]` and never fed
# to `$(( ))`, so neither the octal reading nor the overflow the sanitizers above
# exist for can reach it: measured under this machine's /bin/sh (bash),
# `[ 30 -ge 08 ]` is true and `[ 30 -ge 9223372036854775807 ]` is false, and
# neither errors. Non-digits still would, so those are still rejected.
notify_after=${GATHERD_AWAIT_ASYNC_NOTIFY_AFTER:-20}
case "$notify_after" in
'' | *[!0-9]*) notify_after=20 ;;
esac

started=$(date +%s)
deadline=$(( started + timeout ))
announced=no

while :; do
    # The run converged at this commit.
    current "$sentinel" && break

    # Or it ran and ended badly. site-async.yml writes its sentinel only when no
    # tier failed, so this stamp is the only thing that can say "over" about a
    # failed run. gatherd-await-and-run writes it on every exit path.
    current "$stamp" && break

    # Or REST cannot ever start this boot. gatherd-await-and-run gates on
    # core-complete's EXISTENCE (`while [ ! -f "$complete" ]`), not its
    # freshness, so that file being present is not proof CORE just succeeded --
    # it can be a stale leftover from a previous converge while a `git pull`'s
    # CORE re-run is failing right now. Measured: releasing on last-run alone (an
    # earlier version of this check) fired in that exact state, on the false
    # premise that a non-ok last-run always means REST never started -- and put
    # the cohort in front of a live install, the same failure class this barrier
    # exists to prevent, reached from underneath it. So both conditions, in this
    # order: core-complete absent (REST truly has nothing to start from) AND
    # last-run says CORE did not succeed (it is not just still running).
    #
    # An unreadable last-run is the same "cannot tell" as CORE still running --
    # wait, don't release. last-run is root-owned and this runs as the desktop
    # user; its mode is 0644 today (gatherd-run-core's bare redirect plus the
    # process umask) but nothing guarantees that stays true, and misreading
    # "cannot tell" as "failed" is the same class of false release as above.
    if [ ! -f "$core_complete" ] && [ -r "$core_marker" ]; then
        # Trim whitespace before the equality compare -- commit fc06442 exists in
        # this plan because an untrimmed marker has already caused a false
        # compare once. [[:space:]] covers space/tab/CR in the POSIX/C locale, the
        # same class that regression needed.
        status=$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e q "$core_marker" 2>/dev/null)
        [ "$status" != ok ] && break
    fi

    now=$(date +%s)

    # Expiry is a real outcome, not a formality: the cohort is about to start
    # against a machine that may still be installing its subjects. Say so.
    #
    # It is also where `git pull` + logout/login with no reboot lands --
    # gatherd-async.service already ran to completion this boot at the old HEAD,
    # so nothing will write a fresh sentinel or stamp until the next boot and the
    # wait can only ever end here. Telling that state apart from "REST is about
    # to run" needs unit state, which this file deliberately does not consult
    # (see the systemctl note in the header), so the honest answer is to make the
    # wait visible rather than to guess at its cause.
    if [ "$now" -ge "$deadline" ]; then
        announce --urgency=critical --icon=dialog-warning \
            "Desktop setup wait timed out" \
            "gatherd background setup has not finished. Starting the session helpers anyway -- some may be missing until the next login."
        break
    fi

    if [ "$announced" = no ] && [ "$(( now - started ))" -ge "$notify_after" ]; then
        announced=yes
        announce --icon=system-run \
            "Setting up this machine" \
            "Waiting for gatherd background setup to finish before starting the desktop session helpers."
    fi

    sleep 2
done

exit 0
