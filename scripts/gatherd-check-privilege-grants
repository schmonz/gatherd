#!/usr/bin/env python3
"""Fail if the playbook grants sudo privilege in a shape we have banned.

An interrupted converge used to leave `<user> ALL=(ALL) NOPASSWD: /usr/bin/pacman`
in /etc/sudoers forever: four task files granted it for the duration of a build
and revoked it in a block's `always:`, which runs when a TASK fails but not when
the PROCESS is killed. `pacman -U <any file>` is unrestricted root.

Two rules, both mechanically checkable:

  1. Nothing may write /etc/sudoers directly. Grants go in /etc/sudoers.d/, so
     a leftover is one file to find and delete rather than a line to locate
     inside a file that must stay syntactically valid.
  2. No grant may use `ALL=(ALL)`. Naming (root) as the target user is free and
     strictly narrower.

Every NOPASSWD line must additionally appear in ALLOWED below with a reason, so
adding one is a deliberate, reviewable act.

WHAT THIS DOES NOT DO. This is a spelling check, not a property check. All of
these grant equivalent privilege and pass clean: `Defaults:user !authenticate`;
a template: writing a .j2 (never parsed here -- it is not YAML); adding the user
to a wheel group that already has a NOPASSWD line; a polkit rule under
/etc/polkit-1/rules.d; a setuid helper. It raises the cost of reintroducing THIS
mistake. It does not make privilege escalation impossible.

Usage: gatherd-check-privilege-grants [repo-root]   (exit 0 clean, 1 on violations)
"""
import sys
from pathlib import Path

import yaml

# Deliberately inline, with the reason each is not the banned pattern.
ALLOWED = {
    '{{ target_user }} ALL=(root) NOPASSWD: /usr/local/lib/gatherd/scripts/gatherd-write-vault-pass\n':
        'permanent, one gatherd-owned script, (root) target',
    '{{ target_user }} ALL=(root) NOPASSWD: /usr/local/lib/gatherd/scripts/gatherd-pia-login\n':
        'permanent, one gatherd-owned script, (root) target',
    '{{ target_user }} ALL=(root) NOPASSWD: /usr/bin/pacman\n':
        'build-time only, in /etc/sudoers.d/gatherd-build-grant, swept every '
        'boot by gatherd-sudoers-sweep.service; narrowing it to a wrapper that '
        'validates argv is tracked in plans/TODO.md',
}

SUDOERS_KEYS = ('dest', 'path')


def walk(node, found):
    """Collect (sudoers-path, written-content) pairs anywhere in a parsed tree."""
    if isinstance(node, list):
        for n in node:
            walk(n, found)
    elif isinstance(node, dict):
        for key, val in node.items():
            if isinstance(val, dict):
                target = next((str(val[k]) for k in SUDOERS_KEYS
                               if k in val and str(val[k]).startswith('/etc/sudoers')), None)
                if target:
                    body = val.get('content') or val.get('line') or val.get('block') or ''
                    found.append((target, str(body), val.get('state')))
            walk(val, found)


def main():
    root = Path(sys.argv[1] if len(sys.argv) > 1 else '.')
    violations = []
    # Repo-wide, matching gatherd-check-package-tiers: a grant moved out of a
    # role and into a playbook must not slip past.
    for path in sorted(root.glob('**/*.yml')):
        if any(part in ('.git', '.ansible', 'docs') for part in path.parts):
            continue
        try:
            doc = yaml.safe_load(path.read_text())
        except (yaml.YAMLError, UnicodeDecodeError):
            continue
        found = []
        walk(doc, found)
        for target, body, state in found:
            rel = path.relative_to(root)
            if target.rstrip('/') == '/etc/sudoers':
                violations.append((rel, target, 'writes /etc/sudoers directly; use /etc/sudoers.d/'))
                continue
            if 'ALL=(ALL)' in body:
                violations.append((rel, target, 'grants ALL=(ALL); name (root) as the target user'))
                continue
            # Removals carry the same body but grant nothing.
            if 'NOPASSWD' in body and state != 'absent' and body not in ALLOWED:
                violations.append((rel, target, f'undeclared NOPASSWD grant: {body.strip()!r}'))

    if violations:
        print('Privilege grants that are banned or undeclared — fix the task, or '
              'add the line to ALLOWED in this script with a reason:\n')
        for rel, target, why in violations:
            print(f'  {rel}: {target}: {why}')
        return 1

    print(f'No banned privilege grants; {len(ALLOWED)} documented exception(s).')
    return 0


if __name__ == '__main__':
    sys.exit(main())
