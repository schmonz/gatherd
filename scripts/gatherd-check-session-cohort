#!/bin/sh
# Fail if a session helper is started ahead of the thing it needs.
#
# The mistake this catches: gatherd-session-helpers starts its cohort the instant
# sway starts, which on a repave is minutes before the REST tier installs what
# most of those helpers are about. A helper started too early probes for its
# subject, finds nothing, and exits -- silently, with no notification and no log.
# Measured on the 2026-09-07 repave, that lost the entire cohort for the whole
# first session: no Tailscale tab, no 1Password tab, no conky, no tray, no polkit
# agent, and nothing retried until the next login. It went unnoticed for hours
# precisely because the failure mode of every one of them is to say nothing.
#
# The rule for the immediate form is exact, and cheap, because CORE installs no
# packages at all (CLAUDE.md, "No packages, no AUR, no downloads"). So the set of
# packages present at the first login is precisely tests/base-manifest.txt:
#
#     a `start_now` helper may only need packages in tests/base-manifest.txt.
#
# It therefore has to declare what it needs. An undeclared start_now is a hard
# failure rather than a silent bet -- writing the declaration is the moment the
# author asks the question this gate exists to force.
#
# WHAT THIS DOES NOT DO. It checks DECLARED START-TIME needs. It cannot verify a
# declaration is complete, or honest, and it says nothing about what a helper
# reaches for later: gatherd-prompt-captiveportal legitimately declares only base
# packages and still cannot clear a portal during a pave, because captive-browser
# is itself a REST package and the base image has no browser at all. That case is
# irreducible -- no ordering fixes it -- so the helper announces its inability at
# runtime instead. Do not read a green run here as "every helper can do its job".
#
# This is a parser of convenience, not of record, and it is deliberately strict
# rather than silently blind about where that convenience ends:
#
#   - It understands ONE launch per line, unconditionally invoked
#     (`start_now "$x"`, never `cond && start_now "$x"`, never two calls
#     sharing a line). Anything else is rejected outright as unmatched, not
#     skipped -- see the "does not begin its line" / "share one line" checks
#     below. A silent skip here is exactly how the 2026-09-07 bug went
#     unnoticed: a guarded or doubled-up launch would otherwise be invisible
#     to every rule that follows.
#   - It understands exactly ONE `{ ... } &` block. A second gated block is
#     not a shape this file has, so it is not a shape this gate resolves.
#   - "Installed by CORE" means a `src:` line naming the barrier (directly, or
#     as a `loop:`/`with_items:` entry alongside a templated `src: .../{{ item
#     }}`) inside a roles/*/tasks/core.yml OR a file it reaches via
#     `import_tasks:`/`include_tasks:` -- resolved ONE level only, so a second
#     layer of indirection (core.yml imports A, A imports B, B installs the
#     barrier) is not a shape this gate follows. It does not run Ansible: a
#     `when:` that is always false, or a `dest:` that never matches this host,
#     would still count as installed here. Narrower still: import resolution
#     follows only a bare, unquoted, one-level `import_tasks:`/`include_tasks:`
#     relative to the referencing file -- a quoted or templated ref, or the
#     `include_tasks:` + separate `file:` sub-key spelling, is not resolved.
#     Loop detection recognizes only the block-sequence spelling (`loop:` then
#     items at exactly four spaces) -- inline flow (`loop: [a, b]`), a
#     variable-driven loop, and items nested inside a `block:` are not. Any of
#     these is rc=2 ("could not run"), not a silent rc=0 -- loud, not a
#     mystery, but still a real edge someone will eventually hit.
#   - A barrier call hidden inside a heredoc or a multi-line quoted string
#     would be counted as the real invocation if it matched the anchor
#     pattern below. That shape exists in this file today -- start_when's own
#     body is a multi-line `sh -c '...'` -- though it happens not to contain
#     such a call; the risk is that it or a similar block one day could, and
#     nothing here would notice. Closing that needs a shell parser, which is
#     a worse trade than naming the limit here.
#
# DECLARED, not present: this reads the repo, never the machine it runs on. A
# converged machine has everything installed, so "does it work here" would pass
# for every possible ordering and catch nothing.
#
# Exit 0 clean, 1 violation, 2 could not run. Never a silent skip.
#
# Usage: gatherd-check-session-cohort [repo-root]
set -u

repo="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
helpers="$repo/scripts/gatherd-session-helpers"
manifest="$repo/tests/base-manifest.txt"
barrier=gatherd-await-async

die() { printf 'gatherd-check-session-cohort: %s\n' "$1" >&2; exit 2; }

[ -r "$helpers" ]  || die "cannot read $helpers"
[ -r "$manifest" ] || die "cannot read $manifest"

hfile=$(mktemp) || die "mktemp failed"
mfile=$(mktemp) || die "mktemp failed"
cfile=$(mktemp) || die "mktemp failed"
all=$(mktemp) || die "mktemp failed"
launches=$(mktemp) || die "mktemp failed"
mentions=$(mktemp) || die "mktemp failed"
core_files=$(mktemp) || die "mktemp failed"
extra_files=$(mktemp) || die "mktemp failed"
trap 'rm -f "$hfile" "$mfile" "$cfile" "$all" "$launches" "$mentions" "$core_files" "$extra_files"' EXIT

# CRLF survives word-splitting -- \r is not in $IFS -- so on a Windows-edited
# file it rides along on the last package name on a `# needs:` line, and a
# package that is right there in the manifest silently fails to match. Strip
# it once, up front, rather than special-casing every place that later reads
# a line.
tr -d '\r' < "$helpers" > "$hfile"
tr -d '\r' < "$manifest" > "$mfile"

# The barrier has to exist, be runnable, and be installed by CORE specifically
# -- or every start_later either waits on a command that is not there, or on
# one that only REST installs, which is the original bug again: the barrier
# itself would not exist at the first login it exists to gate.
[ -s "$repo/scripts/$barrier" ] || die "$repo/scripts/$barrier does not exist or is empty"
[ -x "$repo/scripts/$barrier" ] || die "$repo/scripts/$barrier is not executable"

# Detect whether FILE installs the barrier -- either a literal `src:` line, or
# (roles/desktop/tasks/core.yml's pbcopy/pbpaste pair, and tablet_mode.yml's
# music-stand scripts, are exactly this shape) a templated `src: .../{{ item
# }}` task whose own `loop:`/`with_items:` list names the barrier. A parser of
# convenience, not of record: it tracks one task at a time, reset at each
# blank line or `- name:` (this repo's task-separator convention), and stops
# trusting a `loop:`/`with_items:` list the moment a line no longer looks like
# one of its items.
file_installs_barrier() {
    _f=$1
    _templated=no
    _in_loop=no
    while IFS= read -r _l; do
        case "$_l" in
        '') _templated=no; _in_loop=no; continue ;;
        '- name:'*) _templated=no; _in_loop=no ;;
        esac

        # A `case` glob's `[[:space:]]*` matches exactly ONE whitespace char
        # then a wildcard for anything -- it is not "zero or more spaces", so
        # an unstripped line let `src:`/`loop:` match anywhere past column 1:
        # inside a comment (`  # src: .../scripts/gatherd-await-async`), or
        # inside an unrelated key's quoted value (`msg: "src: scripts/... was
        # removed"`). Strip a trailing comment and leading whitespace first,
        # then anchor the patterns to the START of what is left.
        _code=${_l%%#*}
        _code=$(printf '%s' "$_code" | sed 's/^[[:space:]]*//')

        case "$_code" in
        src:*scripts/"$barrier"*) return 0 ;;
        src:*'scripts/{{'*item*'}}'*) _templated=yes ;;
        esac

        if [ "$_in_loop" = yes ]; then
            case "$_l" in
            '    -'*)
                _item=$(printf '%s' "$_l" | sed 's/^[[:space:]]*-[[:space:]]*//; s/[[:space:]]*$//; s/^"//; s/"$//')
                [ "$_item" = "$barrier" ] && return 0
                continue
                ;;
            *) _in_loop=no ;;
            esac
        fi

        case "$_code" in
        loop:*|with_items:*)
            [ "$_templated" = yes ] && _in_loop=yes
            ;;
        esac
    done < "$_f"
    return 1
}

find "$repo/roles" -type f -path '*/tasks/core.yml' > "$core_files" 2>/dev/null

# CORE genuinely installs scripts from files core.yml only REACHES: CLAUDE.md's
# "Tiny task files" convention pushes work into files named for what they do,
# imported from core.yml (roles/desktop/tasks/core.yml's own tablet_mode.yml is
# exactly this). One level, not recursive -- a second layer of indirection is
# not a shape this repo currently uses, and the header says so as a limit.
while IFS= read -r f; do
    d=$(dirname "$f")
    grep -oE 'ansible\.builtin\.(import|include)_tasks:[[:space:]]*[^[:space:]]+' "$f" 2>/dev/null \
        | sed -E 's/^.*_tasks:[[:space:]]*//' \
        | while IFS= read -r ref; do
            [ -f "$d/$ref" ] && printf '%s\n' "$d/$ref" >> "$extra_files"
        done
done < "$core_files"
cat "$extra_files" >> "$core_files"

found_install=no
while IFS= read -r f; do
    # A `state: absent` removal task and a bare comment both name the path
    # without installing anything, and an install in tasks/rest.yml must fail
    # this exactly the same way -- REST is not there yet at the login this
    # gates. file_installs_barrier only recognizes `src:`/loop shapes, so both
    # are already excluded by construction.
    file_installs_barrier "$f" && { found_install=yes; break; }
done < "$core_files"
[ "$found_install" = yes ] \
    || die "no roles/*/tasks/core.yml (or file it imports) installs scripts/$barrier"

# Locate the gated block, so "behind the barrier" is a fact about nesting rather
# than a guess from line numbers. A bare line-number test passes four different
# ways of not waiting: a start_later after the closing `} &`, one at the top of
# the block above the barrier call, a barrier invocation commented out, and a
# start_now buried inside the block.
#
# The leading-quote anchor is what rules out a comment, which
# `#   "$bin/gatherd-await-async"` would otherwise satisfy.
barrier_line=$(grep -n "^[[:space:]]*\"[^\"]*/$barrier\"[[:space:]]*$" "$hfile" | head -1 | cut -d: -f1)
[ -n "$barrier_line" ] \
    || die "$helpers never invokes $barrier as a command; start_later would not wait"

open_line=$(awk -v b="$barrier_line" 'NR < b && /^[[:space:]]*\{[[:space:]]*$/ { n = NR } END { print n }' "$hfile")
close_line=$(awk -v b="$barrier_line" 'NR > b && /^[[:space:]]*\}[[:space:]]*&[[:space:]]*$/ { print NR; exit }' "$hfile")
[ -n "$open_line" ]  || die "no \`{\` opening a block above the $barrier call on line $barrier_line"
[ -n "$close_line" ] || die "no \`} &\` closing the block opened on line $open_line"

rc=0
fail() { printf 'FAIL %s\n' "$1" >&2; rc=1; }

# A code-only view of the file, for deciding what counts as a launch MENTION:
# text after an unquoted `#` and text inside quotes are dropped, line by line,
# so a trailing comment ("# deliberately not start_now") or a quoted string
# that happens to contain one of these words ("use start_later instead") is
# not itself mistaken for a call. This is the same reason a real start_now's
# OWN `# needs:` comment must not add to its line's call count.
#
# Two kinds of line skip sanitizing and are used RAW instead, for two
# unrelated reasons. Neither fallback resolves anything: it only puts the line
# back in view so the "share one line" / "does not begin its line" rules below
# judge it, which rejects it unless the raw line is itself a well-formed
# launch. A launch whose ARGUMENT merely contains escaped quotes takes the
# first fallback and is accepted, because the raw line still anchors and still
# counts one call.
#
#   - A backslash immediately followed by a quote (`\"` or `\'`). This scanner
#     has no escape handling, so it counts such a quote as real: the five raw
#     apostrophes in `echo 'don'\''t'` leave it stuck "inside a quote" to the
#     end of the line, swallowing whatever follows. A bare `\n`/`\t` is not a
#     quoting ambiguity and does not trigger this, so a `printf 'start_later
#     is the default\n'` still sanitizes normally and stays correctly silent.
#
#   - Sanitizing LOST a form word AND the raw line names an evaluating
#     construct (`eval`, `sh`, `bash`, `dash`, `env`). Quoting is precisely how
#     those constructs carry code: in `eval "start_now $bin/x"` and `sh -c
#     'start_now $bin/x'` the launch really is inside a quote, so a correct
#     quote tracker MUST drop it -- the escape in the `\"` spelling is
#     incidental, the quote is the mechanism. Dropping it is what silently
#     hid the launch, which is the one outcome this gate must never produce.
#     The scope is what makes this safe to do: falling back whenever a form
#     word is lost would also drag round 2's legal shapes (a trailing comment
#     naming another form, `msg="use start_later instead"`) onto the raw line
#     and fail them. Both fallbacks can still be loudly wrong -- a decorative
#     escaped quote, or an inert mention of a form word sharing a line with an
#     `sh` -- and a loud false positive is the direction to be wrong in.
#
#     What the word list does NOT cover stays hidden, and the class is wider
#     than one example. Measured on this machine, all rc=0 with no output:
#     `su - "$u" -c '...'`, `doas -u "$u" '...'`, `ssh host '...'`,
#     `zsh -c '...'`, `ksh -c '...'`, `systemd-run --user '...'`. Measured
#     caught, rc=1: `sh -c`, `/bin/sh -c`, `sudo sh -c`, `nohup sh -c`,
#     `xargs -I{} sh -c`, `setsid /usr/bin/env sh -c`, `bash -c`, `dash -c`,
#     `env`, `eval`. (`command start_now "$x"`, `$(start_now "$x")` and a
#     backticked one are caught too, but for a different reason: there the
#     form word is not inside a quote at all, so sanitizing never loses it.)
#     Every uncovered member needs an interpreter other than the one
#     gatherd-session-helpers's own header commits it to ("depends only on
#     sway + POSIX sh"), so each would be a defect on its own terms before
#     this gate ever mattered. Closing the class properly needs a
#     shell parser, not a longer word list -- more short words would only
#     widen the false-positive surface above.
#
#   - One more shape needs no evaluator at all and is likewise hidden: a
#     quoted form word, `"start_now" "$bin/x"`, which the shell runs and
#     sanitizing drops. Measured rc=0 here, rc=1 only at f37aea7 -- round 2's
#     quote-aware scanner reopened it. Left open because nobody quotes a
#     function name, and pinned by tests/check-session-cohort case 45 so a
#     future change trips over it instead of widening it silently.
awk '
    BEGIN {
        dq = "\""; sq = sprintf("%c", 39)
        FORM = "(^|[^a-zA-Z0-9_])start_(now|later|when)([^a-zA-Z0-9_]|$)"
        EVALS = "(^|[^a-zA-Z0-9_])(eval|sh|bash|dash|env)([^a-zA-Z0-9_]|$)"
    }
    {
        line = $0
        has_escaped_quote = 0
        for (i = 1; i < length(line); i++) {
            if (substr(line, i, 1) == "\\") {
                nc = substr(line, i + 1, 1)
                if (nc == dq || nc == sq) { has_escaped_quote = 1; break }
            }
        }
        if (has_escaped_quote) { print line; next }

        out = ""; q = ""
        for (i = 1; i <= length(line); i++) {
            c = substr(line, i, 1)
            if (q != "") { if (c == q) q = ""; continue }
            if (c == dq || c == sq) { q = c; continue }
            if (c == "#") break
            out = out c
        }
        if (line ~ FORM && out !~ FORM && line ~ EVALS) { print line; next }
        print out
    }
' "$hfile" > "$cfile"

# Every REAL use of the three forms, wherever it sits on the line -- not only
# at the very start. A guarded launch (`[ -n "$X" ] && start_now ...`) or two
# launches sharing one line would otherwise never reach any rule below at all:
# that is the 2026-09-07 bug shape exactly, a helper the gate never saw.
grep -nE '(^|[^[:alnum:]_])start_(now|later|when)([^[:alnum:]_]|$)' "$cfile" \
    | grep -v '^[0-9]*:[[:space:]]*start_[a-z]*()' \
    | grep -v '^[0-9]*:[[:space:]]*#' > "$mentions"
[ -s "$mentions" ] || die "no start_now/start_later/start_when launches found in $helpers"

while IFS= read -r entry; do
    lineno=${entry%%:*}
    line=${entry#*:}
    # grep -c counts matching LINES, not occurrences, so two calls sharing a
    # line would read as one -- use -o and count the output instead.
    count=$(printf '%s\n' "$line" \
        | grep -oE '(^|[^[:alnum:]_])start_(now|later|when)([^[:alnum:]_]|$)' | wc -l)
    anchored=no
    printf '%s' "$line" | grep -q '^[[:space:]]*start_\(now\|later\|when\)[[:space:]]' && anchored=yes

    if [ "$count" -ne 1 ]; then
        fail "line $lineno: $count start_now/start_later/start_when calls share one line -- put each on its own line so it can be checked"
    elif [ "$anchored" != yes ]; then
        fail "line $lineno: start_now/start_later/start_when does not begin its line, so nothing here can check it -- write it as a plain, unconditional call"
    fi
done < "$mentions"

# Every launch, however written. Two greps because the rules below need a quoted
# argument to reason about, and a launch written without one -- `start_later
# $cmd` -- would otherwise be invisible to all of them. Written to files so the
# loop runs in THIS shell: a `grep | while` pipeline counts failures in a
# subshell and always reports success.
#
# Plain lexical sort, not `-n`: comm needs both files in the SAME collating
# order it itself would produce, and past 9 launches "10" sorts before "2"
# lexically but after it numerically -- `sort -n` then feeding `comm` silently
# garbled or dropped diagnostics once the real file passed that line count.
grep -n '^[[:space:]]*start_\(now\|later\|when\)[[:space:]]' "$hfile" \
    | grep -v '^[0-9]*:[[:space:]]*start_[a-z]*()' | sort -t: -k1,1 > "$all"
grep -n '^[[:space:]]*start_\(now\|later\)[[:space:]]*"' "$hfile" > "$launches"
grep -n '^[[:space:]]*start_when[[:space:]][^[:space:]]*[[:space:]]*"' "$hfile" >> "$launches"
sort -t: -k1,1 "$launches" -o "$launches"

if [ "$(wc -l < "$all")" -ne "$(wc -l < "$launches")" ]; then
    comm -13 "$launches" "$all" | while IFS= read -r entry; do
        printf 'FAIL line %s: launch argument is not a quoted string, so nothing here can check it\n' \
            "${entry%%:*}" >&2
    done
    rc=1
fi

while IFS= read -r entry; do
    lineno=${entry%%:*}
    line=${entry#*:}
    # The leading TOKEN, not a substring: a command containing the string
    # "start_later" must not be diagnosed as one.
    form=$(printf '%s' "$line" | sed -n 's/^[[:space:]]*\(start_[a-z]*\).*/\1/p')

    inside=no
    [ "$lineno" -gt "$open_line" ] && [ "$lineno" -lt "$close_line" ] && inside=yes

    case "$form" in
    start_later)
        # Against the BARRIER line, not the block's opening brace: a start_later
        # at the top of the block is inside it and still races the pave.
        if [ "$inside" = no ] || [ "$lineno" -lt "$barrier_line" ]; then
            fail "line $lineno: start_later is not below the $barrier call inside the block (lines $open_line-$close_line, barrier on $barrier_line), so it does not wait"
        fi
        continue
        ;;
    start_when)
        [ "$inside" = no ] || fail \
            "line $lineno: start_when is inside the block, which already waits on $barrier -- it carries its own wait and belongs outside"
        # `start_when <command> "<cmd>"`: two arguments, the command either
        # bare or quoted -- `start_when "nowayprompt" "$bin/x"` is as valid a
        # spelling as the unquoted form and must not be rejected either way.
        printf '%s' "$line" | grep -q '^[[:space:]]*start_when[[:space:]]\("[^"]\{1,\}"\|[^[:space:]"]\{1,\}\)[[:space:]]\{1,\}"' \
            || fail "line $lineno: start_when names no command to wait for"
        continue
        ;;
    esac

    # start_now from here down.
    if [ "$inside" = yes ]; then
        fail "line $lineno: start_now is inside the block that waits on $barrier, so it is not immediate -- use start_later"
        continue
    fi

    case "$line" in
    *'#'*needs:*) ;;
    *)
        fail "line $lineno: start_now with no \`# needs:\` declaration -- name what must already be installed, or use start_later"
        continue
        ;;
    esac

    needs=${line#*needs:}
    if [ -z "$(printf '%s' "$needs" | tr -d '[:space:]')" ]; then
        fail "line $lineno: empty \`# needs:\` declaration"
        continue
    fi
    # -F, not a plain -x: a package name is a literal. `libfoo.bar` matched
    # `libfoo-bar` as a regex, so a typo could certify itself.
    for pkg in $needs; do
        grep -qxF -- "$pkg" "$mfile" || fail \
            "line $lineno: start_now needs '$pkg', absent from tests/base-manifest.txt -- CORE installs no packages, so it is not there at the first login; use start_later"
    done
done < "$launches"

exit "$rc"
