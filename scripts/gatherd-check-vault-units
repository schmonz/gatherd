#!/bin/sh
# Fail if a unit's --needs-vault flag disagrees with its playbook.
#
# gatherd-await-and-run takes --needs-vault, and exactly the units whose playbook
# declares `vars_files: vault/vault.yml` may pass it. The flag exists because the
# wait used to be unconditional, which made the REST tier hostage to a password
# site-async.yml never reads -- and REST installs nowayprompt, which the
# in-session vault prompt needs to render, so on a fresh machine the password
# could not even be asked for.
#
# Both directions are failures. A playbook that gained vault vars whose unit
# forgot the flag dies at parse time ("Attempting to decrypt but no vault secrets
# found") -- loud, but only at runtime, on the machine, during a pave. A unit
# that passes the flag for a playbook with no vault vars silently restores the
# deadlock.
#
# DECLARED, not present: this reads the repo, never the machine it runs on.
#
# Exit 0 clean, 1 violation, 2 could not run. Never a silent skip.
#
# Usage: gatherd-check-vault-units [repo-root]
set -u

repo="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
units="$repo/services/system"

die() { printf 'gatherd-check-vault-units: %s\n' "$1" >&2; exit 2; }

[ -d "$units" ] || die "cannot read $units"

rc=0
fail() { printf 'FAIL %s\n' "$1" >&2; rc=1; }

# A vars_files entry can be quoted or not, block or flow (single- or
# multi-line) style, and can carry a trailing comment -- all ordinary YAML.
# And a list item elsewhere that happens to equal "vault/vault.yml" is not a
# vars_files entry just because its value matches. Matching entries requires
# tracking which key's block or flow list a line is actually inside, which
# means tracking indentation -- past what a single regex can express, so this
# is a small awk state machine rather than a longer sed pipeline.
#
# It walks the file once, entering "block" mode at a bare "vars_files:" key
# (recording its indent) and printing each subsequent more-indented "- foo"
# line as a candidate until a line at or above that indent ends the block
# (any key at the same or a shallower level, including a comment-only line's
# next real neighbor -- comments never end or populate the block, since they
# are stripped to nothing before the block-membership check runs). It enters
# "flow" mode at "vars_files: [" with no closing "]" on that line, and
# accumulates lines into one buffer, splitting on "," once the "]" appears --
# which also covers the single-line form, closed on the same line it opens.
#
# Candidates come out with their quoting (if any) still on, same as a raw
# block-style line always did; the pipeline below strips it before comparing.
playbook_declares_vault() {
    _file=$1
    awk '
        function strip_comment(s) { sub(/#.*/, "", s); return s }
        function indent_of(s,   t) { t = s; sub(/[^ \t].*/, "", t); return length(t) }
        # \r joins \t and space here because splitting a CRLF file on \n
        # leaves \r as the last character of every line, and an untrimmed \r
        # broke the bare "vars_files:" == "" check that starts block mode.
        function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }

        {
            line = strip_comment($0)
            content = trim(line)

            if (mode == "flow") {
                buf = buf " " content
                if (index(content, "]") > 0) {
                    sub(/\].*/, "", buf)
                    n = split(buf, parts, ",")
                    for (i = 1; i <= n; i++) { v = trim(parts[i]); if (v != "") print v }
                    mode = "none"
                }
                next
            }

            if (mode == "block") {
                ind = indent_of(line)
                if (content == "") {
                    next
                } else if (ind > key_indent && content ~ /^-/) {
                    val = content
                    sub(/^-[ \t]*/, "", val)
                    if (val != "") print val
                    next
                } else {
                    mode = "none"
                    # fall through: this line may itself be the next key
                }
            }

            if (content ~ /^vars_files:/) {
                key_indent = indent_of(line)
                rest = content
                sub(/^vars_files:[ \t]*/, "", rest)
                if (rest == "") {
                    mode = "block"
                } else if (rest ~ /^\[/) {
                    buf = rest
                    sub(/^\[/, "", buf)
                    if (index(rest, "]") > 0) {
                        sub(/\].*/, "", buf)
                        n = split(buf, parts, ",")
                        for (i = 1; i <= n; i++) { v = trim(parts[i]); if (v != "") print v }
                    } else {
                        mode = "flow"
                    }
                }
            }
        }
    ' "$_file" \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
              -e 's/^"\(.*\)"$/\1/' -e "s/^'\\(.*\\)'\$/\\1/" \
        | grep -qFx 'vault/vault.yml'
}

checked=0
for unit in "$units"/*.service; do
    [ -f "$unit" ] || continue
    line=$(grep -m1 '^ExecStart=.*gatherd-await-and-run' "$unit") || continue
    checked=$((checked + 1))

    # The playbook is the last whitespace-separated word of the ExecStart line.
    playbook=${line##* }

    # A line-continued ExecStart (valid systemd syntax) leaves a bare "\" as
    # that last word. Reporting it as an unrecognized playbook path buries the
    # real problem, so name it.
    if [ "$playbook" = "\\" ]; then
        die "$(basename "$unit"): ExecStart continues onto another line -- this gate only reads that one line, so keep gatherd-await-and-run's arguments on it"
    fi

    # Units name absolute deployed paths; map that back onto this checkout.
    rel=${playbook#/usr/local/lib/gatherd/}
    [ -f "$repo/$rel" ] || die "$(basename "$unit") names $playbook, which is not in this repo"

    declares=no
    playbook_declares_vault "$repo/$rel" && declares=yes

    passes=no
    case "$line" in
    *--needs-vault*) passes=yes ;;
    esac

    if [ "$declares" = yes ] && [ "$passes" = no ]; then
        fail "$(basename "$unit"): $rel declares vars_files: vault/vault.yml but the unit does not pass --needs-vault -- the play will die at parse time with 'no vault secrets found'"
    fi
    if [ "$declares" = no ] && [ "$passes" = yes ]; then
        fail "$(basename "$unit"): passes --needs-vault for $rel, which declares no vault vars -- that blocks the play on a password it never reads"
    fi
done

[ "$checked" -gt 0 ] || die "no gatherd-await-and-run units found under $units"

exit "$rc"
