#!/bin/sh
# The only thing in tablet mode that knows which compositor is running.
#
# Everything else - gatherd-tablet-mode, gatherd-power-button,
# gatherd-hinge-daemon - asks for what it WANTS ("silence the built-in
# keyboard", "is the viewer's window up yet") and never says how. Porting this
# feature to a compositor other than sway means reimplementing this one file
# against the same verbs, rather than hunting swaymsg calls through four
# scripts and a Python daemon.
#
# That boundary is drawn at intent, not at syntax. The i8042 identifier
# heuristic, `type:` selectors, con_id iteration and sway's criteria brackets
# are all sway-shaped details and all live in here. A caller that had to know
# an app_id was matched with [app_id="..."] would not really be decoupled.
#
# Every verb is safe to call when the compositor is absent or unhappy: reads
# print nothing, writes do nothing, and neither is an error. Callers are in the
# middle of disabling somebody's keyboard and cannot afford to abort halfway.
#
# See docs/superpowers/specs/2026-08-16-tablet-mode-design.md.
set -eu

usage() {
    cat >&2 <<'USAGE'
usage: gatherd-compositor <verb> [args]

  internal-output                 print the built-in panel's connector name
  output-transform NAME           print NAME's current transform
  set-transform NAME TRANSFORM    rotate NAME
  valid-transform TRANSFORM       exit 0 if TRANSFORM is one the compositor takes

  silence-builtin-input           stop the built-in keyboard and touchpad
  restore-all-input               re-enable every keyboard and touchpad
  builtin-input-silenced          exit 0 if the built-in keyboards are all off
  builtin-input-disabled          exit 0 if ANY built-in keyboard is off

  inhibit-idle-all MODE           set inhibit_idle MODE on every view
  window-present APP_ID           exit 0 if a window with APP_ID exists
  set-fullscreen APP_ID STATE     fullscreen enable|disable that window
USAGE
    exit 2
}

# Built-in panels only. Matched by connector name because the resting transform
# is NOT necessarily "normal": where a panel is physically mounted rotated,
# wlroots applies the DRM panel-orientation quirk itself and upright landscape
# is transform 90.
internal_output() {
    swaymsg -t get_outputs 2>/dev/null \
        | jq -r 'first(.[] | select(.name | test("^(eDP|DSI|LVDS)")) | .name) // empty' \
            2>/dev/null || true
}

output_transform() {
    # `// empty` matters: without it a missing .transform prints the literal
    # string "null", which a caller would then have to recognise as unusable
    # rather than rotate to.
    swaymsg -t get_outputs 2>/dev/null \
        | jq -r --arg o "$1" 'first(.[] | select(.name == $o) | .transform) // empty' \
            2>/dev/null || true
}

# Which transform names the compositor will accept. Vocabulary, so it belongs
# here rather than in a caller: a port to a compositor that spells rotations
# differently changes this list and nothing else. Callers only ever ask "would
# this value be accepted", never "is this string one of these eight".
valid_transform() {
    case "$1" in
        normal | 90 | 180 | 270 | flipped | flipped-90 | flipped-180 | flipped-270)
            return 0 ;;
        *)  return 1 ;;
    esac
}

set_transform() {
    swaymsg output "$1" transform "$2" >/dev/null 2>&1 || true
}

# The i8042 controller enumerates as 1:1:*. An external or Bluetooth keyboard
# has a real vendor:product id and must keep working while folded - a
# page-turner pedal presents as exactly that, and silencing it would defeat the
# point of using this at a piano.
builtin_keyboards() {
    swaymsg -t get_inputs 2>/dev/null \
        | jq -r '.[] | select(.type == "keyboard")
                     | select(.identifier | startswith("1:1:"))
                     | .identifier' 2>/dev/null \
        | sort -u || true
}

silence_builtin_input() {
    for _id in $(builtin_keyboards); do
        swaymsg input "$_id" events disabled >/dev/null 2>&1 || true
    done
    # The identifier heuristic does not transfer to touchpads: the built-in one
    # is indistinguishable from an external by identifier, and there is no
    # "internal device" flag. The constraint that needs the heuristic is
    # keyboard-specific and is protected by the pedal case above.
    swaymsg input type:touchpad events disabled >/dev/null 2>&1 || true
}

# Deliberately NOT the identifier heuristic. That exists to keep an external
# keyboard alive while folded, a constraint that only applies to DISABLING.
# Re-enabling by type is strictly safer: `enabled` is the default state, so
# sweeping every keyboard and touchpad costs nothing, while the heuristic could
# return an empty list and silently give the human nothing back.
restore_all_input() {
    swaymsg input type:keyboard events enabled >/dev/null 2>&1 || true
    swaymsg input type:touchpad events enabled >/dev/null 2>&1 || true
}

# `length > 0` is the half that matters: "all of an empty list are disabled" is
# vacuously true, which is exactly the answer that hides a failed silencing.
builtin_input_silenced() {
    swaymsg -t get_inputs 2>/dev/null \
        | jq -e '[.[] | select(.type == "keyboard")
                      | select(.identifier | startswith("1:1:"))
                      | .libinput.send_events // empty]
                 | length > 0 and all(. == "disabled")' >/dev/null 2>&1
}

# Positive evidence only: a device reporting no send_events at all means
# "unknown", not "disabled". Treating unknown as disabled would make an
# ordinary unfolded laptop look like a trapped one.
builtin_input_disabled() {
    swaymsg -t get_inputs 2>/dev/null \
        | jq -e '[.[] | select(.type == "keyboard")
                      | select(.identifier | startswith("1:1:"))
                      | .libinput.send_events // empty] | any(. != "enabled")' \
            >/dev/null 2>&1
}

# Every application window in the tree. Outputs and workspaces are containers
# with no app_id and must never be targeted.
view_ids() {
    swaymsg -t get_tree 2>/dev/null \
        | jq -r '.. | objects | select(.app_id != null) | .id' 2>/dev/null || true
}

inhibit_idle_all() {
    for _id in $(view_ids); do
        swaymsg "[con_id=$_id]" inhibit_idle "$1" >/dev/null 2>&1 || true
    done
}

window_present() {
    swaymsg -t get_tree 2>/dev/null \
        | jq -e --arg id "$1" \
            'first(.. | objects | select(.app_id? == $id)) != null' >/dev/null 2>&1
}

set_fullscreen() {
    swaymsg "[app_id=\"$1\"] fullscreen $2" >/dev/null 2>&1 || true
}

[ "$#" -ge 1 ] || usage
_verb="$1"
shift

case "$_verb" in
    internal-output)        internal_output ;;
    output-transform)       [ "$#" -eq 1 ] || usage; output_transform "$1" ;;
    set-transform)          [ "$#" -eq 2 ] || usage; set_transform "$1" "$2" ;;
    valid-transform)        [ "$#" -eq 1 ] || usage; valid_transform "$1" ;;
    silence-builtin-input)  silence_builtin_input ;;
    restore-all-input)      restore_all_input ;;
    builtin-input-silenced) builtin_input_silenced ;;
    builtin-input-disabled) builtin_input_disabled ;;
    inhibit-idle-all)       [ "$#" -eq 1 ] || usage; inhibit_idle_all "$1" ;;
    window-present)         [ "$#" -eq 1 ] || usage; window_present "$1" ;;
    set-fullscreen)         [ "$#" -eq 2 ] || usage; set_fullscreen "$1" "$2" ;;
    *)                      usage ;;
esac
