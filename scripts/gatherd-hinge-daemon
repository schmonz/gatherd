#!/usr/bin/env python3
# Fold-to-tablet-mode trigger: read the lid and base accelerometers, compute
# the signed hinge angle, and call gatherd-tablet-mode across a hysteresis
# band. gatherd-tablet-mode remains the only thing that touches sway state;
# this is one more caller of it, alongside the keybinding and the power
# button. See docs/superpowers/specs/2026-08-16-tablet-mode-design.md.
#
# Usage: gatherd-hinge-daemon           run the daemon loop (this acts)
#        gatherd-hinge-daemon --print   print the current theta and the
#                                       decision the daemon would take, and
#                                       do nothing else - never acts, safe
#                                       to run repeatedly against a live
#                                       session.
#
# Geometry (measured on the real hardware, hinge axis is y): project both
# gravity vectors onto the x-z plane and take the *signed* rotation between
# them - theta IS the hinge angle (within a small fixed offset), atan2-
# wrapped to +-180. The unsigned angle between the vectors is ~86 degrees at
# both a normal typing angle and folded flat past the tablet position - it
# cannot tell those apart, which is why the signed angle is needed at all.
#
# theta does NOT distinguish a shut lid from a folded-back tablet: atan2
# wraps at +-180, not at zero, so hinge 0 (shut) and hinge 360 (folded all
# the way back) both read theta ~= 0. The lid switch, gated on separately
# below, is what tells those two apart - without it, closing the lid would
# read exactly like folding into tablet mode and would trigger it.
#
# Do NOT filter samples by magnitude. These sensors carry a large zero-offset
# (~1.2g at rest) and the machine is sometimes used on a train, where the
# magnitude is not 1g at all. A median over many samples is the noise
# defense, not a magnitude gate.
#
# Auto-rotation (phase 3): the lid sensor is already being read at 10Hz for
# the fold trigger above, so following the display to how the tablet is
# actually held in the hand costs zero extra I2C - I2C is the entire cost
# here (~470us per axis transaction). A second process reading the sensor
# and issuing its own `swaymsg output ... transform` would fight this one,
# which is exactly the twitching an earlier version of this daemon produced;
# rotation is folded into the same loop instead.
#
# Calibration (measured on the real hardware, do NOT re-derive without new
# measurements): the screen plane is spanned by x and y (z is the screen
# normal, used only by the flat-pose guard below, never for the angle
# itself - it is ~10x noisier than x or y on this sensor). Gravity's
# in-plane angle gives the rotation:
#
#     rotation = (REFERENCE_ANGLE - degrees(atan2(y, x))) mod 360
#
# REFERENCE_ANGLE is BY DEFINITION the atan2 reading in the portrait
# score-reading pose, because that pose is the one that must come out as
# transform `normal` (rotation 0) - it is what gatherd-tablet-mode sets on
# entry, and what the human actually reads music at.
#
# Four captures, turning counterclockwise. Every one of them was taken with
# the machine in its LANDSCAPE (open-laptop) orientation, NOT in the portrait
# reading pose - that mislabelling is what made an earlier REFERENCE_ANGLE of
# 177.0 put every quadrant 90 degrees out. Landscape sits 90 degrees from
# portrait, so REFERENCE_ANGLE = 177.0 + 90 = 267.0, and the same raw
# captures then read out as the landscape poses they always were:
#
#   capture                    atan2(y,x)   rotation   transform
#   landscape (as a laptop)    177.0        90         90
#   (a 180 turn)               2.8          264.2      270
#   (a 270 turn)               -94.1        1.1        normal
#   back to start              179.3        87.7       90
#
# Confirming the relabelling: an open laptop rests at transform 90, which is
# exactly what row 1 now yields. Independently measured afterwards, the
# resting lid reads atan2 ~= 180 (proj ratio 0.78 at a typing angle, 0.98
# with the lid vertical) - the same landscape pose as row 1, 90 degrees off
# portrait, as the geometry requires.
#
# Only THREE poses were actually captured - the sweep went straight from the
# first position to the 180 turn, so the fourth quadrant is INFERRED from the
# linear fit (the other three land within ~1 degree of it), not measured.
# Transform is the nearest quadrant, and the mapping from rotation to
# transform is the IDENTITY (rotation 90 -> transform 90): `man 5 sway-output`
# states "The rotation is performed clockwise", so a device turned 90 degrees
# counterclockwise needs a 90-degree clockwise transform to compensate -
# checked in the man page, not recalled.
#
# The flat-pose guard mirrors the hinge's own degenerate-pose guard in
# shape, not in axes: hinge degeneracy is the hinge axis (y) parallel to
# gravity (portrait score-reading - x,z vanish); rotation degeneracy is the
# screen normal (z) parallel to gravity (screen lying flat - x,y vanish).
# They are independent conditions and neither gates the other.

import json
import math
import os
import re
import statistics
import subprocess
import sys
import time
from collections import deque

DEFAULT_LID_DEVICE = "/sys/bus/iio/devices/iio:device0"
DEFAULT_BASE_DEVICE = "/sys/bus/iio/devices/iio:device1"
DEFAULT_LID_STATE_PATH = "/proc/acpi/button/lid/LID0/state"
TABLET_MODE_CMD = "gatherd-tablet-mode"

# Below this fraction of a sensor's own magnitude, the x-z projection is
# noise rather than signal: it means the hinge axis (y) is pointing along
# gravity, which is exactly the pose of reading a portrait score. Any
# threshold comfortably above zero and below the ~1.0 ratio a normal, non-
# vertical pose produces works; this is not a tuned constant.
MIN_PROJECTION_RATIO = 0.3

# Fallback when tablet-mode.conf carries no rotation_reference_deg - matches
# the measured value above, but re-calibrating on other hardware must be a
# config edit (roles/desktop/templates/tablet-mode.conf.j2, driven from
# group_vars/all/main.yml), never a code change.
DEFAULT_ROTATION_REFERENCE_DEG = 267.0

# Below this fraction of the lid sensor's own magnitude, x and y (the screen
# plane) carry no signal - gravity is along the screen normal (z) instead,
# the pose of the tablet lying flat. Same shape of guard as
# MIN_PROJECTION_RATIO above, different axes; see the module header.
MIN_ROTATION_PROJECTION_RATIO = 0.3

# How far past a quadrant's 45-degree boundary a reading must sit before it
# is even considered a challenger - held near a boundary, distance oscillates
# either side of 45 but rarely gets far past it. Combined with
# ROTATION_PERSIST_SAMPLES below (a *different* held-near-boundary reading
# would clear the margin but not repeat), so the hinge held exactly on a
# boundary satisfies neither alone. Not tuned against measured boundary-
# region data - no such data was captured, only the four interior points in
# the module header - so treat this as a reasonable starting margin, not a
# calibrated one.
ROTATION_HYSTERESIS_MARGIN_DEG = 10

# Consecutive same-candidate samples required before the committed transform
# actually changes - see ROTATION_HYSTERESIS_MARGIN_DEG above.
ROTATION_PERSIST_SAMPLES = 3

TRANSFORM_BY_QUADRANT = {0: "normal", 90: "90", 180: "180", 270: "270"}

# Duplicates gatherd-tablet-mode's own internal_output() connector-name
# heuristic (there written in POSIX sh, needed again here in Python) - keep
# the two in sync if the hardware match ever changes.
INTERNAL_OUTPUT_RE = re.compile(r"^(eDP|DSI|LVDS)")


def lid_device():
    return os.environ.get("GATHERD_HINGE_LID_DEVICE", DEFAULT_LID_DEVICE)


def base_device():
    return os.environ.get("GATHERD_HINGE_BASE_DEVICE", DEFAULT_BASE_DEVICE)


def lid_state_path():
    return os.environ.get("GATHERD_HINGE_LID_STATE", DEFAULT_LID_STATE_PATH)


def config_path():
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.environ.get("HOME", ""), ".config"
    )
    return os.path.join(config_home, "gatherd", "tablet-mode.conf")


def config_value(key):
    # Same file gatherd-tablet-mode and gatherd-music-stand source as shell
    # (key=value lines); read here with a plain parser instead of sourcing it,
    # since a stray shell metacharacter must not do anything but be ignored.
    # Any read/parse failure (missing file, bad permissions, garbage line)
    # falls through to None rather than raising - this daemon must never crash
    # the session over a config typo.
    try:
        with open(config_path()) as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                name, _, value = line.partition("=")
                if name.strip() == key:
                    return value.strip()
    except OSError:
        return None
    return None


def threshold(env_name, config_key, default):
    # Env var overrides the config file, which overrides the built-in default
    # - existing GATHERD_HINGE_ENTER/EXIT overrides (relied on by tests) keep
    # working even once the config file also carries these keys.
    raw = os.environ.get(env_name)
    if raw is None:
        raw = config_value(config_key)
    try:
        return float(raw) if raw is not None else float(default)
    except (TypeError, ValueError):
        return float(default)


def fold_enter_deg():
    return threshold("GATHERD_HINGE_ENTER", "fold_enter_deg", 30)


def fold_exit_deg():
    return threshold("GATHERD_HINGE_EXIT", "fold_exit_deg", 50)


def rotation_reference_deg():
    return threshold(
        "GATHERD_HINGE_ROTATION_REFERENCE",
        "rotation_reference_deg",
        DEFAULT_ROTATION_REFERENCE_DEG,
    )


def poll_interval():
    # 0.1s: measured at rest (see fold_enter_deg/fold_exit_deg's comment for
    # the shared fixture), theta's stdev is 2.95 degrees. A rolling median of
    # 5 (window_size below) over this poll leaves ~0.5s reaction latency - a
    # 10x improvement over the previous 5s (window 10 at 0.5s) - while still
    # holding 4x headroom against fold_enter_deg's 30-degree band (residual
    # spread 6.8 degrees at window 5, vs 4.5 at the old window 10).
    return threshold("GATHERD_HINGE_POLL_INTERVAL", "poll_interval", 0.1)


def window_size():
    # 5: residual spread after this median is 6.8 degrees (measured), leaving
    # ~23 degrees of margin against fold_enter_deg's 30-degree band - see
    # poll_interval's comment for the full measurement and the latency this
    # buys. A false ENTER from a resting typing angle (theta~=108) would
    # still need a ~78-degree excursion, about 26 standard deviations of the
    # measured noise, and the lid-switch gate blocks entry outright whenever
    # the lid reads closed - so a shorter window is not spending margin the
    # daemon actually needs at rest. What it does spend is protection against
    # transients while the hinge is genuinely in motion (a captured fold
    # showed intermediate readings before settling); that is judged
    # acceptable because entering tablet mode slightly early during a
    # deliberate fold is harmless - it's what the human is doing anyway.
    return max(1, int(threshold("GATHERD_HINGE_WINDOW", "median_window", 5)))


def state_dir():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "gatherd")


def suppress_marker():
    # Written by `gatherd-tablet-mode off`; cleared here once the hinge has
    # genuinely left the folded band. See that script for why it exists.
    return os.path.join(state_dir(), "tablet-mode-suppressed")


def entry_suppressed():
    return os.path.exists(suppress_marker())


def clear_suppression():
    try:
        os.remove(suppress_marker())
    except OSError:
        pass


def log_path():
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.environ.get("HOME", ""), ".local", "state"
    )
    return os.path.join(state_home, "gatherd", "hinge-daemon.log")


def log_action(action, median_abs_theta):
    # This daemon disables the human's built-in keyboard and rotates their
    # display without being asked, and used to leave no trace of having done
    # either - which made a real lockout impossible to diagnose afterwards.
    # Never fatal: a log that cannot be written must not stop the action, and
    # least of all the exit that gives the keyboard back.
    try:
        path = log_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        theta = "degenerate" if median_abs_theta is None else f"{median_abs_theta:.1f}"
        with open(path, "a") as handle:
            handle.write(
                "%s %s theta=%s lid=%s\n"
                % (
                    time.strftime("%Y-%m-%dT%H:%M:%S"),
                    action,
                    theta,
                    "open" if lid_is_open() else "closed",
                )
            )
    except OSError:
        pass


def read_vector(device_dir):
    def axis(name):
        path = os.path.join(device_dir, f"in_accel_{name}_raw")
        with open(path) as handle:
            return float(handle.read().strip())

    return axis("x"), axis("y"), axis("z")


def magnitude(vector):
    return math.sqrt(sum(component * component for component in vector))


def is_degenerate(vector):
    x, _y, z = vector
    mag = magnitude(vector)
    if mag == 0:
        return True
    projection = math.sqrt(x * x + z * z)
    return (projection / mag) < MIN_PROJECTION_RATIO


def hinge_theta(lid, base):
    # theta = atan2(a0.x*a1.z - a0.z*a1.x, a0.x*a1.x + a0.z*a1.z) IS the hinge
    # angle (to within a small fixed sensor-mounting offset) - there is no
    # further "180 - theta" transform. It is signed and atan2-wrapped to
    # +-180: typing reads ~108, flat reads ~178, and folding on past flat
    # wraps the sign, so a fully folded tablet reads ~-2, not ~182 - the same
    # neighborhood a shut lid reads. See the module header for why the lid
    # switch, not the angle, is what disambiguates those two.
    x0, _y0, z0 = lid
    x1, _y1, z1 = base
    return math.degrees(math.atan2(x0 * z1 - z0 * x1, x0 * x1 + z0 * z1))


def is_flat(vector):
    x, y, _z = vector
    mag = magnitude(vector)
    if mag == 0:
        return True
    projection = math.sqrt(x * x + y * y)
    return (projection / mag) < MIN_ROTATION_PROJECTION_RATIO


def rotation_deg(x, y):
    # See the module header for the calibration this formula is measured
    # from, and for the honesty note that the 90-degree quadrant is inferred
    # rather than one of the captured points.
    return (rotation_reference_deg() - math.degrees(math.atan2(y, x))) % 360


def nearest_quadrant(deg):
    return int(round(deg / 90)) % 4 * 90


def distance_from_quadrant(deg, quadrant):
    # Shortest signed distance from deg to quadrant's center, folded to
    # [0, 180] - i.e. how far deg has wandered from that quadrant, in either
    # direction, ignoring which side.
    return abs(((deg - quadrant + 180) % 360) - 180)


class RotationTracker:
    """Smooths rotation samples with the same median-over-window defense the
    fold trigger uses, then requires a challenger quadrant to both clear a
    margin past the 45-degree boundary AND persist across several samples
    before the committed transform changes - either guard alone still flaps
    for a hinge held near a boundary long enough that a momentary read lands
    on the far side of it; both together do not."""

    def __init__(self):
        self.window = deque(maxlen=window_size())
        self.committed_quadrant = None
        self.challenger_quadrant = None
        self.challenger_count = 0
        # Tracks what was last actually applied via swaymsg, distinct from
        # committed_quadrant - see act_rotation(), which is what reads this.
        self.last_applied = None

    def update(self, vector):
        x, y, _z = vector
        if is_flat(vector):
            return  # "down" is undefined in this pose - hold, decide nothing
        median = self._smoothed(rotation_deg(x, y))
        if self.committed_quadrant is None:
            # No baseline yet: commit immediately rather than making the
            # first-ever reading wait out the persistence guard below, which
            # exists to resist flapping AWAY from an established quadrant,
            # not to delay establishing one.
            self.committed_quadrant = nearest_quadrant(median)
            self._clear_challenger()
            return
        if distance_from_quadrant(median, self.committed_quadrant) <= (
            45 + ROTATION_HYSTERESIS_MARGIN_DEG
        ):
            self._clear_challenger()
            return
        candidate = nearest_quadrant(median)
        if candidate == self.challenger_quadrant:
            self.challenger_count += 1
        else:
            self.challenger_quadrant = candidate
            self.challenger_count = 1
        if self.challenger_count >= ROTATION_PERSIST_SAMPLES:
            self.committed_quadrant = candidate
            self._clear_challenger()

    def _clear_challenger(self):
        self.challenger_quadrant = None
        self.challenger_count = 0

    def _smoothed(self, raw_deg):
        # Unwrap against the previous sample before pushing into the window:
        # the 0/360 seam sits at the CENTER of the "normal" quadrant, not at
        # a boundary, so a genuine crossing of it (e.g. 358 -> 2) must not
        # corrupt a naive mod-360 median the way it would (that median would
        # land near 180, the opposite side of the circle from every sample).
        if self.window:
            last = self.window[-1]
            delta = ((raw_deg - (last % 360)) + 180) % 360 - 180
            unwrapped = last + delta
        else:
            unwrapped = raw_deg
        self.window.append(unwrapped)
        return statistics.median(self.window) % 360

    def transform(self):
        if self.committed_quadrant is None:
            return None
        return TRANSFORM_BY_QUADRANT[self.committed_quadrant]

    def reset(self):
        self.window.clear()
        self.committed_quadrant = None
        self._clear_challenger()
        self.last_applied = None


def internal_output_name():
    # Read-only swaymsg call - safe from decide_once()/print_once(), which
    # never call this; only act_rotation() (poll_once()'s acting path) does.
    result = subprocess.run(
        ["swaymsg", "-t", "get_outputs"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    try:
        outputs = json.loads(result.stdout)
    except ValueError:
        return None
    for output in outputs:
        name = output.get("name", "")
        if INTERNAL_OUTPUT_RE.match(name):
            return name
    return None


def rotate_output(transform):
    # The ONLY swaymsg call rotation is allowed to make - never
    # gatherd-tablet-mode, never its state file. That is the entire reason
    # `gatherd-tablet-mode off` can always restore the ORIGINAL resting
    # transform regardless of anything rotation did while folded: it never
    # sees rotation happen at all.
    name = internal_output_name()
    if name is None:
        return
    subprocess.run(
        ["swaymsg", "output", name, "transform", transform],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def act_rotation(tracker, active):
    if not active:
        # Drop last_applied (not just skip) rather than leave it stale: the
        # next activation must always issue at least one swaymsg call, even
        # if the tracker's committed quadrant happens to match what
        # gatherd-tablet-mode's `on` just set the display to.
        tracker.last_applied = None
        return
    transform = tracker.transform()
    if transform is None or transform == tracker.last_applied:
        return
    rotate_output(transform)
    tracker.last_applied = transform


def lid_is_open():
    # An unreadable lid file (missing node, permissions, EC hiccup) must
    # resolve to "not open" - refusing to fold is always the safe default,
    # since folding means disabling the keyboard out from under the human.
    try:
        with open(lid_state_path()) as handle:
            contents = handle.read()
    except OSError:
        return False
    return "open" in contents


def tablet_mode_active():
    return (
        subprocess.run(
            [TABLET_MODE_CMD, "status"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode
        == 0
    )


def activate():
    subprocess.run([TABLET_MODE_CMD, "on"], check=True)


def deactivate():
    subprocess.run([TABLET_MODE_CMD, "off"], check=True)


def decide(median_abs_theta, lid_open, active, suppressed):
    # An explicit exit outranks the fold. While the human is still folded,
    # `gatherd-tablet-mode off` and the fold trigger disagree, and re-entering
    # would make every escape from the power-button menu a no-op - the mode
    # would flicker off and back on within one poll. The human wins until the
    # hinge itself says otherwise, which is what clearing the marker on an
    # above-fold_exit reading below means.
    if not active and suppressed:
        return "hold"

    # Hysteresis: never act between the two thresholds.
    #
    # Unfolding exits, ALWAYS - no matter what turned tablet mode on. There
    # used to be an ownership rule here (exit only a session this daemon
    # itself entered), to protect the workflow of triggering tablet mode from
    # the keyboard and then folding, which passes through a typing angle far
    # above fold_exit. Those keybindings are gone: folding is now the only way
    # in, so that workflow no longer exists and the guard protected nothing -
    # while its failure mode was severe. It made unfolding a no-op for any
    # session the daemon had not started, leaving the power button as the sole
    # escape from a machine whose keyboard is disabled. A physical, obvious,
    # always-available way out beats a clever one.
    #
    # The lid gate applies only to entering. Closing the lid reads the same
    # near-zero theta as folding does, so without `lid_open` a closing lid
    # would be indistinguishable from a fold and would wrongly disable the
    # keyboard. Exiting needs no such gate: unfolding drives theta away from
    # zero regardless of the lid switch.
    if not active and median_abs_theta < fold_enter_deg() and lid_open:
        return "enter"
    if active and median_abs_theta > fold_exit_deg():
        return "exit"
    return "hold"


def act(action, median_abs_theta=None):
    if action == "enter":
        log_action("enter", median_abs_theta)
        activate()
    elif action == "exit":
        log_action("exit", median_abs_theta)
        deactivate()


def sample(history, rotation_tracker):
    """Read both sensors once and fold a valid reading into history. Returns
    True if the hinge sample was degenerate (and therefore skipped: appending
    it would let a single blind reading corrupt the whole rolling median).

    The SAME lid reading also feeds rotation_tracker, unconditionally - even
    when the hinge sample is degenerate. The two degenerate conditions are
    independent (see the module header): a portrait score-reading pose is
    exactly where hinge detection goes blind, and exactly where rotation
    matters most, so hinge degeneracy must not also silence rotation.
    rotation_tracker.update() is pure computation, no I/O - it does not
    disturb the "degenerate pose never calls gatherd-tablet-mode at all"
    property below."""
    lid = read_vector(lid_device())
    base = read_vector(base_device())
    rotation_tracker.update(lid)
    if is_degenerate(lid) or is_degenerate(base):
        return True
    history.append(abs(hinge_theta(lid, base)))
    return False


def decide_once(history, rotation_tracker):
    """One read-decide cycle, with NO act: read-decide-act split into its
    read-decide half so --print can report a decision without taking it.
    Returns (median_abs_theta, action); median_abs_theta is None when this
    sample was degenerate and no decision was made at all - the daemon holds
    whatever state it was already in."""
    if sample(history, rotation_tracker):
        return None, "hold"
    median_abs_theta = statistics.median(history)
    action = decide(
        median_abs_theta, lid_is_open(), tablet_mode_active(), entry_suppressed()
    )
    return median_abs_theta, action


def poll_once(history, rotation_tracker):
    """One read-decide-act cycle. Only the main loop may call this - it is
    the sole path that is allowed to act. See decide_once for the read-only
    half that --print uses instead."""
    median_abs_theta, action = decide_once(history, rotation_tracker)
    # Only the acting path may clear it - decide_once() stays read-only so
    # --print cannot change what the daemon will do next.
    if median_abs_theta is not None and median_abs_theta > fold_exit_deg():
        clear_suppression()
    act(action, median_abs_theta)
    act_rotation(rotation_tracker, tablet_mode_active())
    return median_abs_theta, action


def print_once():
    """--print: report the theta and the decision the daemon would take,
    WITHOUT taking it. Read-only diagnostic - safe to run, including in a
    loop, against a live session. Must call decide_once, never poll_once:
    poll_once acts, and this ran against the live hardware once under the
    belief that --print was inert, rotating the display and disabling the
    keyboard on every invocation. Output format is unchanged by rotation -
    decide_once() updates the rotation tracker but act_rotation() (the only
    thing that touches swaymsg for rotation) is never called here."""
    history = deque(maxlen=window_size())
    rotation_tracker = RotationTracker()
    median_abs_theta, action = decide_once(history, rotation_tracker)
    if median_abs_theta is None:
        print("theta=degenerate action=hold")
    else:
        print(f"theta={median_abs_theta:.1f} action={action}")


def loop():
    history = deque(maxlen=window_size())
    rotation_tracker = RotationTracker()
    while True:
        poll_once(history, rotation_tracker)
        time.sleep(poll_interval())


def main(argv):
    # --print is read-only (see print_once's docstring) - it never calls
    # gatherd-tablet-mode. Only the no-argument main loop acts.
    if "--print" in argv[1:]:
        print_once()
        return 0
    loop()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
