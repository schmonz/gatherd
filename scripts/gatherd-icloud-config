#!/bin/sh
# The 1Password half of gatherd's iCloud sync: moves the encrypted rclone.conf
# between this machine and the fleet copy. Knows nothing about folders or bisync.
#
# The distributed artifact is already encrypted, so no machine ever has to drive
# `rclone config encryption set` non-interactively — encryption happens once, in
# `bootstrap`, and every other machine only decrypts. rclone preserves existing
# encryption when it rewrites the file after a token refresh, so refreshed
# configs stay distributable.
#
# Usage: gatherd-icloud-config {bootstrap|pull|push|reconnect|status}

set -eu

die()  { printf 'gatherd-icloud-config: %s\n' "$1" >&2; exit 1; }
warn() { printf 'gatherd-icloud-config: warning: %s\n' "$1" >&2; }

# gatherd-icloud-sync sources this same manifest for ICLOUD_REMOTE. Without
# this, changing icloud_remote in group_vars would move sync onto the new
# remote while this script kept probing the old name, and config_works would
# fail everywhere for a reason ("wrong remote") that looks identical to a
# broken config.
GATHERD_ICLOUD_CONF="${GATHERD_ICLOUD_CONF:-$HOME/.config/gatherd/icloud.conf}"
if [ -r "$GATHERD_ICLOUD_CONF" ]; then
    # shellcheck disable=SC1090
    . "$GATHERD_ICLOUD_CONF"
fi

STATE="${GATHERD_ICLOUD_STATE:-$HOME/.local/state/gatherd}"
CONFIG="${RCLONE_CONFIG:-$HOME/.config/rclone/rclone.conf}"
REMOTE="${GATHERD_ICLOUD_REMOTE:-${ICLOUD_REMOTE:-icloud}}"

: "${GATHERD_OP_VAULT:=Private}"
: "${GATHERD_OP_DOCUMENT:=rclone.conf}"
: "${GATHERD_OP_PASSWORD_ITEM:=rclone config}"

# RCLONE_PASSWORD_COMMAND normally arrives ambiently via pam_env, so outside a
# PAM session (a systemd unit, `su -c`) it is absent and rclone would either
# prompt on stdin or error. Pinning it here also means every config_works
# probe below is provably checked against the fleet password, not whatever a
# human happened to unlock rclone with interactively earlier in the session.
# The absolute path matches what roles/system/tasks/user_path.yml delivers via
# pam_env for this same variable: rclone execs the command directly rather
# than through a shell, so a bare name only resolves where ~/.local/bin is
# already on PATH — which, outside a PAM session, it is not.
export RCLONE_PASSWORD_COMMAND="${RCLONE_PASSWORD_COMMAND:-$HOME/.local/bin/gatherd-icloud-password}"

FLEET_OK="$STATE/icloud-fleet-ok"
PLAINTEXT="$STATE/icloud-plaintext-config"
REAUTH="$STATE/icloud-needs-reauth"

mkdir -p "$STATE"

# Every caller has just watched $CONFIG reach iCloud, which is exactly the
# success gatherd-icloud-sync waits for before it clears $REAUTH. Waiting for
# sync instead left the notes asking for a reconnect the human had already
# done, because the notes regenerate at login ahead of the first sync.
mark_fleet_ok() {
    : > "$FLEET_OK"
    rm -f "$REAUTH"
}

# A decrypted config is a live iCloud token in plaintext, so scratch space must
# be tmpfs (per-user, gone at logout) — never disk, and never /tmp, which is
# shared across users and outlives logout. Fail loudly instead of silently
# downgrading to a location that only happens to be tmpfs on this host.
[ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] \
    || die "XDG_RUNTIME_DIR is unset or not a directory; refusing to put a decrypted config on persistent disk"
umask 077
TMP=$(mktemp -d "$XDG_RUNTIME_DIR/gatherd-icloud.XXXXXX")
chmod 700 "$TMP"
# After `reconnect` has taken a fresh 2FA, any later failure (op timing out
# while the human was busy with Apple's prompt is the likely one) leaves a
# working config that only needs publishing. Say so, or the notes' "reconnect"
# bullet sends them through 2FA again.
RECONNECTED=
trap '_rc=$?; rm -rf "$TMP"
      if [ "$_rc" -ne 0 ] && [ -n "$RECONNECTED" ]; then
          printf "gatherd-icloud-config: reconnected, but not published; run: gatherd-icloud-config push\n" >&2
      fi' EXIT
# A trap for a caught (non-EXIT) signal returns control to the interrupted
# point rather than ending the script, so without an explicit exit here the
# script would resume after cleanup with $TMP gone and every later write
# failing. One status (130) covers all three signals because nothing that
# calls this script distinguishes INT from TERM from HUP; it does not track
# the different conventional value per signal (130/143/129).
trap 'rm -rf "$TMP"; exit 130' INT TERM HUP

# A read op could not make is not a document that does not exist. Treating the
# two alike told a machine waiting on 1Password CLI access that the fleet had
# no config and to bootstrap one, and let push and bootstrap create a second
# document or password item beside the real one. Only op's own "isn't an item"
# counts as absent (measured with op 2.39.0); every other failure is quoted.
op_says_absent() { grep -q "isn't an item in the" "$TMP/op.err"; }
op_unreadable()  { die "cannot read op://$GATHERD_OP_VAULT/$1 from 1Password: $(sed -n '/./{p;q}' "$TMP/op.err")"; }

# Fills $TMP/fleet. Returns 0 when fetched, 1 when 1Password says there is no
# such document, 2 when it could not say; callers capture it with `|| _rc=$?`.
doc_fetch() {
    op document get "$GATHERD_OP_DOCUMENT" --vault "$GATHERD_OP_VAULT" \
        > "$TMP/fleet" 2> "$TMP/op.err" && return 0
    op_says_absent && return 1
    return 2
}
# Hand op the path, not the contents. The documented stdin form ("-" plus a
# redirect) reports "expected data on stdin but none found" when stdin is a
# redirected regular file rather than a pipe — op's own example pipes into it.
# --file-name pins the stored filename so it does not vary with $RCLONE_CONFIG.
# $2 is doc_fetch's answer, so the choice between edit and create rests on the
# read the caller already vetted rather than on a second one that could fail.
doc_put() {
    # op prints the new item's JSON on success; the caller says what happened in
    # its own words, so discard it rather than mixing machine output into a
    # human-facing command.
    if [ "$2" -eq 0 ]; then
        op document edit "$GATHERD_OP_DOCUMENT" "$1" \
            --vault "$GATHERD_OP_VAULT" --file-name "$GATHERD_OP_DOCUMENT" >/dev/null
    else
        op document create "$1" --title "$GATHERD_OP_DOCUMENT" \
            --vault "$GATHERD_OP_VAULT" --file-name "$GATHERD_OP_DOCUMENT" >/dev/null
    fi
}

# Reachability is the only definition of "this config works" that matters here.
# rclone's reason stays in $TMP/probe, overwritten by every call, for the one
# caller that has to tell a human why.
config_works() { RCLONE_CONFIG="$1" rclone lsd "$REMOTE:" >/dev/null 2>"$TMP/probe"; }

# A config that fails this is a live iCloud token sitting in plaintext.
# bootstrap and push both gate publishing on it so neither path can be the
# one that hands that token to every other machine's pull.
config_encrypted() { head -n1 "$1" 2>/dev/null | grep -q 'Encrypted rclone configuration'; }

# Trustworthy only when both sides actually decrypted: an empty file means
# `config show` itself failed (locked 1Password, unset password command), not
# "the config decrypted to nothing". Treating two failures as equal and
# in sync would report health while silently never uploading a fix.
plain_configs_match() {
    [ -s "$1" ] && [ -s "$2" ] && cmp -s "$1" "$2"
}

# Deliberately not gated on config_encrypted: that check exists to stop this
# machine from being the one that *publishes* plaintext, not to second-guess
# whatever the fleet document already contains. A fleet doc that somehow
# holds a plaintext config is a 1Password-vault problem to fix at the
# source — refusing to install it here would still leave a human with no
# rclone.conf to run `rclone config reconnect` against.
install_config() {
    mkdir -p "$(dirname "$CONFIG")"
    cp "$1" "$CONFIG"
    chmod 600 "$CONFIG"
}

# Called right after install_config puts a fleet copy on disk. $FLEET_OK is
# Task 7's signal that the fleet round-trip worked, so it must stay narrower
# than "a file now exists at $CONFIG": a copy that doesn't authenticate
# hasn't earned it (existing case), and neither has one that authenticates
# but is plaintext — pull installing that silently is how a machine ends up
# with a config that a later `pull` (via its push delegation) then refuses
# to touch, with no warning anywhere that this was coming. Returns 1 only for
# an encrypted copy that cannot reach iCloud, leaving rclone's reason in $TMP/probe.
note_fleet_install() {
    if ! config_encrypted "$CONFIG"; then
        # This warning goes to stderr, and gatherd-prompt-icloud (the login
        # path that reaches this) discards stderr — so without a sentinel a
        # live iCloud token can land in the clear on disk with nothing
        # surfaced anywhere. $PLAINTEXT gives gatherd-post-setup-notes
        # something to check instead of a log line nobody will read.
        : > "$PLAINTEXT"
        warn "installed config from the fleet is not encrypted; run: rclone config encryption set"
    elif config_works "$CONFIG"; then
        mark_fleet_ok
    else
        return 1
    fi
}

cmd_pull() {
    if [ ! -s "$CONFIG" ]; then
        _fleet=0; doc_fetch || _fleet=$?
        [ "$_fleet" -ne 1 ] || die "no fleet config yet; run: gatherd-icloud-config bootstrap"
        [ "$_fleet" -ne 2 ] || op_unreadable "$GATHERD_OP_DOCUMENT"
        install_config "$TMP/fleet"
        # Install even when it doesn't authenticate: a human needs an
        # rclone.conf on disk to run `rclone config reconnect` against.
        # But say so, and fail: this is the same dead-on-both-sides state the
        # die at the bottom reports, reached one pull earlier, and exiting 0 in
        # silence here read as success until `status` said otherwise.
        note_fleet_install \
            || die "installed the fleet config, but it cannot reach iCloud: $(tail -n1 "$TMP/probe")
if that is an expired token, run: gatherd-icloud-config reconnect"
        return 0
    fi

    if config_works "$CONFIG"; then
        # Deliberately not "is local newer than fleet": last writer wins.
        # Both sides already authenticate by this point, so nothing breaks —
        # the only cost is a working-but-older local config overwriting a
        # newer fleet copy, an acceptable trade for keeping pull's job to
        # "make local and fleet agree" rather than doing its own timestamp
        # bookkeeping.
        cmd_push
        return $?
    fi

    _fleet=0; doc_fetch || _fleet=$?
    [ "$_fleet" -ne 1 ] || die "local config does not work and no fleet config exists"
    [ "$_fleet" -ne 2 ] || op_unreadable "$GATHERD_OP_DOCUMENT"
    if config_works "$TMP/fleet"; then
        install_config "$TMP/fleet"
        # `|| :` keeps set -e from turning a failed second probe into a silent
        # exit; this branch has always reported success once the copy is in.
        note_fleet_install || :
        return 0
    fi

    # Both copies are dead. Overwriting one with the other would look like
    # progress and be none, and would destroy the only config a human could
    # still repair with `rclone config reconnect`.
    die "neither the local nor the fleet config authenticates; iCloud needs re-authentication: gatherd-icloud-config reconnect"
}

cmd_push() {
    [ -s "$CONFIG" ] || die "no local config to publish"
    config_encrypted "$CONFIG" || die "local config is not encrypted; run: rclone config encryption set"
    config_works "$CONFIG" || die "refusing to publish a config that cannot reach iCloud: $(tail -n1 "$TMP/probe")"

    _fleet=0; doc_fetch || _fleet=$?
    [ "$_fleet" -ne 2 ] || op_unreadable "$GATHERD_OP_DOCUMENT"
    if [ "$_fleet" -eq 0 ]; then
        # Compare decrypted contents: rclone's config encryption is
        # nonce-randomised, so two encryptions of identical content differ
        # byte-for-byte and a ciphertext comparison would re-upload every run.
        RCLONE_CONFIG="$CONFIG"    rclone config show > "$TMP/local.plain" 2>/dev/null || true
        RCLONE_CONFIG="$TMP/fleet" rclone config show > "$TMP/fleet.plain" 2>/dev/null || true
        if plain_configs_match "$TMP/local.plain" "$TMP/fleet.plain"; then
            mark_fleet_ok
            return 0
        fi
    fi

    doc_put "$CONFIG" "$_fleet"
    mark_fleet_ok
}

# Re-authenticating is only half the job: until the repaired config is pushed,
# every other machine still pulls the dead one. push re-probes before it
# publishes, so a reconnect that exits 0 without repairing anything still
# cannot reach the fleet.
#
# An expired token expires everywhere, so every machine is told to reconnect.
# The first one to do it fixes the fleet copy, and a second 2FA on any other
# machine would only overwrite that fix with its own. Take the fleet's copy
# when it already works. (Measured: `rclone config reconnect icloud:` repaired
# squirrel-zapper's expired trust token on 2026-09-15.)
cmd_reconnect() {
    [ -s "$CONFIG" ] || die "no local config to reconnect; run: gatherd-icloud-config pull"
    if ! config_works "$CONFIG"; then
        _fleet=0; doc_fetch || _fleet=$?
        [ "$_fleet" -ne 2 ] || op_unreadable "$GATHERD_OP_DOCUMENT"
        if [ "$_fleet" -eq 0 ] && config_works "$TMP/fleet"; then
            install_config "$TMP/fleet"
            note_fleet_install || :
            echo "Another machine already reconnected; installed the fleet config, no 2FA needed."
            return 0
        fi
        RCLONE_CONFIG="$CONFIG" rclone config reconnect "$REMOTE:" \
            || die "rclone could not reconnect $REMOTE:; nothing was published"
        RECONNECTED=yes
    fi
    cmd_push
}

cmd_bootstrap() {
    # Every stage is idempotent against work already done by hand: this machine
    # already has a working remote, an encrypted config, and the password item,
    # so here bootstrap does nothing but upload the document. A bootstrap that
    # assumed greenfield would re-encrypt an encrypted config or overwrite a
    # password item other machines will come to depend on.
    if ! op item get "$GATHERD_OP_PASSWORD_ITEM" --vault "$GATHERD_OP_VAULT" >/dev/null 2>"$TMP/op.err"; then
        op_says_absent || op_unreadable "$GATHERD_OP_PASSWORD_ITEM"
        op item create --category=password \
            --title "$GATHERD_OP_PASSWORD_ITEM" --vault "$GATHERD_OP_VAULT" --generate-password
        echo "Created the config password item. Now encrypt the config:"
        echo "  rclone config encryption set"
        echo "and re-run: gatherd-icloud-config bootstrap"
        return 0
    fi

    [ -s "$CONFIG" ] || die "no local rclone config; run 'rclone config' and add the '$REMOTE' remote first"
    config_encrypted "$CONFIG" || die "local config is not encrypted; run: rclone config encryption set"
    config_works "$CONFIG" || die "local config does not authenticate; fix it before publishing it to the fleet: $(tail -n1 "$TMP/probe")"

    _fleet=0; doc_fetch || _fleet=$?
    [ "$_fleet" -ne 2 ] || op_unreadable "$GATHERD_OP_DOCUMENT"
    doc_put "$CONFIG" "$_fleet"
    mark_fleet_ok
    echo "Published the encrypted config to op://$GATHERD_OP_VAULT/$GATHERD_OP_DOCUMENT"
}

cmd_status() {
    if [ ! -s "$CONFIG" ]; then
        _enc=absent
    elif config_encrypted "$CONFIG"; then
        _enc=encrypted
    else
        _enc=plaintext
    fi

    if [ "$_enc" = absent ]; then
        _reach=not-ready
    elif config_works "$CONFIG"; then
        _reach=verified
    else
        _reach=unreachable
    fi

    _rc=0; doc_fetch || _rc=$?
    if [ "$_rc" -eq 1 ]; then
        _fleet=absent
    elif [ "$_rc" -eq 2 ]; then
        _fleet=unreadable
        warn "cannot read op://$GATHERD_OP_VAULT/$GATHERD_OP_DOCUMENT from 1Password: $(sed -n '/./{p;q}' "$TMP/op.err")"
    elif [ "$_enc" = absent ]; then
        _fleet=unknown
    else
        RCLONE_CONFIG="$CONFIG"    rclone config show > "$TMP/local.plain" 2>/dev/null || true
        RCLONE_CONFIG="$TMP/fleet" rclone config show > "$TMP/fleet.plain" 2>/dev/null || true
        if [ ! -s "$TMP/local.plain" ] || [ ! -s "$TMP/fleet.plain" ]; then
            _fleet=unknown
        elif cmp -s "$TMP/local.plain" "$TMP/fleet.plain"; then
            _fleet='in sync'
        else
            _fleet=differs
        fi
    fi

    printf 'config: %s, %s; fleet: %s\n' "$_enc" "$_reach" "$_fleet"
}

# Self-pruning: any invocation (not just pull) that observes the config is
# encrypted again clears the sentinel note_fleet_install set, the same way
# gatherd-icloud-sync (and mark_fleet_ok) clear $REAUTH on the next success — so fixing the
# config by hand (`rclone config encryption set`) is enough, with no separate
# "acknowledge this" step.
config_encrypted "$CONFIG" && rm -f "$PLAINTEXT"

case "${1:-status}" in
    bootstrap) cmd_bootstrap ;;
    pull)      cmd_pull ;;
    push)      cmd_push ;;
    reconnect) cmd_reconnect ;;
    status)    cmd_status ;;
    *)         echo "usage: $0 {bootstrap|pull|push|reconnect|status}" >&2; exit 2 ;;
esac
