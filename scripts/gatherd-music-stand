#!/bin/sh
# Read sheet music at the piano: tablet mode, then pick a score by composer and
# open it in the viewer's presentation mode (tap to turn the page).
#
# The picker is progressive because there is no keyboard in tablet mode and so
# no type-to-filter — one flat list of every score is a long finger-scroll,
# whereas composer-then-score is two short lists, and MRU ordering makes the
# common case two taps with no scrolling at all.
#
# See docs/superpowers/specs/2026-08-16-tablet-mode-design.md.
set -eu

config="${XDG_CONFIG_HOME:-$HOME/.config}/gatherd/tablet-mode.conf"
root="$HOME/Documents/forscore"
viewer=papers
viewer_flag=""
viewer_env=""
menu_font=""
# shellcheck source=/dev/null
[ -r "$config" ] && . "$config"
root="${MUSIC_STAND_ROOT:-$root}"
viewer="${MUSIC_STAND_VIEWER:-$viewer}"
viewer_flag="${MUSIC_STAND_VIEWER_FLAG:-$viewer_flag}"
viewer_env="${MUSIC_STAND_VIEWER_ENV:-$viewer_env}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/gatherd"
index="$state_dir/music-index.tsv"
mru="$state_dir/music-stand-scores"
viewer_pid_file="$state_dir/music-stand-viewer-pid"
max_mru=20
back='‹ Back'
# Escape needs a keyboard and the human's fuzzel.ini disables
# exit-on-keyboard-focus-loss (tapping elsewhere doesn't dismiss it either),
# so with the keyboard off in tablet mode there is otherwise no way out of
# either level of this picker without choosing a score. Cancel funnels
# composer/title back to empty so it rejoins pick()'s existing
# nothing-chosen path rather than adding a second "do nothing" path.
cancel='󰅖 Cancel'

# fuzzel entries are the touch targets here, so they are deliberately taller and
# wider than the launcher's defaults. menu_font (see tablet-mode.conf.j2) is a
# multiple of foot_font_size, not a constant, so these stay tappable on any
# other machine gatherd converges; absent or empty, fuzzel just uses its own
# default.
#
# The --font override itself is conditional on tablet mode being ACTIVE, not
# just on menu_font being configured: turn_on() below reaches pick() before it
# flips tablet mode on, so a keyboard-invoked pick (human at the keyboard,
# about to fold) sees tablet mode inactive and must stay keyboard-sized. Only
# "Pick another score" from the power button's already-folded escape menu
# (gatherd-power-button) sees tablet mode active, and that's the finger-tap
# case this size is for. A size-22 menu at the keyboard was reported as
# needlessly huge - this is that fix.
pick() {
    set -- --dmenu --prompt "$1" --lines 12 --width 40
    if gatherd-tablet-mode status >/dev/null 2>&1; then
        [ -n "$menu_font" ] && set -- "$@" --font "$menu_font"
    fi
    fuzzel "$@" || true
}

# Regenerate whenever forScore's backup is newer than the index. A stat
# comparison keeps this self-maintaining: no cron, no manual refresh step.
refresh_index() {
    _backup="$root/Automatic Backup.4sb"
    if [ ! -f "$index" ] || { [ -f "$_backup" ] && [ "$_backup" -nt "$index" ]; }; then
        MUSIC_STAND_ROOT="$root" gatherd-music-index || true
    fi
}

# The forScore library this indexes gets renamed and deleted from underneath
# the MRU, which never expires on its own. Matching the whole
# composer/title/filename triple against the index — not just the composer —
# drops a row the moment any part of it goes stale, so a renamed or removed
# score stops resurfacing and file_for() below is guaranteed to resolve
# whatever this offers.
live_mru() {
    [ -r "$mru" ] || return 0
    awk -F'\t' 'NR==FNR { live[$0]; next } ($0 in live)' "$index" "$mru"
}

# Most-recently-played first, then everything else. awk dedupes in one pass and
# preserves first-seen order, so the MRU head wins without a second sort.
composers() {
    { live_mru | cut -f1; cut -f1 "$index"; } 2>/dev/null \
        | awk 'NF && !seen[$0]++'
}

titles_for() {
    { live_mru | awk -F'\t' -v c="$1" '$1 == c { print $2 }'
      awk -F'\t' -v c="$1" '$1 == c { print $2 }' "$index"; } 2>/dev/null \
        | awk 'NF && !seen[$0]++'
}

file_for() {
    awk -F'\t' -v c="$1" -v t="$2" '$1 == c && $2 == t { print $3; exit }' "$index"
}

remember() {
    mkdir -p "$state_dir" 2>/dev/null || return 0
    { printf '%s\t%s\t%s\n' "$1" "$2" "$3"
      [ -r "$mru" ] && cat "$mru"; } 2>/dev/null \
        | awk 'NF && !seen[$0]++' | head -n "$max_mru" > "$mru.tmp" \
        && mv "$mru.tmp" "$mru"
}

# Stop the viewer this script started, and ONLY that one. The pid is recorded
# at launch and re-checked against /proc before anything is signalled, because
# pids are recycled: a stale file must never take out whatever inherited the
# number. Nothing here matches on process name or window class - a pattern
# match has taken out unrelated windows on this machine before, so the rule is
# that a destructive command names exactly one pid this script created.
stop_viewer() {
    [ -r "$viewer_pid_file" ] || return 0
    _pid=$(cat "$viewer_pid_file" 2>/dev/null || true)
    rm -f "$viewer_pid_file"
    case "$_pid" in '' | *[!0-9]*) return 0 ;; esac
    # Tested for readability first: `< /proc/$pid/cmdline` is a REDIRECTION,
    # and a redirection that cannot be opened is diagnosed by the shell itself,
    # which `2>/dev/null` on the command cannot suppress. A pid that has since
    # exited - the common case for a stale file - would otherwise print
    # "No such file or directory" every time the human opened a score.
    _cmd=""
    if [ -r "/proc/$_pid/cmdline" ]; then
        _cmd=$(tr '\0' ' ' < "/proc/$_pid/cmdline" 2>/dev/null || true)
    fi
    case "$_cmd" in
        *"$viewer"*) ;;
        *) return 0 ;;
    esac

    # Signal the process GROUP, not the pid alone. koreader is a wrapper shell
    # that runs the actual reader as a child in a restart loop and never
    # execs, so killing the recorded pid would leave the score on screen with
    # nothing left tracking it. turn_on launches under setsid exactly so that
    # a group exists containing only what we started.
    #
    # Guarded on the pid still BEING its own group leader. That is what proves
    # this is the group setsid made for us, rather than one a recycled pid was
    # reparented into - a group kill aimed at strangers is a much worse
    # mistake than a missed one, so the fallback is the narrower signal.
    #
    # Field 3 after the final ')': a process name can contain spaces and
    # parentheses, so /proc/pid/stat cannot be split on whitespace from the
    # left. After the comm field the columns are state, ppid, pgrp.
    _pgid=$(sed 's/.*) //' "/proc/$_pid/stat" 2>/dev/null | awk '{print $3}' || true)
    if [ -n "$_pgid" ] && [ "$_pgid" = "$_pid" ]; then
        kill -- -"$_pid" 2>/dev/null || true
    else
        kill "$_pid" 2>/dev/null || true
    fi
}

turn_on() {
    refresh_index
    [ -s "$index" ] || { echo "gatherd-music-stand: no scores indexed" >&2; exit 1; }

    while :; do
        composer=$( { composers; printf '%s\n' "$cancel"; } | pick 'composer: ')
        [ "$composer" = "$cancel" ] && composer=''
        [ -n "$composer" ] || exit 0

        title=$( { titles_for "$composer"; printf '%s\n' "$back"; printf '%s\n' "$cancel"; } \
            | pick 'score: ')
        [ "$title" = "$cancel" ] && title=''
        [ -n "$title" ] || exit 0
        [ "$title" = "$back" ] || break
    done

    file=$(file_for "$composer" "$title")
    [ -n "$file" ] || { echo "gatherd-music-stand: no file for $title" >&2; exit 1; }

    # Confirm the file is still on disk BEFORE flipping tablet mode: the index
    # can lag a forScore deletion, and entering tablet mode first would strand
    # the human folded over the keyboard with it disabled and a blank screen.
    [ -f "$root/$file" ] || { echo "gatherd-music-stand: file missing: $root/$file" >&2; exit 1; }

    # Same reasoning, same guard: $viewer (papers) is REST tier and only
    # arrives after login, over the network, while this mechanism itself is
    # CORE and works offline. Between first login and async completion there
    # would be no viewer to hand the file to — check BEFORE tablet mode for
    # the same reason as the file check above.
    command -v "$viewer" >/dev/null 2>&1 \
        || { echo "gatherd-music-stand: viewer not found: $viewer" >&2; exit 1; }

    remember "$composer" "$title" "$file"
    # Replace rather than stack: "Pick another score" from the folded menu is
    # a request to read a different score, not to accumulate viewers behind
    # the fullscreen one - and only the newest pid can be recorded below, so
    # leaving the old one running would also leave it untrackable.
    stop_viewer
    set --
    if [ -n "$viewer_flag" ]; then
        set -- "$viewer_flag"
    fi
    set -- "$@" "$root/$file"
    # setsid so the viewer heads its own process group - see stop_viewer.
    if [ -n "$viewer_env" ]; then
        # Deliberately unquoted: viewer_env is a space-separated list of
        # KEY=VALUE assignments for env(1), and must word-split.
        # shellcheck disable=SC2086
        setsid env $viewer_env "$viewer" "$@" >/dev/null 2>&1 &
    else
        setsid "$viewer" "$@" >/dev/null 2>&1 &
    fi
    _viewer_pid=$!
    mkdir -p "$state_dir" 2>/dev/null || true
    printf '%s\n' "$_viewer_pid" > "$viewer_pid_file" 2>/dev/null || true

    # Already folded when this score was picked? Then tablet mode has been on
    # since long before this window existed, so its fullscreen has already
    # happened and missed. Ask for it again now. A no-op when unfolded, which
    # is the case where the score is meant to be an ordinary window.
    # gatherd-tablet-mode remains the only thing that talks to the compositor.
    gatherd-tablet-mode fullscreen-viewer || true
}

viewer_running() {
    [ -r "$viewer_pid_file" ] || return 1
    _running_pid=$(cat "$viewer_pid_file" 2>/dev/null || true)
    case "$_running_pid" in '' | *[!0-9]*) return 1 ;; esac
    kill -0 "$_running_pid" 2>/dev/null
}

turn_off() {
    stop_viewer
}

case "${1:-toggle}" in
    on)     turn_on ;;
    off)    turn_off ;;
    close)  stop_viewer ;;
    toggle) if viewer_running; then turn_off; else turn_on; fi ;;
    *)      echo "usage: $0 on|off|close|toggle" >&2; exit 2 ;;
esac
