#!/bin/sh
# Fuzzel-driven polkit authentication agent. polkit needs a D-Bus authentication
# agent registered in the session; cmd-polkit-agent supplies that boilerplate and
# speaks a tiny JSON protocol over stdio to a handler command. This script is both
# the launcher and — re-invoked with --handle — that handler, so the whole agent
# is one file. The password prompt reuses gatherd-askpass, so a polkit request
# looks exactly like the sudo/ssh/vault fuzzel prompts and is tagged "[polkit]".

# Overridable only so the handler can be exercised with a stub prompt in tests.
askpass="${GATHERD_ASKPASS:-/usr/local/bin/gatherd-askpass}"

if [ "$1" = "--handle" ]; then
    # cmd-polkit sends one JSON object per line: a "request password" prompts the
    # user; other actions (e.g. "authorization response") just report status and
    # are ignored. We reply with the password or, on Escape, a cancel.
    while IFS= read -r msg; do
        [ "$(printf '%s' "$msg" | jq -r '.action')" = "request password" ] || continue
        # polkit computes a human sentence ("Authentication is required to
        # install software.") and an action id for every request, and this
        # agent used to discard both in favour of a bare tag. They beat
        # anything the /proc walk could recover here: polkit's agent API has no
        # subject parameter, so ancestry names cmd-polkit rather than whatever
        # actually asked. "polkit action" is null when cmd-polkit could not
        # resolve the action, hence the guarded pick rather than a plain //.
        ctx=$(printf '%s' "$msg" | jq -r '
            [ ( [ .message, ."polkit action".message ]
                | map(select(type == "string" and . != "")) | first // empty ),
              ( ."polkit action".id // empty | select(. != "") )
            ] | join("\n")')
        if password=$("$askpass" "[polkit]" "$ctx"); then
            # jq -Rs JSON-encodes the raw password, preserving any character that
            # naive quoting would mangle; printf avoids appending a newline to it.
            # -c is load-bearing: cmd-polkit reads our stdout one physical line at
            # a time and parses only the most recent line as a whole JSON object
            # (see on_new_input in its polkit-auth-handler.service.c). jq's default
            # pretty-print spreads the object over four lines, so cmd-polkit only
            # ever sees the closing "}", fails to parse it, and never calls
            # polkit_agent_session_response — the auth hangs forever with the box
            # already dismissed. Compact output keeps it to the single line the
            # parser expects. (The cancel reply below is already a single line.)
            printf '%s' "$password" | jq -cRs '{action:"authenticate",password:.}'
        else
            printf '%s\n' '{"action":"cancel"}'
        fi
    done
    exit 0
fi

# Parallel mode. In serial mode (-s) a single auth that never tears down — a
# cancelled or stuck session whose polkit-agent-helper-1 lingers — occupies the
# one slot, and every later polkit prompt then times out with NO box: a
# session-long wedge that only an agent restart clears. Parallel mode handles
# each request independently, so one stuck session can't block the rest. The
# tradeoff is the reason -s was here: two *concurrent* prompts both reach for
# fuzzel's single-instance lock and the second fails to draw (gatherd-askpass
# logs the "fuzzel already running" miss). Concurrent polkit auths are rare, and
# a rare lost prompt is far better than a wedge that kills every prompt.
exec cmd-polkit-agent -p -c "$0 --handle"
