#!/bin/sh
# Fuzzel-driven polkit authentication agent. polkit needs a D-Bus authentication
# agent registered in the session; cmd-polkit-agent supplies that boilerplate and
# speaks a tiny JSON protocol over stdio to a handler command. This script is both
# the launcher and — re-invoked with --handle — that handler, so the whole agent
# is one file. The password prompt reuses gatherd-askpass, so a polkit request
# looks exactly like the sudo/ssh/vault fuzzel prompts and is tagged "[polkit]".

# Overridable only so the handler can be exercised with a stub prompt in tests.
askpass="${GATHERD_ASKPASS:-/usr/local/bin/gatherd-askpass}"

if [ "$1" = "--handle" ]; then
    # cmd-polkit sends one JSON object per line: a "request password" prompts the
    # user; other actions (e.g. "authorization response") just report status and
    # are ignored. We reply with the password or, on Escape, a cancel.
    while IFS= read -r msg; do
        [ "$(printf '%s' "$msg" | jq -r '.action')" = "request password" ] || continue
        if password=$("$askpass" "[polkit]"); then
            # jq -Rs JSON-encodes the raw password, preserving any character that
            # naive quoting would mangle; printf avoids appending a newline to it.
            printf '%s' "$password" | jq -Rs '{action:"authenticate",password:.}'
        else
            printf '%s\n' '{"action":"cancel"}'
        fi
    done
    exit 0
fi

# Serial mode: fuzzel can only show one prompt at a time.
exec cmd-polkit-agent -s -c "$0 --handle"
