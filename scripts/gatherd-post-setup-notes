#!/bin/sh
# Manages ~/.config/gatherd-post-setup.md as a living document:
#   - appends sections that are needed but not yet present
#   - when detection says a step is done, removes ONLY the boilerplate lines this
#     script itself generated, leaving anything you added by hand (and dropping a
#     now-empty header). Write freely under any section — your notes are never
#     pruned, with no markers or special formatting to remember.
# Safe to run at any time; gatherd-prompt-postsetup calls it at each login.

# shellcheck disable=SC2016
# The li/section strings deliberately hold literal `backtick` and $(...) command
# text for the reader to paste into their own shell — it is documentation, never
# meant to expand here.

OUTPUT="$HOME/.config/gatherd-post-setup.md"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

h()  { printf '\n# %s\n'  "$1" >> "$OUTPUT"; }

# Render one bullet wrapped to fit an 80-column editor: the first line gets the
# "- " marker, continuation lines a 2-space hanging indent. fold -s breaks only
# at spaces; trailing whitespace is trimmed so the rendering is deterministic —
# prune_section re-renders bullets the same way to find and remove them.
wrap_bullet() {
    printf '%s\n' "$1" | fold -s -w 78 | sed 's/[[:space:]]*$//' | awk '
        NR == 1 { print "- " $0; next }
                { print "  " $0 }'
}

li() { wrap_bullet "$1" >> "$OUTPUT"; }

section_present() { grep -q "^# $1\$" "$OUTPUT" 2>/dev/null; }

# Wipe an entire section, header through the next header — blunt, and only safe
# for the fully-derived Unmanaged WiFi list (regenerated each run, never
# hand-edited). For any section you might annotate, use prune_section instead.
section_remove() {
    awk -v hdr="# $1" '
        $0 == hdr { skip=1; next }
        skip && /^# /  { skip=0 }
        !skip { print }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# Remove only the boilerplate bullets this script generated for a section
# (passed as arguments), leaving any lines you added by hand. If nothing of
# yours remains under the header, drop the header too. This is how "done" steps
# get pruned without ever eating your own notes.
# Drop boilerplate bullets wherever they sit, ignoring section boundaries. Needed
# because h() and li() both append at end of file: when a bullet is added while
# its header already exists further up, h() is skipped and the bullet lands under
# whatever section is currently last. prune_section is scoped to its own header
# and so can never reach those orphans. Matching is on the whole rendered bullet,
# so this only ever removes text this script itself wrote.
prune_bullets_anywhere() {
    _own=$(for _b in "$@"; do wrap_bullet "$_b"; printf '@@PRUNE_SEP@@\n'; done)
    PRUNE_OWN="$_own" awk '
        BEGIN {
            n = split(ENVIRON["PRUNE_OWN"], L, "\n")
            b = ""
            for (i = 1; i <= n; i++) {
                if (L[i] == "@@PRUNE_SEP@@") { if (b != "") own[b] = 1; b = ""; continue }
                b = (b == "") ? L[i] : b "\n" L[i]
            }
        }
        function endgrp(   j, m, gl) {
            if (!ingrp) return
            if (!(g in own)) { m = split(g, gl, "\n"); for (j = 1; j <= m; j++) print gl[j] }
            ingrp = 0; g = ""
        }
        /^- /          { endgrp(); ingrp = 1; g = $0; next }
        ingrp && /^  / { g = g "\n" $0; next }
                       { endgrp(); print }
        END            { endgrp() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

prune_section() {
    _name=$1
    shift
    # A missing header does not mean the bullets are gone — they may be orphaned
    # under a later section. Sweep for them instead of returning empty-handed.
    section_present "$_name" || { prune_bullets_anywhere "$@"; return; }
    # Re-render each boilerplate bullet exactly as li() wrote it (wrapping and
    # all), separated by a sentinel line, so awk matches and drops the whole
    # possibly-multi-line bullet as a unit while leaving hand-added lines verbatim.
    _own=$(for _b in "$@"; do wrap_bullet "$_b"; printf '@@PRUNE_SEP@@\n'; done)
    PRUNE_OWN="$_own" awk -v hdr="# $_name" '
        BEGIN {
            n = split(ENVIRON["PRUNE_OWN"], L, "\n")
            b = ""
            for (i = 1; i <= n; i++) {
                if (L[i] == "@@PRUNE_SEP@@") { if (b != "") own[b] = 1; b = ""; continue }
                b = (b == "") ? L[i] : b "\n" L[i]
            }
        }
        # A bullet group is a "- " line plus its "  " continuation lines; drop the
        # whole group if it matches a boilerplate bullet, else keep it verbatim.
        function endgrp(   j, m, gl) {
            if (!ingrp) return
            if (!(g in own)) {
                m = split(g, gl, "\n")
                for (j = 1; j <= m; j++) { out[++on] = gl[j]; if (gl[j] != "") nonblank = 1 }
            }
            ingrp = 0; g = ""
        }
        function flush(   j) {
            endgrp()
            if (nonblank) { print hdr; for (j = 1; j <= on; j++) print out[j] }
            on = 0; nonblank = 0
        }
        $0 == hdr      { inseg = 1; on = 0; nonblank = 0; ingrp = 0; g = ""; next }
        inseg && /^# / { flush(); inseg = 0; print; next }
        inseg {
            if ($0 ~ /^- /)          { endgrp(); ingrp = 1; g = $0; next }
            if (ingrp && $0 ~ /^  /) { g = g "\n" $0; next }
            endgrp(); out[++on] = $0; if ($0 != "") nonblank = 1; next
        }
                       { print }
        END            { if (inseg) flush() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

collapse_blanks() {
    awk 'prev_blank && /^$/ { next } { prev_blank=(/^$/); print }' \
        "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# ---------------------------------------------------------------------------
# App state detection
# ---------------------------------------------------------------------------

# The SSH-agent socket appears only once "Use the SSH agent" is enabled — the
# last 1Password setup step, so a good proxy for the whole section being done.
onepassword_ssh_agent_ok() { [ -S "$HOME/.1password/agent.sock" ]; }

tailscale_connected() { tailscale ip >/dev/null 2>&1; }

# Sentinels rather than a live probe: this script runs at every login, and
# `rclone listremotes` now shells out to op for the config password, which
# blocks on a locked 1Password. Both files are written by gatherd-icloud-config
# and gatherd-icloud-sync.
_icloud_state="$HOME/.local/state/gatherd"
icloud_fleet_ok()    { [ -f "$_icloud_state/icloud-fleet-ok" ]; }
icloud_needs_reauth() { [ -f "$_icloud_state/icloud-needs-reauth" ]; }
icloud_plaintext_config() { [ -f "$_icloud_state/icloud-plaintext-config" ]; }

# ---------------------------------------------------------------------------
# Section handlers
# Pattern: if done → prune; else if absent → add; else → leave alone
# ---------------------------------------------------------------------------

section_1password() {
    set -- \
        'Sign in to 1Password' \
        'Lock, unlock, enter 2FA code' \
        'Settings → Developer: enable "Connect with 1Password CLI" and "Use the SSH agent"'
    if onepassword_ssh_agent_ok; then
        prune_section '1Password' "$@"
    else
        section_present '1Password' && return
        h '1Password'
        for b in "$@"; do li "$b"; done
    fi
}

section_tailscale() {
    set -- \
        'Connect during this session before rebooting. Set up 1Password (including its browser extension) first — then Tailscale offers to log you in via Apple SSO and 1Password fills it correctly.'
    if tailscale_connected; then
        prune_section 'Tailscale' "$@"
    else
        section_present 'Tailscale' && return
        h 'Tailscale'
        for b in "$@"; do li "$b"; done
    fi
}

section_other_logins() {
    # Only iCloud earns a standing reminder here. Claude Desktop/Code, Zoom, and
    # JetBrains are deliberately not surfaced — logging into them is obvious on
    # demand and didn't merit a recurring nag. PIA needs nothing here either: it
    # logs in automatically from 1Password via gatherd-prompt-pia at every login.
    #
    # Two mutually exclusive iCloud lines, both self-pruning. Bootstrap is a
    # once-per-fleet step, so it only appears on a machine that has never seen a
    # fleet config. Re-auth is periodic and unavoidable — the session token
    # expires whatever we do — so it appears whenever a sync hits an auth error
    # and disappears on the next success.
    b_bootstrap='iCloud: run `gatherd-icloud-config bootstrap` (once per fleet; needs `rclone config` + 2FA first if this is the very first machine)'
    b_reauth='iCloud needs re-authentication: run `rclone config reconnect icloud:` and complete 2FA — every other machine picks it up automatically'
    b_plaintext='iCloud config is plaintext (a live iCloud token sits unencrypted on disk): run `rclone config encryption set`'

    # The bullet this feature replaced. prune_section matches on bullet text, so
    # renaming a bullet orphans the old wording in every notes file that already
    # had it — self-pruning only ever removes text it can still name. A machine
    # provisioned before the fleet-config work therefore kept telling its human
    # to run `rclone config` long after that step became both unnecessary and
    # actively wrong. Prune it unconditionally, forever: it is cheap, and a
    # machine that legitimately needs setup gets b_bootstrap below instead.
    prune_section 'Other Logins' 'iCloud: run `rclone config` and follow prompts to add a remote named `icloud`; complete 2FA when prompted'

    # Each branch prunes its own bullet before possibly re-adding it, not just
    # when it's due to disappear: `li` only appends, so guarding the add with
    # `section_present || h` (skip the header, not the bullet) still let a
    # bullet that survived from the previous run get a second copy appended
    # underneath it. Prune-then-add makes each bullet idempotent regardless of
    # what the file already looked like.
    if icloud_fleet_ok; then
        prune_section 'Other Logins' "$b_bootstrap"
    else
        prune_section 'Other Logins' "$b_bootstrap"
        section_present 'Other Logins' || h 'Other Logins'
        li "$b_bootstrap"
    fi

    if icloud_needs_reauth; then
        prune_section 'Other Logins' "$b_reauth"
        section_present 'Other Logins' || h 'Other Logins'
        li "$b_reauth"
    else
        prune_section 'Other Logins' "$b_reauth"
    fi

    if icloud_plaintext_config; then
        prune_section 'Other Logins' "$b_plaintext"
        section_present 'Other Logins' || h 'Other Logins'
        li "$b_plaintext"
    else
        prune_section 'Other Logins' "$b_plaintext"
    fi
}

section_unmanaged_wifi() {
    # Content is purely derived from current NM state vs Ansible manifest;
    # always rewrite from scratch so newly joined networks surface promptly.
    [ -r /etc/gatherd/managed-wifi.list ] || {
        section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
        return
    }

    saved=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1 }' \
        | sort -u)
    # Suppress both the Ansible-managed networks and any you've durably dismissed
    # in the local ack file. The ack file is per-machine and intentionally not
    # carried across a repave — a fresh machine re-surfaces every unmanaged net.
    _exclude=$(mktemp)
    cat /etc/gatherd/managed-wifi.list > "$_exclude"
    _ack="$HOME/.config/gatherd/wifi-ignore.list"
    [ -r "$_ack" ] && cat "$_ack" >> "$_exclude"
    unmanaged=$(printf '%s\n' "$saved" | grep -vxFf "$_exclude" || true)
    rm -f "$_exclude"

    section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
    [ -n "$unmanaged" ] || return

    # Build the block on its own, then splice it just under the top "Manual steps
    # remaining:" line. This section regenerates every run and would otherwise
    # re-append at the bottom, but it belongs above Verify.
    _blk=$(mktemp)
    _main=$OUTPUT
    OUTPUT=$_blk
    h 'Unmanaged WiFi'
    li 'Either keep in Ansible (vault/vault.yml) or append to ~/.config/gatherd/wifi-ignore.list:'
    printf '%s\n' "$unmanaged" | while IFS= read -r ssid; do
        [ -n "$ssid" ] && printf '  - %s\n' "$ssid" >> "$OUTPUT"
    done
    OUTPUT=$_main

    { head -n 1 "$OUTPUT"; cat "$_blk"; tail -n +2 "$OUTPUT"; } \
        > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
    rm -f "$_blk"
}

section_vault() {
    set -- \
        'Enter password when prompted' \
        'Run `journalctl -u gatherd-vault.service` to check progress'
    if [ -f /etc/gatherd/vault-complete ]; then
        prune_section 'Vault' "$@"
    else
        section_present 'Vault' && return
        h 'Vault'
        for b in "$@"; do li "$b"; done
    fi
}

section_verify() {
    # Never auto-done: user manages this section manually
    section_present 'Verify' && return
    h 'Verify'
    li 'IR remote (machines with an IR receiver only): `ir-keytable -t -s rc0` while pressing buttons prints a scancode + keycode per press.'
    li 'Convergence is fail-open: `/usr/local/lib/gatherd/scripts/gatherd-selftest-failopen --toast` prints `PASS` for all four outcomes and pops the critical toast a failing boot would show. It drives the real wrapper against a scratch marker, so the live status is untouched.'
    li 'The greeter is off the network: `systemctl show gatherd.service autofs.service -p After -p Wants | grep -c network-online` prints `0`. Then boot with the network DISCONNECTED — the greeter comes up without a ~60s NetworkManager-wait-online stall, and the first session has fonts, keybindings, wallpaper and keyring before anything is downloaded.'
    li 'Both tiers converged: `head -1 /etc/gatherd/core-complete` and `head -1 /etc/gatherd/async-complete` each print the same commit as `git -C /usr/local/lib/gatherd rev-parse HEAD`, and `head -1 /etc/gatherd/last-run` prints `ok`.'
    li 'No package drifts from the offline-cache manifest: `/usr/local/lib/gatherd/scripts/gatherd-check-package-tiers /usr/local/lib/gatherd` exits `0`.'
    li 'AUR packages are built unprivileged and installed from a local repo, so no sudoers grant is issued at any point: `sudo grep -c "NOPASSWD: /usr/bin/pacman" /etc/sudoers` prints `0` (only the two permanent per-script grants under /etc/sudoers.d may exist -- `sudo grep -rl NOPASSWD /etc/sudoers.d | wc -l` prints `2`). `grep -c "^\[gatherd-aur\]" /etc/pacman.conf` prints `1`; `stat -c %U /var/cache/gatherd-aur` prints your username and `stat -c %U /etc/pacman.conf` prints `root` -- that split IS the mechanism, the build half writes to a directory it owns and only root installs from it. `pacman -Q aurutils` prints the pkgver-pkgrel pinned in `grep -E "^pkg(ver|rel)=" /usr/local/lib/gatherd/packaging/aurutils/PKGBUILD`. Every AUR package came from the local repo, not from a helper: `pacman -Si 1password | head -1` prints `Repository : gatherd-aur`, and `comm -13 <(pacman -Slq gatherd-aur | sort) <(pacman -Qmq | sort)` prints exactly `aurutils` and `nowayprompt` and nothing else -- those two are built from vendored PKGBUILDs and installed by file path, so they are foreign but never enter the repo; a THIRD name here means something reached the machine outside the repo. The privilege-free path still works end to end on a converged machine: `PACMAN_AUTH=/bin/false AUR_PACMAN_AUTH=/bin/false aur sync --database gatherd-aur --no-view --no-confirm --no-sync --makepkg-args --skippgpcheck --rebuild xdg-terminal-exec` exits `0` having rebuilt the package -- run it with the same environment and flags the playbook uses, or it is not testing what the playbook does. It cannot prompt for a password: /bin/false IS the auth command -- a prompt here means something reintroduced --syncdeps or dropped --no-sync. Finally the failure mode the whole change is about: start a converge and kill it mid-build (`sudo systemctl start gatherd-async.service` then `sudo systemctl stop gatherd-async.service` while a build is running), then re-run the first grep -- still `0`.'
    li 'GRUB background decodes, and is pre-turned where the panel is mounted rotated: `sudo grep -c "insmod jpeg" /boot/grub/grub.cfg` prints 1 or more. On an upright-panel machine `grep GRUB_BACKGROUND /etc/default/grub` prints a .jpg under /usr/local/lib/gatherd/backgrounds; where `cat /sys/class/dmi/id/product_name` prints `MiniBook X` it prints /usr/local/share/gatherd/wallpaper-dark-rotated.jpg instead, and that copy is a lossless quarter-turn of the source — `jpegtran -rotate 90 -optimize -copy none -outfile /tmp/rot.jpg /usr/local/lib/gatherd/backgrounds/wallpaper-dark.jpg && cmp /tmp/rot.jpg /usr/local/share/gatherd/wallpaper-dark-rotated.jpg` prints nothing. The next boot shows the image rather than a plain background, and on the rotated panel the art reads upright; the menu text and LUKS prompt stay sideways, which GRUB cannot fix.'
    li 'Credential prompts wear the crimson house style and say who asked. `sudo -k; sudo id -u` in a NEW terminal pops a crimson box with a salmon border reading `elevating: id -u` and `requested by foot`, in the font from `grep font-regular ~/.config/nowayprompt/config.ini` — typing the password prints `0`, Escape prints nothing and exits non-zero. Context is advisory, not a control, and the box must say so when it has nothing: `/usr/local/bin/gatherd-askpass "[sudo]"` run directly from an ordinary shell shows `context unavailable`. The check is `/proc/<pid>` owner uid 0, NOT `/proc/<pid>/exe` (exe is unreadable through a setuid sudo — the kernel clears the dumpable flag — so an exe check could never succeed either way); it shows `context unavailable` because the invoking shell is unprivileged, not because a readlink failed. Elision is announced: `sudo -k; sudo sh -c "$(printf "printf x\\033[2J")"` shows a line ending `[elided]`. The `sudo` shell function has two independent guards, and either one alone must fall through to sudo'"'"'s own tty prompt with no box — nowayprompt has no tty fallback of its own (`allow_tty_fallback` is set only inside `run_pinentry()`, never on the plain CLI path gatherd-askpass uses): unset `WAYLAND_DISPLAY` — `sudo -k; env -u WAYLAND_DISPLAY bash -i -c '"'"'sudo id -u'"'"'` — and, separately, with `WAYLAND_DISPLAY` left set, hide `nowayprompt` from `command -v` — `sudo -k; bash -i -c '"'"'command() { [ "$1" = -v ] && [ "$2" = nowayprompt ] && return 1; builtin command "$@"; }; sudo id -u'"'"'`. The ssh host-key decision is the SAME box, not a separate foot window: `/usr/local/bin/gatherd-askpass "Are you sure you want to continue connecting (yes/no/[fingerprint])?"` opens an unmasked three-button prompt (`Yes`/`No`/`Abort`) with the whole prompt legible; `Yes` prints `yes`, `No` prints `no`, `Abort` prints nothing and exits non-zero. Finally `grep -c gatherd-hostkey-verify ~/.config/sway/config.d/application_defaults` prints `0`.'
    li 'iCloud sync: `gatherd-icloud-config status` prints `config: encrypted, verified; fleet: in sync`; `gatherd-icloud-sync FSNotes` exits 0 and `tail -3 ~/.local/state/gatherd/rclone-icloud-FSNotes.log` ends with a successful bisync; `ls ~/Documents/iCloud/FSNotes | wc -l` is non-zero'
    li 'iCloud unlock trigger: `grep -c unlock-command ~/.config/gtklock/config.ini` prints 1; `rm -f ~/.local/state/gatherd/icloud-sync.stamp` (the unlock command uses --if-due with a 300s minimum, so without this the stamp legitimately no-ops and looks like a failure on a healthy machine), lock the screen and unlock it, then re-run — the stamp file exists again'
    li 'gatherd consumes the tablet-mode mechanism from its own repo rather than owning the scripts: `git -C ~/.local/src/chuwi-minibook-tablet-mode describe --tags` prints the same tag as `grep tablet_mode_upstream_version /usr/local/lib/gatherd/group_vars/all/main.yml`; `command -v minibook-tablet-mode minibook-power-button minibook-hinge-daemon minibook-compositor` all resolve under `~/.local/bin`. The old systemd unit is gone in favor of a udev rule bound to the pinned clone: `systemctl list-unit-files gatherd-hinge-sensor.service` prints nothing (not even "not-found" implies a leftover link — confirm `ls /etc/systemd/system/gatherd-hinge-sensor.service` fails too), and `readlink -f /etc/udev/rules.d/99-minibook-hinge-sensor.rules` resolves to a path under `~/.local/src/chuwi-minibook-tablet-mode/udev/`.'
    li 'Tablet mode disables the built-in keyboard, so run the check below as one pasted sequence. Before starting: the power button sits on an edge of the chassis and stays reachable when folded — press it and pick `Exit tablet mode` from its touch menu if you get stuck. `minibook-tablet-mode status; echo $?` prints `1`. Then paste this whole sequence at once: `minibook-tablet-mode on; swaymsg -t get_outputs | jq -r ".[] | select(.name | test(\"^(eDP|DSI|LVDS)\")) | \"\(.transform) \(.rect.width)x\(.rect.height)\""; swaymsg -t get_inputs | jq -r ".[] | select(.identifier | startswith(\"1:1:\")) | .libinput.send_events"; swaymsg -t get_inputs | jq -r ".[] | select(.type == \"touchpad\") | .libinput.send_events"; minibook-tablet-mode off; swaymsg -t get_inputs | jq -r ".[] | select(.identifier | startswith(\"1:1:\")) | .libinput.send_events"; swaymsg -t get_inputs | jq -r ".[] | select(.type == \"touchpad\") | .libinput.send_events"` prints, in order: a portrait size (`normal 857x1371` on the MiniBook X — NOT `90`, which is upright landscape on a physically rotated panel), then `disabled` (keyboard), then `disabled` (touchpad — the riskier half to get wrong, since it uses no identifier heuristic and is disabled unconditionally), then `enabled` (keyboard), then `enabled` (touchpad). Those last two only show up because of the re-query — `minibook-tablet-mode off` itself prints nothing. Finally, as a separate step: `minibook-tablet-mode on`, touch the screen and confirm the pointer lands under your finger while it is rotated, then press the edge power button and pick `Exit tablet mode`. Then the lockout case, which is the one that actually stranded a human: `minibook-tablet-mode on; rm -f "$XDG_RUNTIME_DIR/minibook-tablet-mode/tablet-mode"` (input still disabled, state file gone) — press the edge power button and confirm you STILL get the tablet menu rather than the stock power menu, pick `Exit tablet mode`, and confirm the keyboard types again. `minibook-tablet-mode off` must never be a no-op. Also confirm no keystroke enters tablet mode: `grep -c "minibook-tablet-mode toggle\|gatherd-music-stand toggle" ~/.config/sway/config.d/default` prints `0` — folding is the only way in, unfolding always the way out, including for a session the hinge daemon did not start. `tail -5 ~/.local/state/minibook-tablet-mode/hinge-daemon.log` shows an `enter`/`exit` line with the theta for each fold you just did.'
    li 'Auto-rotation follows the tablet in the hands while folded, reusing the lid sensor already read for the fold trigger, and its calibration is a config value, not a hardcoded constant: `grep -c rotation_reference_deg ~/.config/minibook-tablet-mode/config` prints `1`. The session already runs the daemon (`gatherd-session-helpers` starts it) — confirm exactly one with `pgrep -a -x python3 | grep -c hinge-daemon` printing `1`, and do NOT start a second: two daemons issue competing transforms and the display visibly twitches. First record the resting transform with `swaymsg -t get_outputs | jq -r ".[] | select(.name | test(\"^(eDP|DSI|LVDS)\")) | .transform"` (this is what exiting must restore below). Then, with the machine folded on the music stand, `minibook-tablet-mode on` and watch with `watch -n0.2 "swaymsg -t get_outputs | jq -r \".[] | select(.name | test(\\\"^(eDP|DSI|LVDS)\\\")) | .transform\""` while turning the folded tablet a quarter turn at a time through all four orientations. Two things must hold, and the second is the one that catches a miscalibrated reference: (a) the printed transform follows within about a second of each turn and holds steady (no flicker) while held still, including flat on a table, where it must not change at all — the daemon samples slowly while nothing moves and snaps to the fast rate on motion, so the FIRST turn after a long rest may take up to an extra idle interval to be noticed while later ones are immediate, and that is working as intended (`grep poll_interval_idle ~/.config/minibook-tablet-mode/config`); and (b) it prints the transform that matches the pose — `normal` when the tablet is held upright in the portrait score-reading position, `90` when held as a landscape laptop screen. Checking only (a) passes a display that tracks your turns perfectly while sitting a quarter turn off, which is exactly the bug the 177.0-vs-267.0 reference produced. Sanity-check against your eyes too: the score reads upright in every one of the four orientations. Then `minibook-tablet-mode off` and re-run the same `swaymsg -t get_outputs | jq -r ...` transform check — it prints the SAME value the very first check above recorded, not whatever orientation the tablet was last turned to.'
    li 'Music stand picks by composer, then score: `gatherd-music-index && cut -f1 ~/.local/state/gatherd/music-index.tsv | sort -u | wc -l` prints a non-zero composer count, and `wc -l < ~/.local/state/gatherd/music-index.tsv` equals `ls ~/Documents/forscore/*.pdf | wc -l`. `gatherd-music-stand on` offers composers, then that composer'"'"'s scores, and opens the pick fullscreen with the screen no longer blanking. The viewer is koreader, chosen because it can turn pages BACKWARDS by touch: tap the left edge and confirm you go back a page, tap elsewhere and you go forward — papers could only ever go forward, which stranded a human mid-piece. Confirm it is running natively rather than through XWayland (`swaymsg -t get_tree | grep -c '"'"'"app_id": "luajit"'"'"'` prints 1 while a score is open; the app_id is the interpreter'"'"'s, not the application'"'"'s) and that one whole page fills the screen at a time. Then `Close score` from the folded menu and confirm no viewer survives (`pgrep -c -x reader.lua` prints 0, and so does `pgrep -c -x koreader`; NOT `pgrep -x luajit`, which matches nothing either way — `luajit` is the window'"'"'s app_id, while the processes are named `koreader` for the wrapper and `reader.lua` for the child that draws) — koreader'"'"'s wrapper does not exec, so the viewer is a child and only a process-group kill takes it down. Check the score fills the screen in BOTH orders, since they take different paths: open a score unfolded and then fold (tablet mode fullscreens what is already there), and separately, while already folded, use `Pick another score` from the power-button menu (the window does not exist yet when tablet mode turns on, so gatherd-music-stand asks for it afterwards via `minibook-tablet-mode fullscreen-viewer`). Unfold and the score goes back to being an ordinary window. Finally, `find ~/Documents/forscore -name '"'"'*.sdr'"'"'` prints nothing: koreader stores per-document state centrally, not beside the scores in the synced library. Folded, the edge power button offers exactly four entries — `Pick another score`, `Close score`, `Auto-rotate: on`, `Cancel` — and NO exit and NO power entry: folding is what starts tablet mode and unfolding is what ends it, so there is nothing to toggle. Check both, WHILE STILL FOLDED: `Close score` closes the PDF viewer (`test -f ~/.local/state/gatherd/music-stand-viewer-pid` exits non-zero afterwards) and leaves you in tablet mode (`minibook-tablet-mode status` still exits 0, and the keyboard is still disabled); tap `Auto-rotate: on` and confirm the entry now reads `Auto-rotate: off` and that turning the tablet no longer turns the display (tap it again to restore); then unfold and confirm tablet mode ends on its own within a second or so. `minibook-tablet-mode rotation-status; echo $?` prints `0` when auto-rotation is on, `1` when off.'
    li 'Vesktop launches with no network of its own, because converge already fetched Vencord for it. Vesktop decides it has a bundle by testing that five paths merely EXIST -- no size, hash or version check (`access(F_OK)` over package.json plus the four asset names, in dist/js/main.js inside /usr/lib/vesktop/app.asar). That cuts both ways, and both halves need checking. FIRST, the pre-fetch, BEFORE ever launching Vesktop on a fresh repave: `ls ~/.config/vesktop/sessionData/vencordFiles | wc -l` prints `11` (ten release assets plus the package.json converge writes), and `for f in Main Preload; do node --check ~/.config/vesktop/sessionData/vencordFiles/vencordDesktop$f.js || echo BAD $f; done` prints nothing. SECOND, that the first launch really does stay off the network -- record `stat -c %Y ~/.config/vesktop/sessionData/vencordFiles/* | md5sum`, launch Vesktop via `vesktop --enable-logging 2>&1 | tee /tmp/vesktop.log`, let it reach the Discord login or app screen, quit, then re-run the same stat|md5sum: the sum is UNCHANGED and `grep -c "Failed to fetch" /tmp/vesktop.log` prints `0`. Nothing was downloaded, which is the whole point -- this must hold on a link too slow to have fetched it. THIRD, the repair, since a present-but-truncated file still "exists" and so Vesktop re-require()s it forever rather than healing itself -- that is what left three weeks of blank Vesktop windows. `truncate -s 8000 ~/.config/vesktop/sessionData/vencordFiles/vencordDesktopMain.js` then `sudo rm -f /etc/gatherd/core-complete && sudo systemctl start gatherd.service && ls ~/.config/vesktop/sessionData/vencordFiles` fails with `No such file or directory`; a following `sudo rm -f /etc/gatherd/async-complete && sudo systemctl start gatherd-async.service` puts all 11 files back. FOURTH, the half that a fetch-every-time or delete-every-time implementation would silently fail: with that intact bundle in place, run BOTH tiers again and confirm `stat -c %Y ...| md5sum` is unchanged -- an intact bundle must survive converge untouched, or every boot re-downloads ~700KB. Note the parse check covers only the two files node itself loads; vencordDesktopRenderer.js is browser code node never parses, and --checking it could reject a healthy bundle into a re-download loop. If the fetch cannot complete, converge must leave NOTHING rather than a partial: unplug the network mid-converge and confirm the directory is absent afterwards and the converge still finished (`head -1 /etc/gatherd/last-run` prints `ok`).'
    li 'Tailscale stays silent once you are on the tailnet, in the notes and at login both: `tailscale status --json | grep BackendState` prints `Running`; then `gatherd-post-setup-notes && grep -c "^# Tailscale" ~/.config/gatherd-post-setup.md` prints `0` — an empty header was the bug, so the section must be pruned rather than rendered blank; and `time gatherd-prompt-tailscale` exits 0 in well under a second WITHOUT opening a browser tab. That login half only misbehaves in the first ~5s after sway starts, while tailscaled still has no address, so also confirm no admin tab appears on the next real login. On a fresh repave, before the tailnet login, the section instead carries the connect reminder.'
    li 'Shutdown does not stall on the NFS umount helper. `systemctl show autofs.service -p KillMode -p TimeoutStopUSec` prints `KillMode=mixed` and `TimeoutStopUSec=3s`. Then, after a reboot: `journalctl -b -1 --no-pager | grep -c "autofs.service: Unit process"` prints `0` (no orphaned helper escaped the cgroup — an orphan here is what used to cost two minutes), and `journalctl -b -1 -o short-unix --no-pager | awk "/Stopping Automounts/{s=\$1} /autofs.service: (Deactivated successfully|Failed with result)/{printf \"%.2f\\n\", \$1-s; exit}"` prints a number at or under about `3.2`. NOTE: `autofs.service: Failed with result (timeout)` in that boot is EXPECTED, not a symptom — umount.nfs4 wedges returning NFSv4 delegations on every shutdown, so the cgroup never empties and systemd always has to SIGKILL it; the timeout is the bound we chose. Shutdown as a whole should feel like well under 10s from pressing reboot to POST.'
    li 'Every web app carries 1Password, sideloaded because Helium cannot reach the Web Store at all. `ls ~/.local/share/ice/extensions/1password/manifest.json` exists, and the unpacked copy kept its OFFICIAL id rather than a path-derived one -- `python3 -c "import json,hashlib,base64,os; k=base64.b64decode(json.load(open(os.path.expanduser(\"~/.local/share/ice/extensions/1password/manifest.json\")))[\"key\"]); print(\"\".join(chr(ord(\"a\")+int(c,16)) for c in hashlib.sha256(k).hexdigest()[:32]))"` prints `aeblfdkhhhdcdjpifhhbdiojplfjncoa`. That pinning IS the mechanism, not a detail: 1Password'"'"'s native-messaging host answers only a fixed allowlist of extension ids, so a path-derived id would be refused and the extension would fall back to asking you to sign in to an account. `grep -c load-extension ~/.local/share/applications/WebApp-ChatGPT.desktop` prints `1`. Then open any web app from the launcher and `pgrep -af 1Password-BrowserSupport | grep -c aeblfdkhhhdcdjpifhhbdiojplfjncoa` prints `1` -- it reached the desktop app, so the vault is there without a per-profile sign-in. The fetcher fails closed, and that must be checked rather than assumed: `/usr/local/lib/gatherd/scripts/gatherd-fetch-browser-extension /tmp/nope aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa; echo $?` prints a non-zero status and leaves no /tmp/nope behind. EXPECTED, not a bug: the first time you open each web app, 1Password shows a welcome page once. Measured as once per profile, not per launch, and it does not stop the extension working.'
    li 'Duolingo runs on Waterfox because its speaking exercises cannot work in Helium (dead speech endpoint, dummy API key) and cannot work in Arch chromium either (Google answers 403 for the distro key). `pacman -Q waterfox-bin` prints a version and `grep -c waterfox-bin /etc/1password/custom_allowed_browsers` prints `1` -- the name checked is the binary the launcher execs, and "waterfox" alone gets UnknownBrowser. `grep -c '"'"'^user_pref("general.useragent.override"'"'"' ~/.local/share/ice/waterfox-profiles/Duolingo/user.js` prints `1` (Duolingo offers speaking only to a UA that parses as Chrome; there is no feature detection behind it) and `grep -c ExtensionStorageIDB ~/.local/share/ice/waterfox-profiles/Duolingo/user.js` prints `1` (what keeps the add-on settings in a seedable JSON file). `python3 -c "import json,os; d=json.load(open(os.path.expanduser(\"~/.local/share/ice/waterfox-profiles/Duolingo/browser-extension-data/@firefox-speech-polyfill/storage.js\")))[\"settings\"][\"defaults\"]; print(d[\"provider\"], d[\"voskModel\"], d[\"language\"])"` prints `vosk vosk-model-small-de-0.15 de` -- voskModel is the one that picks the recognizer; setting only the language leaves an English recognizer transcribing German, which looks exactly like a broken model. `ls ~/.local/share/ice/waterfox-profiles/Duolingo/extensions/ | wc -l` prints `2` (speech polyfill + 1Password) and `test -f ~/.waterfox/native-messaging-hosts/com.1password.1password.json` succeeds. The ~44MB recognizer came down at converge time, not mid-lesson: `test -f ~/.local/share/ice/waterfox-profiles/Duolingo/.gatherd-model-warmed` succeeds and `du -sm ~/.local/share/ice/waterfox-profiles/Duolingo/storage/default | cut -f1` prints 40 or more. Only the app is in the launcher: `grep -c NoDisplay=true ~/.local/share/applications/waterfox.desktop` prints `1`. Then open Duolingo from the launcher: `swaymsg -t get_tree | grep -c '"'"'"app_id": "WebApp-Duolingo"'"'"'` prints `1` -- that is MOZ_APP_REMOTINGNAME doing its job, since --class is X11-only and would leave it reporting `waterfox`, and StartupWMClass would never match. The window has no tab strip, no address bar and no left sidebar. Finally the part only you can judge, and the whole reason any of this exists: do a German speaking exercise and it accepts your speech, offline, with no audio leaving the machine. 1Password shows your vault in the same window without asking you to sign in. If it hears you but drops the last word of a phrase, that is the add-on'"'"'s 1000ms Silence Timeout rather than the model -- raise Silence Timeout and Grace window in its options.'
}

