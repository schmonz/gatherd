#!/bin/sh
# Manages ~/.config/gatherd-post-setup.md, a file you edit freely: add notes
# anywhere, tick an item off by deleting it. Runs at every login, from
# gatherd-prompt-postsetup.
#
# It never edits that file in place. Each run renders what the machine needs
# into a file of its own, then three-way merges: your file, the render from the
# last run (the base), and this run's. Your additions and deletions are changes
# against the base, so they stand; the script's are changes too, so a step that
# is done disappears and a new one arrives. Earlier versions instead edited the
# file and guessed which lines were theirs from their text, and every guess had
# a way to take a note of yours with it -- the last one, a WiFi section that
# filed notes at the top under its own header and then wiped it, took a set of
# notes for good.
#
# Every run is committed to a git repository beside the base, your file before
# the merge as well as after it, so any rewrite can be undone:
#   git -C ~/.local/state/gatherd/post-setup-history log -p

# shellcheck disable=SC2016
# The li/section strings deliberately hold literal `backtick` and $(...) command
# text for the reader to paste into their own shell — it is documentation, never
# meant to expand here.

OUTPUT="$HOME/.config/gatherd-post-setup.md"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

h()  { printf '\n# %s\n'  "$1" >> "$OUTPUT"; }

# Render one bullet wrapped to fit an 80-column editor: the first line gets the
# "- " marker, continuation lines a 2-space hanging indent. fold -s breaks only
# at spaces; trailing whitespace is trimmed so the rendering is deterministic,
# which the merge needs: a bullet that renders differently is a changed line.
wrap_bullet() {
    printf '%s\n' "$1" | fold -s -w 78 | sed 's/[[:space:]]*$//' | awk '
        NR == 1 { print "- " $0; next }
                { print "  " $0 }'
}

li() { wrap_bullet "$1" >> "$OUTPUT"; }

section_present() { grep -q "^# $1\$" "$OUTPUT" 2>/dev/null; }

# Add one bullet under a section, starting the section if this run has not.
# Bullets for one section are rendered together, so the end of the render is
# always the end of that section.
add_bullet() {
    section_present "$1" || h "$1"
    li "$2"
}

# Every check, every run. Ticking one off is deleting it from your file, and
# the merge keeps that deletion for as long as the check reads the same; a
# reworded check is a new line, so it comes back, which is what you want for a
# check you have not run in that form.
verify_li() {
    _nverify=$((_nverify + 1))
    li "$1"
    # The upgrade from the seen-list: a check it offered and you deleted is
    # ticked off, so it belongs in the first base (see migrate_base).
    if [ -n "$_seen_render" ]; then
        _vid=$(printf '%s' "$1" | sha256sum | cut -c1-16)
        grep -qxF -- "$_vid" "$VERIFY_SEEN" && wrap_bullet "$1" >> "$_seen_render"
    fi
    return 0
}

collapse_blanks() {
    awk 'prev_blank && /^$/ { next } { prev_blank=(/^$/); print }' \
        "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# ---------------------------------------------------------------------------
# App state detection
# ---------------------------------------------------------------------------

# The SSH-agent socket appears only once "Use the SSH agent" is enabled — the
# last 1Password setup step, so a good proxy for the whole section being done.
onepassword_ssh_agent_ok() { [ -S "$HOME/.1password/agent.sock" ]; }

tailscale_connected() { tailscale ip >/dev/null 2>&1; }

# Sentinels rather than a live probe: this script runs at every login, and
# `rclone listremotes` now shells out to op for the config password, which
# blocks on a locked 1Password. Both files are written by gatherd-icloud-config
# and gatherd-icloud-sync.
_icloud_state="$HOME/.local/state/gatherd"
icloud_fleet_ok()    { [ -f "$_icloud_state/icloud-fleet-ok" ]; }
icloud_needs_reauth() { [ -f "$_icloud_state/icloud-needs-reauth" ]; }
icloud_plaintext_config() { [ -f "$_icloud_state/icloud-plaintext-config" ]; }
icloud_config_on_disk() { [ -s "${RCLONE_CONFIG:-$HOME/.config/rclone/rclone.conf}" ]; }

# A web app's login is a cookie in its own browser profile, so these ask the
# cookie jar rather than keeping a sentinel: nothing gatherd runs is in the loop
# when a human signs in, and the browser is the only thing that knows.
#
# Both read a COPY. The file belongs to a running browser, which holds a lock
# sqlite will not read through, and ?immutable=1 reads the main file only --
# missing exactly the fresh login, which is still in the journal beside it.
#
# Expiry, not just presence: a signed-out browser can leave the name behind.
# The units differ and both are measured here -- Firefox stores milliseconds
# (Duolingo's jwt_token read 1821046783824), Chromium microseconds since 1601
# (iCloud's X-APPLE-WEBAUTH-TOKEN read 13436576766233114, about 30 days out).
_cookie_live() {
    command -v sqlite3 >/dev/null 2>&1 || return 1
    _db=$1 _query=$2
    [ -f "$_db" ] || return 1
    _tmp=$(mktemp -d) || return 1
    cp "$_db" "$_tmp/db" 2>/dev/null || { rm -rf "$_tmp"; return 1; }
    for _sfx in -journal -wal -shm; do
        if [ -f "$_db$_sfx" ]; then cp "$_db$_sfx" "$_tmp/db$_sfx"; fi
    done
    _n=$(sqlite3 "$_tmp/db" "$_query" 2>/dev/null)
    rm -rf "$_tmp"
    [ "${_n:-0}" -gt 0 ] 2>/dev/null
}

_web_app_profiles="$HOME/.local/share/ice"

duolingo_logged_in() {
    _cookie_live "$_web_app_profiles/waterfox-profiles/Duolingo/cookies.sqlite" \
        "select count(*) from moz_cookies where host = '.duolingo.com'
           and name = 'jwt_token' and expiry / 1000 > cast(strftime('%s', 'now') as integer);"
}

icloud_web_logged_in() {
    _cookie_live "$_web_app_profiles/profiles/iCloud/Default/Cookies" \
        "select count(*) from cookies where host_key = '.icloud.com'
           and name = 'X-APPLE-WEBAUTH-TOKEN'
           and expires_utc / 1000000 - 11644473600 > cast(strftime('%s', 'now') as integer);"
}

# `claude auth status` prints JSON and does not prompt: measured at 0.3s on a
# signed-in machine, which is cheap enough for a script that runs at every
# login. The exit status is 0 either way, so the field is what answers.
claude_code_logged_in() {
    command -v claude >/dev/null 2>&1 || return 1
    claude auth status 2>/dev/null | grep -q '"loggedIn"[[:space:]]*:[[:space:]]*true'
}

# The desktop app is Electron and keeps its session where Chromium would: a
# sessionKey cookie for claude.ai in its own profile, measured at a month out.
# Its config.json holds an oauth token cache too, but that file also carries
# keys written before any sign-in, so the cookie is the narrower question.
claude_desktop_logged_in() {
    _cookie_live "$HOME/.config/Claude/Cookies" \
        "select count(*) from cookies where host_key = '.claude.ai'
           and name = 'sessionKey'
           and expires_utc / 1000000 - 11644473600 > cast(strftime('%s', 'now') as integer);"
}

# ---------------------------------------------------------------------------
# Section handlers
# Each renders what is still to do, into an empty file; the merge does the rest.
# ---------------------------------------------------------------------------

section_1password() {
    set -- \
        'Sign in to 1Password' \
        'Lock, unlock, enter 2FA code' \
        'Settings → Developer: enable "Connect with 1Password CLI" and "Use the SSH agent"'
    onepassword_ssh_agent_ok && return
    h '1Password'
    for b in "$@"; do li "$b"; done
}

section_tailscale() {
    set -- \
        'Connect during this session before rebooting. Set up 1Password (including its browser extension) first — then Tailscale offers to log you in via Apple SSO and 1Password fills it correctly.'
    tailscale_connected && return
    h 'Tailscale'
    for b in "$@"; do li "$b"; done
}

section_other_logins() {
    # Every login a human still has to perform by hand, each pruned by asking
    # whether it has happened -- a bullet nobody can tick off is a nag, which is
    # why Zoom and JetBrains stay out: nothing here can tell whether they are
    # signed in. PIA needs nothing either: it logs in automatically from
    # 1Password via gatherd-prompt-pia at every login.
    #
    # Re-auth is periodic and unavoidable — the session token expires whatever
    # we do — so its bullet appears whenever a sync hits an auth error and goes
    # once sync, or gatherd-icloud-config, next reaches iCloud.
    # Lead with pull, not bootstrap. This bullet shows whenever icloud-fleet-ok
    # is missing, and this script cannot tell "no fleet config exists" from "this
    # machine has not fetched it yet" without calling op, which blocks on a locked
    # 1Password. The second is by far the common case -- gatherd-prompt-icloud
    # gives up quietly if 1Password stays locked past its deadline -- and the old
    # wording sent a second machine through `rclone config` and a fresh 2FA.
    # pull itself says when bootstrap is the right step.
    b_bootstrap='iCloud: run `gatherd-icloud-config pull`, then `gatherd-icloud-config status` should read `encrypted, verified`. If pull says there is no fleet config yet with 1Password unlocked, this is the first machine: `rclone config` + 2FA, then `gatherd-icloud-config bootstrap`'
    # reconnect publishes as well as re-authenticating: the fleet copy is usually
    # just as dead, and until this machine pushes the repair no other machine
    # has one to pick up.
    b_reauth='iCloud needs re-authentication: run `gatherd-icloud-config reconnect` and complete 2FA'
    b_plaintext='iCloud config is plaintext (a live iCloud token sits unencrypted on disk): run `rclone config encryption set`'

    # At most one of pull and reconnect, never both. With a config on disk that
    # sync could not reach, reconnect is the step that covers both cases: it
    # installs the fleet copy when another machine already repaired it, and
    # re-authenticates otherwise. Pull cannot produce the `verified` its bullet
    # promises there if the fleet is dead too. With no config on disk, the reauth
    # sentinel is only sync failing its probe for want of one, and there is no
    # remote to reconnect. The sentinel cannot tell an expired token from being
    # offline, so an offline machine is told to reconnect until sync next works.
    _icloud_reauth=no
    icloud_needs_reauth && icloud_config_on_disk && _icloud_reauth=yes

    if ! icloud_config_on_disk || { ! icloud_fleet_ok && [ "$_icloud_reauth" = no ]; }; then
        add_bullet 'Other Logins' "$b_bootstrap"
    fi

    # Ahead of reconnect: push refuses a plaintext config, so encryption is the
    # step that has to come first when both are due.
    if icloud_plaintext_config; then
        add_bullet 'Other Logins' "$b_plaintext"
    fi

    if [ "$_icloud_reauth" = yes ]; then
        add_bullet 'Other Logins' "$b_reauth"
    fi

    # Ctrl+R is not a flourish: Waterfox starts extensions only after the window
    # has opened, so the page the launcher passes on the command line loads
    # before 1Password is running and never gets it. A reload is what attaches
    # it, and Duolingo is a single-page app that never reloads itself.
    b_duolingo='Duolingo: open it, press Ctrl+R (1Password only attaches to a page loaded after the browser has started), then sign in'
    duolingo_logged_in || add_bullet 'Other Logins' "$b_duolingo"

    # One sign-in for the four of them: they share a Helium profile (see
    # web_apps in group_vars), so any one will do -- Notes because it is the
    # quickest to confirm.
    b_icloud_web='iCloud web apps: open Notes and sign in; Find My, Reminders and iCloud Drive share that sign-in'
    icloud_web_logged_in || add_bullet 'Other Logins' "$b_icloud_web"

    # Two sign-ins, not one: Claude Code's authentication docs state that the
    # desktop app authenticates separately, and nothing documents sharing a
    # session between them.
    b_claude_code='Claude Code: run `claude auth login`'
    claude_code_logged_in || add_bullet 'Other Logins' "$b_claude_code"

    b_claude_desktop='Claude Desktop: open it from the app menu and sign in (a separate sign-in from Claude Code)'
    claude_desktop_logged_in || add_bullet 'Other Logins' "$b_claude_desktop"
}

section_unmanaged_wifi() {
    # Derived from current NM state vs the Ansible manifest, every run, so newly
    # joined networks surface promptly and forgotten ones go.
    _wifi_list="${GATHERD_MANAGED_WIFI_LIST:-/etc/gatherd/managed-wifi.list}"
    [ -r "$_wifi_list" ] || return

    saved=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1 }' \
        | sort -u)
    # Suppress both the Ansible-managed networks and any you've durably dismissed
    # in the local ack file. The ack file is per-machine and intentionally not
    # carried across a repave — a fresh machine re-surfaces every unmanaged net.
    _exclude=$(mktemp)
    cat "$_wifi_list" > "$_exclude"
    _ack="$HOME/.config/gatherd/wifi-ignore.list"
    [ -r "$_ack" ] && cat "$_ack" >> "$_exclude"
    unmanaged=$(printf '%s\n' "$saved" | grep -vxFf "$_exclude" || true)
    rm -f "$_exclude"
    [ -n "$unmanaged" ] || return

    h 'Unmanaged WiFi'
    li 'Either keep in Ansible (vault/vault.yml) or append to ~/.config/gatherd/wifi-ignore.list:'
    printf '%s\n' "$unmanaged" | while IFS= read -r ssid; do
        [ -n "$ssid" ] && printf '  - %s\n' "$ssid" >> "$OUTPUT"
    done
}

section_sonames() {
    # What gatherd built, and whether the loader can start it. Recomputed from
    # live state at every login, because the defect it catches arrives without
    # any edit to this repo: an AUR package under-declares what upstream links
    # against, upstream changes what it links against, and a program that
    # worked yesterday stops opening its window.
    #
    # A verify_li step cannot hold this. A verify step is a manual acceptance
    # check for a newly intended behaviour and is DELETED once exercised
    # (CLAUDE.md, Repave cadence), so after the next repave nothing would
    # invoke gatherd-assert-sonames at all.
    #
    # Nor a task in site-async.yml: that play writes async-complete only when
    # no tier failed, and gatherd-await-and-run gates the whole REST run on
    # that sentinel, so one unresolved soname would re-run every REST tier on
    # every boot, forever, over a tray icon.
    #
    _mark='gatherd built '

    # REST is what builds the packages this asks about, so before it has
    # converged there is nothing to ask -- and gatherd-assert-sonames would
    # exit 2 saying [gatherd-aur] has no sync database, at every login of a
    # first pave. Existence rather than freshness (which is what
    # gatherd-show-slow-progress needs): the question is what this machine can
    # load, not whether the repo has moved on since it converged.
    #
    # What this actually asks is "has REST ever converged here", and that is
    # weaker than it looks. site-async.yml's "Mark slow setup complete" writes
    # the sentinel `when: gatherd_failed_tiers | default([]) | length == 0`, so
    # a FIRST pave whose tiers failed has no sentinel and skips this section --
    # the case the guard is for, since gatherd-assert-sonames would exit 2 with
    # no [gatherd-aur] database to read.
    #
    # It does not extend to a converged machine. Nothing anywhere removes the
    # sentinel: `grep -rn async-complete` over this tree finds that one copy
    # task and no remover outside test sandboxes and docs, and the verify step
    # below tells the human to
    # `sudo rm -f` it by hand precisely because there is no other way to get a
    # failed run reproduced. So after a later HEAD whose REST tiers failed, the
    # stale sentinel is still there and this section renders as usual.
    #
    # That is the right outcome rather than a hole to plug. Those packages are
    # installed and the question of whether they load is a real one, and the
    # failed run is being reported far more loudly elsewhere:
    # gatherd-async.service is `failed`, which gatherd-show-slow-progress
    # reports at login, and its journal names the tiers.
    _sentinel="${GATHERD_ASYNC_SENTINEL:-/etc/gatherd/async-complete}"
    [ -f "$_sentinel" ] || return

    _tsv=$(mktemp)
    _why=$(mktemp)
    "${GATHERD_HOME:-/usr/local/lib/gatherd}/scripts/gatherd-assert-sonames" --tsv \
        > "$_tsv" 2> "$_why"
    _rc=$?

    set --
    if [ "$_rc" -eq 1 ]; then
        while IFS="$(printf '\t')" read -r _pkg _exe _soname; do
            [ -n "$_soname" ] || continue
            set -- "$@" "$_mark$_pkg, and $_exe cannot load $_soname. Find the\
 provider -- \`sudo pacman -Fy\` once, then \`pacman -F $_soname\` -- and declare\
 it in the *_packages var for a tier that converges BEFORE that build."
        done < "$_tsv"
    elif [ "$_rc" -ne 0 ]; then
        # Exit 2 is not exit 0. A check that could not look at the machine has
        # not said the machine is fine, and saying nothing here would be the
        # silent skip gatherd-assert-sonames refuses to make about itself.
        # A reason is not guaranteed: exit 2 with nothing on stderr would
        # otherwise leave the bullet reading "... nothing has checked: ." The
        # script that produces it always says why, so this is the belt to that
        # brace rather than an observed state.
        _why1=$(head -1 "$_why")
        set -- "${_mark}packages nothing has checked: ${_why1:-the check gave no\
 reason}. Until that is fixed, nothing here says this machine can start what it\
 installed."
    fi
    rm -f "$_tsv" "$_why"

    [ "$#" -gt 0 ] || return
    h 'Libraries'
    for _b in "$@"; do li "$_b"; done
}

section_strays() {
    # Packages this machine has and nothing accounts for. Recomputed at every
    # login for the same reason section_sonames is: the defect arrives without
    # any edit to this repo. An electron version bumps in an AUR PKGBUILD, the
    # repo follows it, and the superseded one stays installed -- explicitly, so
    # no orphan sweep reaches it.
    #
    # Not a verify_li step: those are deleted once exercised (CLAUDE.md, Repave
    # cadence), so after the next repave nothing would invoke the check at all.
    # Not a task in site-async.yml either: async-complete is written only when
    # no tier failed and gatherd-await-and-run gates REST on that sentinel, so
    # one stray package would re-run every REST tier on every boot, forever.
    _mark='gatherd does not account for '

    # No async-complete guard, unlike section_sonames. postinstall clones the
    # whole checkout before Ansible first runs, so the check can answer from
    # the first login, and before REST converges the machine holds only base
    # and bootstrap packages, which it accounts for. A guard would only hide it
    # on a machine whose REST has never fully converged.

    _tsv=$(mktemp)
    _why=$(mktemp)
    "${GATHERD_HOME:-/usr/local/lib/gatherd}/scripts/gatherd-assert-packages-declared" \
        --tsv > "$_tsv" 2> "$_why"
    _rc=$?

    set --
    if [ "$_rc" -eq 1 ] && [ -s "$_tsv" ]; then
        while read -r _pkg; do
            [ -n "$_pkg" ] || continue
            # Never one blanket command. --asdeps orphans what only a hook or
            # script uses (rate-mirrors, here), and -Rs refuses what a package
            # still requires (the electron that prompted this).
            set -- "$@" "$_mark$_pkg. If anything uses it -- a hook, a script,\
 you -- declare it in the *_packages var for the tier that needs it. If not:\
 \`sudo pacman -Rs $_pkg\`, or \`sudo pacman -D --asdeps $_pkg\` when\
 \`pacman -Qi $_pkg\` lists something under Required By."
        done < "$_tsv"
    elif [ "$_rc" -ne 0 ]; then
        # Exit 2 is not exit 0, the same argument section_sonames makes. Nor is
        # exit 1 with no names: that is a crash, not a finding.
        # The reason is the "cannot run:" line, wherever a warning put it; a
        # crash's is its last line, not its "Traceback" header.
        _why1=$(sed -n 's/^cannot run: //p' "$_why" | head -n 1)
        [ -n "$_why1" ] || _why1=$(tail -n 1 "$_why")
        set -- "${_mark}this machine's packages until its check can run:\
 ${_why1:-it gave no reason}."
    fi
    rm -f "$_tsv" "$_why"

    [ "$#" -gt 0 ] || return
    h 'Packages'
    for _b in "$@"; do li "$_b"; done
}

section_vault() {
    # Ask gatherd-vault-pass-needed rather than watching for vault-complete. The
    # sentinel says the vault PLAY has converged, which is minutes later and a
    # different question: between a correct password being stored and the play
    # finishing, the section stood there telling you to enter a password you had
    # already entered. The predicate is the same one both prompts use, and a
    # stored password is only ever one that decrypted the vault (see
    # gatherd-await-and-run), so its absence is exactly "a human still has to type
    # something".
    b_enter='Enter password when prompted'

    # Overridable only so the branch can be exercised against a sandbox in tests
    # (the same reason gatherd-vault-pass-needed itself takes GATHERD_HOME).
    if "${GATHERD_HOME:-/usr/local/lib/gatherd}/scripts/gatherd-vault-pass-needed"; then
        add_bullet 'Vault' "$b_enter"
    fi
}

section_verify() {
    # Never auto-done: you tick items off by deleting them, and the merge keeps
    # them deleted.
    h 'Verify'
    verify_li 'IR remote (machines with an IR receiver only): `ir-keytable -t -s rc0` prints a scancode and keycode for each button press.'
    verify_li 'The greeter is off the network. Boot with the network DISCONNECTED: the greeter comes up with no ~60s wait-online stall, and the first session has fonts, keybindings, wallpaper and keyring.'
    verify_li 'AUR packages build unprivileged and install from the local repo, with no sudoers grant issued at any point: `sudo grep -c '"'"'NOPASSWD: /usr/bin/pacman'"'"' /etc/sudoers` prints `0` and `sudo grep -rl NOPASSWD /etc/sudoers.d | wc -l` prints `2` -- during a build, and after killing a converge mid-build. Nothing reached the machine outside the repo: `comm -13 <(pacman -Slq gatherd-aur | sort) <(pacman -Qmq | sort)` prints aurutils and nothing else.'
    verify_li 'GRUB shows the wallpaper at boot, and on the MiniBook X'"'"'s rotated panel the art reads upright (the menu text stays sideways; GRUB cannot fix that).'
    verify_li 'iCloud syncs on unlock: `rm -f ~/.local/state/gatherd/icloud-sync.stamp` (the trigger is --if-due with a 300s floor), lock the screen, unlock, and the stamp is back.'
    verify_li 'Tablet mode comes from chuwi-minibook-tablet-mode rather than gatherd: `git -C ~/.local/src/chuwi-minibook-tablet-mode describe --tags` matches `tablet_mode_upstream_version`, and `command -v minibook-tablet-mode` resolves under `~/.local/bin`.'
    verify_li 'CORE creates `~/.config/minibook-tablet-mode/` itself, before the clone that owns it exists. `rm -rf ~/.config/minibook-tablet-mode ~/.local/src/chuwi-minibook-tablet-mode && sudo rm -f /etc/gatherd/core-complete && sudo systemctl start gatherd.service`, then `last-run` reads `ok` and the config and menu are there with no clone.'
    verify_li 'Fold the machine: it turns portrait, keyboard and touchpad go dead, touch lands under your finger. Unfold: everything comes back. No keystroke enters tablet mode. The edge power button always offers `Exit tablet mode` -- including after `rm -f "$XDG_RUNTIME_DIR/minibook-tablet-mode/tablet-mode"`, which is what once stranded a human.'
    verify_li 'Folded, turning the tablet rotates the display to match within about a second and holds steady when still; the score reads upright in all four orientations. `minibook-tablet-mode off` restores the transform it started at.'
    verify_li 'Music stand: `gatherd-music-stand on` picks composer then score and opens it fullscreen in koreader, screen no longer blanking; a left-edge tap goes BACK a page. `Close score` from the folded menu leaves no viewer running. Check the score fills the screen both when you fold with it already open and when you pick one while folded.'
    verify_li 'Vesktop reaches Discord without downloading Vencord, on a link too slow to have fetched it. `truncate -s 8000 ~/.config/vesktop/sessionData/vencordFiles/vencordDesktopMain.js`, then a converge puts all 11 files back; an intact bundle survives a converge untouched.'
    verify_li 'A repave leaves no `~/Waterfox`: `ls -d ~/Waterfox` fails once REST has finished, and again after `gtk-launch WebApp-Duolingo`, whose first window has no "Open previous tabs?" bar and whose login 1Password still fills.'
    verify_li 'Shutdown does not stall on the NFS umount helper: reboot to POST is well under 10s. `autofs.service: Failed with result (timeout)` in `journalctl -b -1` is EXPECTED -- umount.nfs4 always has to be killed.'
    verify_li 'Duolingo speaking exercises work: a German exercise accepts your voice, recognized locally so no audio leaves the machine, and no microphone prompt appears. The window has one tab, no tab strip or address bar, and 1Password'"'"'s vault without signing in.'
    verify_li 'A converged machine needs neither the network nor the pacman lock to stay converged: with `sudo touch /var/lib/pacman/db.lck` held, a converge is still green. `sudo rm -f /var/lib/pacman/db.lck` afterwards.'
    verify_li 'A converge never touches a real Chromium profile: `sudo pacman -S --noconfirm chromium`, `mkdir -p ~/.config/chromium && echo x > ~/.config/chromium/History`, converge, and `History` is still there. `sudo pacman -Rs chromium` afterwards.'
    verify_li 'The ADHD skill loads unasked: `ls ~/.claude/.i-have-adhd-always` exists, and a fresh `claude` session answers `/i-have-adhd` without a marketplace prompt.'
    verify_li 'Sheet music fetches itself: `rm -f ~/.local/state/gatherd/musicscores-fetch.stamp && gatherd-musicscores-fetch && cat ~/.local/state/gatherd/musicscores-fetch.stamp` prints a timestamp (no stamp means no fetch happened, whatever the exit code), and `ls ~/Documents/forscore/*.pdf | wc -l` matches forScore. If the Mac cannot be logged into it says so rather than exiting quietly.'
    verify_li 'One failing tier no longer takes the rest down: `sudo mv /usr/bin/tailscale{,.bak}`, then `sudo rm -f /etc/gatherd/async-complete && sudo systemctl start gatherd-async.service`. Every other tier converges and the run ends `1 REST tier(s) did not converge: tailscale (Set tailscale operator)`, with no `async-complete` written. Restore the binary, start it again, and the sentinel is back.'
    verify_li 'The cohort waits for REST rather than racing it: `~/.local/bin/gatherd-await-async; echo done` returns immediately on this converged machine, and `env GATHERD_ASYNC_SENTINEL=/nonexistent GATHERD_AWAIT_ASYNC_TIMEOUT=5 ~/.local/bin/gatherd-await-async; echo done` takes about 5s and pops a notification saying it gave up. On a fresh pave the Tailscale and 1Password tabs open without logging out and back in.'
    verify_li 'The Package Installation window follows REST, not just the sentinel: once a commit newer than this repave lands and this boot'"'"'s REST run has ended without failing, `sudo git -C /usr/local/lib/gatherd pull`, then log out and in with no reboot: no window opens (`~/.local/bin/gatherd-show-slow-progress --check; echo $?` prints `1`). Reboot and log in straight away: the window is up and ends `Installation complete.`'
    verify_li 'Broadcom 802.11ac WiFi (BCM4360/4352 Macs): `nmcli -t -f TYPE,STATE dev | grep -x wifi:connected` prints a line on the first boot after the repave, and again after a reboot.'
    verify_li 'iCloud: next time the token expires, the notes show only `gatherd-icloud-config reconnect`, and after it `gatherd-icloud-config status` reads `encrypted, verified; fleet: in sync`.'
    verify_li 'The login notes tick themselves off: sign in to Duolingo (Ctrl+R first), Notes, Claude Code and Claude Desktop, then `gatherd-post-setup-notes` leaves no `# Other Logins` section. Opening Reminders needs no second iCloud sign-in.'
    verify_li 'Waybar survives the converge: after media has played in the first session, `coredumpctl list waybar` prints `No coredumps found`.'
    verify_li 'The converge says where its time went: `journalctl -u gatherd-async.service | grep -A12 "TASKS RECAP"` lists the slowest tasks, longest first, with no `Skipping callback plugin` warning anywhere above it.'
    verify_li 'Nothing is unaccounted for: `/usr/local/lib/gatherd/scripts/gatherd-assert-packages-declared; echo $?` prints `0`. Then `sudo pacman -S --asexplicit --noconfirm cowsay`, log out and in: the Packages section names cowsay. `sudo pacman -Rs cowsay`.'
    verify_li 'Helium uses Qt6: quit and relaunch Helium; it comes up dark, and `grep -ls libqt6_shim /proc/[0-9]*/maps` prints at least one path.'
    verify_li 'Mavernix on an opt-in machine: `sudo touch /etc/gatherd/opt-in/mavernix`, `sudo systemctl start gatherd-async.service`; ReGreet offers Mavernix, it logs in (upright and at the Sway scale on the MiniBook X), and sway is still the default.'
    verify_li 'TI-84 backup tools are installed and talk to the calculator: `tiget --help` runs, and with the calculator plugged in, `ti84-fetch-all` in backup-taavi-ti84 fetches without sudo.'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

NOTES=$OUTPUT
HISTORY="${XDG_STATE_HOME:-$HOME/.local/state}/gatherd/post-setup-history"
# Where the version before the merge remembered which checks it had offered.
# Read once, to build the first base, then removed.
VERIFY_SEEN="${XDG_STATE_HOME:-$HOME/.local/state}/gatherd/post-setup-verify-seen"

_work=$(mktemp -d) || exit 1
trap 'rm -rf "$_work"' EXIT

# Pinned so nothing in the user's own git config can stop a commit or hide a
# file from one. Measured: with commit.gpgsign set and no secret key, a commit
# fails with `gpg: skipped "...": No secret key`; and a global ignore listing
# *.md left nothing to commit at all.
hist() {
    git -C "$HISTORY" -c user.name=gatherd -c user.email=gatherd@localhost \
        -c commit.gpgsign=false -c core.hooksPath=/dev/null \
        -c core.excludesFile=/dev/null -c core.attributesFile=/dev/null \
        -c core.autocrlf=false "$@"
}
# Commit what is there of notes.md and base.md. Succeeds only once HEAD holds
# notes.md byte for byte -- read back, so no filter can stand in for it --
# because a rewrite with no snapshot behind it is the one thing not allowed.
hist_commit() {
    for _f in notes.md base.md; do
        [ -f "$HISTORY/$_f" ] || continue
        hist add -f -- "$_f" 2>/dev/null || return 1
    done
    hist diff --cached --quiet 2>/dev/null ||
        hist commit -q -m "$1" >/dev/null 2>&1 || return 1
    hist cat-file blob HEAD:notes.md 2>/dev/null | cmp -s - "$HISTORY/notes.md"
}

# This run's render. Before the lock: a probe that hangs here should cost this
# login, not every login after it.
_nverify=0
_seen_render=
if [ ! -f "$HISTORY/base.md" ] && [ -f "$VERIFY_SEEN" ]; then
    _seen_render="$_work/seen"
    : > "$_seen_render"
fi
OUTPUT="$_work/new"
printf 'Manual steps remaining:\n' > "$OUTPUT"
section_unmanaged_wifi
section_sonames
section_strays
section_verify
section_vault
section_1password
section_tailscale
section_other_logins
collapse_blanks

# A render that came up short (a full /tmp, a broken pipeline) would read as
# every missing line ticked off. Every check renders every run, so count them.
_nverify_rendered=$(awk '/^# /{ on = ($0 == "# Verify") } on && /^- /' "$OUTPUT" | wc -l)
[ "$_nverify_rendered" -ge "${_nverify:-0}" ] && [ "${_nverify:-0}" -gt 0 ] || exit 0

mkdir -p "$HISTORY" "${NOTES%/*}" || exit 1

# One run at a time: two merging against the same base would undo each other.
# A run still holding the lock after 30s is stuck, and this one gives way.
if command -v flock >/dev/null 2>&1; then
    exec 9> "$HISTORY.lock"
    flock -w 30 9 || exit 0
fi

# No notes file yet: the render is the whole of it.
if [ ! -e "$NOTES" ]; then
    cp "$OUTPUT" "$NOTES" || exit 1
    if command -v git >/dev/null 2>&1; then
        [ -d "$HISTORY/.git" ] || git init -q "$HISTORY" >/dev/null 2>&1
        cp "$OUTPUT" "$HISTORY/base.md" && cp "$NOTES" "$HISTORY/notes.md" &&
            hist_commit 'Start the notes file'
    fi
    exit 0
fi

# Without git there is no history, and no rewrite is allowed without one.
command -v git >/dev/null 2>&1 || exit 0
[ -d "$HISTORY/.git" ] || git init -q "$HISTORY" >/dev/null 2>&1 || exit 0
# Under the lock, any git lock file is what a run killed mid-commit left.
find "$HISTORY/.git" -name '*.lock' -type f -exec rm -f {} + 2>/dev/null

# A run stopped between replacing the notes and replacing the base. Its base
# belongs with its notes: keep it only if the notes are what it wrote.
if [ -f "$HISTORY/base.md.new" ]; then
    if [ -f "$HISTORY/pending.md" ] && cmp -s "$NOTES" "$HISTORY/pending.md"; then
        mv "$HISTORY/base.md.new" "$HISTORY/base.md" || exit 0
    else
        rm -f "$HISTORY/base.md.new"
    fi
fi
rm -f "$HISTORY/pending.md"

# What you wrote since the last run, committed before anything here touches it.
cp "$NOTES" "$_work/ours" || exit 1
cp "$_work/ours" "$HISTORY/notes.md" || exit 0
if [ -f "$HISTORY/base.md" ]; then
    cp "$HISTORY/base.md" "$_work/base" || exit 0
fi
hist_commit 'Your edits since the last login' || exit 0

# No base yet: the first run after the merge arrived. The base is what the
# script last wrote, so build the nearest thing to it: every line of this
# render that is already in your file, wherever it is, plus the checks the old
# seen-list says were offered (absent now means ticked off). Anything else this
# render has is new, and arrives.
if [ ! -f "$_work/base" ]; then
    awk '
        FILENAME == ARGV[1] { n[++nn] = $0; next }
        FILENAME == ARGV[2] { mine[$0] = 1; next }
        FILENAME == ARGV[3] { seen[$0] = 1; next }
        END { for (j = 1; j <= nn; j++) if (n[j] in mine || (n[j] in seen && n[j] != "")) print n[j] }
    ' "$OUTPUT" "$_work/ours" "${_seen_render:-/dev/null}" > "$_work/base" || exit 0
fi

# The merge. Matching is by position, through the longest common subsequence,
# never by text alone: a line of yours that reads like one of the script's is
# still yours. Earlier versions of this file guessed ownership from text, and
# every guess had a way to take a note with it.
awk '
    # Fences as CommonMark has them: a run of 3+ backticks or tildes opens, and
    # only a run of the same character at least as long, with nothing after
    # it, closes. Nothing inside one is a header, and nothing inside one can
    # be the script: it never writes a fence.
    function fencerun(s,   c, m) {
        c = substr(s, 1, 1)
        if (c != "`" && c != "~") return ""
        m = match(s, (c == "`") ? "^`+" : "^~+")
        return (RLENGTH >= 3) ? substr(s, 1, RLENGTH) : ""
    }
    # Longest common subsequence of a[1..na] and b[1..nb]; ab[i] = j, ba[j] = i.
    function lcs(a, na, b, nb, ab, ba,    i, j, L) {
        for (i = na + 1; i >= 1; i--) for (j = nb + 1; j >= 1; j--) {
            if (i > na || j > nb) L[i, j] = 0
            else if (a[i] == b[j]) L[i, j] = L[i + 1, j + 1] + 1
            else L[i, j] = (L[i + 1, j] >= L[i, j + 1]) ? L[i + 1, j] : L[i, j + 1]
        }
        i = 1; j = 1
        while (i <= na && j <= nb) {
            if (a[i] == b[j] && L[i, j] == L[i + 1, j + 1] + 1) { ab[i] = j; ba[j] = i; i++; j++ }
            else if (L[i + 1, j] >= L[i, j + 1]) i++
            else j++
        }
    }
    # Where a block that starts a section goes: before the next header of
    # of yours or of the script after k, so it never splits a section.
    function secend(k,   p) {
        for (p = k + 1; p <= no && !hdr[p]; p++) ;
        return p
    }
    FILENAME == ARGV[1] { o[++no] = $0; next }
    FILENAME == ARGV[2] { b[++nb] = $0; next }
    FILENAME == ARGV[3] { n[++nn] = $0; next }
    END {
        open = ""
        for (k = 1; k <= no; k++) {
            r = fencerun(o[k])
            if (open == "") {
                fenced[k] = (r != "")
                if (r != "") open = r
            } else {
                fenced[k] = 1
                if (r != "" && substr(r, 1, 1) == substr(open, 1, 1) && length(r) >= length(open) \
                    && o[k] ~ /^[`~]+[ \t]*$/) open = ""
            }
            hdr[k] = (!fenced[k] && o[k] ~ /^# /)
            oa[k] = fenced[k] ? "\034" k : o[k]
        }
        lcs(b, nb, n, nn, bn, nbk)      # base vs new: what the script kept
        lcs(oa, no, b, nb, ob, bo)      # yours vs base: where lines of the script sit

        # The section each line of the render belongs to.
        h = ""
        for (j = 1; j <= nn; j++) { if (n[j] ~ /^# /) h = n[j]; sec[j] = h; if (n[j] ~ /^# /) secj[h] = j }
        # And of yours, with the first kept copy of each header.
        h = ""
        for (k = 1; k <= no; k++) { if (hdr[k]) h = o[k]; govern[k] = h }

        # A line of yours goes only if the script wrote it (aligned to the
        # base) and no longer renders it.
        changed = 0
        for (k = 1; k <= no; k++) keep[k] = !(ob[k] && !bn[ob[k]])
        # A blank line goes only beside a line that goes: one between two of
        # your paragraphs is yours, whatever the alignment says.
        for (k = 1; k <= no; k++) {
            if (keep[k] || o[k] != "") continue
            for (u = k - 1; u >= 1 && o[u] == ""; u--) ;
            for (d = k + 1; d <= no && o[d] == ""; d++) ;
            if (!((u >= 1 && !keep[u]) || (d <= no && !keep[d]))) keep[k] = 1
        }
        # A header stays while a line of yours is still under it, and so does
        # the blank line that set it apart.
        for (k = 1; k <= no; k++) {
            if (!hdr[k] || keep[k]) continue
            for (m = k + 1; m <= no && !hdr[m]; m++)
                if (!ob[m] && o[m] != "") { keep[k] = 1; break }
            if (keep[k] && k > 1 && o[k - 1] == "" && !keep[k - 1]) keep[k - 1] = 1
        }
        for (k = 1; k <= no; k++) {
            if (!keep[k]) changed = 1
            if (keep[k] && hdr[k] && !(o[k] in khead)) khead[o[k]] = k
        }

        # Lines the script started rendering.
        # A blank line the script adds travels with the next line it adds, so
        # the gap before a new section arrives with the section.
        pend = ""
        for (j = 1; j <= nn; j++) {
            if (nbk[j]) {
                if (pend != "") {
                    for (jj = j - 1; jj >= 1; jj--) if (nbk[jj] && bo[nbk[jj]]) break
                    p = (jj >= 1) ? bo[nbk[jj]] + 1 : 1
                    ins[p] = ins[p] pend; pend = ""
                }
                continue
            }
            changed = 1
            if (n[j] == "") { pend = pend "\n"; continue }
            s = sec[j]
            pos = 0
            for (jj = j - 1; jj >= 1; jj--) if (nbk[jj] && bo[nbk[jj]]) { pos = bo[nbk[jj]]; break }
            if (n[j] ~ /^# /) {
                # A section the script starts, unless you kept its header:
                # then what follows goes under yours, not under a second one.
                if (n[j] in khead) { pend = ""; continue }
                p = secend(pos); hpos[n[j]] = p
            } else if (s == "" || (pos && govern[pos] == s && (s in khead))) {
                # Beside the line it follows, past any lines of yours after
                # that, but not past a header.
                p = pos + 1
                while (p <= no && !ob[p] && !hdr[p]) p++
            } else if (s in khead) {
                # Its section is in your file, but the line it follows is now
                # under another header (yours, say): end of its own section.
                p = secend(khead[s])
                while (p - 1 > khead[s] && o[p - 1] == "") p--
            } else if (s in hpos) {
                p = hpos[s]
            } else {
                # You deleted its header: bring the header back with it.
                p = secend(pos); hpos[s] = p
                ins[p] = ins[p] "\n" s "\n"
            }
            ins[p] = ins[p] pend n[j] "\n"; pend = ""
        }
        if (pend != "") ins[no + 1] = ins[no + 1] pend
        if (!changed) exit 3
        for (p = 1; p <= no + 1; p++) {
            if (p in ins) printf "%s", ins[p]
            if (p <= no && keep[p]) print o[p]
        }
    }
' "$_work/ours" "$_work/base" "$OUTPUT" > "$_work/result"
_rc=$?
if [ "$_rc" -eq 3 ]; then
    cp "$_work/ours" "$_work/result"
elif [ "$_rc" -ne 0 ]; then
    exit 0
elif [ -s "$_work/ours" ] && [ "$(tail -c 1 "$_work/ours" | od -An -c | tr -d ' ')" != '\n' ] &&
     [ "$(tail -n 1 "$_work/result")" = "$(tail -n 1 "$_work/ours")" ]; then
    # Your last line had no newline and is still last: leave it that way.
    _len=$(wc -c < "$_work/result")
    head -c $((_len - 1)) "$_work/result" > "$_work/result.nonl" &&
        mv "$_work/result.nonl" "$_work/result"
fi

# The next base goes in first: if it cannot be written, neither is your file,
# and the next run merges from the same place.
cp "$OUTPUT" "$HISTORY/base.md.new" || exit 0

if [ "$_rc" -ne 3 ]; then
    # Replace the file the path names, so a symlinked notes file stays one.
    # The staging copy starts as a copy of your file, so it keeps its mode.
    _target=$(readlink -f "$NOTES") || exit 0
    _stage=$(mktemp "$_target.XXXXXX") || exit 0
    if ! { cp -p "$_target" "$_stage" && cat "$_work/result" > "$_stage"; }; then
        rm -f "$_stage"; exit 0
    fi
    # Edited while this ran (an editor saving, say): write nothing, keep the
    # old base, and merge at the next login instead.
    if ! cmp -s "$NOTES" "$_work/ours"; then
        rm -f "$_stage" "$HISTORY/base.md.new"; exit 0
    fi
    # What this run is about to write, so a run stopped after the next line
    # can tell whether its base.md.new belongs with the notes (see above).
    cp "$_work/result" "$HISTORY/pending.md" || { rm -f "$_stage" "$HISTORY/base.md.new"; exit 0; }
    mv "$_stage" "$_target" || { rm -f "$_stage" "$HISTORY/base.md.new" "$HISTORY/pending.md"; exit 0; }
fi
mv "$HISTORY/base.md.new" "$HISTORY/base.md" || exit 0
rm -f "$HISTORY/pending.md"
cp "$_work/result" "$HISTORY/notes.md"
hist_commit 'Merge this login'\''s render'
[ -z "$_seen_render" ] || rm -f "$VERIFY_SEEN"
exit 0
