#!/bin/sh
# Manages ~/.config/gatherd-post-setup.md as a living document:
#   - appends sections that are needed but not yet present
#   - when detection says a step is done, removes ONLY the boilerplate lines this
#     script itself generated, leaving anything you added by hand (and dropping a
#     now-empty header). Write freely under any section — your notes are never
#     pruned, with no markers or special formatting to remember.
# Safe to run at any time; gatherd-prompt-postsetup calls it at each login.

OUTPUT="$HOME/.config/gatherd-post-setup.md"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

h()  { printf '\n# %s\n'  "$1" >> "$OUTPUT"; }

# Render one bullet wrapped to fit an 80-column editor: the first line gets the
# "- " marker, continuation lines a 2-space hanging indent. fold -s breaks only
# at spaces; trailing whitespace is trimmed so the rendering is deterministic —
# prune_section re-renders bullets the same way to find and remove them.
wrap_bullet() {
    printf '%s\n' "$1" | fold -s -w 78 | sed 's/[[:space:]]*$//' | awk '
        NR == 1 { print "- " $0; next }
                { print "  " $0 }'
}

li() { wrap_bullet "$1" >> "$OUTPUT"; }

section_present() { grep -q "^# $1\$" "$OUTPUT" 2>/dev/null; }

# Wipe an entire section, header through the next header — blunt, and only safe
# for the fully-derived Unmanaged WiFi list (regenerated each run, never
# hand-edited). For any section you might annotate, use prune_section instead.
section_remove() {
    awk -v hdr="# $1" '
        $0 == hdr { skip=1; next }
        skip && /^# /  { skip=0 }
        !skip { print }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# Remove only the boilerplate bullets this script generated for a section
# (passed as arguments), leaving any lines you added by hand. If nothing of
# yours remains under the header, drop the header too. This is how "done" steps
# get pruned without ever eating your own notes.
prune_section() {
    _name=$1
    shift
    section_present "$_name" || return
    # Re-render each boilerplate bullet exactly as li() wrote it (wrapping and
    # all), separated by a sentinel line, so awk matches and drops the whole
    # possibly-multi-line bullet as a unit while leaving hand-added lines verbatim.
    _own=$(for _b in "$@"; do wrap_bullet "$_b"; printf '@@PRUNE_SEP@@\n'; done)
    PRUNE_OWN="$_own" awk -v hdr="# $_name" '
        BEGIN {
            n = split(ENVIRON["PRUNE_OWN"], L, "\n")
            b = ""
            for (i = 1; i <= n; i++) {
                if (L[i] == "@@PRUNE_SEP@@") { if (b != "") own[b] = 1; b = ""; continue }
                b = (b == "") ? L[i] : b "\n" L[i]
            }
        }
        # A bullet group is a "- " line plus its "  " continuation lines; drop the
        # whole group if it matches a boilerplate bullet, else keep it verbatim.
        function endgrp(   j, m, gl) {
            if (!ingrp) return
            if (!(g in own)) {
                m = split(g, gl, "\n")
                for (j = 1; j <= m; j++) { out[++on] = gl[j]; if (gl[j] != "") nonblank = 1 }
            }
            ingrp = 0; g = ""
        }
        function flush(   j) {
            endgrp()
            if (nonblank) { print hdr; for (j = 1; j <= on; j++) print out[j] }
            on = 0; nonblank = 0
        }
        $0 == hdr      { inseg = 1; on = 0; nonblank = 0; ingrp = 0; g = ""; next }
        inseg && /^# / { flush(); inseg = 0; print; next }
        inseg {
            if ($0 ~ /^- /)          { endgrp(); ingrp = 1; g = $0; next }
            if (ingrp && $0 ~ /^  /) { g = g "\n" $0; next }
            endgrp(); out[++on] = $0; if ($0 != "") nonblank = 1; next
        }
                       { print }
        END            { if (inseg) flush() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

collapse_blanks() {
    awk 'prev_blank && /^$/ { next } { prev_blank=(/^$/); print }' \
        "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# ---------------------------------------------------------------------------
# App state detection
# ---------------------------------------------------------------------------

# The SSH-agent socket appears only once "Use the SSH agent" is enabled — the
# last 1Password setup step, so a good proxy for the whole section being done.
onepassword_ssh_agent_ok() { [ -S "$HOME/.1password/agent.sock" ]; }

tailscale_connected() { tailscale ip >/dev/null 2>&1; }

tailscale_settings_ok() {
    _prefs=$(tailscale debug prefs 2>/dev/null)
    printf '%s' "$_prefs" | grep -qE '"CorpDNS":\s*true' &&
    printf '%s' "$_prefs" | grep -qE '"RouteAll":\s*true'
}

icloud_configured()     { rclone listremotes 2>/dev/null | grep -q '^icloud:'; }

# ---------------------------------------------------------------------------
# Section handlers
# Pattern: if done → prune; else if absent → add; else → leave alone
# ---------------------------------------------------------------------------

section_1password() {
    set -- \
        'Sign in to 1Password' \
        'Lock, unlock, enter 2FA code' \
        'Settings → Developer: enable "Connect with 1Password CLI" and "Use the SSH agent"'
    if onepassword_ssh_agent_ok; then
        prune_section '1Password' "$@"
    else
        section_present '1Password' && return
        h '1Password'
        for b in "$@"; do li "$b"; done
    fi
}

section_tailscale() {
    # Never auto-done: exit node check is always relevant after a repave
    section_present 'Tailscale' && return
    h 'Tailscale'
    tailscale_connected   || li 'Connect during this session before rebooting. Set up 1Password (including its browser extension) first — then Tailscale offers to log you in via Apple SSO and 1Password fills it correctly.'
    tailscale_settings_ok || li 'Run `tailscale set --accept-dns=true --accept-routes`'
}

section_other_logins() {
    # Only iCloud earns a standing reminder here, and it auto-prunes once the
    # rclone remote exists. Claude Desktop/Code, Zoom, and JetBrains are
    # deliberately not surfaced — logging into them is obvious on demand and
    # didn't merit a recurring nag. PIA needs nothing here either: it logs in
    # automatically from 1Password via gatherd-prompt-pia at every login.
    b_icloud='iCloud: run `rclone config` and follow prompts to add a remote named `icloud`; complete 2FA when prompted'

    if icloud_configured; then
        prune_section 'Other Logins' "$b_icloud"
    else
        section_present 'Other Logins' && return
        h 'Other Logins'
        li "$b_icloud"
    fi
}

section_unmanaged_wifi() {
    # Content is purely derived from current NM state vs Ansible manifest;
    # always rewrite from scratch so newly joined networks surface promptly.
    [ -r /etc/gatherd/managed-wifi.list ] || {
        section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
        return
    }

    saved=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1 }' \
        | sort -u)
    # Suppress both the Ansible-managed networks and any you've durably dismissed
    # in the local ack file. The ack file is per-machine and intentionally not
    # carried across a repave — a fresh machine re-surfaces every unmanaged net.
    _exclude=$(mktemp)
    cat /etc/gatherd/managed-wifi.list > "$_exclude"
    _ack="$HOME/.config/gatherd/wifi-ignore.list"
    [ -r "$_ack" ] && cat "$_ack" >> "$_exclude"
    unmanaged=$(printf '%s\n' "$saved" | grep -vxFf "$_exclude" || true)
    rm -f "$_exclude"

    section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
    [ -n "$unmanaged" ] || return

    # Build the block on its own, then splice it just under the top "Manual steps
    # remaining:" line. This section regenerates every run and would otherwise
    # re-append at the bottom, but it belongs above Verify.
    _blk=$(mktemp)
    _main=$OUTPUT
    OUTPUT=$_blk
    h 'Unmanaged WiFi'
    li 'Either keep in Ansible (vault/vault.yml) or append to ~/.config/gatherd/wifi-ignore.list:'
    printf '%s\n' "$unmanaged" | while IFS= read -r ssid; do
        [ -n "$ssid" ] && printf '  - %s\n' "$ssid" >> "$OUTPUT"
    done
    OUTPUT=$_main

    { head -n 1 "$OUTPUT"; cat "$_blk"; tail -n +2 "$OUTPUT"; } \
        > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
    rm -f "$_blk"
}

section_vault() {
    set -- \
        'Enter password when prompted' \
        'Run `journalctl -u gatherd-vault.service` to check progress'
    if [ -f /etc/gatherd/vault-complete ]; then
        prune_section 'Vault' "$@"
    else
        section_present 'Vault' && return
        h 'Vault'
        for b in "$@"; do li "$b"; done
    fi
}

section_verify() {
    # Never auto-done: user manages this section manually
    section_present 'Verify' && return
    h 'Verify'
    li 'Session helper reaping (no stacking across logins): log out and back in, then check the tray — exactly one of each managed icon (1Password, LocalSend, Tailscale, PIA, arch-update), never two. `gatherd-session-helpers` reaps its cohort when sway exits, and as a backstop sweeps any prior-session orphan on startup (any gatherd helper not in the new supervisor'\''s process group) before launching a fresh cohort. So a session whose teardown failed — sway IPC never reached, supervisor killed mid-wait — self-corrects at the next login instead of stacking. To exercise the backstop directly: before logging out, note a cohort PID (`pgrep -f gatherd-conky`); after logging back in, confirm that PID is gone and only one new cohort exists.'
    li 'LocalSend startup flash: log out and back in, watching the screen — no LocalSend window should flash up before it settles into the tray. `gatherd-intercept-localsend-flash` (launched from the supervisor just before localsend) stashes the startup surface to scratchpad until LocalSend withdraws it via `--hidden`. If a brief flash returns, confirm the interceptor is installed and still listed in `gatherd-session-helpers`.'
    li 'Graphical sudo uses fuzzel (not seahorse): confirm `grep '\''^[[:space:]]*Path[[:space:]]*askpass'\'' /etc/sudo.conf` shows exactly one active line, pointing at `/usr/local/bin/gatherd-askpass`, with no `seahorse` line. Then exercise the no-terminal path that actually triggers an askpass helper: from within the sway session run `swaymsg exec '\''sudo -k true'\''` (launched with no controlling tty) and confirm the password prompt that appears is the fuzzel box, not a GTK/seahorse dialog. A terminal `sudo` still reads the tty as usual; this only governs sudo invoked from a launcher or keybinding. `SUDO_ASKPASS` in pam_env covers the common case, but the sudo.conf line is the environment-independent guarantee that overrides any EndeavourOS seahorse default.'
    li 'Graphical ssh uses fuzzel (not seahorse): confirm `grep '\''^SSH_ASKPASS'\'' /etc/security/pam_env.conf` shows `/usr/local/bin/gatherd-askpass`. From the sway session, with a passphrase-protected key not yet in the agent, run `swaymsg exec '\''ssh -T git@github.com'\''` (no controlling tty) and confirm the passphrase prompt is the fuzzel box, not seahorse/GTK. A terminal `ssh` still prompts on the tty — `SSH_ASKPASS_REQUIRE` is intentionally left unset.'
    li 'Shared sudo credential cache: confirm `sudo visudo -cf /etc/sudoers.d/gatherd-sudo-timestamp` reports `parsed OK`. Then `sudo -K`, run one `sudo true` and authenticate, and within 2 minutes run `sudo true` from a *different* terminal (or `swaymsg exec`) — it should NOT re-prompt. After ~2 minutes it should prompt again. timestamp_type=global shares one cache across the user'\''s processes so an agent shelling out repeatedly authenticates once.'
    li 'Zoom screen sharing: try sharing a window — confirm screen sharing works under Sway/wlroots'
    li 'Mirror re-ranking hook: confirm `/etc/pacman.d/hooks/gatherd-rerank-mirrors.hook` is installed. When the `pacman-mirrorlist` package next updates, pacman prints "Re-ranking pacman mirrors with rate-mirrors..." and afterward `head -3 /etc/pacman.d/mirrorlist` shows a fresh rate-mirrors timestamp with no leftover `/etc/pacman.d/mirrorlist.pacnew`. To exercise now without waiting for an update: `sudo /usr/local/lib/gatherd/scripts/gatherd-rerank-mirrors`, then re-check the header timestamp. rate-mirrors pulls the mirror set live, so we never merge the package'\''s stock list — we re-rank ours on the upgrade signal and discard the .pacnew.'
    li 'gatherd-show-slow-progress in a terminal: while gatherd-async is running, open a terminal and run `gatherd-show-slow-progress` — it should tail the log right there, not open a second terminal window. From sway autostart (no TTY) it still opens a new foot window as before.'
    li 'WiFi no-blip on re-run: while connected to a managed WiFi network, trigger a gatherd re-run and confirm the connection stays up throughout — no disconnect, reconnect notification, or IP change. The network task should report `ok`, not `changed`, when the pushed config matches what NetworkManager already has.'
    li 'Early GRUB cmdline pre-seed (first-session usability): zswap is baked into /etc/default/grub by `postinstall` before the first boot, not applied later by gatherd. Confirm live in the running kernel from first boot on a sub-8GB machine: `cat /sys/module/zswap/parameters/enabled` is `Y` and `grep -o zswap.enabled=1 /proc/cmdline` is present.'
    li 'HiDPI scaling (HiDPI-panel machines only): run `swaymsg -t get_outputs | grep scale` — expect `"scale": 2`. Run `grep scale ~/.config/sway/config.d/outputs` — expect `output * scale 2`. Fonts in foot, waybar, and text apps should look appropriately sized for the screen, not enormous.'
    li 'IR receiver (machines with an IR receiver, e.g. T60): run `ls /dev/lirc* /sys/class/rc/rc* 2>/dev/null` — should show at least one device'
    li 'IR receiver: run `ir-keytable` — confirm device listed with a keymap loaded'
    li 'IR receiver: run `ir-keytable -t -s rc0` and press remote buttons — should show scancode + keycode per press'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

[ -f "$OUTPUT" ] || printf 'Manual steps remaining:\n' > "$OUTPUT"

section_unmanaged_wifi
section_verify
section_vault
section_1password
section_tailscale
section_other_logins

collapse_blanks
