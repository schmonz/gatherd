#!/bin/sh
# Manages ~/.config/gatherd-post-setup.md as a living document:
#   - appends sections that are needed but not yet present
#   - when detection says a step is done, removes ONLY the boilerplate lines this
#     script itself generated, leaving anything you added by hand (and dropping a
#     now-empty header). Write freely under any section — your notes are never
#     pruned, with no markers or special formatting to remember.
# Safe to run at any time; gatherd-prompt-postsetup calls it at each login.

OUTPUT="$HOME/.config/gatherd-post-setup.md"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

h()  { printf '\n# %s\n'  "$1" >> "$OUTPUT"; }

# Render one bullet wrapped to fit an 80-column editor: the first line gets the
# "- " marker, continuation lines a 2-space hanging indent. fold -s breaks only
# at spaces; trailing whitespace is trimmed so the rendering is deterministic —
# prune_section re-renders bullets the same way to find and remove them.
wrap_bullet() {
    printf '%s\n' "$1" | fold -s -w 78 | sed 's/[[:space:]]*$//' | awk '
        NR == 1 { print "- " $0; next }
                { print "  " $0 }'
}

li() { wrap_bullet "$1" >> "$OUTPUT"; }

section_present() { grep -q "^# $1\$" "$OUTPUT" 2>/dev/null; }

# Wipe an entire section, header through the next header — blunt, and only safe
# for the fully-derived Unmanaged WiFi list (regenerated each run, never
# hand-edited). For any section you might annotate, use prune_section instead.
section_remove() {
    awk -v hdr="# $1" '
        $0 == hdr { skip=1; next }
        skip && /^# /  { skip=0 }
        !skip { print }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# Remove only the boilerplate bullets this script generated for a section
# (passed as arguments), leaving any lines you added by hand. If nothing of
# yours remains under the header, drop the header too. This is how "done" steps
# get pruned without ever eating your own notes.
prune_section() {
    _name=$1
    shift
    section_present "$_name" || return
    # Re-render each boilerplate bullet exactly as li() wrote it (wrapping and
    # all), separated by a sentinel line, so awk matches and drops the whole
    # possibly-multi-line bullet as a unit while leaving hand-added lines verbatim.
    _own=$(for _b in "$@"; do wrap_bullet "$_b"; printf '@@PRUNE_SEP@@\n'; done)
    PRUNE_OWN="$_own" awk -v hdr="# $_name" '
        BEGIN {
            n = split(ENVIRON["PRUNE_OWN"], L, "\n")
            b = ""
            for (i = 1; i <= n; i++) {
                if (L[i] == "@@PRUNE_SEP@@") { if (b != "") own[b] = 1; b = ""; continue }
                b = (b == "") ? L[i] : b "\n" L[i]
            }
        }
        # A bullet group is a "- " line plus its "  " continuation lines; drop the
        # whole group if it matches a boilerplate bullet, else keep it verbatim.
        function endgrp(   j, m, gl) {
            if (!ingrp) return
            if (!(g in own)) {
                m = split(g, gl, "\n")
                for (j = 1; j <= m; j++) { out[++on] = gl[j]; if (gl[j] != "") nonblank = 1 }
            }
            ingrp = 0; g = ""
        }
        function flush(   j) {
            endgrp()
            if (nonblank) { print hdr; for (j = 1; j <= on; j++) print out[j] }
            on = 0; nonblank = 0
        }
        $0 == hdr      { inseg = 1; on = 0; nonblank = 0; ingrp = 0; g = ""; next }
        inseg && /^# / { flush(); inseg = 0; print; next }
        inseg {
            if ($0 ~ /^- /)          { endgrp(); ingrp = 1; g = $0; next }
            if (ingrp && $0 ~ /^  /) { g = g "\n" $0; next }
            endgrp(); out[++on] = $0; if ($0 != "") nonblank = 1; next
        }
                       { print }
        END            { if (inseg) flush() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

collapse_blanks() {
    awk 'prev_blank && /^$/ { next } { prev_blank=(/^$/); print }' \
        "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# ---------------------------------------------------------------------------
# App state detection
# ---------------------------------------------------------------------------

# The SSH-agent socket appears only once "Use the SSH agent" is enabled — the
# last 1Password setup step, so a good proxy for the whole section being done.
onepassword_ssh_agent_ok() { [ -S "$HOME/.1password/agent.sock" ]; }

tailscale_connected() { tailscale ip >/dev/null 2>&1; }

tailscale_settings_ok() {
    _prefs=$(tailscale debug prefs 2>/dev/null)
    printf '%s' "$_prefs" | grep -qE '"CorpDNS":\s*true' &&
    printf '%s' "$_prefs" | grep -qE '"RouteAll":\s*true'
}

icloud_configured()     { rclone listremotes 2>/dev/null | grep -q '^icloud:'; }

# ---------------------------------------------------------------------------
# Section handlers
# Pattern: if done → prune; else if absent → add; else → leave alone
# ---------------------------------------------------------------------------

section_1password() {
    set -- \
        'Sign in to 1Password' \
        'Lock, unlock, enter 2FA code' \
        'Settings → Developer: enable "Connect with 1Password CLI" and "Use the SSH agent"'
    if onepassword_ssh_agent_ok; then
        prune_section '1Password' "$@"
    else
        section_present '1Password' && return
        h '1Password'
        for b in "$@"; do li "$b"; done
    fi
}

section_tailscale() {
    # Never auto-done: exit node check is always relevant after a repave
    section_present 'Tailscale' && return
    h 'Tailscale'
    tailscale_connected   || li 'Connect during this session before rebooting. Set up 1Password (including its browser extension) first — then Tailscale offers to log you in via Apple SSO and 1Password fills it correctly.'
    tailscale_settings_ok || li 'Run `tailscale set --accept-dns=true --accept-routes`'
}

section_other_logins() {
    # Only iCloud earns a standing reminder here, and it auto-prunes once the
    # rclone remote exists. Claude Desktop/Code, Zoom, and JetBrains are
    # deliberately not surfaced — logging into them is obvious on demand and
    # didn't merit a recurring nag. PIA needs nothing here either: it logs in
    # automatically from 1Password via gatherd-prompt-pia at every login.
    b_icloud='iCloud: run `rclone config` and follow prompts to add a remote named `icloud`; complete 2FA when prompted'

    if icloud_configured; then
        prune_section 'Other Logins' "$b_icloud"
    else
        section_present 'Other Logins' && return
        h 'Other Logins'
        li "$b_icloud"
    fi
}

section_unmanaged_wifi() {
    # Content is purely derived from current NM state vs Ansible manifest;
    # always rewrite from scratch so newly joined networks surface promptly.
    [ -r /etc/gatherd/managed-wifi.list ] || {
        section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
        return
    }

    saved=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1 }' \
        | sort -u)
    # Suppress both the Ansible-managed networks and any you've durably dismissed
    # in the local ack file. The ack file is per-machine and intentionally not
    # carried across a repave — a fresh machine re-surfaces every unmanaged net.
    _exclude=$(mktemp)
    cat /etc/gatherd/managed-wifi.list > "$_exclude"
    _ack="$HOME/.config/gatherd/wifi-ignore.list"
    [ -r "$_ack" ] && cat "$_ack" >> "$_exclude"
    unmanaged=$(printf '%s\n' "$saved" | grep -vxFf "$_exclude" || true)
    rm -f "$_exclude"

    section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
    [ -n "$unmanaged" ] || return

    # Build the block on its own, then splice it just under the top "Manual steps
    # remaining:" line. This section regenerates every run and would otherwise
    # re-append at the bottom, but it belongs above Verify.
    _blk=$(mktemp)
    _main=$OUTPUT
    OUTPUT=$_blk
    h 'Unmanaged WiFi'
    li 'Either keep in Ansible (vault/vault.yml) or append to ~/.config/gatherd/wifi-ignore.list:'
    printf '%s\n' "$unmanaged" | while IFS= read -r ssid; do
        [ -n "$ssid" ] && printf '  - %s\n' "$ssid" >> "$OUTPUT"
    done
    OUTPUT=$_main

    { head -n 1 "$OUTPUT"; cat "$_blk"; tail -n +2 "$OUTPUT"; } \
        > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
    rm -f "$_blk"
}

section_vault() {
    set -- \
        'Enter password when prompted' \
        'Run `journalctl -u gatherd-vault.service` to check progress'
    if [ -f /etc/gatherd/vault-complete ]; then
        prune_section 'Vault' "$@"
    else
        section_present 'Vault' && return
        h 'Vault'
        for b in "$@"; do li "$b"; done
    fi
}

section_verify() {
    # Never auto-done: user manages this section manually
    section_present 'Verify' && return
    h 'Verify'
    li 'polkit auth DRAWS a box for an ordinary CLI action AND the command returns — the behavioral check the topology test does not cover. Use `pkexec`, NOT a D-Bus action: `systemctl restart` and friends return as soon as polkitd records the grant even when the agent handshake is broken and leaks a helper, so they MASK a broken success path (this exact masking cost a repave cycle to see through); pkexec waits synchronously for the agent result and is the only action that visibly hangs when it breaks. As your normal user, NOT via sudo, in a foot terminal in the running Sway session, as the first polkit action after a fresh login (the agent is launched once at session start, so a launch/registration bug only shows on that first cold request): `time pkexec true; echo exit=$?`. A fuzzel box tagged `[polkit]` MUST appear; type your password + Enter, and pkexec returns in well under a second with `exit=0`. Confirm clean teardown: `pgrep -af polkit-agent-helper-1` prints nothing (no leaked helper) and `journalctl -b | grep pkexec | tail -1` shows `Executing command [.. COMMAND=/usr/bin/true]`. Two regressions this catches, both of which hang pkexec with the box already gone: (1) NO box appears — gatherd-askpass letting fuzzel inherit cmd-polkit'\''s never-closing stdin pipe (`fuzzel --dmenu` blocks on EOF before it draws); fixed by redirecting fuzzel'\''s stdin from /dev/null. (2) Box appears and TAKES the password, then pkexec hangs forever with a stuck polkit-agent-helper-1 — the handler emitting its authenticate reply as multi-line pretty JSON, while cmd-polkit reads the handler stdout one physical line at a time and parses only the last line (`}`), so the password never reaches the helper; fixed by `jq -c` (compact, single line) in gatherd-polkit-agent.'
    li 'Managed WiFi profiles are interface-independent and autoconnect (no dead profiles, no GUI duplicates). Every managed SSID must have an EMPTY connection.interface-name — never `*` (a literal `*` binds the profile to a device named "*", matches nothing, so it never activates and you join via the GUI, leaving a duplicate "<ssid> 1") and never a real device like `wlan0` (gatherd unbinds those; an installer-created profile starts pinned to the device it first joined on, and the nmcli module cannot clear it). Every bracket empty: `while read s; do printf "%s [%s]\n" "$s" "$(nmcli -g connection.interface-name connection show "$s")"; done < /etc/gatherd/managed-wifi.list`. No duplicates: `nmcli -t -g NAME connection show | grep -E " [0-9]+$"` prints nothing. Then on a fresh repave first booted on Ethernet, unplug it and confirm the home network autoconnects with no manual selection or password entry.'
    li 'WPA-Enterprise (802.1x) WiFi profiles carry a full, headless-capable 802.1x config. The nmcli module can only set key-mgmt: wpa-eap, never the 802-1x.* group, so gatherd writes EAP method/identity/phase2-auth/password with raw nmcli — verify all four landed and the password is STORED (not agent-prompted), or the profile silently fails to autoconnect on a fresh boot. For every managed enterprise SSID: `while read s; do [ "$(nmcli -g 802-11-wireless-security.key-mgmt connection show "$s")" = wpa-eap ] || continue; printf "%s: eap=[%s] id=[%s] phase2=[%s] pwflags=[%s]\n" "$s" "$(nmcli -g 802-1x.eap connection show "$s")" "$(nmcli -g 802-1x.identity connection show "$s")" "$(nmcli -g 802-1x.phase2-auth connection show "$s")" "$(nmcli -g 802-1x.password-flags connection show "$s")"; done < /etc/gatherd/managed-wifi.list`. Each line must have all of eap/id/phase2 non-empty AND `pwflags=[0]` — flag 0 means the secret is stored in the keyfile so NM connects unattended; a non-zero flag (e.g. 1 = agent-owned) means NM would pop a prompt and the network never autoconnects on a headless/first boot. The password itself reads back as `<hidden>`, so pwflags=0 is the only mechanical proof it is present. Functional: with the enterprise network in range, `nmcli connection up "<ssid>"` connects with NO interactive password prompt; on a fresh repave it autoconnects with no manual selection or entry, same as the home PSK network.'
    li 'IR receiver (machines with an IR receiver): `ls /dev/lirc* /sys/class/rc/rc* 2>/dev/null` shows at least one device; `ir-keytable` lists the device with a keymap loaded; and `ir-keytable -t -s rc0` while pressing remote buttons shows a scancode + keycode per press.'
    li 'Unattended pave after one early entry: the vault password is collected on the console Before=gatherd.service (gatherd-prompt-vault-console.service), so on a fresh repave you enter it right after the LUKS passphrase and the whole rest — system play, vault play, async packages, autologin — runs hands-off. The prompt is routed through systemd`s console ask-password agent (the script calls `systemd-ask-password --no-tty`, same machinery as a systemd-cryptsetup LUKS prompt) — NOT by reading the tty ourselves: a hand-rolled `stty -echo`+`read` on the unit`s inherited tty silently captured zero keystrokes at boot (the read blocked on a visible, foreground tty1 yet no input arrived, because nothing had claimed the console the way the agent does — activate the VT, text mode, foreground pgrp), which cost two repave cycles to see through. The in-Sway `[vault]` fuzzel box is now only a fallback for when the console prompt is not answered in time. Mechanical: `systemctl is-enabled gatherd-prompt-vault-console.service` is `enabled`; `systemctl show -p After gatherd.service | tr " " "\n" | grep -qx gatherd-prompt-vault-console.service` succeeds (it is ordered before gatherd.service); the script drives the agent, not a tty — `grep -q "systemd-ask-password --no-tty" /usr/local/lib/gatherd/scripts/gatherd-prompt-vault-console` succeeds and `systemctl show -p TTYPath gatherd-prompt-vault-console.service` is empty (no `StandardInput=tty*`, so the regression of grabbing the tty ourselves cannot return); and on a converged machine it self-skips — `/usr/local/lib/gatherd/scripts/gatherd-vault-pass-needed; echo $?` prints `1` (a stored .vault_pass means never re-ask) and after a normal boot `systemctl show -p ConditionResult gatherd-prompt-vault-console.service` is `ConditionResult=no`. The gate is shared with the session prompt via gatherd-vault-pass-needed, so the two cannot drift. Functional (reproduce the prompt without a repave): `sudo rm -f /etc/gatherd/vault-complete /usr/local/lib/gatherd/.vault_pass`, then in one terminal `sudo systemctl start --no-block gatherd-prompt-vault-console.service` and in a second `sudo systemd-tty-ask-password-agent` — the agent shows `[gatherd] Ansible vault password` with masked (`*`) echo; type a WRONG password and the service re-broadcasts (the agent re-prompts), type the correct one and the service finishes and writes `/usr/local/lib/gatherd/.vault_pass` (root, 0600). Then `sudo systemctl restart gatherd-vault.service` and `test -f /etc/gatherd/vault-complete && echo OK` prints `OK`, no unit `failed`. On a real fresh repave: after the LUKS passphrase the masked `[gatherd]` prompt appears on the now-upright console (fbcon rotation is in effect by the real-root stage, unlike the sideways LUKS/GRUB screens) before the long run; enter it once and the machine finishes to a logged-in desktop untouched. The masked `*` feedback is the cue that keystrokes are landing — the old prompt gave none and looked dead.'
    li 'Fractional panel scaling (MiniBook X — dense ~215 PPI DSI panel with no EDID): rather than leave it at 1x (where DPI-driven apps render tiny) or push it to a too-coarse integer 2x (960px logical), Sway scales the panel 1.4 and foot is recomputed for the smaller logical width so the layout is unchanged. Mechanical: `grep "output \* scale" ~/.config/sway/config.d/outputs` is `output * scale 1.4` and `grep "^font=" ~/.config/foot/foot.ini` ends `size=10`. The >=80-col two-up invariant holds: in a half-width (side-by-side) foot, `tput cols` is >= 80 (~85), at the same physical text size as a 1x/size-14 panel. Gated on product_name == "MiniBook X", so other machines are untouched — a low-DPI panel keeps scale 1 (no `output * scale` line is written at all) and the HiDPI EDID machine keeps scale 2; confirm on those that `~/.config/sway/config.d/outputs` has no 1.4 line. Functional (eyeball): Slack, Claude Desktop, Helium, 1Password and LocalSend render at a size consistent with foot/xed and stay crisp — they run native Wayland (`--ozone-platform=wayland`), so the fractional-scale protocol keeps them sharp rather than upscaled-blurry; GTK3 apps (xed) are supersampled (drawn at 2x, downscaled to 1.4) and acceptably sharp. The DPI-driven apps need no per-app treatment because the single compositor scale covers every current and future app.'
    li 'Web app icons resolve official and hi-res: gatherd-fetch-webapp-icon writes ~/.local/share/ice/icons/<codename>.png for every web_apps entry — official 512px App Store artwork via the iTunes Lookup API (app_store_id), else a pinned icon_url, else DuckDuckGo''s favicon. None missing: `for d in ~/.local/share/applications/WebApp-*.desktop; do ic=$(sed -n "s/^Icon=//p" "$d"); test -s "$ic" || echo "MISSING $d"; done` prints nothing. Every app except HuggingChat (no App Store app, so a 256px DDG fallback) must be 512px: `for f in ~/.local/share/ice/icons/*.png; do python3 -c "from PIL import Image;import sys;print(sys.argv[1].rsplit(\"/\",1)[-1], Image.open(sys.argv[1]).size[0])" "$f"; done` prints 512 for all but HuggingChat. A smaller width means the iTunes lookup failed at fetch time and it fell back to DDG — delete that png and re-run the play to refetch, or re-check the app_store_id at `itunes.apple.com/search?term=NAME&entity=software`. Eyeball: in the Mod-Shift-D menu the icons render crisp, not pixelated.'
    li 'Remote GUI via VNC over SSH: wayvnc binds loopback only and is reached through an SSH tunnel — sshd is the sole auth boundary, VNC has none of its own. Mechanical: `cat ~/.config/wayvnc/config` shows `address=127.0.0.1` and `enable_auth=false`; `grep -c "run \"wayvnc\"" ~/.local/bin/gatherd-session-helpers` is `1` (a cohort child, so logout kills it and frees 127.0.0.1:5900 — a plain sway exec would orphan and hold the port); `sudo sshd -T | grep -i allowtcpforwarding` is `allowtcpforwarding yes`. The client for reaching other machines is installed: `pacman -Qq remmina libvncserver` lists both (Remmina has its own SSH-tunnel support — same localhost+SSH model). In a running Sway session wayvnc listens on loopback ONLY: `ss -ltnp | grep 5900` shows `127.0.0.1:5900`, never `0.0.0.0`; from another host `nc -z -w3 <host> 5900` is refused (the port is off the network). Functional (manual, from another host on the tailnet): open an SSH tunnel to <host>:22 and point a VNC client (Screens/Remmina) at `localhost:5900` with Authentication = None — it lands straight in the live Sway session with no VNC password. Note: wayvnc only starts once a Sway session is up (it is a session cohort child), which is fine since starting that session requires being at the machine anyway.'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

[ -f "$OUTPUT" ] || printf 'Manual steps remaining:\n' > "$OUTPUT"

section_unmanaged_wifi
section_verify
section_vault
section_1password
section_tailscale
section_other_logins

collapse_blanks
