#!/bin/sh
# Manages ~/.config/gatherd-post-setup.md as a living document:
#   - appends sections that are needed but not yet present
#   - when detection says a step is done, removes ONLY the boilerplate lines this
#     script itself generated, leaving anything you added by hand (and dropping a
#     now-empty header). Write freely under any section — your notes are never
#     pruned, with no markers or special formatting to remember.
# Safe to run at any time; gatherd-prompt-postsetup calls it at each login.

OUTPUT="$HOME/.config/gatherd-post-setup.md"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

h()  { printf '\n# %s\n'  "$1" >> "$OUTPUT"; }

# Render one bullet wrapped to fit an 80-column editor: the first line gets the
# "- " marker, continuation lines a 2-space hanging indent. fold -s breaks only
# at spaces; trailing whitespace is trimmed so the rendering is deterministic —
# prune_section re-renders bullets the same way to find and remove them.
wrap_bullet() {
    printf '%s\n' "$1" | fold -s -w 78 | sed 's/[[:space:]]*$//' | awk '
        NR == 1 { print "- " $0; next }
                { print "  " $0 }'
}

li() { wrap_bullet "$1" >> "$OUTPUT"; }

section_present() { grep -q "^# $1\$" "$OUTPUT" 2>/dev/null; }

# Wipe an entire section, header through the next header — blunt, and only safe
# for the fully-derived Unmanaged WiFi list (regenerated each run, never
# hand-edited). For any section you might annotate, use prune_section instead.
section_remove() {
    awk -v hdr="# $1" '
        $0 == hdr { skip=1; next }
        skip && /^# /  { skip=0 }
        !skip { print }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# Remove only the boilerplate bullets this script generated for a section
# (passed as arguments), leaving any lines you added by hand. If nothing of
# yours remains under the header, drop the header too. This is how "done" steps
# get pruned without ever eating your own notes.
prune_section() {
    _name=$1
    shift
    section_present "$_name" || return
    # Re-render each boilerplate bullet exactly as li() wrote it (wrapping and
    # all), separated by a sentinel line, so awk matches and drops the whole
    # possibly-multi-line bullet as a unit while leaving hand-added lines verbatim.
    _own=$(for _b in "$@"; do wrap_bullet "$_b"; printf '@@PRUNE_SEP@@\n'; done)
    PRUNE_OWN="$_own" awk -v hdr="# $_name" '
        BEGIN {
            n = split(ENVIRON["PRUNE_OWN"], L, "\n")
            b = ""
            for (i = 1; i <= n; i++) {
                if (L[i] == "@@PRUNE_SEP@@") { if (b != "") own[b] = 1; b = ""; continue }
                b = (b == "") ? L[i] : b "\n" L[i]
            }
        }
        # A bullet group is a "- " line plus its "  " continuation lines; drop the
        # whole group if it matches a boilerplate bullet, else keep it verbatim.
        function endgrp(   j, m, gl) {
            if (!ingrp) return
            if (!(g in own)) {
                m = split(g, gl, "\n")
                for (j = 1; j <= m; j++) { out[++on] = gl[j]; if (gl[j] != "") nonblank = 1 }
            }
            ingrp = 0; g = ""
        }
        function flush(   j) {
            endgrp()
            if (nonblank) { print hdr; for (j = 1; j <= on; j++) print out[j] }
            on = 0; nonblank = 0
        }
        $0 == hdr      { inseg = 1; on = 0; nonblank = 0; ingrp = 0; g = ""; next }
        inseg && /^# / { flush(); inseg = 0; print; next }
        inseg {
            if ($0 ~ /^- /)          { endgrp(); ingrp = 1; g = $0; next }
            if (ingrp && $0 ~ /^  /) { g = g "\n" $0; next }
            endgrp(); out[++on] = $0; if ($0 != "") nonblank = 1; next
        }
                       { print }
        END            { if (inseg) flush() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

collapse_blanks() {
    awk 'prev_blank && /^$/ { next } { prev_blank=(/^$/); print }' \
        "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# ---------------------------------------------------------------------------
# App state detection
# ---------------------------------------------------------------------------

# The SSH-agent socket appears only once "Use the SSH agent" is enabled — the
# last 1Password setup step, so a good proxy for the whole section being done.
onepassword_ssh_agent_ok() { [ -S "$HOME/.1password/agent.sock" ]; }

tailscale_connected() { tailscale ip >/dev/null 2>&1; }

tailscale_settings_ok() {
    _prefs=$(tailscale debug prefs 2>/dev/null)
    printf '%s' "$_prefs" | grep -qE '"CorpDNS":\s*true' &&
    printf '%s' "$_prefs" | grep -qE '"RouteAll":\s*true'
}

icloud_configured()     { rclone listremotes 2>/dev/null | grep -q '^icloud:'; }
claude_desktop_authed() { find "$HOME/.config/Claude" -name '*.json' 2>/dev/null | grep -q .; }
claude_code_authed()    { [ -f "$HOME/.claude/.credentials.json" ] || [ -f "$HOME/.claude/credentials" ]; }

# ---------------------------------------------------------------------------
# Section handlers
# Pattern: if done → prune; else if absent → add; else → leave alone
# ---------------------------------------------------------------------------

section_1password() {
    set -- \
        'Sign in to 1Password' \
        'Lock, unlock, enter 2FA code' \
        'Settings → Developer: enable "Connect with 1Password CLI" and "Use the SSH agent"'
    if onepassword_ssh_agent_ok; then
        prune_section '1Password' "$@"
    else
        section_present '1Password' && return
        h '1Password'
        for b in "$@"; do li "$b"; done
    fi
}

section_tailscale() {
    # Never auto-done: exit node check is always relevant after a repave
    section_present 'Tailscale' && return
    h 'Tailscale'
    tailscale_connected   || li 'Connect during this session before rebooting. Else next session re-run `sudo tailscale set --operator=$USER` first.'
    tailscale_settings_ok || li 'Run `tailscale set --accept-dns=true --accept-routes`'
}

section_other_logins() {
    # Detectable logins (Claude, iCloud) get pruned once done. Zoom and JetBrains
    # login state isn't reliably detectable — Toolbox writes assorted .json just by
    # running, so any file heuristic false-positives — so they're never auto-done
    # and keep this section alive.
    b_claude_desktop='Claude Desktop: log in via the app'
    b_claude_code='Claude Code: run `claude` in a terminal'
    b_zoom='Zoom: log in'
    b_jetbrains='JetBrains Toolbox: log in to your account by clicking the tray icon'
    b_icloud='iCloud: run `rclone config` and follow prompts to add a remote named `icloud`; complete 2FA when prompted'

    set --
    claude_desktop_authed && set -- "$@" "$b_claude_desktop"
    claude_code_authed    && set -- "$@" "$b_claude_code"
    icloud_configured     && set -- "$@" "$b_icloud"
    [ "$#" -gt 0 ] && prune_section 'Other Logins' "$@"

    section_present 'Other Logins' && return
    h 'Other Logins'
    claude_desktop_authed || li "$b_claude_desktop"
    claude_code_authed    || li "$b_claude_code"
    li "$b_zoom"
    li "$b_jetbrains"
    icloud_configured     || li "$b_icloud"
}

section_unmanaged_wifi() {
    # Content is purely derived from current NM state vs Ansible manifest;
    # always rewrite from scratch so newly joined networks surface promptly.
    [ -r /etc/gatherd/managed-wifi.list ] || {
        section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
        return
    }

    saved=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1 }' \
        | sort -u)
    # Suppress both the Ansible-managed networks and any you've durably dismissed
    # in the local ack file. The ack file is per-machine and intentionally not
    # carried across a repave — a fresh machine re-surfaces every unmanaged net.
    _exclude=$(mktemp)
    cat /etc/gatherd/managed-wifi.list > "$_exclude"
    _ack="$HOME/.config/gatherd/wifi-ignore.list"
    [ -r "$_ack" ] && cat "$_ack" >> "$_exclude"
    unmanaged=$(printf '%s\n' "$saved" | grep -vxFf "$_exclude" || true)
    rm -f "$_exclude"

    section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
    [ -n "$unmanaged" ] || return

    # Build the block on its own, then splice it just under the top "Manual steps
    # remaining:" line. This section regenerates every run and would otherwise
    # re-append at the bottom, but it belongs above Verify.
    _blk=$(mktemp)
    _main=$OUTPUT
    OUTPUT=$_blk
    h 'Unmanaged WiFi'
    li 'Either keep in Ansible (vault/vault.yml) or append to ~/.config/gatherd/wifi-ignore.list:'
    printf '%s\n' "$unmanaged" | while IFS= read -r ssid; do
        [ -n "$ssid" ] && printf '  - %s\n' "$ssid" >> "$OUTPUT"
    done
    OUTPUT=$_main

    { head -n 1 "$OUTPUT"; cat "$_blk"; tail -n +2 "$OUTPUT"; } \
        > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
    rm -f "$_blk"
}

section_vault() {
    set -- \
        'Enter password when prompted' \
        'Run `journalctl -u gatherd-vault.service` to check progress'
    if [ -f /etc/gatherd/vault-complete ]; then
        prune_section 'Vault' "$@"
    else
        section_present 'Vault' && return
        h 'Vault'
        for b in "$@"; do li "$b"; done
    fi
}

section_verify() {
    # Never auto-done: user manages this section manually
    section_present 'Verify' && return
    h 'Verify'
    li 'LocalSend startup flash: log out and back in, watching the screen — no LocalSend window should flash up before it settles into the tray. `gatherd-intercept-localsend-flash` (launched from the supervisor just before localsend) stashes the startup surface to scratchpad until LocalSend withdraws it via `--hidden`. If a brief flash returns, confirm the interceptor is installed and still listed in `gatherd-session-helpers`.'
    li 'Heavy sign-in apps not autostarted: after a normal login (and after a first-boot provisioning session), confirm `pgrep -f jetbrains-toolbox` and `pgrep -f vesktop` print nothing — they are installed (`pacman -Q jetbrains-toolbox vesktop-bin`) but never autostarted, by gatherd-session-helpers or otherwise. Open them on demand and sign in via 1Password. Lightweight tray utilities (1Password, LocalSend, Tailscale, PIA, arch-update) do still appear.'
    li 'Zoom screen sharing: try sharing a window — confirm screen sharing works under Sway/wlroots'
    li 'Helium appearance: open Helium settings and confirm the Qt theme (dark, and visually dark — tabs and toolbar should not be white/grey), normal (not Compact) browser layout, zen mode off, no rounded frame around web contents, "Use system title bar and borders" enabled, and "Continue where you left off" on startup. Spot-check with `grep -E "system_theme|custom_chrome_frame|layout|rounded_frame|zen_mode|restore_on_startup" ~/.config/net.imput.helium/Default/Preferences` — expect system_theme 2, custom_chrome_frame false, layout 0, rounded_frame false, zen_mode false, restore_on_startup 1 (Chromium enum: 1 = continue where you left off, 5 = New Tab page). (Seeded into Default/Preferences on a fresh profile; initial_preferences silently drops these keys.)'
    li 'Qt dark mode: open Helium (or any Qt app) — it should come up dark, not bright white.'
    li 'Software GL on legacy GPUs: only relevant if this machine'\''s GPU predates GL3 (e.g. the T60'\''s ATI Mobility Radeon X1400). gatherd-systray checks `lspci -n` at launch for r300-family IDs (1002:5b6x / 1002:7145) and exports LIBGL_ALWAYS_SOFTWARE=1 for the launched app only, so sway/wlroots stays on hardware GL. On such a machine the GL-using tray apps should render — LocalSend opens with no "Unable to create a GL context", 1Password'\''s first window draws cleanly. If the GPU is legacy but still broken, the lspci match in gatherd-systray did not catch it — check `lspci -n | grep -iE "1002|vga|display"` and add the ID to that pattern.'
    li 'environment.d reaching the session (decide if it is a black hole): in a foot terminal launched from sway — a sway child, not a systemd --user service — run `printenv GATHERD_ENVIRONMENT_SENTINEL`. gatherd drops it in ~/.config/environment.d/99-gatherd-env-sentinel.conf purely as a uniquely-named canary (nothing special-cases it, unlike SUDO_ASKPASS which sudo may scrub). Expect `cheese`. If empty, environment.d is a black hole for this session and every var placed there is dead — move the askpass var (and any others) off environment.d, then stop using it. Record the verdict in the env-propagation TODO.'
    li 'Netsurf fallback browser (all machines): run `which netsurf` — expect /usr/bin/netsurf. It is the lightweight browser to fall back to on constrained machines; launch it once to confirm it renders a page.'
    li 'claude-code on pre-AVX CPUs: gatherd installs the native claude-code and claude-cowork-service only when the CPU has AVX (the binary uses AVX/SSE4 and SIGILLs otherwise, e.g. on the Core 2 T60). Run `grep -qm1 avx /proc/cpuinfo && echo AVX || echo no-AVX`. On no-AVX expect `pacman -Q claude-code` to report it is not installed while `pacman -Q claude-desktop-bin` is — SSH in from an AVX box to use Claude. On AVX expect claude-code installed and `claude --version` to run without dumping core (check `coredumpctl list claude` is empty).'
    li 'Early GRUB cmdline pre-seed (first-session usability): the phantom-display and zswap fixes are baked into /etc/default/grub by `postinstall` before the first boot, not applied later by gatherd. Confirm they are live in the running kernel from that first boot (no reboot needed): on a MacBookPro5,2, `grep -o video=LVDS-2:d /proc/cmdline` is present; on a sub-8GB machine, `cat /sys/module/zswap/parameters/enabled` is `Y` and `grep -o zswap.enabled=1 /proc/cmdline` is present. `grep -E "video=LVDS-2:d|zswap.enabled=1" /etc/default/grub` should show each exactly once (postinstall added it; the gatherd task is a no-op).'
    li 'HiDPI scaling (HiDPI-panel machines only): run `swaymsg -t get_outputs | grep scale` — expect `"scale": 2`. Run `grep scale ~/.config/sway/config.d/outputs` — expect `output * scale 2`. Fonts in foot, waybar, and text apps should look appropriately sized for the screen, not enormous.'
    li 'Keyboard backlight keys (backlit keyboards only): press the keyboard-brightness up/down keys (F5/F6 on Apple) — the keys should visibly raise and lower the key backlight. The device is auto-detected (e.g. `smc::kbd_backlight`, `tpacpi::kbd_backlight`) and the step is derived from its max, so a coarse three-level keyboard moves one level per press while a 255-level keyboard moves smoothly.'
    li 'ThinkVantage button (ThinkPads with the blue button, e.g. T60): press it — should open a terminal'
    li 'IR receiver (machines with an IR receiver, e.g. T60): run `ls /dev/lirc* /sys/class/rc/rc* 2>/dev/null` — should show at least one device'
    li 'IR receiver: run `ir-keytable` — confirm device listed with a keymap loaded'
    li 'IR receiver: run `ir-keytable -t -s rc0` and press remote buttons — should show scancode + keycode per press'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

[ -f "$OUTPUT" ] || printf 'Manual steps remaining:\n' > "$OUTPUT"

section_unmanaged_wifi
section_verify
section_vault
section_1password
section_tailscale
section_other_logins

collapse_blanks
