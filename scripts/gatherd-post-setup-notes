#!/bin/sh
# Manages ~/.config/gatherd-post-setup.md as a living document:
#   - appends sections that are needed but not yet present
#   - when detection says a step is done, removes ONLY the boilerplate lines this
#     script itself generated, leaving anything you added by hand (and dropping a
#     now-empty header). Write freely under any section — your notes are never
#     pruned, with no markers or special formatting to remember.
# Safe to run at any time; gatherd-prompt-postsetup calls it at each login.

# shellcheck disable=SC2016
# The li/section strings deliberately hold literal `backtick` and $(...) command
# text for the reader to paste into their own shell — it is documentation, never
# meant to expand here.

OUTPUT="$HOME/.config/gatherd-post-setup.md"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

h()  { printf '\n# %s\n'  "$1" >> "$OUTPUT"; }

# Render one bullet wrapped to fit an 80-column editor: the first line gets the
# "- " marker, continuation lines a 2-space hanging indent. fold -s breaks only
# at spaces; trailing whitespace is trimmed so the rendering is deterministic —
# prune_section re-renders bullets the same way to find and remove them.
wrap_bullet() {
    printf '%s\n' "$1" | fold -s -w 78 | sed 's/[[:space:]]*$//' | awk '
        NR == 1 { print "- " $0; next }
                { print "  " $0 }'
}

li() { wrap_bullet "$1" >> "$OUTPUT"; }

section_present() { grep -q "^# $1\$" "$OUTPUT" 2>/dev/null; }

# Wipe an entire section, header through the next header — blunt, and only safe
# for the fully-derived Unmanaged WiFi list (regenerated each run, never
# hand-edited). For any section you might annotate, use prune_section instead.
section_remove() {
    awk -v hdr="# $1" '
        $0 == hdr { skip=1; next }
        skip && /^# /  { skip=0 }
        !skip { print }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# Remove only the boilerplate bullets this script generated for a section
# (passed as arguments), leaving any lines you added by hand. If nothing of
# yours remains under the header, drop the header too. This is how "done" steps
# get pruned without ever eating your own notes.
prune_section() {
    _name=$1
    shift
    section_present "$_name" || return
    # Re-render each boilerplate bullet exactly as li() wrote it (wrapping and
    # all), separated by a sentinel line, so awk matches and drops the whole
    # possibly-multi-line bullet as a unit while leaving hand-added lines verbatim.
    _own=$(for _b in "$@"; do wrap_bullet "$_b"; printf '@@PRUNE_SEP@@\n'; done)
    PRUNE_OWN="$_own" awk -v hdr="# $_name" '
        BEGIN {
            n = split(ENVIRON["PRUNE_OWN"], L, "\n")
            b = ""
            for (i = 1; i <= n; i++) {
                if (L[i] == "@@PRUNE_SEP@@") { if (b != "") own[b] = 1; b = ""; continue }
                b = (b == "") ? L[i] : b "\n" L[i]
            }
        }
        # A bullet group is a "- " line plus its "  " continuation lines; drop the
        # whole group if it matches a boilerplate bullet, else keep it verbatim.
        function endgrp(   j, m, gl) {
            if (!ingrp) return
            if (!(g in own)) {
                m = split(g, gl, "\n")
                for (j = 1; j <= m; j++) { out[++on] = gl[j]; if (gl[j] != "") nonblank = 1 }
            }
            ingrp = 0; g = ""
        }
        function flush(   j) {
            endgrp()
            if (nonblank) { print hdr; for (j = 1; j <= on; j++) print out[j] }
            on = 0; nonblank = 0
        }
        $0 == hdr      { inseg = 1; on = 0; nonblank = 0; ingrp = 0; g = ""; next }
        inseg && /^# / { flush(); inseg = 0; print; next }
        inseg {
            if ($0 ~ /^- /)          { endgrp(); ingrp = 1; g = $0; next }
            if (ingrp && $0 ~ /^  /) { g = g "\n" $0; next }
            endgrp(); out[++on] = $0; if ($0 != "") nonblank = 1; next
        }
                       { print }
        END            { if (inseg) flush() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

collapse_blanks() {
    awk 'prev_blank && /^$/ { next } { prev_blank=(/^$/); print }' \
        "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# ---------------------------------------------------------------------------
# App state detection
# ---------------------------------------------------------------------------

# The SSH-agent socket appears only once "Use the SSH agent" is enabled — the
# last 1Password setup step, so a good proxy for the whole section being done.
onepassword_ssh_agent_ok() { [ -S "$HOME/.1password/agent.sock" ]; }

tailscale_connected() { tailscale ip >/dev/null 2>&1; }

# Sentinels rather than a live probe: this script runs at every login, and
# `rclone listremotes` now shells out to op for the config password, which
# blocks on a locked 1Password. Both files are written by gatherd-icloud-config
# and gatherd-icloud-sync.
_icloud_state="$HOME/.local/state/gatherd"
icloud_fleet_ok()    { [ -f "$_icloud_state/icloud-fleet-ok" ]; }
icloud_needs_reauth() { [ -f "$_icloud_state/icloud-needs-reauth" ]; }
icloud_plaintext_config() { [ -f "$_icloud_state/icloud-plaintext-config" ]; }

# ---------------------------------------------------------------------------
# Section handlers
# Pattern: if done → prune; else if absent → add; else → leave alone
# ---------------------------------------------------------------------------

section_1password() {
    set -- \
        'Sign in to 1Password' \
        'Lock, unlock, enter 2FA code' \
        'Settings → Developer: enable "Connect with 1Password CLI" and "Use the SSH agent"'
    if onepassword_ssh_agent_ok; then
        prune_section '1Password' "$@"
    else
        section_present '1Password' && return
        h '1Password'
        for b in "$@"; do li "$b"; done
    fi
}

section_tailscale() {
    # Never auto-done: exit node check is always relevant after a repave
    section_present 'Tailscale' && return
    h 'Tailscale'
    tailscale_connected   || li 'Connect during this session before rebooting. Set up 1Password (including its browser extension) first — then Tailscale offers to log you in via Apple SSO and 1Password fills it correctly.'
}

section_other_logins() {
    # Only iCloud earns a standing reminder here. Claude Desktop/Code, Zoom, and
    # JetBrains are deliberately not surfaced — logging into them is obvious on
    # demand and didn't merit a recurring nag. PIA needs nothing here either: it
    # logs in automatically from 1Password via gatherd-prompt-pia at every login.
    #
    # Two mutually exclusive iCloud lines, both self-pruning. Bootstrap is a
    # once-per-fleet step, so it only appears on a machine that has never seen a
    # fleet config. Re-auth is periodic and unavoidable — the session token
    # expires whatever we do — so it appears whenever a sync hits an auth error
    # and disappears on the next success.
    b_bootstrap='iCloud: run `gatherd-icloud-config bootstrap` (once per fleet; needs `rclone config` + 2FA first if this is the very first machine)'
    b_reauth='iCloud needs re-authentication: run `rclone config reconnect icloud:` and complete 2FA — every other machine picks it up automatically'
    b_plaintext='iCloud config is plaintext (a live iCloud token sits unencrypted on disk): run `rclone config encryption set`'

    # Each branch prunes its own bullet before possibly re-adding it, not just
    # when it's due to disappear: `li` only appends, so guarding the add with
    # `section_present || h` (skip the header, not the bullet) still let a
    # bullet that survived from the previous run get a second copy appended
    # underneath it. Prune-then-add makes each bullet idempotent regardless of
    # what the file already looked like.
    if icloud_fleet_ok; then
        prune_section 'Other Logins' "$b_bootstrap"
    else
        prune_section 'Other Logins' "$b_bootstrap"
        section_present 'Other Logins' || h 'Other Logins'
        li "$b_bootstrap"
    fi

    if icloud_needs_reauth; then
        prune_section 'Other Logins' "$b_reauth"
        section_present 'Other Logins' || h 'Other Logins'
        li "$b_reauth"
    else
        prune_section 'Other Logins' "$b_reauth"
    fi

    if icloud_plaintext_config; then
        prune_section 'Other Logins' "$b_plaintext"
        section_present 'Other Logins' || h 'Other Logins'
        li "$b_plaintext"
    else
        prune_section 'Other Logins' "$b_plaintext"
    fi
}

section_unmanaged_wifi() {
    # Content is purely derived from current NM state vs Ansible manifest;
    # always rewrite from scratch so newly joined networks surface promptly.
    [ -r /etc/gatherd/managed-wifi.list ] || {
        section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
        return
    }

    saved=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1 }' \
        | sort -u)
    # Suppress both the Ansible-managed networks and any you've durably dismissed
    # in the local ack file. The ack file is per-machine and intentionally not
    # carried across a repave — a fresh machine re-surfaces every unmanaged net.
    _exclude=$(mktemp)
    cat /etc/gatherd/managed-wifi.list > "$_exclude"
    _ack="$HOME/.config/gatherd/wifi-ignore.list"
    [ -r "$_ack" ] && cat "$_ack" >> "$_exclude"
    unmanaged=$(printf '%s\n' "$saved" | grep -vxFf "$_exclude" || true)
    rm -f "$_exclude"

    section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
    [ -n "$unmanaged" ] || return

    # Build the block on its own, then splice it just under the top "Manual steps
    # remaining:" line. This section regenerates every run and would otherwise
    # re-append at the bottom, but it belongs above Verify.
    _blk=$(mktemp)
    _main=$OUTPUT
    OUTPUT=$_blk
    h 'Unmanaged WiFi'
    li 'Either keep in Ansible (vault/vault.yml) or append to ~/.config/gatherd/wifi-ignore.list:'
    printf '%s\n' "$unmanaged" | while IFS= read -r ssid; do
        [ -n "$ssid" ] && printf '  - %s\n' "$ssid" >> "$OUTPUT"
    done
    OUTPUT=$_main

    { head -n 1 "$OUTPUT"; cat "$_blk"; tail -n +2 "$OUTPUT"; } \
        > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
    rm -f "$_blk"
}

section_vault() {
    set -- \
        'Enter password when prompted' \
        'Run `journalctl -u gatherd-vault.service` to check progress'
    if [ -f /etc/gatherd/vault-complete ]; then
        prune_section 'Vault' "$@"
    else
        section_present 'Vault' && return
        h 'Vault'
        for b in "$@"; do li "$b"; done
    fi
}

section_verify() {
    # Never auto-done: user manages this section manually
    section_present 'Verify' && return
    h 'Verify'
    li 'IR remote (machines with an IR receiver only): `ir-keytable -t -s rc0` while pressing buttons prints a scancode + keycode per press.'
    li 'Convergence is fail-open: `/usr/local/lib/gatherd/scripts/gatherd-selftest-failopen --toast` prints `PASS` for all four outcomes and pops the critical toast a failing boot would show. It drives the real wrapper against a scratch marker, so the live status is untouched.'
    li 'The greeter is off the network: `systemctl show gatherd.service autofs.service -p After -p Wants | grep -c network-online` prints `0`. Then boot with the network DISCONNECTED — the greeter comes up without a ~60s NetworkManager-wait-online stall, and the first session has fonts, keybindings, wallpaper and keyring before anything is downloaded.'
    li 'Both tiers converged: `head -1 /etc/gatherd/core-complete` and `head -1 /etc/gatherd/async-complete` each print the same commit as `git -C /usr/local/lib/gatherd rev-parse HEAD`, and `head -1 /etc/gatherd/last-run` prints `ok`.'
    li 'No package drifts from the offline-cache manifest: `/usr/local/lib/gatherd/scripts/gatherd-check-package-tiers /usr/local/lib/gatherd` exits `0`.'
    li 'GRUB background decodes, and is pre-turned where the panel is mounted rotated: `sudo grep -c "insmod jpeg" /boot/grub/grub.cfg` prints 1 or more. On an upright-panel machine `grep GRUB_BACKGROUND /etc/default/grub` prints a .jpg under /usr/local/lib/gatherd/backgrounds; where `cat /sys/class/dmi/id/product_name` prints `MiniBook X` it prints /usr/local/share/gatherd/wallpaper-dark-rotated.jpg instead, and that copy is a lossless quarter-turn of the source — `jpegtran -rotate 90 -optimize -copy none -outfile /tmp/rot.jpg /usr/local/lib/gatherd/backgrounds/wallpaper-dark.jpg && cmp /tmp/rot.jpg /usr/local/share/gatherd/wallpaper-dark-rotated.jpg` prints nothing. The next boot shows the image rather than a plain background, and on the rotated panel the art reads upright; the menu text and LUKS prompt stay sideways, which GRUB cannot fix.'
    li 'Credential prompts wear the crimson house style: `/usr/local/bin/gatherd-askpass "[sudo]"` pops a crimson box with a salmon border and a `❯  [sudo]` prompt, in the same font as the fuzzel launcher (`grep ^font= ~/.config/fuzzel/fuzzel.ini`) — typing echoes to stdout, Escape exits non-zero and prints nothing. Then `/usr/local/bin/gatherd-askpass "Are you sure you want to continue connecting (yes/no/[fingerprint])?"` opens a crimson foot window titled `SSH host key verification`, in the same font as `grep ^font= ~/.config/foot/foot.ini`.'
    li 'iCloud sync: `gatherd-icloud-config status` prints `config: encrypted, verified; fleet: in sync`; `gatherd-icloud-sync FSNotes` exits 0 and `tail -3 ~/.local/state/gatherd/rclone-icloud-FSNotes.log` ends with a successful bisync; `ls ~/Documents/iCloud/FSNotes | wc -l` is non-zero'
    li 'iCloud unlock trigger: `grep -c unlock-command ~/.config/gtklock/config.ini` prints 1; `rm -f ~/.local/state/gatherd/icloud-sync.stamp` (the unlock command uses --if-due with a 300s minimum, so without this the stamp legitimately no-ops and looks like a failure on a healthy machine), lock the screen and unlock it, then re-run — the stamp file exists again'
    li 'Tablet mode disables the built-in keyboard, so run the check below as one pasted sequence. Before starting: the power button sits on an edge of the chassis and stays reachable when folded — press it and pick `Exit tablet mode` from its touch menu if you get stuck. `gatherd-tablet-mode status; echo $?` prints `1`. Then paste this whole sequence at once: `gatherd-tablet-mode on; swaymsg -t get_outputs | jq -r ".[] | select(.name | test(\"^(eDP|DSI|LVDS)\")) | \"\(.transform) \(.rect.width)x\(.rect.height)\""; swaymsg -t get_inputs | jq -r ".[] | select(.identifier | startswith(\"1:1:\")) | .libinput.send_events"; gatherd-tablet-mode off; swaymsg -t get_inputs | jq -r ".[] | select(.identifier | startswith(\"1:1:\")) | .libinput.send_events"` prints, in order: a portrait size (`normal 857x1371` on the MiniBook X — NOT `90`, which is upright landscape on a physically rotated panel), then `disabled`, then `enabled`. That last `enabled` only shows up because of the re-query — `gatherd-tablet-mode off` itself prints nothing. Finally, as a separate step: `gatherd-tablet-mode on`, touch the screen and confirm the pointer lands under your finger while it is rotated, then press the edge power button and pick `Exit tablet mode`.'
    li 'Music stand picks by composer, then score: `gatherd-music-index && cut -f1 ~/.local/state/gatherd/music-index.tsv | sort -u | wc -l` prints a non-zero composer count, and `wc -l < ~/.local/state/gatherd/music-index.tsv` equals `ls ~/Documents/forscore/*.pdf | wc -l`. `gatherd-music-stand on` offers composers, then that composer'"'"'s scores, and opens the pick fullscreen with the screen no longer blanking; the edge power button then offers `Exit tablet mode`.'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

[ -f "$OUTPUT" ] || printf 'Manual steps remaining:\n' > "$OUTPUT"

section_unmanaged_wifi
section_verify
section_vault
section_1password
section_tailscale
section_other_logins

collapse_blanks
