#!/bin/sh
# Manages ~/.config/gatherd-post-setup.md as a living document:
#   - appends sections that are needed but not yet present
#   - when detection says a step is done, removes ONLY the boilerplate lines this
#     script itself generated, leaving anything you added by hand (and dropping a
#     now-empty header). Write freely under any section — your notes are never
#     pruned, with no markers or special formatting to remember.
# Safe to run at any time; gatherd-prompt-postsetup calls it at each login.

OUTPUT="$HOME/.config/gatherd-post-setup.md"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

h()  { printf '\n# %s\n'  "$1" >> "$OUTPUT"; }
li() { printf -- '- %s\n' "$1" >> "$OUTPUT"; }

section_present() { grep -q "^# $1\$" "$OUTPUT" 2>/dev/null; }

# Wipe an entire section, header through the next header — blunt, and only safe
# for the fully-derived Unmanaged WiFi list (regenerated each run, never
# hand-edited). For any section you might annotate, use prune_section instead.
section_remove() {
    awk -v hdr="# $1" '
        $0 == hdr { skip=1; next }
        skip && /^# /  { skip=0 }
        !skip { print }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# Remove only the boilerplate bullets this script generated for a section
# (passed as arguments), leaving any lines you added by hand. If nothing of
# yours remains under the header, drop the header too. This is how "done" steps
# get pruned without ever eating your own notes.
prune_section() {
    _name=$1
    shift
    section_present "$_name" || return
    PRUNE_BULLETS=$(printf '%s\n' "$@") \
    awk -v hdr="# $_name" '
        BEGIN {
            n = split(ENVIRON["PRUNE_BULLETS"], a, "\n")
            for (i = 1; i <= n; i++) if (a[i] != "") own["- " a[i]] = 1
        }
        function flush(   i) {
            if (nonblank) { print hdr; for (i = 1; i <= bn; i++) print body[i] }
            bn = 0; nonblank = 0
        }
        $0 == hdr      { inseg = 1; bn = 0; nonblank = 0; next }
        inseg && /^# / { flush(); inseg = 0; print; next }
        inseg          { if ($0 in own) next; body[++bn] = $0; if ($0 != "") nonblank = 1; next }
                       { print }
        END            { if (inseg) flush() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

collapse_blanks() {
    awk 'prev_blank && /^$/ { next } { prev_blank=(/^$/); print }' \
        "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# ---------------------------------------------------------------------------
# Hardware detection
# ---------------------------------------------------------------------------

is_thinkpad()     { grep -qi 'thinkpad' /sys/class/dmi/id/product_version 2>/dev/null \
                        || grep -qiE 'lenovo|ibm' /sys/class/dmi/id/board_vendor 2>/dev/null; }
is_chromebook()   { grep -qi 'google' /sys/class/dmi/id/sys_vendor 2>/dev/null; }
has_ir_receiver() { ls /dev/lirc* /sys/class/rc/rc* >/dev/null 2>&1; }
has_resume()      { [ "$(systemctl is-enabled suspend.target 2>/dev/null)" != "masked" ]; }
has_grub()        { [ -f /etc/default/grub ]; }

# ---------------------------------------------------------------------------
# App state detection
# ---------------------------------------------------------------------------

onepassword_keyring_ok() {
    [ -f "$HOME/.local/share/keyrings/login.keyring" ]
}

helium_1p_extension_ok() {
    [ -d "$HOME/.config/net.imput.helium/Default/Extensions/aeblfdkhhhdcdjpifhhbdiojplfjncoa" ]
}

tailscale_connected() { tailscale ip >/dev/null 2>&1; }

tailscale_settings_ok() {
    _prefs=$(tailscale debug prefs 2>/dev/null)
    printf '%s' "$_prefs" | grep -qE '"CorpDNS":\s*true' &&
    printf '%s' "$_prefs" | grep -qE '"RouteAll":\s*true'
}

icloud_configured()     { rclone listremotes 2>/dev/null | grep -q '^icloud:'; }
claude_desktop_authed() { find "$HOME/.config/Claude" -name '*.json' 2>/dev/null | grep -q .; }
claude_code_authed()    { [ -f "$HOME/.claude/.credentials.json" ] || [ -f "$HOME/.claude/credentials" ]; }

# ---------------------------------------------------------------------------
# Section handlers
# Pattern: if done → prune; else if absent → add; else → leave alone
# ---------------------------------------------------------------------------

section_1password() {
    set -- \
        'Open seahorse' \
        'Create a "login" keyring with no password' \
        'Sign in to 1Password' \
        'Lock, unlock, enter 2FA code' \
        'Settings → Developer → enable "Connect with 1Password CLI" (gatherd-prompt-pia depends on this)' \
        'Settings → Developer → enable "Use the SSH agent" (git/ssh auth via the vault-held key; ~/.ssh/config already points github.com at the agent)'
    if onepassword_keyring_ok; then
        prune_section '1Password' "$@"
    else
        section_present '1Password' && return
        h '1Password'
        for b in "$@"; do li "$b"; done
    fi
}

section_helium() {
    b_ext='Install 1Password browser extension'
    b_ts='Log into Tailscale admin console'
    if helium_1p_extension_ok && tailscale_connected; then
        prune_section 'Helium' "$b_ext" "$b_ts"
    else
        section_present 'Helium' && return
        h 'Helium'
        helium_1p_extension_ok || li "$b_ext"
        tailscale_connected    || li "$b_ts"
    fi
}

section_tailscale() {
    # Never auto-done: exit node check is always relevant after a repave
    section_present 'Tailscale' && return
    h 'Tailscale'
    tailscale_connected   || li 'Connect now — log in this session before rebooting. The operator pref only persists once the node has logged in; reboot while still logged out and the systray says "no permission to manage tailscale", fixed by re-running `sudo tailscale set --operator=$USER`.'
    tailscale_settings_ok || li 'Run `tailscale set --accept-dns=true --accept-routes`'
    li 'Fix exit node: check admin console ("cannot relay traffic")'
}

section_icloud() {
    set -- 'Run `rclone config` and follow prompts to add a remote named `icloud`; complete 2FA when prompted'
    if icloud_configured; then
        prune_section 'iCloud' "$@"
    else
        section_present 'iCloud' && return
        h 'iCloud'
        for b in "$@"; do li "$b"; done
    fi
}

section_claude() {
    b_desktop='Desktop: log in via the app'
    b_code='Code: run `claude` in a terminal'
    if claude_desktop_authed && claude_code_authed; then
        prune_section 'Claude' "$b_desktop" "$b_code"
    else
        section_present 'Claude' && return
        h 'Claude'
        claude_desktop_authed || li "$b_desktop"
        claude_code_authed    || li "$b_code"
    fi
}

section_zoom() {
    # Never auto-done: login state not detectable
    section_present 'Zoom' && return
    h 'Zoom'
    li 'Log in'
    li 'Try sharing a window — confirm screen sharing works under Sway/wlroots'
}

section_jetbrains() {
    # Never auto-done: account-login state isn't reliably detectable. Toolbox
    # autostarts and writes assorted .json by merely running, so any file-based
    # heuristic false-positives and prunes this before you've actually logged in.
    section_present 'JetBrains Toolbox' && return
    h 'JetBrains Toolbox'
    li 'Log in to your JetBrains account by clicking the tray icon'
}

section_unmanaged_wifi() {
    # Content is purely derived from current NM state vs Ansible manifest;
    # always rewrite from scratch so newly joined networks surface promptly.
    [ -r /etc/gatherd/managed-wifi.list ] || {
        section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
        return
    }

    saved=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1 }' \
        | sort -u)
    unmanaged=$(printf '%s\n' "$saved" | grep -vxFf /etc/gatherd/managed-wifi.list || true)

    section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
    [ -n "$unmanaged" ] || return

    h 'Unmanaged WiFi'
    li 'These saved WiFi connections are not in Ansible — consider adding to wifi_networks (SSID) + group_vars/all/vault.yml (PSK):'
    printf '%s\n' "$unmanaged" | while IFS= read -r ssid; do
        [ -n "$ssid" ] && li "  - $ssid"
    done
}

section_vault() {
    set -- \
        'Enter vault password when prompted — WiFi and other secrets will configure in the background' \
        'Run `journalctl -u gatherd-vault.service` to check progress'
    if [ -f /etc/gatherd/vault-complete ]; then
        prune_section 'Vault' "$@"
    else
        section_present 'Vault' && return
        h 'Vault'
        for b in "$@"; do li "$b"; done
    fi
}

section_verify() {
    # Never auto-done: user manages this section manually
    section_present 'Verify' && return
    h 'Verify'
    li 'PIA Quick Tour: on the first launch after a repave, pia-client opens to the login/connect screen, not the multi-step Quick Tour walkthrough (nor the "What'\''s New" dialog). Confirm `grep lastUsedVersion ~/.config/privateinternetaccess/clientsettings.json` matches `/opt/piavpn/bin/piactl --version`'
    li 'PIA: am I actually able to get online with it?'
    li 'Tailscale shutdown: shut down — should complete in under 30 seconds with no "A stop job is running for Tailscale" delay'
    li 'gatherd async/vault services: `systemctl is-failed gatherd-async.service gatherd-vault.service` shows neither failed (the old path-unit start-limit loop is gone), the slow AUR packages installed, and `/etc/gatherd/async-complete` exists. Dropping `.vault_pass` should run them the same session with no reboot.'
    li 'LocalSend startup flash: log out and back in, watching the screen — no LocalSend window should flash up before it settles into the tray. `gatherd-intercept-localsend-flash` (launched from the supervisor just before localsend) stashes the startup surface to scratchpad until LocalSend withdraws it via `--hidden`. If a brief flash returns, confirm the interceptor is installed and still listed in `gatherd-session-helpers`.'
    if is_thinkpad; then
        li 'ThinkVantage button (T60): press blue ThinkVantage button — should open a terminal'
    fi
    if has_ir_receiver; then
        li 'IR receiver: run `ls /dev/lirc* /sys/class/rc/rc* 2>/dev/null` — should show at least one device'
        li 'IR receiver: run `ir-keytable` — confirm device listed with a keymap loaded'
        li 'IR receiver: run `ir-keytable -t -s rc0` and press remote buttons — should show scancode + keycode per press'
    fi
    li 'WiFi unmanaged-network nudge: hand-join any new network, log out and back in — an "Unmanaged WiFi" section listing it should appear in this file'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

[ -f "$OUTPUT" ] || printf 'Manual steps remaining:\n' > "$OUTPUT"

section_verify
section_unmanaged_wifi
section_vault
section_1password
section_helium
section_tailscale
section_icloud
section_claude
section_zoom
section_jetbrains

collapse_blanks
