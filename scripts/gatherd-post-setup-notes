#!/bin/sh
# Manages ~/.config/gatherd-post-setup.md as a living document:
#   - appends sections that are needed but not yet present
#   - when detection says a step is done, removes ONLY the boilerplate lines this
#     script itself generated, leaving anything you added by hand (and dropping a
#     now-empty header). Write freely under any section — your notes are never
#     pruned, with no markers or special formatting to remember.
# Safe to run at any time; gatherd-prompt-postsetup calls it at each login.

# shellcheck disable=SC2016
# The li/section strings deliberately hold literal `backtick` and $(...) command
# text for the reader to paste into their own shell — it is documentation, never
# meant to expand here.

OUTPUT="$HOME/.config/gatherd-post-setup.md"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

h()  { printf '\n# %s\n'  "$1" >> "$OUTPUT"; }

# Render one bullet wrapped to fit an 80-column editor: the first line gets the
# "- " marker, continuation lines a 2-space hanging indent. fold -s breaks only
# at spaces; trailing whitespace is trimmed so the rendering is deterministic —
# prune_section re-renders bullets the same way to find and remove them.
wrap_bullet() {
    printf '%s\n' "$1" | fold -s -w 78 | sed 's/[[:space:]]*$//' | awk '
        NR == 1 { print "- " $0; next }
                { print "  " $0 }'
}

li() { wrap_bullet "$1" >> "$OUTPUT"; }

section_present() { grep -q "^# $1\$" "$OUTPUT" 2>/dev/null; }

# Wipe an entire section, header through the next header — blunt, and only safe
# for the fully-derived Unmanaged WiFi list (regenerated each run, never
# hand-edited). For any section you might annotate, use prune_section instead.
section_remove() {
    awk -v hdr="# $1" '
        $0 == hdr { skip=1; next }
        skip && /^# /  { skip=0 }
        !skip { print }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# Remove only the boilerplate bullets this script generated for a section
# (passed as arguments), leaving any lines you added by hand. If nothing of
# yours remains under the header, drop the header too. This is how "done" steps
# get pruned without ever eating your own notes.
# Drop boilerplate bullets wherever they sit, ignoring section boundaries. Needed
# because h() and li() both append at end of file: when a bullet is added while
# its header already exists further up, h() is skipped and the bullet lands under
# whatever section is currently last. prune_section is scoped to its own header
# and so can never reach those orphans. Matching is on the whole rendered bullet,
# so this only ever removes text this script itself wrote.
# Append bullets at the END of an existing section, before the next "# " header
# (or at EOF for the last section). h() and li() can only append at end of file,
# which is right for a section being created and wrong for one that already
# exists further up -- the bullets would land under whatever section is last.
append_to_section() {
    _hdr="$1"; shift
    _new=$(for _b in "$@"; do wrap_bullet "$_b"; done)
    [ -n "$_new" ] || return 0
    APPEND_NEW="$_new" awk -v hdr="# $_hdr" '
        $0 == hdr           { print; inside = 1; next }
        inside && /^# /     { print ENVIRON["APPEND_NEW"]; inside = 0 }
                            { print }
        END                 { if (inside) print ENVIRON["APPEND_NEW"] }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# Where Verify remembers what it has already offered you. Without this the whole
# section was written once and then frozen for the life of the file: the guard
# was `section_present Verify && return`, so every check added after your notes
# were first generated -- fourteen of them, by the time anyone noticed -- never
# reached the file at all. Re-rendering the section instead is not an option
# either: you tick an item off by DELETING it, so a plain re-render would
# resurrect everything you have already done.
#
# Per-bullet ids are the way out. A bullet is offered exactly once, whether or
# not it is still in the file, so new checks arrive and finished ones stay gone.
# The id is a hash of the bullet text, so editing a check makes it a new check
# and it comes back -- which is what you want, since a reworded check is one you
# have not run in that form.
VERIFY_SEEN="${XDG_STATE_HOME:-$HOME/.local/state}/gatherd/post-setup-verify-seen"

verify_li() {
    _vid=$(printf '%s' "$1" | sha256sum | cut -c1-16)
    grep -qxF -- "$_vid" "$VERIFY_SEEN" 2>/dev/null && return 0
    mkdir -p "${VERIFY_SEEN%/*}"
    printf '%s\n' "$_vid" >> "$VERIFY_SEEN"

    # Migration for notes written before this mechanism existed: those bullets
    # are in the file but in no seen-list, and re-adding them would duplicate.
    # The first rendered line is enough to recognise one.
    # -- because a rendered bullet starts with "- ", which grep would otherwise
    # parse as options rather than as the pattern.
    grep -qxF -- "$(wrap_bullet "$1" | head -1)" "$OUTPUT" 2>/dev/null && return 0

    if [ "$_verify_section_existed" = yes ]; then
        append_to_section 'Verify' "$1"
    else
        li "$1"
    fi
}

prune_bullets_anywhere() {
    _own=$(for _b in "$@"; do wrap_bullet "$_b"; printf '@@PRUNE_SEP@@\n'; done)
    PRUNE_OWN="$_own" awk '
        BEGIN {
            n = split(ENVIRON["PRUNE_OWN"], L, "\n")
            b = ""
            for (i = 1; i <= n; i++) {
                if (L[i] == "@@PRUNE_SEP@@") { if (b != "") own[b] = 1; b = ""; continue }
                b = (b == "") ? L[i] : b "\n" L[i]
            }
        }
        function endgrp(   j, m, gl) {
            if (!ingrp) return
            if (!(g in own)) { m = split(g, gl, "\n"); for (j = 1; j <= m; j++) print gl[j] }
            ingrp = 0; g = ""
        }
        /^- /          { endgrp(); ingrp = 1; g = $0; next }
        ingrp && /^  / { g = g "\n" $0; next }
                       { endgrp(); print }
        END            { endgrp() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

prune_section() {
    _name=$1
    shift
    # A missing header does not mean the bullets are gone — they may be orphaned
    # under a later section. Sweep for them instead of returning empty-handed.
    section_present "$_name" || { prune_bullets_anywhere "$@"; return; }
    # Re-render each boilerplate bullet exactly as li() wrote it (wrapping and
    # all), separated by a sentinel line, so awk matches and drops the whole
    # possibly-multi-line bullet as a unit while leaving hand-added lines verbatim.
    _own=$(for _b in "$@"; do wrap_bullet "$_b"; printf '@@PRUNE_SEP@@\n'; done)
    PRUNE_OWN="$_own" awk -v hdr="# $_name" '
        BEGIN {
            n = split(ENVIRON["PRUNE_OWN"], L, "\n")
            b = ""
            for (i = 1; i <= n; i++) {
                if (L[i] == "@@PRUNE_SEP@@") { if (b != "") own[b] = 1; b = ""; continue }
                b = (b == "") ? L[i] : b "\n" L[i]
            }
        }
        # A bullet group is a "- " line plus its "  " continuation lines; drop the
        # whole group if it matches a boilerplate bullet, else keep it verbatim.
        function endgrp(   j, m, gl) {
            if (!ingrp) return
            if (!(g in own)) {
                m = split(g, gl, "\n")
                for (j = 1; j <= m; j++) { out[++on] = gl[j]; if (gl[j] != "") nonblank = 1 }
            }
            ingrp = 0; g = ""
        }
        function flush(   j) {
            endgrp()
            if (nonblank) { print hdr; for (j = 1; j <= on; j++) print out[j] }
            on = 0; nonblank = 0
        }
        $0 == hdr      { inseg = 1; on = 0; nonblank = 0; ingrp = 0; g = ""; next }
        inseg && /^# / { flush(); inseg = 0; print; next }
        inseg {
            if ($0 ~ /^- /)          { endgrp(); ingrp = 1; g = $0; next }
            if (ingrp && $0 ~ /^  /) { g = g "\n" $0; next }
            endgrp(); out[++on] = $0; if ($0 != "") nonblank = 1; next
        }
                       { print }
        END            { if (inseg) flush() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

collapse_blanks() {
    awk 'prev_blank && /^$/ { next } { prev_blank=(/^$/); print }' \
        "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# ---------------------------------------------------------------------------
# App state detection
# ---------------------------------------------------------------------------

# The SSH-agent socket appears only once "Use the SSH agent" is enabled — the
# last 1Password setup step, so a good proxy for the whole section being done.
onepassword_ssh_agent_ok() { [ -S "$HOME/.1password/agent.sock" ]; }

tailscale_connected() { tailscale ip >/dev/null 2>&1; }

# Sentinels rather than a live probe: this script runs at every login, and
# `rclone listremotes` now shells out to op for the config password, which
# blocks on a locked 1Password. Both files are written by gatherd-icloud-config
# and gatherd-icloud-sync.
_icloud_state="$HOME/.local/state/gatherd"
icloud_fleet_ok()    { [ -f "$_icloud_state/icloud-fleet-ok" ]; }
icloud_needs_reauth() { [ -f "$_icloud_state/icloud-needs-reauth" ]; }
icloud_plaintext_config() { [ -f "$_icloud_state/icloud-plaintext-config" ]; }

# ---------------------------------------------------------------------------
# Section handlers
# Pattern: if done → prune; else if absent → add; else → leave alone
# ---------------------------------------------------------------------------

section_1password() {
    set -- \
        'Sign in to 1Password' \
        'Lock, unlock, enter 2FA code' \
        'Settings → Developer: enable "Connect with 1Password CLI" and "Use the SSH agent"'
    if onepassword_ssh_agent_ok; then
        prune_section '1Password' "$@"
    else
        section_present '1Password' && return
        h '1Password'
        for b in "$@"; do li "$b"; done
    fi
}

section_tailscale() {
    set -- \
        'Connect during this session before rebooting. Set up 1Password (including its browser extension) first — then Tailscale offers to log you in via Apple SSO and 1Password fills it correctly.'
    if tailscale_connected; then
        prune_section 'Tailscale' "$@"
    else
        section_present 'Tailscale' && return
        h 'Tailscale'
        for b in "$@"; do li "$b"; done
    fi
}

section_other_logins() {
    # Only iCloud earns a standing reminder here. Claude Desktop/Code, Zoom, and
    # JetBrains are deliberately not surfaced — logging into them is obvious on
    # demand and didn't merit a recurring nag. PIA needs nothing here either: it
    # logs in automatically from 1Password via gatherd-prompt-pia at every login.
    #
    # Two mutually exclusive iCloud lines, both self-pruning. Bootstrap is a
    # once-per-fleet step, so it only appears on a machine that has never seen a
    # fleet config. Re-auth is periodic and unavoidable — the session token
    # expires whatever we do — so it appears whenever a sync hits an auth error
    # and disappears on the next success.
    b_bootstrap='iCloud: run `gatherd-icloud-config bootstrap` (once per fleet; needs `rclone config` + 2FA first if this is the very first machine)'
    b_reauth='iCloud needs re-authentication: run `rclone config reconnect icloud:` and complete 2FA — every other machine picks it up automatically'
    b_plaintext='iCloud config is plaintext (a live iCloud token sits unencrypted on disk): run `rclone config encryption set`'

    # The bullet this feature replaced. prune_section matches on bullet text, so
    # renaming a bullet orphans the old wording in every notes file that already
    # had it — self-pruning only ever removes text it can still name. A machine
    # provisioned before the fleet-config work therefore kept telling its human
    # to run `rclone config` long after that step became both unnecessary and
    # actively wrong. Prune it unconditionally, forever: it is cheap, and a
    # machine that legitimately needs setup gets b_bootstrap below instead.
    prune_section 'Other Logins' 'iCloud: run `rclone config` and follow prompts to add a remote named `icloud`; complete 2FA when prompted'

    # Each branch prunes its own bullet before possibly re-adding it, not just
    # when it's due to disappear: `li` only appends, so guarding the add with
    # `section_present || h` (skip the header, not the bullet) still let a
    # bullet that survived from the previous run get a second copy appended
    # underneath it. Prune-then-add makes each bullet idempotent regardless of
    # what the file already looked like.
    if icloud_fleet_ok; then
        prune_section 'Other Logins' "$b_bootstrap"
    else
        prune_section 'Other Logins' "$b_bootstrap"
        section_present 'Other Logins' || h 'Other Logins'
        li "$b_bootstrap"
    fi

    if icloud_needs_reauth; then
        prune_section 'Other Logins' "$b_reauth"
        section_present 'Other Logins' || h 'Other Logins'
        li "$b_reauth"
    else
        prune_section 'Other Logins' "$b_reauth"
    fi

    if icloud_plaintext_config; then
        prune_section 'Other Logins' "$b_plaintext"
        section_present 'Other Logins' || h 'Other Logins'
        li "$b_plaintext"
    else
        prune_section 'Other Logins' "$b_plaintext"
    fi
}

section_unmanaged_wifi() {
    # Content is purely derived from current NM state vs Ansible manifest;
    # always rewrite from scratch so newly joined networks surface promptly.
    [ -r /etc/gatherd/managed-wifi.list ] || {
        section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
        return
    }

    saved=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1 }' \
        | sort -u)
    # Suppress both the Ansible-managed networks and any you've durably dismissed
    # in the local ack file. The ack file is per-machine and intentionally not
    # carried across a repave — a fresh machine re-surfaces every unmanaged net.
    _exclude=$(mktemp)
    cat /etc/gatherd/managed-wifi.list > "$_exclude"
    _ack="$HOME/.config/gatherd/wifi-ignore.list"
    [ -r "$_ack" ] && cat "$_ack" >> "$_exclude"
    unmanaged=$(printf '%s\n' "$saved" | grep -vxFf "$_exclude" || true)
    rm -f "$_exclude"

    section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
    [ -n "$unmanaged" ] || return

    # Build the block on its own, then splice it just under the top "Manual steps
    # remaining:" line. This section regenerates every run and would otherwise
    # re-append at the bottom, but it belongs above Verify.
    _blk=$(mktemp)
    _main=$OUTPUT
    OUTPUT=$_blk
    h 'Unmanaged WiFi'
    li 'Either keep in Ansible (vault/vault.yml) or append to ~/.config/gatherd/wifi-ignore.list:'
    printf '%s\n' "$unmanaged" | while IFS= read -r ssid; do
        [ -n "$ssid" ] && printf '  - %s\n' "$ssid" >> "$OUTPUT"
    done
    OUTPUT=$_main

    { head -n 1 "$OUTPUT"; cat "$_blk"; tail -n +2 "$OUTPUT"; } \
        > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
    rm -f "$_blk"
}

section_vault() {
    set -- \
        'Enter password when prompted' \
        'Run `journalctl -u gatherd-vault.service` to check progress'
    if [ -f /etc/gatherd/vault-complete ]; then
        prune_section 'Vault' "$@"
    else
        section_present 'Vault' && return
        h 'Vault'
        for b in "$@"; do li "$b"; done
    fi
}

section_verify() {
    # Never auto-done: you manage this section manually, ticking items off by
    # deleting them. See verify_li for how new checks still reach an existing
    # file without resurrecting the ones you have finished.
    if section_present 'Verify'; then
        _verify_section_existed=yes
    else
        _verify_section_existed=no
        h 'Verify'
    fi
    verify_li 'IR remote (machines with an IR receiver only): `ir-keytable -t -s rc0` prints a scancode and keycode for each button press.'
    verify_li 'Convergence is fail-open: `/usr/local/lib/gatherd/scripts/gatherd-selftest-failopen --toast` prints `PASS` for all four outcomes and pops the toast a failing boot would show.'
    verify_li 'The greeter is off the network. Boot with the network DISCONNECTED: the greeter comes up with no ~60s wait-online stall, and the first session has fonts, keybindings, wallpaper and keyring.'
    verify_li 'Both tiers converged: `head -1 /etc/gatherd/core-complete` and `head -1 /etc/gatherd/async-complete` both match `git -C /usr/local/lib/gatherd rev-parse HEAD`, and `head -1 /etc/gatherd/last-run` prints `ok`.'
    verify_li 'No package drifts from the offline-cache manifest: `/usr/local/lib/gatherd/scripts/gatherd-check-package-tiers /usr/local/lib/gatherd` exits `0`.'
    verify_li 'AUR packages build unprivileged and install from the local repo, with no sudoers grant issued at any point: `sudo grep -c '"'"'NOPASSWD: /usr/bin/pacman'"'"' /etc/sudoers` prints `0` and `sudo grep -rl NOPASSWD /etc/sudoers.d | wc -l` prints `2` -- during a build, and after killing a converge mid-build. Nothing reached the machine outside the repo: `comm -13 <(pacman -Slq gatherd-aur | sort) <(pacman -Qmq | sort)` prints aurutils and nowayprompt and nothing else.'
    verify_li 'GRUB shows the wallpaper at boot, and on the MiniBook X'"'"'s rotated panel the art reads upright (the menu text stays sideways; GRUB cannot fix that).'
    verify_li 'Credential prompts wear the crimson house style: `sudo -k; sudo id -u` in a NEW terminal pops the box reading `elevating: id -u` and `requested by foot`. ssh host-key questions use the same box, not a separate foot window.'
    verify_li 'iCloud sync: `gatherd-icloud-config status` prints `config: encrypted, verified; fleet: in sync`, and `gatherd-icloud-sync FSNotes` populates `~/Documents/iCloud/FSNotes`.'
    verify_li 'iCloud syncs on unlock: `rm -f ~/.local/state/gatherd/icloud-sync.stamp` (the trigger is --if-due with a 300s floor), lock the screen, unlock, and the stamp is back.'
    verify_li 'Tablet mode comes from chuwi-minibook-tablet-mode rather than gatherd: `git -C ~/.local/src/chuwi-minibook-tablet-mode describe --tags` matches `tablet_mode_upstream_version`, and `command -v minibook-tablet-mode` resolves under `~/.local/bin`.'
    verify_li 'CORE creates `~/.config/minibook-tablet-mode/` itself, before the clone that owns it exists. `rm -rf ~/.config/minibook-tablet-mode ~/.local/src/chuwi-minibook-tablet-mode && sudo rm -f /etc/gatherd/core-complete && sudo systemctl start gatherd.service`, then `last-run` reads `ok` and the config and menu are there with no clone.'
    verify_li 'Fold the machine: it turns portrait, keyboard and touchpad go dead, touch lands under your finger. Unfold: everything comes back. No keystroke enters tablet mode. The edge power button always offers `Exit tablet mode` -- including after `rm -f "$XDG_RUNTIME_DIR/minibook-tablet-mode/tablet-mode"`, which is what once stranded a human.'
    verify_li 'Folded, turning the tablet rotates the display to match within about a second and holds steady when still; the score reads upright in all four orientations. `minibook-tablet-mode off` restores the transform it started at.'
    verify_li 'Music stand: `gatherd-music-stand on` picks composer then score and opens it fullscreen in koreader, screen no longer blanking; a left-edge tap goes BACK a page. `Close score` from the folded menu leaves no viewer running. Check the score fills the screen both when you fold with it already open and when you pick one while folded.'
    verify_li 'Vesktop reaches Discord without downloading Vencord, on a link too slow to have fetched it. `truncate -s 8000 ~/.config/vesktop/sessionData/vencordFiles/vencordDesktopMain.js`, then a converge puts all 11 files back; an intact bundle survives a converge untouched.'
    verify_li 'Once on the tailnet, Tailscale goes silent: no `# Tailscale` section in these notes, and `gatherd-prompt-tailscale` exits in well under a second without opening a browser tab.'
    verify_li 'Shutdown does not stall on the NFS umount helper: reboot to POST is well under 10s. `autofs.service: Failed with result (timeout)` in `journalctl -b -1` is EXPECTED -- umount.nfs4 always has to be killed.'
    verify_li 'Every web app carries 1Password: open any of them from the launcher and the vault is there without a per-profile sign-in. (A one-time welcome page per profile is expected.)'
    verify_li 'Duolingo speaking exercises work: a German exercise accepts your voice, recognized locally so no audio leaves the machine, and no microphone prompt appears. The window has one tab, no tab strip or address bar, and 1Password'"'"'s vault without signing in.'
    verify_li 'A verify step added after these notes already existed still reaches them, and one you delete stays deleted across logins.'
    verify_li 'A converged machine needs neither the network nor the pacman lock to stay converged: with `sudo touch /var/lib/pacman/db.lck` held, a converge is still green. `sudo rm -f /var/lib/pacman/db.lck` afterwards.'
    verify_li 'The doubt hooks are installed and the commit one fires only on commits: `echo '"'"'{"tool_input":{"command":"ls"}}'"'"' | ~/.local/bin/gatherd-doubt-commit-hook` prints nothing, and the same with `git commit -m x` prints a JSON reminder.'
    verify_li 'A converge never touches a real Chromium profile: `sudo pacman -S --noconfirm chromium`, `mkdir -p ~/.config/chromium && echo x > ~/.config/chromium/History`, converge, and `History` is still there.'
    verify_li 'The migration ledger is complete: `/usr/local/lib/gatherd/scripts/gatherd-check-migrations /usr/local/lib/gatherd` exits `0`.'
    verify_li 'The ADHD skill loads unasked: `ls ~/.claude/.i-have-adhd-always` exists, and a fresh `claude` session answers `/i-have-adhd` without a marketplace prompt.'
    verify_li 'Sheet music fetches itself: `rm -f ~/.local/state/gatherd/musicscores-fetch.stamp && gatherd-musicscores-fetch && cat ~/.local/state/gatherd/musicscores-fetch.stamp` prints a timestamp (no stamp means no fetch happened, whatever the exit code), and `ls ~/Documents/forscore/*.pdf | wc -l` matches forScore. If the Mac cannot be logged into it says so rather than exiting quietly.'
    verify_li 'Claude Desktop signs in once and stays signed in: open Claude from the app menu and `pgrep -af "^/usr/lib/claude-desktop/claude-desktop --password-store=gnome-libsecret"` prints it (that flag is only there if the launch went through our wrapper). Quit it, open it again: still signed in, no "Your sign-in won'"'"'t be saved on this device" toast.'
    verify_li 'Every configured pacman repo has a sync database, so a plain `pacman -S` works: `pacman -Sp bash` prints `bash`, not `could not find database`.'
    verify_li 'One failing tier no longer takes the rest down: `sudo mv /usr/bin/tailscale{,.bak}`, then `sudo rm -f /etc/gatherd/async-complete && sudo systemctl start gatherd-async.service`. Every other tier converges and the run ends `1 REST tier(s) did not converge: tailscale (Set tailscale operator)`, with no `async-complete` written. Restore the binary, start it again, and the sentinel is back.'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

[ -f "$OUTPUT" ] || printf 'Manual steps remaining:\n' > "$OUTPUT"

section_unmanaged_wifi
section_verify
section_vault
section_1password
section_tailscale
section_other_logins

collapse_blanks
