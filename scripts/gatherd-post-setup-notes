#!/bin/sh
# Manages ~/.config/gatherd-post-setup.md as a living document:
#   - appends sections that are needed but not yet present
#   - when detection says a step is done, removes ONLY the boilerplate lines this
#     script itself generated, leaving anything you added by hand (and dropping a
#     now-empty header). Write freely under any section — your notes are never
#     pruned, with no markers or special formatting to remember.
# Safe to run at any time; gatherd-prompt-postsetup calls it at each login.

# shellcheck disable=SC2016
# The li/section strings deliberately hold literal `backtick` and $(...) command
# text for the reader to paste into their own shell — it is documentation, never
# meant to expand here.

OUTPUT="$HOME/.config/gatherd-post-setup.md"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

h()  { printf '\n# %s\n'  "$1" >> "$OUTPUT"; }

# Render one bullet wrapped to fit an 80-column editor: the first line gets the
# "- " marker, continuation lines a 2-space hanging indent. fold -s breaks only
# at spaces; trailing whitespace is trimmed so the rendering is deterministic —
# prune_section re-renders bullets the same way to find and remove them.
wrap_bullet() {
    printf '%s\n' "$1" | fold -s -w 78 | sed 's/[[:space:]]*$//' | awk '
        NR == 1 { print "- " $0; next }
                { print "  " $0 }'
}

li() { wrap_bullet "$1" >> "$OUTPUT"; }

section_present() { grep -q "^# $1\$" "$OUTPUT" 2>/dev/null; }

# Wipe an entire section, header through the next header — blunt, and only safe
# for the fully-derived Unmanaged WiFi list (regenerated each run, never
# hand-edited). For any section you might annotate, use prune_section instead.
section_remove() {
    awk -v hdr="# $1" '
        $0 == hdr { skip=1; next }
        skip && /^# /  { skip=0 }
        !skip { print }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# Remove only the boilerplate bullets this script generated for a section
# (passed as arguments), leaving any lines you added by hand. If nothing of
# yours remains under the header, drop the header too. This is how "done" steps
# get pruned without ever eating your own notes.
prune_section() {
    _name=$1
    shift
    section_present "$_name" || return
    # Re-render each boilerplate bullet exactly as li() wrote it (wrapping and
    # all), separated by a sentinel line, so awk matches and drops the whole
    # possibly-multi-line bullet as a unit while leaving hand-added lines verbatim.
    _own=$(for _b in "$@"; do wrap_bullet "$_b"; printf '@@PRUNE_SEP@@\n'; done)
    PRUNE_OWN="$_own" awk -v hdr="# $_name" '
        BEGIN {
            n = split(ENVIRON["PRUNE_OWN"], L, "\n")
            b = ""
            for (i = 1; i <= n; i++) {
                if (L[i] == "@@PRUNE_SEP@@") { if (b != "") own[b] = 1; b = ""; continue }
                b = (b == "") ? L[i] : b "\n" L[i]
            }
        }
        # A bullet group is a "- " line plus its "  " continuation lines; drop the
        # whole group if it matches a boilerplate bullet, else keep it verbatim.
        function endgrp(   j, m, gl) {
            if (!ingrp) return
            if (!(g in own)) {
                m = split(g, gl, "\n")
                for (j = 1; j <= m; j++) { out[++on] = gl[j]; if (gl[j] != "") nonblank = 1 }
            }
            ingrp = 0; g = ""
        }
        function flush(   j) {
            endgrp()
            if (nonblank) { print hdr; for (j = 1; j <= on; j++) print out[j] }
            on = 0; nonblank = 0
        }
        $0 == hdr      { inseg = 1; on = 0; nonblank = 0; ingrp = 0; g = ""; next }
        inseg && /^# / { flush(); inseg = 0; print; next }
        inseg {
            if ($0 ~ /^- /)          { endgrp(); ingrp = 1; g = $0; next }
            if (ingrp && $0 ~ /^  /) { g = g "\n" $0; next }
            endgrp(); out[++on] = $0; if ($0 != "") nonblank = 1; next
        }
                       { print }
        END            { if (inseg) flush() }
    ' "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

collapse_blanks() {
    awk 'prev_blank && /^$/ { next } { prev_blank=(/^$/); print }' \
        "$OUTPUT" > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
}

# ---------------------------------------------------------------------------
# App state detection
# ---------------------------------------------------------------------------

# The SSH-agent socket appears only once "Use the SSH agent" is enabled — the
# last 1Password setup step, so a good proxy for the whole section being done.
onepassword_ssh_agent_ok() { [ -S "$HOME/.1password/agent.sock" ]; }

tailscale_connected() { tailscale ip >/dev/null 2>&1; }

icloud_configured()     { rclone listremotes 2>/dev/null | grep -q '^icloud:'; }

# ---------------------------------------------------------------------------
# Section handlers
# Pattern: if done → prune; else if absent → add; else → leave alone
# ---------------------------------------------------------------------------

section_1password() {
    set -- \
        'Sign in to 1Password' \
        'Lock, unlock, enter 2FA code' \
        'Settings → Developer: enable "Connect with 1Password CLI" and "Use the SSH agent"'
    if onepassword_ssh_agent_ok; then
        prune_section '1Password' "$@"
    else
        section_present '1Password' && return
        h '1Password'
        for b in "$@"; do li "$b"; done
    fi
}

section_tailscale() {
    # Never auto-done: exit node check is always relevant after a repave
    section_present 'Tailscale' && return
    h 'Tailscale'
    tailscale_connected   || li 'Connect during this session before rebooting. Set up 1Password (including its browser extension) first — then Tailscale offers to log you in via Apple SSO and 1Password fills it correctly.'
}

section_other_logins() {
    # Only iCloud earns a standing reminder here, and it auto-prunes once the
    # rclone remote exists. Claude Desktop/Code, Zoom, and JetBrains are
    # deliberately not surfaced — logging into them is obvious on demand and
    # didn't merit a recurring nag. PIA needs nothing here either: it logs in
    # automatically from 1Password via gatherd-prompt-pia at every login.
    b_icloud='iCloud: run `rclone config` and follow prompts to add a remote named `icloud`; complete 2FA when prompted'

    if icloud_configured; then
        prune_section 'Other Logins' "$b_icloud"
    else
        section_present 'Other Logins' && return
        h 'Other Logins'
        li "$b_icloud"
    fi
}

section_unmanaged_wifi() {
    # Content is purely derived from current NM state vs Ansible manifest;
    # always rewrite from scratch so newly joined networks surface promptly.
    [ -r /etc/gatherd/managed-wifi.list ] || {
        section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
        return
    }

    saved=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1 }' \
        | sort -u)
    # Suppress both the Ansible-managed networks and any you've durably dismissed
    # in the local ack file. The ack file is per-machine and intentionally not
    # carried across a repave — a fresh machine re-surfaces every unmanaged net.
    _exclude=$(mktemp)
    cat /etc/gatherd/managed-wifi.list > "$_exclude"
    _ack="$HOME/.config/gatherd/wifi-ignore.list"
    [ -r "$_ack" ] && cat "$_ack" >> "$_exclude"
    unmanaged=$(printf '%s\n' "$saved" | grep -vxFf "$_exclude" || true)
    rm -f "$_exclude"

    section_present 'Unmanaged WiFi' && section_remove 'Unmanaged WiFi'
    [ -n "$unmanaged" ] || return

    # Build the block on its own, then splice it just under the top "Manual steps
    # remaining:" line. This section regenerates every run and would otherwise
    # re-append at the bottom, but it belongs above Verify.
    _blk=$(mktemp)
    _main=$OUTPUT
    OUTPUT=$_blk
    h 'Unmanaged WiFi'
    li 'Either keep in Ansible (vault/vault.yml) or append to ~/.config/gatherd/wifi-ignore.list:'
    printf '%s\n' "$unmanaged" | while IFS= read -r ssid; do
        [ -n "$ssid" ] && printf '  - %s\n' "$ssid" >> "$OUTPUT"
    done
    OUTPUT=$_main

    { head -n 1 "$OUTPUT"; cat "$_blk"; tail -n +2 "$OUTPUT"; } \
        > "${OUTPUT}.tmp" && mv "${OUTPUT}.tmp" "$OUTPUT"
    rm -f "$_blk"
}

section_vault() {
    set -- \
        'Enter password when prompted' \
        'Run `journalctl -u gatherd-vault.service` to check progress'
    if [ -f /etc/gatherd/vault-complete ]; then
        prune_section 'Vault' "$@"
    else
        section_present 'Vault' && return
        h 'Vault'
        for b in "$@"; do li "$b"; done
    fi
}

section_verify() {
    # Never auto-done: user manages this section manually
    section_present 'Verify' && return
    h 'Verify'
    li 'IR receiver (machines with an IR receiver): `ls /dev/lirc* /sys/class/rc/rc* 2>/dev/null` shows at least one device; `ir-keytable` lists the device with a keymap loaded; and `ir-keytable -t -s rc0` while pressing remote buttons shows a scancode + keycode per press.'
    li 'Convergence is fail-open, so a playbook error or hang can never block greetd: `head -1 /etc/gatherd/last-run` prints `ok` after this boot, and any other value (`failed`, `timeout`, `syntax-error`) raised a critical desktop notification at login. Reproduce every failure path here, against a scratch marker so the real status is untouched: `d=$(mktemp -d); g=/usr/local/lib/gatherd/scripts; printf -- "a: b: c:::\n" > "$d/broken.yml"; printf -- "- {hosts: localhost, gather_facts: false, tasks: [{ansible.builtin.command: sleep 600, changed_when: false}]}\n" > "$d/hang.yml"`; then `GATHERD_CORE_MARKER=$d/m GATHERD_CORE_LOG=$d/l $g/gatherd-run-core "$d/broken.yml" >/dev/null 2>&1; echo "$?"; head -1 "$d/m"` prints `0` then `syntax-error` (a bad parse never even attempts a run); `GATHERD_CORE_TIMEOUT=5 GATHERD_CORE_MARKER=$d/m GATHERD_CORE_LOG=$d/l $g/gatherd-run-core "$d/hang.yml" >/dev/null 2>&1; echo "$?"; head -1 "$d/m"` prints `0` then `timeout` (a hang cannot wedge boot); and `GATHERD_CORE_MARKER=$d/m $g/gatherd-prompt-lastrun` pops the critical "gatherd setup: timeout" toast that a failing boot would have shown.'
    li 'GRUB background decodes (the wallpapers are JPEG, and GRUB'"'"'s jpeg reader takes baseline 4:2:0/4:4:4 only — a rejected image fails silently to a plain background): `grep GRUB_BACKGROUND /etc/default/grub` prints the .jpg under /usr/local/lib/gatherd/backgrounds; `grep -c "insmod jpeg" /boot/grub/grub.cfg` prints 1 or more; and the GRUB menu shows the Big Sur image, not a black screen, on the next boot.'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

[ -f "$OUTPUT" ] || printf 'Manual steps remaining:\n' > "$OUTPUT"

section_unmanaged_wifi
section_verify
section_vault
section_1password
section_tailscale
section_other_logins

collapse_blanks
