#!/bin/sh
# Dispatch the power button on tablet state.
#
# The power button is on an edge of the chassis and stays reachable when the
# machine is folded, which makes it the only usable escape hatch once the
# built-in keyboard is disabled. Unfolded, this is transparent: it execs the
# stock EndeavourOS power menu unchanged, so behaviour on every other machine
# and in every other pose is untouched.
#
# See docs/superpowers/specs/2026-08-16-tablet-mode-design.md.
set -eu

# The unfolded fallback: whatever this desktop already uses for the power
# button. Configurable because it is the one genuinely host-specific thing in
# here - EndeavourOS ships this path, another distribution or another
# compositor will not - and a port should not have to edit code to say so.
power_menu="$HOME/.config/sway/scripts/power_menu.sh"
menu_font=""
config="${XDG_CONFIG_HOME:-$HOME/.config}/gatherd/tablet-mode.conf"
# Sourced BEFORE the unfolded fallback below, not after: a configured
# power_menu that is read later than the exec that uses it is not configurable
# at all.
# shellcheck source=/dev/null
[ -r "$config" ] && . "$config"

# Ask the compositor what is actually true, rather than trusting the state
# file alone.
# A disabled built-in keyboard IS the trap this menu exists to escape, and it
# is observable directly; the state file is a record of intent that can go
# stale. When the two disagree, the human is still stuck, so the escape menu
# must still appear - offering the stock power menu (whose entries assume a
# working keyboard) to someone who has none is how a wrong menu becomes a
# lockout.
if ! gatherd-tablet-mode status && ! gatherd-compositor builtin-input-disabled; then
    exec "$power_menu"
fi

# Record what the menu was handed and what came back. This menu has twice
# come up showing its prompt and no entries, on a folded machine with no
# keyboard, and three separate explanations were argued from first principles
# and then falsified by measurement - a stock-menu mix-up, phantom keystrokes
# from the folded keyboard, and a rotation landing mid-map. Guessing has had
# its turn. Cheap enough to run on every press: a handful of bytes when the
# human reaches for the escape hatch, which is not a hot path.
menu_log() {
    _dir="${XDG_STATE_HOME:-$HOME/.local/state}/gatherd"
    mkdir -p "$_dir" 2>/dev/null || return 0
    printf '%s %s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$1" \
        >> "$_dir/power-button.log" 2>/dev/null || true
}

# menu_font (a whole fontconfig string, not just a size) is a multiple of
# foot_font_size, not a constant: it derives from the panel via
# tablet-mode.conf.j2, so this escape hatch stays tappable on any other
# machine gatherd converges. Absent or empty, fuzzel just uses its own
# default, unchanged from before this menu had a font override at all.
set -- --dmenu --prompt 'tablet: ' --lines 4 --width 24
[ -n "$menu_font" ] && set -- "$@" --font "$menu_font"

# Nothing here exits tablet mode, and nothing here powers the machine off.
# Folded IS tablet mode: it began when the hinge folded and it ends when the
# hinge unfolds, so an "exit" entry could only ever mean "undo the fold you
# are still holding" - which the daemon would correct within a poll, and which
# would hand back a keyboard that is lying face-down on the stand. Unfolding
# is the exit, and it is a thing your hands already know how to do.
# The auto-rotate entry states what is true now, not what tapping it does.
# Reading it as an instruction ("Auto-rotate off" = "turn it off") and as a
# status ("it is off") would give opposite meanings, so it is labelled the way
# a checkbox is: the label is the state, and tapping changes it.
if gatherd-tablet-mode rotation-status; then
    rotation_entry='󰑦 Auto-rotate: on'
else
    rotation_entry='󰑧 Auto-rotate: off'
fi

entries=$(printf '%s\n' \
    '󰈙 Pick another score' \
    '󰎈 Close score' \
    "$rotation_entry" \
    '󰅖 Cancel')

# Everything that was true at the moment the menu was built. fuzzel is
# single-instance, so a second one already running is recorded too - it exits
# without drawing, and would otherwise look identical to a menu that drew
# nothing.
_kbd=disabled
gatherd-compositor builtin-input-disabled || _kbd=enabled-or-unknown
_out=$(gatherd-compositor internal-output)
_geom="$_out $(gatherd-compositor output-transform "$_out")"
_fuzzels=0
if command -v pgrep >/dev/null 2>&1; then
    _fuzzels=$(pgrep -x -c fuzzel 2>/dev/null || echo 0)
fi
menu_log "open entries=$(printf '%s\n' "$entries" | grep -c .) kbd=[$_kbd] output=[$_geom] fuzzel_already_running=$_fuzzels"

# `if`, not `selection=$(...); _rc=$?`: under `set -e` a non-zero fuzzel
# aborts at the assignment and $? is never read, so the one outcome most worth
# recording - the menu failing to give anything back - would be the one that
# never got logged.
if selection=$(printf '%s\n' "$entries" | fuzzel "$@"); then
    _rc=0
else
    _rc=$?
    selection=""
fi
menu_log "close rc=$_rc selection=[$selection]"
[ "$_rc" -eq 0 ] || exit 0

case "$selection" in
    *'Close score'*)        gatherd-music-stand close ;;
    *'Auto-rotate'*)        gatherd-tablet-mode rotation-toggle ;;
    # `on`, not `toggle`: tablet mode is already active here, so toggle would
    # exit it. `gatherd-tablet-mode on` is a no-op when already active, so
    # re-running the picker never interrupts the fold.
    *'Pick another score'*) gatherd-music-stand on ;;
    # Escape needs a keyboard, and the human's fuzzel.ini disables
    # exit-on-keyboard-focus-loss, so with the keyboard off in tablet mode
    # this is the only way out of the escape menu that changes nothing. No
    # arm needed for it: it matches no case above, so it already falls
    # through to doing nothing — this arm exists to say so on purpose rather
    # than by omission.
    *'Cancel'*)             : ;;
esac
