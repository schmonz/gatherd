#!/bin/sh
# Dispatch the power button on tablet state.
#
# The power button is on an edge of the chassis and stays reachable when the
# machine is folded, which makes it the only usable escape hatch once the
# built-in keyboard is disabled. Unfolded, this is transparent: it execs the
# stock EndeavourOS power menu unchanged, so behaviour on every other machine
# and in every other pose is untouched.
#
# See docs/superpowers/specs/2026-08-16-tablet-mode-design.md.
set -eu

powermenu="$HOME/.config/sway/scripts/power_menu.sh"

# Ask sway what is actually true, rather than trusting the state file alone.
# A disabled built-in keyboard IS the trap this menu exists to escape, and it
# is observable directly; the state file is a record of intent that can go
# stale. When the two disagree, the human is still stuck, so the escape menu
# must still appear - offering the stock power menu (whose entries assume a
# working keyboard) to someone who has none is how a wrong menu becomes a
# lockout.
builtin_input_disabled() {
    # Positive evidence only: a device that reports no send_events at all
    # (sway does not expose libinput detail for every input) means "unknown",
    # not "disabled". Treating unknown as disabled would pop the tablet escape
    # menu on an ordinary unfolded laptop.
    swaymsg -t get_inputs 2>/dev/null \
        | jq -e '[.[] | select(.type == "keyboard")
                      | select(.identifier | startswith("1:1:"))
                      | .libinput.send_events // empty] | any(. != "enabled")' \
            >/dev/null 2>&1
}

if ! gatherd-tablet-mode status && ! builtin_input_disabled; then
    exec "$powermenu"
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/gatherd/tablet-mode.conf"
menu_font=""
# shellcheck source=/dev/null
[ -r "$config" ] && . "$config"

# menu_font (a whole fontconfig string, not just a size) is a multiple of
# foot_font_size, not a constant: it derives from the panel via
# tablet-mode.conf.j2, so this escape hatch stays tappable on any other
# machine gatherd converges. Absent or empty, fuzzel just uses its own
# default, unchanged from before this menu had a font override at all.
set -- --dmenu --prompt 'tablet: ' --lines 4 --width 24
[ -n "$menu_font" ] && set -- "$@" --font "$menu_font"

# No power/shutdown entry. This menu is reached folded, by touch, with the
# built-in keyboard disabled - the worst possible place to put an irreversible
# action one mis-tap away from `Exit tablet mode`. Unfolding reaches the stock
# power menu with a working keyboard, which is where shutting down belongs.
selection=$(printf '%s\n' \
    '󰊓 Exit tablet mode' \
    '󰎈 Exit music stand' \
    '󰈙 Pick another score' \
    '󰅖 Cancel' \
    | fuzzel "$@") || exit 0

case "$selection" in
    *'Exit tablet mode'*)   gatherd-tablet-mode off ;;
    *'Exit music stand'*)   gatherd-music-stand off ;;
    # `on`, not `toggle`: tablet mode is already active here, so toggle would
    # exit it. `gatherd-tablet-mode on` is a no-op when already active, so
    # re-running the picker never interrupts the fold.
    *'Pick another score'*) gatherd-music-stand on ;;
    # Escape needs a keyboard, and the human's fuzzel.ini disables
    # exit-on-keyboard-focus-loss, so with the keyboard off in tablet mode
    # this is the only way out of the escape menu that changes nothing. No
    # arm needed for it: it matches no case above, so it already falls
    # through to doing nothing — this arm exists to say so on purpose rather
    # than by omission.
    *'Cancel'*)             : ;;
esac
