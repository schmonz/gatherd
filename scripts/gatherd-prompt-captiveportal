#!/bin/sh
# Watches NM connectivity; launches captive-browser on portal detection.
# Runs from sway autostart, not a systemd --user service: the GUI needs the
# graphical session env (WAYLAND_DISPLAY/SWAYSOCK), which a user unit lacks, so
# the browser it spawned never had a display to open on — the original bug.
#
# Event-driven via `nmcli monitor` (NOT a poll loop — polling would respawn
# nmcli every couple seconds and block CPU idle, bad on battery). The catch:
# nmcli's piped stdout is block-buffered, so a lone "Connectivity is now
# 'portal'" line could sit unflushed for ~100s before the read loop saw it
# (observed at LaPromNyack). `stdbuf -oL` forces line buffering so each event is
# delivered the moment nmcli prints it.
#
# Self-restarting (replaces systemd Restart=always): respawns nmcli monitor if
# it exits. captive-browser's output is logged — hitting a portal is a rare,
# hard-to-stage event, so without a log there's nothing to diagnose afterward.
log="${XDG_CACHE_HOME:-$HOME/.cache}/captive-browser.log"
while :; do
    LC_ALL=C stdbuf -oL nmcli monitor 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            *[Cc]onnectivity*[Pp]ortal*)
                # captive-browser and the helium profile it drives are both AUR packages the
                # REST tier installs -- and a portal is exactly what stops REST fetching them.
                # Measured: the base image contains no browser at all, not netsurf, firefox,
                # chromium, epiphany, falkon, qutebrowser, links, lynx, w3m or elinks, only the
                # webkit2gtk-4.1 library. So during a first pave there is genuinely nothing to
                # launch, and the only useful thing this watcher can do is say so rather than
                # go quiet. libnotify and mako are both in tests/base-manifest.txt, so this
                # reaches the screen at the first login.
                command -v captive-browser >/dev/null 2>&1 || {
                    printf '\n===== portal detected %s; captive-browser not installed yet =====\n' \
                        "$(date '+%F %T')" >>"$log"
                    notify-send --urgency=critical --icon=dialog-warning --expire-time=300000 \
                        "Captive portal" \
                        "This network needs a sign-in, and captive-browser is not installed yet. Clear the portal from another device, or connect to a different network -- setup cannot download anything until you do."
                    continue
                }
                pgrep -x captive-browser >/dev/null || {
                    printf '\n===== portal detected %s; launching captive-browser =====\n' \
                        "$(date '+%F %T')" >>"$log"
                    captive-browser >>"$log" 2>&1 &
                }
                ;;
            *[Cc]onnectivity*[Ff]ull*)
                # Authenticated — close the portal window so it's not left in the
                # way. Target the window by app_id (not the helium process name,
                # which the user's main browser shares); closing it makes helium
                # exit, which makes the captive-browser wrapper shut down cleanly.
                pgrep -x captive-browser >/dev/null && {
                    printf '===== connectivity full %s; closing captive-browser =====\n' \
                        "$(date '+%F %T')" >>"$log"
                    swaymsg '[app_id="captive-browser"] kill' >>"$log" 2>&1
                }
                ;;
        esac
    done
    sleep 1
done
