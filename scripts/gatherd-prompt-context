#!/bin/sh
# Answer "what popped this password box?" for gatherd-askpass.
#
# sudo hands its askpass helper nothing -- no SUDO_COMMAND, no SUDO_UID, just
# the invoking user's environment -- and polkit's agent API has no subject
# parameter at all, so neither upstream will tell us who is asking. Reading
# /proc behind their backs is the only route. That makes this a workaround for
# an API gap rather than a load-bearing security control, and it is why this
# lives in its own file: see the spec's "What a correct API would look like".
#
# Always exits 0. A prompt that cannot be annotated must still be shown.

proc="${GATHERD_PROC:-/proc}"

# Field 4 of /proc/<pid>/stat is ppid, but field-splitting on spaces breaks
# when comm contains one ("(Web Content)"). comm is the only parenthesised
# field, so cutting past the last ")" is exact where awk '{print $4}' is not.
ppid_of() {
    sed 's/^.*) //' "$proc/$1/stat" 2>/dev/null | cut -d' ' -f2
}

comm_of() {
    cat "$proc/$1/comm" 2>/dev/null
}

# Keep printable ASCII, drop everything else, and say so if anything went.
# Allowlist rather than blocklist: enumerating what is safe cannot be
# out-flanked by a byte nobody thought of. Metacharacters are deliberately
# kept -- a reader needs to see "curl evil.sh | sh" as it really is; the
# danger was only ever control bytes and escape sequences.
#
# $2 is the truncation length, or 0 for none. --sanitize and --sanitize-long
# both call this so the allowlist itself -- the part that must not be wrong --
# cannot drift between the two modes; only the cap differs.
allowlist() {
    _raw=$1
    _cap=$2
    _clean=$(printf '%s' "$_raw" | LC_ALL=C tr -cd '\40-\176')
    # Track elision independently of truncation. A command can be both
    # over-long and full of control bytes, and reporting only the truncation
    # would hide precisely what this marker exists to disclose.
    _mark=''
    [ "${#_clean}" -ne "${#_raw}" ] && _mark=' [elided]'
    if [ "$_cap" -gt 0 ] && [ "${#_clean}" -gt "$_cap" ]; then
        _clean=$(printf '%s' "$_clean" | cut -c1-"$_cap")...
    fi
    printf '%s%s' "$_clean" "$_mark"
}

sanitize() {
    allowlist "$1" 60
}

# Runs the allowlist FIRST, then checks for a forged "elevating: " or
# "requested by " prefix on the CLEANED, leading-blank-trimmed result. Doing
# it in the other order -- match the raw line, allowlist after -- was the
# bug: a leading control byte or space survives to defeat a match against the
# raw line, then gets stripped (control byte) or simply passed through
# (space) by the allowlist afterward, leaving a byte-exact forgery in the
# only two prefixes that carry a uid-0 privilege attestation. Trimming only
# leading blanks (not the whole line) keeps the match anchored to what a
# reader actually sees at the start of the line, which is what "elevating: "
# vs "  elevating: " both render as.
#
# $2 is the truncation length passed straight through to allowlist (60 for
# --sanitize, 0/no cap for --sanitize-long); only the cap differs between the
# two callers, so the guard itself must not drift between them.
neutralize_line() {
    _nl_line=$(allowlist "$1" "$2")
    _nl_trimmed=${_nl_line#"${_nl_line%%[! ]*}"}
    case "$_nl_trimmed" in
    'elevating: '* | 'requested by '*) _nl_line="unverified: $_nl_line" ;;
    esac
    printf '%s\n' "$_nl_line"
}

# --sanitize is gatherd-askpass's entry point for caller-supplied CONTEXT: a
# polkit message, or the ancestry line assembled below. Any application can
# register a polkit action with attacker-chosen text, so this needs the same
# allowlist as the /proc walk (shared via allowlist()), plus two protections
# that belong specifically to context, not to prompt text in general:
#
#   - capped at 2 lines, because the box has room for exactly the 1-2 lines
#     the /proc walk itself ever produces; more than that is not more
#     context, it is an attempt to push the real content off the visible box.
#   - a line that opens with "elevating: " or "requested by " is neutralised
#     (see neutralize_line above). Those two prefixes are the only strings in
#     this design that carry a uid-0 privilege attestation (see the /proc
#     walk below), so untrusted text reaching the box must not be able to
#     forge them. The line is kept, not dropped -- the reader should still
#     see what was sent, just not mistake it for the real thing.
#
# --sanitize-long is the entry point for a caller-supplied PROMPT string (an
# ssh host-key fingerprint, a passphrase key path): same allowlist and the
# same prefix guard, but no line cap and no truncation. The 2-line cap above
# is about pushing real context off the box, which does not apply to a
# single long prompt string; the prefix guard applies equally here, because
# the host-key description IS the whole box body (see gatherd-askpass) and a
# forged "elevating: " line inside it would look exactly as attested as a
# real one. An ssh fingerprint is legitimately long and multi-line, so
# cutting it to 2 lines or 60 characters would defeat the one prompt where
# reading it in full is the point.
if [ "${1:-}" = '--sanitize' ]; then
    _n=0
    while IFS= read -r _line || [ -n "$_line" ]; do
        _n=$((_n + 1))
        if [ "$_n" -gt 2 ]; then
            break
        fi
        neutralize_line "$_line" 60
    done
    exit 0
fi

if [ "${1:-}" = '--sanitize-long' ]; then
    while IFS= read -r _line || [ -n "$_line" ]; do
        neutralize_line "$_line" 0
    done
    exit 0
fi

pid="${1:-}"

lines=''
add() { lines="${lines:+$lines
}$1"; }

if [ -n "$pid" ] && [ -d "$proc/$pid" ]; then
    # sudo is setuid-root, so the kernel clears its dumpable flag and
    # /proc/<pid>/exe is unreadable to us -- readlink returns empty even though
    # we are the same real user. Ownership of /proc/<pid> survives that: the
    # kernel sets it from the process's euid, so uid 0 proves the process really
    # did gain privilege. That is the check that matters, because any process
    # can set SUDO_ASKPASS and exec us with a fabricated "[sudo]" prompt, and
    # without it such a box would carry a convincing fake command. comm is
    # spoofable via prctl(PR_SET_NAME), so it only picks which privileged tool
    # this is -- it is never what establishes privilege.
    if [ "$(stat -c %u "$proc/$pid" 2>/dev/null)" = "0" ] &&
       [ "$(comm_of "$pid")" = "sudo" ]; then
        # Drop argv[0] (a literal "sudo" or an absolute path, depending on how
        # it was invoked) and the -A we add ourselves in the sudo shell
        # function; it is noise in every prompt the function produces.
        # Nothing else is parsed out: sudo option parsing is subtle enough
        # that guessing wrong would show a command that is not the one being
        # run.
        argv=$(tr '\0' ' ' < "$proc/$pid/cmdline" 2>/dev/null)
        argv=${argv% }
        case "$argv" in
        *' '*) argv=${argv#* } ;;
        *) argv='' ;;
        esac
        argv=${argv#-A}
        argv=${argv# }
        [ -n "$argv" ] && add "elevating: $(sanitize "$argv")"
    fi

    # Name the app, not the shell that happens to sit between it and sudo.
    # Report only comm: a process can rewrite its own argv (that is what
    # setproctitle does), so this line is materially less trustworthy than the
    # one above and must not be dressed up with a full command line.
    #
    # Start at $pid itself, not its parent. sudo stays correctly attributed
    # because it is already in the skip-list below, so a sudo pid still
    # resolves to the first non-shell ancestor above it -- but every other
    # caller (ssh, a spoofed direct exec of gatherd-askpass) IS the process
    # that popped the box, and starting one hop up used to name whatever
    # forked *it* instead: the supervisor or the terminal, not the requester.
    walk=$pid
    hops=0
    while [ -n "$walk" ] && [ "$walk" -gt 1 ] 2>/dev/null && [ "$hops" -lt 12 ]; do
        c=$(comm_of "$walk")
        case "$c" in
        sudo | bash | sh | zsh | dash | fish) ;;
        '') break ;;
        *) add "requested by $(sanitize "$c")"; break ;;
        esac
        walk=$(ppid_of "$walk")
        hops=$((hops + 1))
    done
fi

printf '%s\n' "${lines:-context unavailable}"
