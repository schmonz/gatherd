#!/bin/sh
# Sway autostart helper: fetches the fleet iCloud config once 1Password is
# usable, then establishes any missing local folder copies.
#
# Same readiness problem as gatherd-prompt-pia: `op whoami` is not a usable
# check under desktop-app integration (it only reports an explicit `op signin`),
# so poll an actual read instead — it starts succeeding once the app is running,
# unlocked, and CLI access is authorised.

set -eu

: "${GATHERD_OP_VAULT:=Private}"
: "${GATHERD_OP_PASSWORD_ITEM:=rclone config}"
DEADLINE_SECS="${GATHERD_ICLOUD_DEADLINE:-300}"

# op fast-tier, rclone slow-AUR-tier: on a fresh machine there is a real
# window where op exists and rclone does not. Without this, a machine that
# reaches this script mid-provisioning gets a false "iCloud needs
# re-authentication" notification (from gatherd-icloud-sync's own probe
# failing on a missing binary) instead of the quiet not-ready it deserves.
command -v op >/dev/null 2>&1 || exit 0
command -v rclone >/dev/null 2>&1 || exit 0

_deadline=$(( $(date +%s) + DEADLINE_SECS ))
until op item get "$GATHERD_OP_PASSWORD_ITEM" --vault "$GATHERD_OP_VAULT" >/dev/null 2>&1; do
    [ "$(date +%s)" -lt "$_deadline" ] || exit 0
    sleep 5
done

# Independent concerns, not a pipeline: a machine whose local config works but
# is plaintext takes cmd_pull's push-delegation branch and dies on the
# encryption guard (see note_fleet_install), which used to suppress sync
# entirely, silently, at every login. Neither call's failure should stop the
# other from being attempted.
gatherd-icloud-config pull >/dev/null 2>&1 || true
gatherd-icloud-sync --init-if-empty >/dev/null 2>&1 || true
