#!/bin/sh
# In-session fallback for the vault password. The early console prompt
# (gatherd-prompt-vault-console) normally collects it before login, so on a
# typical pave this self-skips. It still serves the cases where that prompt was
# not answered in time but the operator reached the desktop anyway (autologin
# landing them straight here), and a re-pave triggered from within a session.
#
# gatherd-vault-pass-needed is the single source of truth for whether to ask;
# see it for why a stored password ends the asking. We only start once the
# first-boot system run has finished — before that there is nothing to unblock.
needed=/usr/local/lib/gatherd/scripts/gatherd-vault-pass-needed

test -f /etc/gatherd/core-complete || exit 0

while "$needed"; do
    vault_pass=$("${SUDO_ASKPASS:-/usr/local/bin/gatherd-askpass}" "[vault]") || exit 0
    printf '%s' "$vault_pass" | sudo -n /usr/local/lib/gatherd/scripts/gatherd-write-vault-pass

    # The password is now in flight. gatherd-await-and-run discards it if it
    # fails to decrypt the vault — re-arming the predicate so we re-ask — and
    # keeps it if it works, leaving the predicate false so we stop. Wait on that
    # verdict (or the vault play converging) rather than re-asking immediately.
    while ! "$needed"; do
        test -f /etc/gatherd/vault-complete && exit 0
        sleep 2
    done
done
