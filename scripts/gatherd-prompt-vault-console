#!/bin/sh
# Collect the vault password on the console, early in boot, so the operator can
# enter it up front — right after the LUKS passphrase — and then walk away while
# the rest of the pave runs unattended. Ordered Before=gatherd.service by
# gatherd-prompt-vault-console.service.
#
# Self-skips on every boot where a password is already stored (see
# gatherd-vault-pass-needed) — nearly every boot, where this exits before ever
# prompting. The in-session fuzzel prompt (gatherd-prompt-vault) is the fallback
# for when this one is not answered in time (an unwatched console, or autologin
# landing the operator straight at the desktop).
#
# The prompt is routed through systemd's console ask-password agent
# (systemd-ask-password-console, the same machinery that asks for LUKS
# passphrases under systemd-cryptsetup), NOT by reading the tty ourselves. An
# earlier hand-rolled version did `stty -echo` + `read` on the unit's inherited
# tty and silently received NO keystrokes in the early-boot console: the read
# blocked on a visible, foreground tty1 yet no input arrived, because nothing
# had claimed the console the way a getty or ask-password agent does (activate
# the VT, put it in text mode, become its foreground process group). The agent
# does all of that. PORTABILITY: this is now the one systemd-specific bit of the
# vault flow — the predicate, storage and validation below stay POSIX. An s6 /
# Artix port replaces only the `systemd-ask-password` call with that init's
# console-prompt equivalent.
set -u

# Overridable only so the loop can be exercised against a sandbox in tests.
gatherd_home="${GATHERD_HOME:-/usr/local/lib/gatherd}"
needed="$gatherd_home/scripts/gatherd-vault-pass-needed"
vault_file="$gatherd_home/vault/vault.yml"
vault_pass="$gatherd_home/.vault_pass"

# Bounded so an unwatched or headless console defers to the desktop prompt
# rather than stalling the whole pave: the operator is right here after LUKS, so
# this only has to outlast a few seconds of walking up to the keyboard.
deadline_secs=60

"$needed" || exit 0

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
umask 077

while "$needed"; do
    # --echo=masked shows one * per keystroke so the operator can see input is
    # registering (the old prompt gave no feedback and looked dead). --no-tty
    # forces the broadcast/agent path even if the unit hands us a tty, so the
    # console agent — not our process — owns the console. --timeout bounds the
    # wait so a missing operator defers to the in-session desktop prompt.
    pass=$(systemd-ask-password --no-tty --echo=masked --timeout="$deadline_secs" \
        --icon=dialog-password --id=gatherd:vault \
        '[gatherd] Ansible vault password (or wait to use the desktop prompt):') || {
        printf '[vault] no entry; deferring to the desktop prompt.\n'
        exit 0
    }

    if [ -z "$pass" ]; then
        printf '[vault] no entry; deferring to the desktop prompt.\n'
        exit 0
    fi

    # Validate before storing, so await-and-run never has to discard a bad one
    # here. With no vault file deployed the password only has to exist (matches
    # gatherd-await-and-run's own no-vault branch).
    printf '%s' "$pass" > "$tmp"
    if [ ! -f "$vault_file" ] || ansible-vault view --vault-password-file="$tmp" "$vault_file" >/dev/null 2>&1; then
        cp -- "$tmp" "$vault_pass"
        chmod 600 "$vault_pass"
        printf '[vault] accepted.\n'
        exit 0
    fi

    printf '[vault] that password did not decrypt the vault; try again.\n'
done
