#!/bin/sh
# Session-lifetime supervisor for gatherd's sway-autostart helpers.
#
# Why this exists: sway does not reap its autostart `exec` children, and nothing
# below it kills them on logout either — systemd-logind ships KillUserProcesses=no
# (the distro default), and seatd (what a minimal Artix/s6 sway uses) has no
# session lifecycle at all. So every helper we autostart outlives the session as
# an orphan, and a fresh copy stacks on the next login (observed: three
# captive-portal watchers, three conkys). Fixing it here, in the session layer,
# keeps it init-agnostic — depends only on sway + POSIX sh, so it ports to
# Artix/s6 (seatd or elogind) unchanged. See plans/TODO.md "Session teardown" for
# the full rationale and the rejected alternatives (KillUserProcesses=yes, the
# systemd graphical-session.target/uwsm approach).
#
# Why not XDG autostart (~/.config/autostart/*.desktop): it is the "standard"
# mechanism, but it is the wrong layer here and we deliberately do not use it.
# Reaping on logout is the whole point, and the only thing that reaps XDG
# autostart entries is systemd's xdg-desktop-autostart.target, scoped to
# graphical-session.target — which does not exist on the Artix/s6 + seatd target,
# so the orphans-stacking-every-login bug returns there in full. A bare `Exec=`
# line also can't express what these helpers need: the systray apps must wait for
# a StatusNotifierWatcher (the gatherd-systray wrapper) or their icons silently
# never register, which `.desktop` autostart would race. So gatherd owns session
# autostart here, on purpose, and the apps' own self-registered autostart entries
# are intentionally ignored — they are inert in this sway session (nothing runs
# them). This is the way it needs to be, not a gap to migrate to XDG later.
#
# Mechanism: become a process-group leader, launch the cohort as our children,
# then block until sway's IPC connection closes. That wait is event-driven, not a
# poll: `swaymsg subscribe` returns on the `shutdown` event for a clean exit, and
# on a crash the socket just closes (EOF) and it returns anyway. On wakeup we
# signal the whole process group, so the helpers and their grandchildren (the
# watcher's nmcli monitor, any captive-browser, etc.) all go down together.

# Re-exec once under setsid so we lead our own process group and the group-signal
# below reaches the whole cohort. The env guard prevents an infinite re-exec.
if [ -z "$GATHERD_SUPERVISOR" ]; then
    GATHERD_SUPERVISOR=1 exec setsid -w "$0" "$@"
fi

bin="$HOME/.local/bin"
run() { sh -c "$1" & }

# Sweep any cohort a prior login leaked. One sway session runs at a time, so any
# gatherd helper not in this supervisor's own process group ($$) is a stale
# orphan from a session that failed to reap itself. Kill it by group (SIGKILL,
# no grace — its session is long gone) so each leaf app dies with its wrapper.
# This is the backstop: whichever link in the previous session's teardown broke
# (IPC never reached, supervisor killed mid-wait, an older script), we clear the
# mess here, before launching a fresh cohort — so helpers never stack across
# logins. Skip ourselves and our own setsid launcher by name.
for _pid in $(pgrep -f "$bin/gatherd-" 2>/dev/null); do
    case "$(ps -o args= -p "$_pid" 2>/dev/null)" in
        # Also skip gatherd-show-slow-progress: it is a current-session sibling
        # sway `exec` (not a cohort child, so in its own process group), and its
        # `foot` wrapper's cmdline matches the glob above — without this skip the
        # sweep SIGKILLs the live progress window. It self-terminates once
        # async-complete exists, so a prior session never leaves a stale one.
        # polkit-agent needs no skip: it is a cohort child (below), in our own
        # process group, so the `!= $$` test already spares the live one — while a
        # genuinely leaked one from a prior session still gets swept, as intended.
        *gatherd-session-helpers* | *gatherd-show-slow-progress*) continue ;;
    esac
    _pgid=$(ps -o pgid= -p "$_pid" 2>/dev/null | tr -d ' ')
    [ -n "$_pgid" ] && [ "$_pgid" != "$$" ] && kill -KILL -- "-$_pgid" 2>/dev/null
done

# The cohort: long-running session helpers gatherd autostarts. One-shots and
# things with their own lifecycle (swayidle, gatherd-show-slow-progress) stay as
# plain sway `exec` lines and are intentionally not listed here.
# The polkit agent belongs here, not as a standalone sway `exec`: launched as a
# cohort child it shares our process group, so the stale-orphan sweep above
# spares it and we reap it on logout — a standalone exec sat in its own group and
# the sweep SIGKILL'd the fresh agent every login (its `cmd-polkit-agent -c
# .../gatherd-polkit-agent` cmdline matches the gatherd- glob). Launch it first so
# it is registered before anything can trigger a polkit prompt.
run "$bin/gatherd-polkit-agent"
# xdg-desktop-portal's systemd unit has Requisite=graphical-session.target, which
# we don't activate (init-agnostic design). Start it directly so the Requisite
# check is bypassed; the backends (xdg-desktop-portal-gtk for Qt Settings/dark mode)
# only have PartOf/After, not Requisite, so they D-Bus-activate fine once this runs.
run "/usr/lib/xdg-desktop-portal"
# wayvnc as a cohort child, not a plain sway `exec`: a plain exec would orphan on
# logout (sway reaps nothing) and keep holding 127.0.0.1:5900, so the next
# session's wayvnc could not bind. As a cohort child it dies with the group on
# logout, freeing the port. VNC is localhost-only, reached over SSH — plans/VNC.md.
run "wayvnc"
run "$bin/gatherd-conky"
# Only installed on has_dual_accelerometer machines (roles/desktop/tasks/
# tablet_mode_upstream.yml); `run` on a missing binary just fails quietly like
# any other cohort member would on hardware that lacks it.
run "$bin/minibook-hinge-daemon"
run "$bin/gatherd-prompt-captiveportal"
run "$bin/gatherd-prompt-1password"
run "$bin/gatherd-prompt-tailscale"
run "$bin/gatherd-prompt-postsetup"
run "$bin/gatherd-prompt-vault"
run "$bin/gatherd-prompt-pia"
run "$bin/gatherd-prompt-icloud"
run "$bin/gatherd-prompt-lastrun"
run "env XDG_CURRENT_DESKTOP=GNOME $bin/gatherd-systray 1password --silent"
# Stash LocalSend's startup-window flash before it reaches the screen. Must be
# launched just ahead of localsend so it is already subscribed when the first
# surface maps (see scripts/gatherd-intercept-localsend-flash).
run "$bin/gatherd-intercept-localsend-flash"
run "$bin/gatherd-systray localsend --hidden"
run "$bin/gatherd-systray tailscale systray"
# Sign-in apps (JetBrains Toolbox, Discord/vesktop, Slack, Zoom, …) are
# deliberately never autostarted — not here and not during provisioning. They
# are just installed; open them on demand and sign in via 1Password when needed.
# Nothing special about them, and starting them on every login wastes a potato.
run "$bin/gatherd-systray /opt/piavpn/bin/pia-client --quiet"
run "$bin/gatherd-systray arch-update --tray"

# Teardown runs when this supervisor learns the session is ending, by whichever
# signal arrives first: sway's shutdown event (clean logout) or a TERM/HUP/INT
# (something killing us directly). Both funnel into cleanup() so neither path can
# die bare and strand the cohort — the trap is armed BEFORE we block, closing the
# window where a signal during the wait used to kill us before cleanup ran.
# cleanup ignores the TERM it sends to its own group so it outlives that long
# enough to KILL any straggler.
cleanup() {
    trap '' TERM
    kill -TERM -- "-$$" 2>/dev/null
    sleep 2
    for p in $(pgrep -g "$$" | grep -vx "$$"); do
        kill -KILL "$p" 2>/dev/null
    done
    exit 0
}
trap cleanup TERM HUP INT

# Sway's IPC can lag a moment behind session start on a slow or first boot, so
# retry before giving up rather than stranding the cohort on a single early miss
# (the suspected cause of the first-boot orphan). If it truly never answers we
# exit and leave the cohort running (old leaky-but-functional behavior) — but now
# the next login's startup sweep reaps that leak. This runs detached from sway's
# `exec` and after the cohort is already launched, so it never delays login or
# the helpers coming up; at worst it delays only teardown-readiness.
_n=0
until swaymsg -t get_version >/dev/null 2>&1; do
    _n=$((_n + 1))
    [ "$_n" -ge 30 ] && exit 0
    sleep 1
done

# Block until sway goes away, then take the cohort down with us.
swaymsg -m -t subscribe '["shutdown"]' >/dev/null 2>&1
cleanup
