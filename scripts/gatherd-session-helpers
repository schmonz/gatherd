#!/bin/sh
# Session-lifetime supervisor for gatherd's sway-autostart helpers.
#
# Why this exists: sway does not reap its autostart `exec` children, and nothing
# below it kills them on logout either — systemd-logind ships KillUserProcesses=no
# (the distro default), and seatd (what a minimal Artix/s6 sway uses) has no
# session lifecycle at all. So every helper we autostart outlives the session as
# an orphan, and a fresh copy stacks on the next login (observed: three
# captive-portal watchers, three conkys). Fixing it here, in the session layer,
# keeps it init-agnostic — depends only on sway + POSIX sh, so it ports to
# Artix/s6 (seatd or elogind) unchanged. See plans/TODO.md "Session teardown" for
# the full rationale and the rejected alternatives (KillUserProcesses=yes, the
# systemd graphical-session.target/uwsm approach).
#
# Why not XDG autostart (~/.config/autostart/*.desktop): it is the "standard"
# mechanism, but it is the wrong layer here and we deliberately do not use it.
# Reaping on logout is the whole point, and the only thing that reaps XDG
# autostart entries is systemd's xdg-desktop-autostart.target, scoped to
# graphical-session.target — which does not exist on the Artix/s6 + seatd target,
# so the orphans-stacking-every-login bug returns there in full. A bare `Exec=`
# line also can't express what these helpers need: the systray apps must wait for
# a StatusNotifierWatcher (the gatherd-systray wrapper) or their icons silently
# never register, which `.desktop` autostart would race. So gatherd owns session
# autostart here, on purpose, and the apps' own self-registered autostart entries
# are intentionally ignored — they are inert in this sway session (nothing runs
# them). This is the way it needs to be, not a gap to migrate to XDG later.
#
# Mechanism: become a process-group leader, launch the cohort as our children,
# then block until sway's IPC connection closes. That wait is event-driven, not a
# poll: `swaymsg subscribe` returns on the `shutdown` event for a clean exit, and
# on a crash the socket just closes (EOF) and it returns anyway. On wakeup we
# signal the whole process group, so the helpers and their grandchildren (the
# watcher's nmcli monitor, any captive-browser, etc.) all go down together.

# Re-exec once under setsid so we lead our own process group and the group-signal
# below reaches the whole cohort. The env guard prevents an infinite re-exec.
if [ -z "$GATHERD_SUPERVISOR" ]; then
    GATHERD_SUPERVISOR=1 exec setsid -w "$0" "$@"
fi

bin="$HOME/.local/bin"

# Sweep any cohort a prior login leaked. One sway session runs at a time, so any
# gatherd helper not in this supervisor's own process group ($$) is a stale
# orphan from a session that failed to reap itself. Kill it by group (SIGKILL,
# no grace — its session is long gone) so each leaf app dies with its wrapper.
# This is the backstop: whichever link in the previous session's teardown broke
# (IPC never reached, supervisor killed mid-wait, an older script), we clear the
# mess here, before launching a fresh cohort — so helpers never stack across
# logins.
for _pid in $(pgrep -f "$bin/gatherd-" 2>/dev/null); do
    # Skip by pid, not by name. A backgrounded `{ … } &` subshell inherits this
    # script's argv, so a name test would also spare one LEAKED by a previous
    # session -- which would then wake from the barrier and launch a whole second
    # cohort into this one. Only two processes are genuinely ours: this shell,
    # and the `setsid -w` waiting on it.
    [ "$_pid" = "$$" ] && continue
    [ "$_pid" = "$PPID" ] && continue
    case "$(ps -o args= -p "$_pid" 2>/dev/null)" in
        # gatherd-show-slow-progress still needs sparing: it is a
        # current-session sibling sway `exec` in its own process group, and
        # its `foot` wrapper's cmdline matches the glob above. It
        # self-terminates once async-complete is current, so a prior session
        # never leaves a stale one.
        *gatherd-show-slow-progress*) continue ;;
    esac
    # polkit-agent needs no skip here: it is a cohort child (below), in our
    # own process group, so this `!= $$` pgid test already spares the live
    # one -- while a genuinely leaked one from a prior session still gets
    # swept, as intended.
    _pgid=$(ps -o pgid= -p "$_pid" 2>/dev/null | tr -d ' ')
    [ -n "$_pgid" ] && [ "$_pgid" != "$$" ] && kill -KILL -- "-$_pgid" 2>/dev/null
done

# The cohort: long-running session helpers gatherd autostarts. One-shots and
# things with their own lifecycle (swayidle, gatherd-show-slow-progress) stay as
# plain sway `exec` lines and are intentionally not listed here.
#
# Three launch forms, split on WHEN each helper's subject exists. sway starts
# this the instant the session does, which on a repave is minutes before the REST
# tier installs what most of these helpers are about. A helper started ahead of
# its subject probes, finds nothing, and exits without saying so; measured on the
# 2026-09-07 repave, that silently lost every one of them for the whole first
# session, including the Tailscale and 1Password browser tabs that are the only
# reason a fresh machine needs a human at all. scripts/gatherd-await-async
# carries the measurements.
#
#   start_now    immediate. Carries a `# needs:` declaration of the packages that
#                must already be installed. CORE installs no packages, so that
#                means "in tests/base-manifest.txt" and nothing else;
#                scripts/gatherd-check-session-cohort enforces exactly that, and
#                an undeclared start_now is a hard failure rather than a silent
#                bet.
#   start_later  behind the barrier, inside the block below. The default. When in
#                doubt use it: waiting costs a converged machine nothing (the
#                barrier returns at once) and costs a repave only the minutes
#                during which the helper had nothing to work with anyway.
#   start_when   behind a wait for one named command. For the helper whose
#                subject lands materially earlier than the end of the run.
start_now()   { sh -c "$1" & }
start_later() { sh -c "$1" & }

# Bounded the same way the barrier is, and always proceeds: a helper must never
# be suppressed because a wait could not decide.
start_when() {
    _cmd=$1
    shift
    sh -c '
        # Overridable only so the expiry path can be exercised in tests --
        # same idiom as GATHERD_AWAIT_ASYNC_TIMEOUT in gatherd-await-async.
        # 1800 iterations * the 2s sleep below = 3600s. A bound of its own,
        # not a copy of the barrier bound: this waits for one package, and in
        # the measured run nowayprompt was installed at 11:37:48, about four
        # minutes after the 11:33:55 session start, where the barrier waits for
        # the whole tier.
        _bound=${GATHERD_START_WHEN_TIMEOUT:-1800}
        case "$_bound" in
        "" | *[!0-9]*) _bound=1800 ;;
        esac
        _n=0
        while ! command -v "$1" >/dev/null 2>&1; do
            _n=$((_n + 1))
            [ "$_n" -ge "$_bound" ] && break
            sleep 2
        done
        shift
        exec sh -c "$1"
    ' _ "$_cmd" "$1" &
}

# --- Immediately: needed DURING the pave, and subject is already in base ---

# xdg-desktop-portal's systemd unit has Requisite=graphical-session.target, which
# we don't activate (init-agnostic design). Start it directly so the Requisite
# check is bypassed; the backends (xdg-desktop-portal-gtk for Qt Settings/dark mode)
# only have PartOf/After, not Requisite, so they D-Bus-activate fine once this runs.
start_now "/usr/lib/xdg-desktop-portal"  # needs: xdg-desktop-portal
# A watcher, not a probe, so it is immediate even though captive-browser itself
# arrives with REST: what it needs at start is nmcli, and it must already be
# listening when a portal appears. It cannot actually clear one during a pave --
# nothing in the base image can, measured -- so on a portal hit with no
# captive-browser installed it logs the detection and raises a critical
# notification telling the human to clear the portal from another device.
start_now "$bin/gatherd-prompt-captiveportal"  # needs: networkmanager coreutils procps-ng sway libnotify
# Reports the CORE run's outcome, which is settled before the greeter appears.
start_now "$bin/gatherd-prompt-lastrun"  # needs: libnotify coreutils

# --- When its own renderer exists ---

# It looks like it belongs above -- it exists to unblock site-vault.yml while the
# pave is still running -- and it cannot go there: it prompts through
# SUDO_ASKPASS, i.e. gatherd-askpass, which renders with nowayprompt, a REST
# package. Nor does it belong behind the barrier, because nowayprompt lands at
# ~11:37 and the run does not end until ~11:49, and those twelve minutes are the
# difference between the WiFi configuration landing during the pave or after it.
start_when nowayprompt "$bin/gatherd-prompt-vault"

# --- Behind the barrier: subject is installed by the REST tier ---
#
# One barrier for the whole group rather than one per helper, so the wait is
# polled once instead of a dozen times. The group is a child of this
# supervisor, so it stays in our process group and the teardown below still
# reaps it. Source order within the group is preserved as WRITTEN (each
# start_later call forks in sequence) but that is not itself a runtime
# ordering guarantee -- see the localsend/systray pair below for the one place
# that matters and why it actually holds.
{
    "$bin/gatherd-await-async"

    # The polkit agent belongs here, not as a standalone sway `exec`: launched as a
    # cohort child it shares our process group, so the stale-orphan sweep above
    # spares it and we reap it on logout — a standalone exec sat in its own group and
    # the sweep SIGKILL'd the fresh agent every login (its `cmd-polkit-agent -c
    # .../gatherd-polkit-agent` cmdline matches the gatherd- glob). Launched first as
    # a best effort, not a guarantee: nothing enforces registration order among
    # the 16 members below, which all now fire in a tight cluster at barrier
    # release, rather than spread across a slow login the way they used to be.
    # cmd-polkit registers quickly regardless; a prompt raised before it does
    # gets a bare denial instead of a UI.
    start_later "$bin/gatherd-polkit-agent"
    # wayvnc as a cohort child, not a plain sway `exec`: a plain exec would orphan on
    # logout (sway reaps nothing) and keep holding 127.0.0.1:5900, so the next
    # session's wayvnc could not bind. As a cohort child it dies with the group on
    # logout, freeing the port. VNC is localhost-only, reached over SSH — plans/VNC.md.
    #
    # Deliberately left start_later rather than start_when: wayvnc's own
    # package lands ~14 minutes before barrier release -- a longer margin than
    # the ~12 minutes cited for nowayprompt above -- so it would also qualify,
    # and remote GUI access during a pave is exactly when you'd want it.
    # Whether that's the right behavior is a preference about how the machine
    # should act while paving, not a defect, so it's left for a human call
    # rather than decided here.
    start_later "wayvnc"
    start_later "$bin/gatherd-conky"
    # Only installed on has_dual_accelerometer machines (roles/desktop/tasks/
    # tablet_mode_upstream.yml); starting a missing binary just fails quietly like
    # any other cohort member would on hardware that lacks it.
    start_later "$bin/minibook-hinge-daemon"
    start_later "$bin/gatherd-prompt-1password"
    start_later "$bin/gatherd-prompt-tailscale"
    # Behind the barrier so its detection sees the finished machine. Run ahead of
    # REST it writes "Sign in to 1Password" against a machine where 1Password is
    # not installed yet, and then -- because each section is only added once --
    # never revisits the sections it got wrong.
    start_later "$bin/gatherd-prompt-postsetup"
    start_later "$bin/gatherd-prompt-pia"
    start_later "$bin/gatherd-prompt-icloud"
    # One-shot, not a watcher: it rate-limits itself and exits. Login only, unlike
    # iCloud's extra unlock trigger — the Mac it pulls from is usually asleep, and
    # scores change on the order of weeks, so retrying on every unlock would buy
    # nothing but wakeups.
    start_later "$bin/gatherd-musicscores-fetch --if-due"
    start_later "env XDG_CURRENT_DESKTOP=GNOME $bin/gatherd-systray 1password --silent"
    # Stash LocalSend's startup-window flash before it reaches the screen.
    # Source order is not what guarantees this: start_later just forks in
    # sequence, and two forks issued a couple of milliseconds apart race under
    # the scheduler -- measured, the interceptor landed after this line's
    # systray call in 1 of 3 sandbox reruns when both stubs were equally cheap
    # (see the smoke test in the Task 7 report). What actually protects it is
    # an asymmetry in the two paths: the interceptor only has to open a sway
    # IPC subscription, while gatherd-systray pays a D-Bus round trip to the
    # StatusNotifierWatcher -- already registered by barrier release, so that
    # call returns quickly (measured on this machine:
    # `busctl --user status org.kde.StatusNotifierWatcher` completes in
    # single-digit milliseconds once waybar owns the name, contributing no
    # meaningful delay) -- and then execs an application that takes
    # appreciably longer to map its first surface. See
    # scripts/gatherd-intercept-localsend-flash.
    start_later "$bin/gatherd-intercept-localsend-flash"
    start_later "$bin/gatherd-systray localsend --hidden"
    start_later "$bin/gatherd-systray tailscale systray"
    # Sign-in apps (JetBrains Toolbox, Discord/vesktop, Slack, Zoom, …) are
    # deliberately never autostarted — not here and not during provisioning. They
    # are just installed; open them on demand and sign in via 1Password when needed.
    # Nothing special about them, and starting them on every login wastes a potato.
    start_later "$bin/gatherd-systray /opt/piavpn/bin/pia-client --quiet"
    start_later "$bin/gatherd-systray arch-update --tray"
} &

# Teardown runs when this supervisor learns the session is ending, by whichever
# signal arrives first: sway's shutdown event (clean logout) or a TERM/HUP/INT
# (something killing us directly). Both funnel into cleanup() so neither path can
# die bare and strand the cohort — the trap is armed BEFORE we block, closing the
# window where a signal during the wait used to kill us before cleanup ran.
# cleanup ignores the TERM it sends to its own group so it outlives that long
# enough to KILL any straggler.
cleanup() {
    trap '' TERM
    kill -TERM -- "-$$" 2>/dev/null
    sleep 2
    for p in $(pgrep -g "$$" | grep -vx "$$"); do
        kill -KILL "$p" 2>/dev/null
    done
    exit 0
}
trap cleanup TERM HUP INT

# Sway's IPC can lag a moment behind session start on a slow or first boot, so
# retry before giving up rather than stranding the cohort on a single early miss
# (the suspected cause of the first-boot orphan). If it truly never answers we
# exit and leave the cohort running (old leaky-but-functional behavior) — but now
# the next login's startup sweep reaps that leak. This runs detached from sway's
# `exec` and after the cohort is already launched, so it never delays login or
# the helpers coming up; at worst it delays only teardown-readiness.
_n=0
until swaymsg -t get_version >/dev/null 2>&1; do
    _n=$((_n + 1))
    [ "$_n" -ge 30 ] && exit 0
    sleep 1
done

# Block until sway goes away, then take the cohort down with us.
swaymsg -m -t subscribe '["shutdown"]' >/dev/null 2>&1
cleanup
