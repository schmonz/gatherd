#!/bin/sh
# Show the gatherd-async slow-package install progress in a terminal — but only
# while an install is genuinely in progress. Decide *before* opening any window,
# so nothing flashes on screen on later logins once async has finished.
#
# Run from sway autostart WITHOUT a terminal wrapper:
#     exec gatherd-show-slow-progress
# The outer instance gates, then re-execs itself inside foot only when there is
# work to show; the inner instance (env flag set) skips the gate and displays.
#
# Pass --demo to bypass the async-complete gate so both display paths (in-place
# tail in a foot tab, foot window otherwise) can be exercised on an already-
# converged machine; the loop below then exits at once and reports completion.

if [ -z "${GATHERD_SLOW_PROGRESS_TERM:-}" ]; then
    # The async-complete sentinel is the whole gate: it is absent only on the
    # first boot while slow packages are still pending or installing, and present
    # forever after. So its absence means "there is work to watch" — show
    # progress; its presence means "done" — stay silent, no flash on later
    # logins. We deliberately do NOT also probe gatherd-async.service state:
    # at autostart time that service may not have reached 'active' yet, so gating
    # on it raced the window away before async came up. Waiting for the sentinel
    # in the loop below is race-free and keeps this decision init-agnostic.
    if [ "${1:-}" != "--demo" ]; then
        [ -f /etc/gatherd/async-complete ] && exit 0
    fi

    # Display in-place only when stdout is a pseudo-terminal — i.e. the user ran
    # this in a foot tab. Otherwise open our own foot window. We must NOT gate on
    # a bare `[ -t 1 ]`: at sway autostart fd 1 is the login VT (/dev/tty1),
    # which IS a tty yet is invisible (sway draws over it), so isatty quietly
    # sent the journal tail to tty1 and no window ever appeared — the long-
    # standing "it never opens, I run it by hand" bug. A real interactive
    # terminal is always a /dev/pts/*; the VT and pipes are not.
    case "$(readlink /proc/$$/fd/1 2>/dev/null)" in
        /dev/pts/*) export GATHERD_SLOW_PROGRESS_TERM=1 ;;
        *)          exec foot -e env GATHERD_SLOW_PROGRESS_TERM=1 "$0" ;;
    esac
fi

printf '\033]0;Package Installation\007'
echo "Installing remaining packages..."
echo ""

journalctl -fn 50 -u gatherd-async.service &
jctl_pid=$!

while [ ! -f /etc/gatherd/async-complete ]; do
    systemctl is-failed --quiet gatherd-async.service && break
    sleep 2
done

sleep 1
kill "$jctl_pid" 2>/dev/null
wait "$jctl_pid" 2>/dev/null

echo ""
echo "----------------------------------------"
if [ -f /etc/gatherd/async-complete ]; then
    echo "Installation complete."
else
    echo "Installation failed."
    echo "Details: journalctl -u gatherd-async.service"
fi
printf "Press Enter to close... "
read -r _
