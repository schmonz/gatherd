#!/bin/sh
# Show the gatherd-async slow-package install progress in a terminal — but only
# while an install is genuinely in progress. Decide *before* opening any window,
# so nothing flashes on screen on later logins once async has finished.
#
# Run from sway autostart WITHOUT a terminal wrapper:
#     exec gatherd-show-slow-progress
# The outer instance gates, then re-execs itself inside foot only when there is
# work to show; the inner instance (env flag set) skips the gate and displays.
#
# Pass --demo to bypass the gate so both display paths (in-place tail in a foot
# tab, foot window otherwise) can be exercised on an already-converged machine;
# the loop below then exits at once and reports completion.

# Overridable only so the gate can be pointed at a sandbox, the same reason
# gatherd-await-async takes them.
gatherd_home="${GATHERD_HOME:-/usr/local/lib/gatherd}"
sentinel="${GATHERD_ASYNC_SENTINEL:-/etc/gatherd/async-complete}"

# Freshness of the sentinel, not its existence, and via the same helper
# gatherd-await-async uses. site-async.yml overwrites the sentinel at the end of
# a run and never removes it at the start, so after a `git pull` the file is
# still on disk holding the OLD commit while REST re-runs every tier. The two
# consumers have to agree about that file: the barrier holds the session cohort
# for the whole re-run, so a window that reads the stale file as "done" leaves
# the human several minutes of empty session with nothing on screen explaining
# it -- the same harm, relocated.
#
# Only exit 1 means converged, matching the barrier: a missing script exits 127
# and a non-executable one 126, and reading either as converged would silently
# turn the gate into "never show anything".
converged() {
    "$gatherd_home/scripts/gatherd-needs-run" "$sentinel"
    [ "$?" -eq 1 ]
}

if [ -z "${GATHERD_SLOW_PROGRESS_TERM:-}" ]; then
    # We deliberately do NOT also probe gatherd-async.service state: at autostart
    # time that service may not have reached 'active' yet, so gating on it raced
    # the window away before async came up. Waiting on the sentinel in the loop
    # below is race-free and keeps this decision init-agnostic.
    if [ "${1:-}" != "--demo" ]; then
        converged && exit 0
    fi

    # Display in-place only when stdout is a pseudo-terminal — i.e. the user ran
    # this in a foot tab. Otherwise open our own foot window. We must NOT gate on
    # a bare `[ -t 1 ]`: at sway autostart fd 1 is the login VT (/dev/tty1),
    # which IS a tty yet is invisible (sway draws over it), so isatty quietly
    # sent the journal tail to tty1 and no window ever appeared — the long-
    # standing "it never opens, I run it by hand" bug. A real interactive
    # terminal is always a /dev/pts/*; the VT and pipes are not.
    case "$(readlink /proc/$$/fd/1 2>/dev/null)" in
        /dev/pts/*) export GATHERD_SLOW_PROGRESS_TERM=1 ;;
        *)          exec foot -e env GATHERD_SLOW_PROGRESS_TERM=1 "$0" ;;
    esac
fi

printf '\033]0;Package Installation\007'
echo "Installing remaining packages..."
echo ""

journalctl -fn 50 -u gatherd-async.service &
jctl_pid=$!

while ! converged; do
    systemctl is-failed --quiet gatherd-async.service && break
    sleep 2
done

sleep 1
kill "$jctl_pid" 2>/dev/null
wait "$jctl_pid" 2>/dev/null

echo ""
echo "----------------------------------------"
if converged; then
    echo "Installation complete."
else
    echo "Installation failed."
    echo "Details: journalctl -u gatherd-async.service"
fi
printf "Press Enter to close... "
read -r _
