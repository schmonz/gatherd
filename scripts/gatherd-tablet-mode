#!/bin/sh
# Put the session into (or out of) tablet mode: rotate the internal panel to
# portrait and stop the built-in keyboard and touchpad from typing against
# whatever the folded machine is resting on.
#
# This is the only thing that touches sway state. The keybinding, the power
# button and (later) a hinge-angle daemon are all callers — which is what lets
# the trigger change without reopening the mechanism. See
# docs/superpowers/specs/2026-08-16-tablet-mode-design.md.
set -eu

state_dir="${XDG_RUNTIME_DIR:-/tmp}/gatherd"
state_file="$state_dir/tablet-mode"
config="${XDG_CONFIG_HOME:-$HOME/.config}/gatherd/tablet-mode.conf"

transform=normal
# shellcheck source=/dev/null
[ -r "$config" ] && . "$config"
transform="${GATHERD_TABLET_TRANSFORM:-$transform}"

# Matched by connector name rather than index because the resting transform is
# NOT necessarily "normal": where the panel is physically mounted rotated,
# wlroots applies the DRM panel-orientation quirk itself and upright landscape
# is transform 90. We record whatever we find and restore that.
internal_output() {
    swaymsg -t get_outputs \
        | jq -r 'first(.[] | select(.name | test("^(eDP|DSI|LVDS)")) | .name) // empty'
}

# Built-in keyboards only: the i8042 controller enumerates as 1:1:*. An external
# or Bluetooth keyboard has a real vendor:product id and must keep working while
# folded — a page-turner pedal presents as exactly that, and silencing it would
# defeat the point of using this at a piano.
builtin_keyboards() {
    swaymsg -t get_inputs \
        | jq -r '.[] | select(.type == "keyboard")
                     | select(.identifier | startswith("1:1:"))
                     | .identifier' \
        | sort -u
}

# The re-enable side deliberately does NOT use the i8042 heuristic below.
# That heuristic exists to keep an external keyboard (a page-turner pedal)
# alive while folded - a constraint that only applies to DISABLING. Re-enabling
# by type is strictly safer: `enabled` is the default state, so sweeping every
# keyboard and touchpad costs nothing, while the heuristic could return an
# empty list (a transient swaymsg or jq failure inside a command substitution
# is invisible to `set -e`) and silently give the human nothing back.
enable_all_input() {
    swaymsg input type:keyboard events enabled >/dev/null || true
    swaymsg input type:touchpad events enabled >/dev/null || true
}

set_builtin_events() {
    for _id in $(builtin_keyboards); do
        swaymsg input "$_id" events "$1" >/dev/null
    done
    # The i8042 identifier heuristic does not transfer to touchpads: the built-in
    # touchpad is indistinguishable by identifier from an external one, and Sway
    # exposes no "internal device" flag. The constraint (keeping external input
    # working while folded) is keyboard-specific and is protected by the pedal case.
    swaymsg input type:touchpad events "$1" >/dev/null
}

# Every application window (not outputs, not workspaces — those are
# containers with no app_id) currently in the tree. This is what makes idle
# inhibition tablet-mode-scoped rather than viewer-scoped: the score being on
# screen is only one of the things a folded, keyboard-disabled machine must
# stay awake for.
view_ids() {
    swaymsg -t get_tree | jq -r '.. | objects | select(.app_id != null) | .id'
}

set_inhibitors() {
    for _id in $(view_ids); do
        swaymsg "[con_id=$_id]" inhibit_idle "$1" >/dev/null
    done
}

is_on() { [ -f "$state_file" ]; }

turn_on() {
    if is_on; then return 0; fi
    _output=$(internal_output)
    if [ -z "$_output" ]; then
        echo "gatherd-tablet-mode: no internal output found" >&2
        exit 1
    fi
    mkdir -p "$state_dir"
    # Written before rotating, so `off` restores the real resting transform.
    # `// empty` matters: without it a missing .transform writes the literal
    # string "null", which turn_off must then treat as unusable rather than
    # rotate to.
    swaymsg -t get_outputs \
        | jq -r --arg o "$_output" 'first(.[] | select(.name == $o) | .transform) // empty' \
        > "$state_file"
    swaymsg output "$_output" transform "$transform" >/dev/null
    set_builtin_events disabled
    set_inhibitors open
}

turn_off() {
    # NO `is_on` early return. `off` is the recovery command: it must put the
    # session back to a usable state whatever it finds, because the one case
    # that matters most is precisely the one where state has gone out of sync
    # - input disabled but the state file missing. Returning early there made
    # `off` a silent no-op and left no way at all to get the keyboard back
    # from the machine itself. Every step below is already idempotent.
    _output=$(internal_output)
    _prior=""
    if [ -f "$state_file" ]; then
        _prior=$(cat "$state_file")
    fi

    # Re-enable input FIRST. This is the safety-critical half of turning
    # tablet mode off: once the keyboard is disabled, the power button is the
    # only escape hatch, and it calls this. If anything below it (rotation)
    # were to run first and exit non-zero under `set -eu`, this line would
    # never be reached and the human would be stranded with a dead keyboard
    # and touchpad and no way to get them back. Confirmed on this hardware:
    # `swaymsg output DSI-1 transform null` exits 2.
    enable_all_input

    # Clearing idle inhibitors happens second, and is non-fatal (|| true) for
    # the same reason the rotation restore below is: input is already safe by
    # this point, and a compositor error here must never stop the rotation
    # restore or state cleanup that follow it from running.
    set_inhibitors none || true

    # Only rotate to a value sway itself would accept. Do NOT fall back to
    # "normal" when the recorded value is missing or bogus (e.g. the literal
    # string "null" from a pre-`// empty` bug) — on this hardware, where
    # wlroots applies the DRM panel-orientation quirk, "normal" is *portrait*.
    # Falling back to it would rotate an already-correct screen into tablet
    # orientation. Leaving the display untouched is strictly safer.
    case "$_prior" in
        normal | 90 | 180 | 270 | flipped | flipped-90 | flipped-180 | flipped-270) ;;
        *)
            echo "gatherd-tablet-mode: recorded transform '$_prior' is not valid; leaving the display as-is" >&2
            _prior=""
            ;;
    esac
    if [ -n "$_output" ] && [ -n "$_prior" ]; then
        # Non-fatal: a compositor error rotating back must never prevent the
        # rest of turn_off (clearing state) from completing.
        swaymsg output "$_output" transform "$_prior" >/dev/null || true
    fi

    rm -f "$state_file"
}

case "${1:-toggle}" in
    on)     turn_on ;;
    off)    turn_off ;;
    toggle) if is_on; then turn_off; else turn_on; fi ;;
    status) is_on ;;
    *)      echo "usage: $0 on|off|toggle|status" >&2; exit 2 ;;
esac
