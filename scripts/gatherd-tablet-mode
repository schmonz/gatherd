#!/bin/sh
# Put the session into (or out of) tablet mode: rotate the internal panel to
# portrait and stop the built-in keyboard and touchpad from typing against
# whatever the folded machine is resting on.
#
# This is the only thing that touches compositor state, and it reaches the
# compositor only through gatherd-compositor. The keybinding, the power
# button and (later) a hinge-angle daemon are all callers — which is what lets
# the trigger change without reopening the mechanism. See
# docs/superpowers/specs/2026-08-16-tablet-mode-design.md.
set -eu

state_dir="${XDG_RUNTIME_DIR:-/tmp}/gatherd"
state_file="$state_dir/tablet-mode"
# Auto-rotation is a preference, unlike tablet mode itself, which is just the
# fold. Read by gatherd-hinge-daemon, toggled from the folded menu. Lives in
# XDG_RUNTIME_DIR, so it lasts a session and resets on reboot: a setting you
# flipped once at the piano should not silently outlive the reason for it.
rotation_off_file="$state_dir/rotation-off"
config="${XDG_CONFIG_HOME:-$HOME/.config}/gatherd/tablet-mode.conf"

transform=normal
viewer_app_id=""
# shellcheck source=/dev/null
[ -r "$config" ] && . "$config"
transform="${GATHERD_TABLET_TRANSFORM:-$transform}"

# Matched by connector name rather than index because the resting transform is
# NOT necessarily "normal": where the panel is physically mounted rotated,
# wlroots applies the DRM panel-orientation quirk itself and upright landscape
# is transform 90. We record whatever we find and restore that.
internal_output() {
    gatherd-compositor internal-output
}

# Confirm the built-in keyboards are actually silenced rather than assuming it.
# Asking the compositor to silence them can come back having done nothing at
# all - a transient query failure leaves nothing to iterate over - and turn_on
# would carry on and rotate the screen regardless. The result is a tablet mode
# that looks fully on while the keyboard is still live, and a machine folded
# onto its own keys types into whatever is focused. That is how a folded fuzzel
# menu once came up with its prompt and every entry filtered away.
builtin_keyboards_silenced() {
    gatherd-compositor builtin-input-silenced
}

warn() {
    echo "gatherd-tablet-mode: $1" >&2
    _log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/gatherd"
    mkdir -p "$_log_dir" 2>/dev/null || return 0
    printf '%s %s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$1" \
        >> "$_log_dir/tablet-mode.log" 2>/dev/null || true
}

# Retry rather than trust: the failure this guards against is transient by
# nature. Non-fatal after the last attempt - refusing to enter tablet mode
# would leave the human with an unreadable folded screen, which is worse than
# a live keyboard they have been warned about.
disable_builtin_input() {
    _try=1
    while [ "$_try" -le 3 ]; do
        gatherd-compositor silence-builtin-input
        if builtin_keyboards_silenced; then
            return 0
        fi
        _try=$((_try + 1))
    done
    warn "WARNING could not confirm the built-in keyboard is disabled - a folded machine may type against whatever it is resting on"
    return 1
}

# The score fills the screen while folded, and goes back to being a window
# when unfolded. papers got this free from presentation mode, which is
# inherently fullscreen; koreader opens as an ordinary window, and the score is
# opened BEFORE the fold in the normal flow, so nothing at launch time can
# arrange it. Matching the configured app_id rather than the focused window: on
# a folded machine the human cannot change focus, and whatever they left
# focused before folding is not necessarily the score.
#
# Never fatal. A compositor that will not fullscreen a window is a cosmetic
# problem; failing here would abort the rest of turn_on, which disables the
# keyboard, or the rest of turn_off, which gives it back.
set_viewer_fullscreen() {
    [ -n "$viewer_app_id" ] || return 0
    gatherd-compositor set-fullscreen "$viewer_app_id" "$1"
}

# Wait for the viewer's window to exist, then fullscreen it. Needed when a
# score is opened while ALREADY folded - "Pick another score" from the folded
# menu - because turn_on's fullscreen ran long before this window existed, and
# the launching script cannot do it inline either: it returns as soon as the
# process is spawned, well before the window maps.
#
# Bounded and always succeeds. A viewer that never appears (a crash, a missing
# file, a human who cancelled) must not leave the caller hanging or reporting
# failure for something cosmetic.
viewer_window_present() {
    gatherd-compositor window-present "$viewer_app_id"
}

fullscreen_viewer() {
    is_on || return 0
    [ -n "$viewer_app_id" ] || return 0
    _waited=0
    while [ "$_waited" -lt 50 ]; do
        if viewer_window_present; then
            set_viewer_fullscreen enable
            return 0
        fi
        _waited=$((_waited + 1))
        sleep 0.1
    done
    return 0
}

is_on() { [ -f "$state_file" ]; }

turn_on() {
    if is_on; then return 0; fi
    _output=$(internal_output)
    if [ -z "$_output" ]; then
        echo "gatherd-tablet-mode: no internal output found" >&2
        exit 1
    fi
    mkdir -p "$state_dir"
    # Written before rotating, so `off` restores the real resting transform.
    # `// empty` matters: without it a missing .transform writes the literal
    # string "null", which turn_off must then treat as unusable rather than
    # rotate to.
    gatherd-compositor output-transform "$_output" > "$state_file"
    gatherd-compositor set-transform "$_output" "$transform"
    disable_builtin_input || true
    gatherd-compositor inhibit-idle-all open
    set_viewer_fullscreen enable
}

turn_off() {
    # NO `is_on` early return. `off` is the recovery command: it must put the
    # session back to a usable state whatever it finds, because the one case
    # that matters most is precisely the one where state has gone out of sync
    # - input disabled but the state file missing. Returning early there made
    # `off` a silent no-op and left no way at all to get the keyboard back
    # from the machine itself. Every step below is already idempotent.
    _output=$(internal_output)
    _prior=""
    if [ -f "$state_file" ]; then
        _prior=$(cat "$state_file")
    fi

    # Re-enable input FIRST. This is the safety-critical half of turning
    # tablet mode off: once the keyboard is disabled, the power button is the
    # only escape hatch, and it calls this. If anything below it (rotation)
    # were to run first and exit non-zero under `set -eu`, this line would
    # never be reached and the human would be stranded with a dead keyboard
    # and touchpad and no way to get them back. Not hypothetical: asking for
    # an invalid transform genuinely fails on this hardware, which is what
    # made the ordering matter in the first place.
    gatherd-compositor restore-all-input

    # Clearing idle inhibitors happens second, and is non-fatal (|| true) for
    # the same reason the rotation restore below is: input is already safe by
    # this point, and a compositor error here must never stop the rotation
    # restore or state cleanup that follow it from running.
    gatherd-compositor inhibit-idle-all none
    set_viewer_fullscreen disable

    # Only rotate to a value the compositor would accept. Do NOT fall back to
    # "normal" when the recorded value is missing or bogus (e.g. the literal
    # string "null" from a pre-`// empty` bug) — on this hardware, where
    # wlroots applies the DRM panel-orientation quirk, "normal" is *portrait*.
    # Falling back to it would rotate an already-correct screen into tablet
    # orientation. Leaving the display untouched is strictly safer.
    if ! gatherd-compositor valid-transform "$_prior"; then
        echo "gatherd-tablet-mode: recorded transform '$_prior' is not valid; leaving the display as-is" >&2
        _prior=""
    fi
    if [ -n "$_output" ] && [ -n "$_prior" ]; then
        # Non-fatal: a compositor error rotating back must never prevent the
        # rest of turn_off (clearing state) from completing.
        gatherd-compositor set-transform "$_output" "$_prior"
    fi

    rm -f "$state_file"
}

rotation_is_on() { [ ! -f "$rotation_off_file" ]; }

case "${1:-toggle}" in
    on)     turn_on ;;
    off)    turn_off ;;
    toggle) if is_on; then turn_off; else turn_on; fi ;;
    status) is_on ;;
    fullscreen-viewer) fullscreen_viewer ;;
    rotation-status) rotation_is_on ;;
    rotation-on)     rm -f "$rotation_off_file" ;;
    rotation-off)    mkdir -p "$state_dir"; : > "$rotation_off_file" ;;
    rotation-toggle) if rotation_is_on; then
                         mkdir -p "$state_dir"; : > "$rotation_off_file"
                     else
                         rm -f "$rotation_off_file"
                     fi ;;
    *)      echo "usage: $0 on|off|toggle|status|fullscreen-viewer|rotation-{status,on,off,toggle}" >&2
            exit 2 ;;
esac
