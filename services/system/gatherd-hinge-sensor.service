[Unit]
Description=Bind the MiniBook X base accelerometer (hinge sensor)
# No Before=greetd.service: unlike gatherd.service this isn't gating first
# boot, it's a small sysfs write with its own idempotency and failure
# handling built in (see the script). Runs early enough for
# gatherd-hinge-daemon to find iio:device1 once the desktop starts.
#
# NOT systemd-udev-settle.service: it's deprecated upstream (systemd's own
# unit file calls it a crutch for "legacy services which cannot reliably cope
# with dynamic device configurations"), and this repo already avoids that
# class of boot-delay unit for the same reason network-online.target is
# avoided in gatherd.service. The i2c adapter this script needs is
# PCI-attached and present early; systemd-udev-trigger.service (measured
# 271ms on this machine) is already in the boot path and is ordering enough.
After=systemd-udev-trigger.service
Wants=systemd-udev-trigger.service

[Service]
Type=oneshot
# The script itself no-ops on any missing PCI path/adapter/address and
# never errors, so this unit cannot fail a boot even on non-MiniBook-X
# hardware.
ExecStart=/usr/local/lib/gatherd/scripts/gatherd-bind-hinge-sensor
RemainAfterExit=no
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
