[Unit]
Description=gatherd vault password (early console prompt)
# Collect the vault password up front, before the long unattended first-boot
# run, so the operator enters it right after LUKS and walks away. Ordered before
# gatherd.service (and so, transitively, before greetd) so the rest of the pave
# is hands-off. ExecCondition skips this on every boot where a valid password is
# already stored, so it normally costs a couple of stats and never prompts.
Before=gatherd.service
After=local-fs.target
ConditionPathExists=/usr/local/lib/gatherd/site-vault.yml

[Service]
Type=oneshot
ExecCondition=/usr/local/lib/gatherd/scripts/gatherd-vault-pass-needed
# The script prompts via systemd-ask-password, so systemd's console agent owns
# the console (VT activation, text mode, foreground pgrp) — this unit needs no
# tty of its own. The script's own deadline_secs bounds each prompt; this is a
# backstop above an operator retrying a few mistyped passwords.
ExecStart=/usr/local/lib/gatherd/scripts/gatherd-prompt-vault-console
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600s

[Install]
WantedBy=multi-user.target
