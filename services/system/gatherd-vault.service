[Unit]
Description=gatherd vault-protected configuration
After=network-online.target nss-lookup.target gatherd.service
Wants=network-online.target nss-lookup.target

[Service]
# See gatherd-async.service for why this is Type=simple with all the logic in
# the script: started once at boot, it waits for the vault password to appear
# and runs site-vault.yml when it does — no path watcher, no start-limit loop.
Type=simple
ExecStart=/usr/local/lib/gatherd/scripts/gatherd-await-and-run /etc/gatherd/vault-complete /usr/local/lib/gatherd/site-vault.yml
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
