[Unit]
Description=gatherd first-boot setup
After=network-online.target nss-lookup.target systemd-user-sessions.service
Before=greetd.service
Wants=network-online.target nss-lookup.target
ConditionPathExists=/usr/local/lib/gatherd/site.yml

[Service]
Type=oneshot
WorkingDirectory=/usr/local/lib/gatherd
ExecCondition=/usr/local/lib/gatherd/scripts/gatherd-needs-run /etc/gatherd/complete
# The wrapper owns galaxy install, sleep-inhibit, syntax gate, timeout, and
# status recording — and always exits 0, so a playbook error or hang can never
# fail this unit and block greetd. Real status: /etc/gatherd/last-run.
ExecStart=/usr/local/lib/gatherd/scripts/gatherd-run-core /usr/local/lib/gatherd/site.yml
RemainAfterExit=no
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
