#!/bin/sh
# Unit tests for gatherd-askpass.
#
# Fakes nowayprompt so the classification, the exit-code mapping and the
# secret-extraction are exercised without drawing anything. Exit mapping is the
# part that must not be wrong: a cancel misread as success would feed an empty
# password to sudo, and a success misread as cancel would wedge the vault loop.
#
# Usage: tests/askpass

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
PASS=0
FAIL=0

WORK=$(mktemp -d)
export WORK  # so fake scripts written to FAKEBIN can find it too
trap 'rm -rf "$WORK"' EXIT
FAKEBIN="$WORK/bin"
mkdir -p "$FAKEBIN"
PATH="$FAKEBIN:$REPO/scripts:$PATH"
export PATH

GATHERD_WAYPROMPT="$FAKEBIN/nowayprompt"
export GATHERD_WAYPROMPT

ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

assert_out() {
    _d=$1; _want=$2; shift 2
    _got=$("$@" 2>/dev/null || true)
    if [ "$_got" = "$_want" ]; then ok "$_d"; else bad "$_d (want [$_want] got [$_got])"; fi
}
assert_fail() { _d=$1; shift; if "$@" >/dev/null 2>&1; then bad "$_d (expected failure)"; else ok "$_d"; fi; }

# fake_nowayprompt <exit> <stdout...> -- also records its argv for inspection.
fake_nowayprompt() {
    _rc=$1; shift
    {
        printf '#!/bin/sh\n'
        printf 'printf "%%s\\n" "$@" > "%s/argv"\n' "$WORK"
        for _l in "$@"; do printf 'printf "%%s\\n" %s\n' "'$_l'"; done
        printf 'exit %s\n' "$_rc"
    } > "$FAKEBIN/nowayprompt"
    chmod +x "$FAKEBIN/nowayprompt"
}

# Exit 0 means the user pressed OK; the secret is the second line.
fake_nowayprompt 0 'user-action: ok' 'pin: hunter2'
assert_out 'an ok press prints the secret' 'hunter2' gatherd-askpass '[sudo]'

# A secret containing the literal prefix must survive. The stock
# wayprompt-ssh-askpass strips "pin: " from anywhere in the line, which
# corrupts exactly this password; we anchor to the start of line 2 instead.
fake_nowayprompt 0 'user-action: ok' 'pin: pin: sneaky'
assert_out 'a secret containing the prefix is not corrupted' 'pin: sneaky' gatherd-askpass '[sudo]'

# A secret with a leading dash must not be eaten by echo.
fake_nowayprompt 0 'user-action: ok' 'pin: -n'
assert_out 'a secret starting with a dash survives' '-n' gatherd-askpass '[sudo]'

# 10 is cancel, 20 is not-ok, 1 is error -- all abort, none print anything.
for _rc in 10 20 1; do
    fake_nowayprompt "$_rc" 'user-action: cancel' 'no pin'
    assert_fail "exit $_rc is a cancel" gatherd-askpass '[sudo]'
    assert_out "exit $_rc prints no secret" '' gatherd-askpass '[sudo]'
done

# The host-key prompt is a decision, not a secret: three buttons, no masking,
# and the answer comes from which button was pressed.
fake_nowayprompt 0 'user-action: ok'
assert_out 'the host-key prompt answers yes on ok' \
    'yes' gatherd-askpass 'Are you sure you want to continue connecting (yes/no/[fingerprint])?'
grep -q -- '--get-pin' "$WORK/argv" && bad 'the host-key prompt must not mask input' \
    || ok 'the host-key prompt does not mask input'

fake_nowayprompt 20 'user-action: not-ok'
assert_out 'the host-key prompt answers no on not-ok' \
    'no' gatherd-askpass 'Are you sure you want to continue connecting (yes/no/[fingerprint])?'

fake_nowayprompt 10 'user-action: cancel'
assert_fail 'the host-key prompt aborts on cancel' \
    gatherd-askpass 'Are you sure you want to continue connecting (yes/no/[fingerprint])?'

# A caller-supplied context wins over the /proc walk: polkit knows more than
# ancestry could recover.
fake_nowayprompt 0 'user-action: ok' 'pin: x'
gatherd-askpass '[polkit]' 'Authentication is required to install software' >/dev/null 2>&1 || true
if grep -q 'Authentication is required to install software' "$WORK/argv"; then
    ok 'a caller-supplied context reaches nowayprompt'
else
    bad 'a caller-supplied context reaches nowayprompt'
fi

# Finding 1 regression: an explicitly-empty argv[2] is the caller saying "I
# have no context", and must be believed rather than second-guessed with a
# /proc walk. Fake gatherd-prompt-context so a walk that ran is distinguishable
# from one that never happened -- without the fake, a reverted fix would still
# usually print real ancestry text here rather than coincidentally producing
# the string "context unavailable", but the fake makes the check exact.
cat > "$FAKEBIN/gatherd-prompt-context" <<'EOF'
#!/bin/sh
if [ "$1" = '--sanitize' ]; then
    cat
    exit 0
fi
: > "$WORK/proc_walk_invoked"
printf 'context unavailable\n'
EOF
chmod +x "$FAKEBIN/gatherd-prompt-context"

fake_nowayprompt 0 'user-action: ok' 'pin: x'
gatherd-askpass '[polkit]' '' >/dev/null 2>&1 || true
_desc=$(awk '/^--description$/{getline; print; exit}' "$WORK/argv")
if [ "$_desc" = 'context unavailable' ]; then
    ok 'an explicitly-empty context yields context unavailable'
else
    bad "an explicitly-empty context yields context unavailable (got [$_desc])"
fi
if [ -e "$WORK/proc_walk_invoked" ]; then
    bad 'an explicitly-empty context does not invoke the /proc walk'
else
    ok 'an explicitly-empty context does not invoke the /proc walk'
fi
rm -f "$FAKEBIN/gatherd-prompt-context" "$WORK/proc_walk_invoked"

# Finding 2: a caller-supplied context is unbounded and unsanitized input --
# any app can register a polkit action with attacker-chosen text -- so it must
# pass through the same allowlist as the /proc walk before reaching the box.
_ctx="clean$(printf '\033')[2Jbad"
fake_nowayprompt 0 'user-action: ok' 'pin: x'
gatherd-askpass '[polkit]' "$_ctx" >/dev/null 2>&1 || true
_desc=$(awk '/^--description$/{getline; print; exit}' "$WORK/argv")
if [ "$_desc" = 'clean[2Jbad [elided]' ]; then
    ok 'a caller-supplied context with a control byte is sanitized and marked'
else
    bad "a caller-supplied context with a control byte is sanitized and marked (got [$_desc])"
fi

# A caller-supplied context longer than 60 characters gets the same truncation
# as the /proc walk's own findings.
_long=$(printf '%070d' 0 | tr '0' 'a')
fake_nowayprompt 0 'user-action: ok' 'pin: x'
gatherd-askpass '[polkit]' "$_long" >/dev/null 2>&1 || true
_desc=$(awk '/^--description$/{getline; print; exit}' "$WORK/argv")
_want="$(printf '%060d' 0 | tr '0' 'a')..."
if [ "$_desc" = "$_want" ]; then
    ok 'a caller-supplied context over 60 characters is truncated with ...'
else
    bad "a caller-supplied context over 60 characters is truncated with ... (got [$_desc])"
fi

# Finding 3: the host-key prompt embeds a hostname/fingerprint that ssh
# assembles from whatever we connected to (a crafted ssh://<host>/ in a repo
# or CI config reaches here), so it must be sanitized like every other
# untrusted string -- but through --sanitize-long, not --sanitize, so the
# fingerprint is not cut to 60 characters or 2 lines. A control byte must
# still be stripped and marked; the rest of the (over 60 character) prompt
# must survive uncut, which a reverted fix (raw "$prompt", or the wrong mode)
# would not produce.
_hostkey="Are you sure you want to continue connecting (yes/no/[fingerprint])? ED25519 key fingerprint is SHA256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa$(printf '\033')[2J."
fake_nowayprompt 0 'user-action: ok'
gatherd-askpass "$_hostkey" >/dev/null 2>&1 || true
_desc=$(awk '/^--description$/{getline; print; exit}' "$WORK/argv")
_want_hostkey="Are you sure you want to continue connecting (yes/no/[fingerprint])? ED25519 key fingerprint is SHA256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa[2J. [elided]"
if [ "$_desc" = "$_want_hostkey" ]; then
    ok 'the host-key description is sanitized uncut, not truncated at 60 characters'
else
    bad "the host-key description is sanitized uncut, not truncated at 60 characters (got [$_desc])"
fi

# nowayprompt absent is a cancel, not a crash and not a fallback to fuzzel.
rm -f "$FAKEBIN/nowayprompt"
assert_fail 'a missing nowayprompt is a clean cancel' gatherd-askpass '[sudo]'

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
