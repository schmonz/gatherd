#!/bin/sh
# Unit tests for gatherd-assert-packages-declared.
#
# Machine state arrives through a pacman shim on $PATH answering from
# $GATHERD_TEST_DB, the same mechanism tests/assert-sonames uses. Repo state is a
# sandbox tree, so these tests never depend on what this working tree happens to
# declare today.
set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
CHECK="$REPO/scripts/gatherd-assert-packages-declared"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

PASS=0
FAIL=0
ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

# A pacman that answers only what this check asks. Anything else is a test bug,
# not a pass: a shim that silently answers an unexpected query would let the
# check drift away from what it claims to read.
mkdir -p "$WORK/shim"
cat > "$WORK/shim/pacman" <<'SHIM'
#!/bin/sh
db=${GATHERD_TEST_DB:?}
case "$1" in
    -Qeq) [ -f "$db/explicit" ] || { echo 'error: database broken' >&2; exit 1; }
          cat "$db/explicit" ;;
    *)    echo "shim pacman: unexpected invocation: $*" >&2; exit 1 ;;
esac
SHIM
chmod +x "$WORK/shim/pacman"
PATH="$WORK/shim:$PATH"
export PATH

# A sandbox repo: group_vars, a base manifest for THIS architecture, and one
# playbook the walk can reach.
sandbox() {
    _root=$1
    rm -rf "$_root"
    mkdir -p "$_root/group_vars/all" "$_root/tests" "$_root/roles/system/tasks"
    printf '# arch: %s\n' "$(uname -m)" > "$_root/tests/base-manifest.txt"
    cat > "$_root/group_vars/all/main.yml" <<'GV'
---
core_packages: []
rest_packages:
  - declared-pkg
GV
    cat > "$_root/roles/system/tasks/rest.yml" <<'T'
---
- name: Install the rest packages
  community.general.pacman:
    name: "{{ rest_packages }}"
    state: present
T
    cat > "$_root/site-core.yml" <<'P'
---
- name: System
  hosts: localhost
  tasks: []
P
    cat > "$_root/site-async.yml" <<'P'
---
- name: System
  hosts: localhost
  tasks:
    - name: Configure the system
      ansible.builtin.include_tasks: roles/system/tasks/rest.yml
P
}

run_check() {
    GATHERD_TEST_DB="$WORK/db" "$CHECK" "$1" > "$WORK/out" 2> "$WORK/err"
    echo $?
}

# --- Case 1: installed, declared nowhere, not in base -> exit 1, named --------
sandbox "$WORK/repo"
mkdir -p "$WORK/db"
printf 'declared-pkg\nstray-pkg\n' > "$WORK/db/explicit"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 1 ] && grep -q 'stray-pkg' "$WORK/err"; then
    ok 'a stray is exit 1 and named'
else
    bad "a stray should be exit 1 and named (got $rc)"; sed 's/^/       /' "$WORK/err"
fi
if ! grep -q 'declared-pkg' "$WORK/err"; then
    ok 'a declared package is not reported'
else
    bad 'a declared package was reported as a stray'
fi

# --- Case 2: everything declared -> exit 0 -----------------------------------
printf 'declared-pkg\n' > "$WORK/db/explicit"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 0 ]; then
    ok 'all declared is exit 0'
else
    bad "all declared should be exit 0 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 3: in the base manifest, declared nowhere -> exit 0 ----------------
# The base image is not this repo's to declare. Were this a violation, the gate
# would open with ~900 findings and be switched off the same day.
printf '# arch: %s\nbase-pkg\n' "$(uname -m)" > "$WORK/repo/tests/base-manifest.txt"
printf 'declared-pkg\nbase-pkg\n' > "$WORK/db/explicit"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 0 ]; then
    ok 'a base-image package is accounted for'
else
    bad "base-image package should be exit 0 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 4: the vendored-PKGBUILD pair and the bootstrap -> exit 0 ---------
# aurutils and nowayprompt are installed by file path, out of a result
# registered as _<package>_built; that name is the declaration. ansible comes
# from postinstall, which no playbook walk reaches.
cat > "$WORK/repo/roles/system/tasks/vendored.yml" <<'T'
---
- name: Install the vendored package
  community.general.pacman:
    name: "{{ _aurutils_built.files[0].path }}"
    state: present
T
cat >> "$WORK/repo/site-async.yml" <<'P'
    - name: Build from a vendored PKGBUILD
      ansible.builtin.include_tasks: roles/system/tasks/vendored.yml
P
printf 'install_prerequisites() {\n    pacman -S --noconfirm --needed ansible git\n}\n' \
    > "$WORK/repo/postinstall"
printf 'declared-pkg\naurutils\nansible\n' > "$WORK/db/explicit"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 0 ]; then
    ok 'a vendored build and the bootstrap are accounted for'
else
    bad "vendored build and bootstrap should be exit 0 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 4a: the bootstrap stops installing it -> it is a stray ---------------
# An exemption that outlives what it cites is this gate's own bug class: the
# repo has stopped declaring a package and nothing says so.
printf 'install_prerequisites() {\n    pacman -S --noconfirm --needed git\n}\n' \
    > "$WORK/repo/postinstall"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 1 ] && grep -q '^  ansible$' "$WORK/err"; then
    ok 'an exemption lapses with the file it cites'
else
    bad "a lapsed exemption should be exit 1 naming ansible (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 4a2: ansible-core, or a comment, does not hold ansible's exemption --
printf 'install_prerequisites() {\n    pacman -S --noconfirm --needed ansible-core git\n}\n' \
    > "$WORK/repo/postinstall"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 1 ] && grep -q '^  ansible$' "$WORK/err"; then
    ok 'ansible-core does not stand in for ansible'
else
    bad "ansible-core should not hold the ansible exemption (got $rc)"; sed 's/^/       /' "$WORK/err"
fi
printf '# pacman -S ansible came from here once\n' > "$WORK/repo/postinstall"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 1 ] && grep -q '^  ansible$' "$WORK/err"; then
    ok 'a comment does not hold the ansible exemption'
else
    bad "a comment should not hold the ansible exemption (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 4b: the installer's hardware picks -> exit 0 -------------------------
# The base manifest holds one machine's microcode and GPU drivers. Another
# machine's must not be told to remove its own.
printf 'declared-pkg\namd-ucode\nvulkan-radeon\n' > "$WORK/db/explicit"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 0 ]; then
    ok "another machine's microcode and GPU driver are accounted for"
else
    bad "installer hardware picks should be exit 0 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 5: declared under a when: this machine fails -> exit 0 -------------
# A has_* declaration still counts. It works because the imported resolve()
# decides only the architecture -- measured, it returns None for every has_*
# fact, so conditions_of records the condition by name instead of dropping the
# task. Pinned here because the day resolve() learns to evaluate facts, every
# has_* package starts reading as a stray on exactly the machines that have the
# hardware, and this case is the only thing that would say so.
cat > "$WORK/repo/roles/system/tasks/gated.yml" <<'T'
---
- name: Install the hardware-gated package
  community.general.pacman:
    name: gated-pkg
    state: present
  when: has_no_such_hardware
T
cat >> "$WORK/repo/site-async.yml" <<'P'
    - name: Configure gated hardware
      ansible.builtin.include_tasks: roles/system/tasks/gated.yml
P
printf 'declared-pkg\ngated-pkg\n' > "$WORK/db/explicit"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 0 ]; then
    ok 'a hardware-gated declaration still counts'
else
    bad "gated declaration should be exit 0 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 6: base manifest from another architecture -> exit 2 --------------
printf '# arch: nosucharch\nbase-pkg\n' > "$WORK/repo/tests/base-manifest.txt"
printf 'declared-pkg\n' > "$WORK/db/explicit"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 2 ] && grep -q 'nosucharch' "$WORK/err"; then
    ok 'a foreign-architecture manifest is exit 2'
else
    bad "foreign-arch manifest should be exit 2 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 7: no base manifest -> exit 2 ------------------------------------
rm -f "$WORK/repo/tests/base-manifest.txt"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 2 ] && grep -q 'base-manifest' "$WORK/err"; then
    ok 'a missing manifest is exit 2, not a clean run'
else
    bad "missing manifest should be exit 2 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 8: pacman fails -> exit 2 ---------------------------------------
sandbox "$WORK/repo"
rm -f "$WORK/db/explicit"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 2 ] && grep -qi 'pacman' "$WORK/err"; then
    ok 'a failed pacman query is exit 2'
else
    bad "failed pacman should be exit 2 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 9: an unreadable aur sync line -> exit 2 -------------------------
# Never "assume declared". A build whose targets cannot be read would otherwise
# widen the declared set silently, which is how a gate goes blind.
printf 'declared-pkg\n' > "$WORK/db/explicit"
cat > "$WORK/repo/roles/system/tasks/opaque.yml" <<'T'
---
- name: Build something the parser cannot read
  ansible.builtin.command: "{{ aur_sync_command }} {{ some_var | map('upper') | list }}"
  changed_when: false
T
cat >> "$WORK/repo/site-async.yml" <<'P'
    - name: Build opaquely
      ansible.builtin.include_tasks: roles/system/tasks/opaque.yml
P
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 2 ] && grep -q 'opaque.yml' "$WORK/err"; then
    ok 'an unreadable build line is exit 2, naming the file'
else
    bad "unreadable build should be exit 2 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 9a: an install name it cannot read -> exit 2 ------------------------
# Dropping it would make every package behind it a stray, each with removal
# advice. Same Ansible meaning, different shape: 76 false strays, measured.
sandbox "$WORK/repo"
sed -i 's/{{ rest_packages }}/{{ rest_packages | list }}/' \
    "$WORK/repo/roles/system/tasks/rest.yml"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 2 ] && grep -q 'rest_packages | list' "$WORK/err"; then
    ok 'an unreadable install name is exit 2, quoting it'
else
    bad "unreadable install name should be exit 2 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 9d: other shapes it must not take as a package name -> exit 2 -----
for name in "{% if has_x %}a{% else %}b{% endif %}" 'extra/foo' '/tmp/foo.pkg.tar.zst'; do
    sandbox "$WORK/repo"
    cat >> "$WORK/repo/roles/system/tasks/rest.yml" <<T
- name: Install something oddly named
  community.general.pacman:
    name: "$name"
    state: present
T
    rc=$(run_check "$WORK/repo" || true)
    if [ "$rc" = 2 ]; then
        ok "an install name like $name is exit 2"
    else
        bad "an install name like $name should be exit 2 (got $rc)"; sed 's/^/       /' "$WORK/err"
    fi
done

# --- Case 9e: a guard target is not an install, so it is not read strictly ---
# visit() resolves assert_aur_deps targets through the same names_from.
sandbox "$WORK/repo"
cat >> "$WORK/repo/roles/system/tasks/rest.yml" <<'T'
- name: Check the build's dependencies
  ansible.builtin.include_tasks: tasks/assert_aur_deps.yml
  vars:
    aur_assert_targets: "{{ rest_packages | list }}"
T
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 0 ]; then
    ok 'a guard target expression is not an install name'
else
    bad "a guard target should not make the check exit $rc"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 9f: a vendored package with a hyphen -------------------------------
# Ansible reads _foo-bar_built as subtraction, so foo-bar registers _foo_bar_built.
cat > "$WORK/repo/roles/system/tasks/rest.yml" <<'T'
---
- name: Install the rest packages
  community.general.pacman:
    name: "{{ rest_packages }}"
    state: present
- name: Install the vendored package
  community.general.pacman:
    name: "{{ _foo_bar_built.files[0].path }}"
    state: present
T
printf 'declared-pkg\nfoo-bar\n' > "$WORK/db/explicit"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 0 ]; then
    ok 'a hyphenated vendored package is declared'
else
    bad "a hyphenated vendored package should be exit 0 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi
printf 'declared-pkg\n' > "$WORK/db/explicit"

# --- Case 9b: a var group_vars does not define -> exit 2 ----------------------
sandbox "$WORK/repo"
sed -i 's/{{ rest_packages }}/{{ role_default_packages }}/' \
    "$WORK/repo/roles/system/tasks/rest.yml"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 2 ] && grep -q 'role_default_packages' "$WORK/err"; then
    ok 'a var group_vars does not define is exit 2'
else
    bad "undefined var should be exit 2 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 9c: anything unexpected is exit 2, not a traceback's exit 1 ---------
# Exit 1 claims strays; with no names behind it the login notes said nothing.
sandbox "$WORK/repo"
: > "$WORK/repo/group_vars/all/main.yml"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 2 ] && ! grep -q 'Traceback' "$WORK/err"; then
    ok 'an empty group_vars is exit 2'
else
    bad "empty group_vars should be exit 2 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi
sandbox "$WORK/repo"
rm -f "$WORK/repo/tests/base-manifest.txt"
mkdir "$WORK/repo/tests/base-manifest.txt"
rc=$(run_check "$WORK/repo" || true)
if [ "$rc" = 2 ] && ! grep -q 'Traceback' "$WORK/err"; then
    ok 'an unreadable manifest is exit 2'
else
    bad "unreadable manifest should be exit 2 (got $rc)"; sed 's/^/       /' "$WORK/err"
fi

# --- Case 10: the imported module still provides what this reads -----------
# The reuse in gatherd-assert-packages-declared is only safe if this fails when
# gatherd-check-aur-deps is refactored out from under it.
if python3 - "$REPO" <<'PY'
import importlib.util, sys
from importlib.machinery import SourceFileLoader
from pathlib import Path
p = Path(sys.argv[1]) / 'scripts' / 'gatherd-check-aur-deps'
s = importlib.util.spec_from_file_location('g', p, loader=SourceFileLoader('g', str(p)))
m = importlib.util.module_from_spec(s); s.loader.exec_module(m)
missing = [n for n in ('load', 'visit', 'names_from', 'ENTRY_POINTS')
           if not hasattr(m, n)]
sys.exit(1 if missing else 0)
PY
then
    ok 'gatherd-check-aur-deps still provides the walk this reads'
else
    bad 'gatherd-check-aur-deps no longer provides load/visit/names_from/ENTRY_POINTS'
fi

printf '\n%s passed, %s failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
