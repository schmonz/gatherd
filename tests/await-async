#!/bin/sh
# Unit tests for gatherd-await-async, the barrier the session cohort waits on.
#
# Each case is a way the barrier could quietly undo the fix it delivers:
#   - it must return AT ONCE on a converged machine, or every login pays for the
#     first one;
#   - it must WAIT while the run is unfinished, or nothing changed;
#   - it must treat a STALE sentinel as unfinished, because site-async.yml
#     overwrites the sentinel without removing it, so after a `git pull` the file
#     is still there holding the old commit while REST re-runs;
#   - it must release on a run that FINISHED AND FAILED, which the sentinel
#     cannot express;
#   - it must release when CORE failed and REST has nothing to start from, but
#     NOT when CORE failed while a REST run from before the `git pull` is still
#     genuinely in progress -- core-complete's presence, not last-run's content,
#     is what tells those two apart;
#   - it must treat an unreadable last-run the same as CORE still running (wait),
#     never the same as CORE having failed (release);
#   - it must trim whitespace before comparing last-run's content, not compare
#     it exactly;
#   - it must treat a missing or non-executable gatherd-needs-run as "cannot
#     tell", never as "converged";
#   - a timeout value that is all digits but not a safe one (a leading zero, or
#     one big enough to overflow the deadline arithmetic) must not crash the
#     script, release it early, or be read as octal instead of decimal;
#   - it must always exit 0, because it is a wait and not a predicate.
#
# Usage: tests/await-async

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
BARRIER="$REPO/scripts/gatherd-await-async"
PASS=0
FAIL=0

ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }
assert() { _d=$1; shift; if [ "$@" ]; then ok "$_d"; else bad "$_d"; fi; }

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
HOMEDIR="$WORK/gatherd"
mkdir -p "$HOMEDIR/scripts" "$WORK/nohome"
cp "$REPO/scripts/gatherd-needs-run" "$HOMEDIR/scripts/"
git -C "$HOMEDIR" init -q
git -C "$HOMEDIR" -c user.email=t@t -c user.name=t commit -q --allow-empty -m base
HEAD=$(git -C "$HOMEDIR" rev-parse HEAD)

SENTINEL="$WORK/async-complete"
STAMP="$WORK/async-complete-finished"
LASTRUN="$WORK/last-run"
# Absent, like a machine whose CORE run has not written it yet -- created only by
# the tests that need it present.
CORE_COMPLETE="$WORK/core-complete"
printf 'ok\n' > "$LASTRUN"

# Overridable so test 13 can point one call at a sandbox with a broken
# gatherd-needs-run without duplicating the whole function.
BARRIER_HOME="$HOMEDIR"

run_barrier() {
    _start=$(date +%s)
    GATHERD_HOME="$BARRIER_HOME" GATHERD_ASYNC_SENTINEL="$SENTINEL" \
        GATHERD_CORE_MARKER="$LASTRUN" GATHERD_CORE_COMPLETE="$CORE_COMPLETE" \
        "$@" sh "$BARRIER" >/dev/null 2>&1 && RC=0 || RC=$?
    ELAPSED=$(( $(date +%s) - _start ))
}

# Releases the barrier from a background job after a delay, the way the real
# REST run's own gatherd-await-and-run eventually does. Used whenever a case
# needs to prove the barrier is genuinely blocked rather than about to release
# for an unrelated reason.
release_stamp_after() {
    rm -f "$STAMP"
    ( sleep "$1"; printf '%s\n' "$HEAD" > "$STAMP" ) &
}

# 1. Converged: sentinel records the deployed HEAD. Every login after the first.
printf '%s\n' "$HEAD" > "$SENTINEL"
run_barrier env
assert "returns at once when the sentinel is current (${ELAPSED}s)" "$ELAPSED" -le 1
assert "and exits 0 (rc=$RC)" "$RC" -eq 0

# 2. Stale sentinel and no stamp: what every boot after a `git pull` looks like
#    while REST re-runs. An existence test would return instantly here.
printf '%s\n' 0000000000000000000000000000000000000000 > "$SENTINEL"
rm -f "$STAMP"
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=3
assert "waits on a stale sentinel (${ELAPSED}s)" "$ELAPSED" -ge 2
assert "and exits 0 at the bound (rc=$RC)" "$RC" -eq 0

# 3. A stale stamp is no better than a stale sentinel.
printf '%s\n' 0000000000000000000000000000000000000000 > "$STAMP"
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=3
assert "waits on a stale stamp (${ELAPSED}s)" "$ELAPSED" -ge 2

# 4. The run finished and FAILED: no fresh sentinel will ever appear, but the
#    tiers are over. Without this the cohort waits out the bound after every
#    failure.
printf '%s\n' "$HEAD" > "$STAMP"
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=60
assert "releases on a finished-but-failed run (${ELAPSED}s)" "$ELAPSED" -le 5
assert "and exits 0 (rc=$RC)" "$RC" -eq 0

# 5. The stamp landing mid-wait releases it -- the actual first-boot sequence,
#    where the barrier is already blocked when the run ends.
release_stamp_after 2
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=60
wait
assert "releases when the stamp lands mid-wait (${ELAPSED}s)" "$ELAPSED" -le 10
assert "and not before it landed (${ELAPSED}s)" "$ELAPSED" -ge 2

# 6. CORE failed on a first boot: core-complete was never written, so
# gatherd-await-and-run's own `while [ ! -f "$complete" ]` gate means REST never
# started and never will this boot. A broken machine is exactly when the tray
# and the polkit agent are wanted.
rm -f "$STAMP" "$CORE_COMPLETE"
printf 'timeout\n/var/log/gatherd.log\n' > "$LASTRUN"
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=60
assert "releases when CORE never completed at all (${ELAPSED}s)" "$ELAPSED" -le 5
assert "and exits 0 (rc=$RC)" "$RC" -eq 0

# 6a. The equality compare against last-run's content must be trimmed, not
# exact: with core-complete absent, "ok " with a trailing space is CORE
# succeeding, and reading it as anything else releases the cohort in front of a
# CORE run that is (as far as this file can tell) still in progress.
printf 'ok \n' > "$LASTRUN"
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=3
assert "waits when last-run is \"ok \" with trailing whitespace (${ELAPSED}s)" "$ELAPSED" -ge 2
assert "and exits 0 (rc=$RC)" "$RC" -eq 0
printf 'ok\n' > "$LASTRUN"

# 7. CORE failed on a `git pull` re-run, but core-complete is a STALE leftover
# from the previous converge -- gatherd-await-and-run's gate is existence, not
# freshness, so REST is genuinely running right now behind that stale file. An
# earlier version of this barrier read non-ok last-run alone as "REST never
# started" and released here in error, putting the cohort in front of a live
# install. It must wait for the real stamp instead.
: > "$CORE_COMPLETE"
release_stamp_after 2
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=60
wait
assert "does not release early on a stale core-complete (${ELAPSED}s)" "$ELAPSED" -ge 2
assert "releases once the real run finishes (${ELAPSED}s)" "$ELAPSED" -le 10
rm -f "$CORE_COMPLETE"
printf 'ok\n' > "$LASTRUN"

# 8. CORE still running: core-complete absent, and last-run not yet written at
# all (record() only ever runs once CORE finishes). Must wait, not release.
rm -f "$STAMP" "$LASTRUN"
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=3
assert "waits while CORE has not finished (${ELAPSED}s)" "$ELAPSED" -ge 2
assert "and exits 0 (rc=$RC)" "$RC" -eq 0

# 9. An unreadable last-run is the same "cannot tell" as CORE still running, not
# the same as "CORE failed". last-run is root-owned in production; mode 000
# here stands in for "this reader cannot open it" regardless of the reason.
printf 'failed\n/var/log/x\n' > "$LASTRUN"
chmod 000 "$LASTRUN"
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=3
assert "waits when last-run cannot be read (${ELAPSED}s)" "$ELAPSED" -ge 2
assert "and exits 0 (rc=$RC)" "$RC" -eq 0
chmod 644 "$LASTRUN"
printf 'ok\n' > "$LASTRUN"

# 10. A checkout git calls foreign must not read as permanently unconverged.
printf '%s\n' "$HEAD" > "$SENTINEL"
run_barrier env GIT_TEST_ASSUME_DIFFERENT_OWNER=1 HOME="$WORK/nohome" GATHERD_AWAIT_ASYNC_TIMEOUT=6
assert "returns at once on a foreign-owned checkout (${ELAPSED}s)" "$ELAPSED" -le 1

# 11. All-digit is not the same as safe. Each of these parses without error
# under the naive *[!0-9]* guard but breaks the arithmetic a different way:
# 08/019 contain a digit no octal literal can (`$(( ))` errors outright), 007
# quietly means 7 (kept even though that coincides with its decimal reading --
# it still proves a leading zero made only of valid octal digits does not
# crash, which 08/019 don't cover), and the u64-max value overflows the
# deadline negative and would release at once on an unconverged machine. Each
# must still park in the wait loop and release only when the real stamp lands.
for bad_timeout in 08 019 007 9223372036854775807; do
    printf '%s\n' 0000000000000000000000000000000000000000 > "$SENTINEL"
    release_stamp_after 2
    run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT="$bad_timeout"
    wait
    assert "GATHERD_AWAIT_ASYNC_TIMEOUT=$bad_timeout does not release early (${ELAPSED}s)" "$ELAPSED" -ge 2
    assert "and still releases on the real stamp (${ELAPSED}s)" "$ELAPSED" -le 10
    assert "and exits 0 (rc=$RC)" "$RC" -eq 0
done

# 11a. `007` above cannot tell octal from decimal parsing apart -- they agree.
# `010` does: octal 8 vs. decimal 10. No stamp arrives here, so the barrier
# runs out the actual bound; reading it as decimal is what makes the wait land
# at 10s rather than 8.
printf '%s\n' 0000000000000000000000000000000000000000 > "$SENTINEL"
rm -f "$STAMP"
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=010
assert "GATHERD_AWAIT_ASYNC_TIMEOUT=010 waits 10s, not octal's 8 (${ELAPSED}s)" "$ELAPSED" -ge 9

# 12. Always exits 0 is an invariant, not an aspiration: a garbage bound must not
# throw under `set -u`, nor be mistaken for "no bound at all" -- it must still
# wait on a stale sentinel rather than treat the fallback as an instant pass.
printf '%s\n' 0000000000000000000000000000000000000000 > "$SENTINEL"
release_stamp_after 2
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=abc
wait
assert "a non-numeric bound still waits for the run (${ELAPSED}s)" "$ELAPSED" -ge 2
assert "and releases once it finishes (${ELAPSED}s)" "$ELAPSED" -le 10
assert "and exits 0 (rc=$RC)" "$RC" -eq 0

# 13. A missing or non-executable gatherd-needs-run must not read as converged.
# current() only trusts an exit code of exactly 1 for this reason; changing that
# to "not 0" passes every other case here, because a non-executable script's
# rc=126 is nonzero too.
BROKENHOME="$WORK/broken-gatherd"
mkdir -p "$BROKENHOME/scripts"
cp "$REPO/scripts/gatherd-needs-run" "$BROKENHOME/scripts/"
chmod 644 "$BROKENHOME/scripts/gatherd-needs-run"
git -C "$BROKENHOME" init -q
git -C "$BROKENHOME" -c user.email=t@t -c user.name=t commit -q --allow-empty -m base
rm -f "$STAMP"
printf '%s\n' "$HEAD" > "$SENTINEL"
BARRIER_HOME="$BROKENHOME"
run_barrier env GATHERD_AWAIT_ASYNC_TIMEOUT=3
BARRIER_HOME="$HOMEDIR"
assert "a non-executable gatherd-needs-run still waits (${ELAPSED}s)" "$ELAPSED" -ge 2
assert "and exits 0 (rc=$RC)" "$RC" -eq 0

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
