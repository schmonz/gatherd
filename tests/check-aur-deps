#!/bin/sh
# Unit tests for gatherd-check-aur-deps.
#
# The gate exists because a dependency that is merely PRESENT is not a
# dependency that is DECLARED, and only the second one survives a repave. So
# the cases that matter are the ones a reachability check gets wrong:
#
#   * a declared dependency removed while something else still drags it in
#     (github-cli depends on mailcap, so nothing would have missed it)
#   * a dependency declared in a LATER tier than the build that needs it,
#     which is exactly how gsl reached the machine nine minutes too late
#   * a file that builds an AUR package without being placed in the converge
#     order, which is how thinkfan went unchecked
#
# And the case it must NOT flag: a dependency that really is on the ISO.
#
# Runs against a copy of the real repo, so it needs a synced pacman db and the
# network. The .SRCINFO cache under ~/.cache/gatherd makes repeat runs cheap.
#
# Usage: tests/check-aur-deps

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
PASS=0
FAIL=0

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
cp -R "$REPO" "$WORK/repo"
GATE="$WORK/repo/scripts/gatherd-check-aur-deps"
VARS="$WORK/repo/group_vars/all/main.yml"
AMBIENT="$WORK/repo/roles/hardware/tasks/ambient_light.yml"
APPLESMC="$WORK/repo/roles/hardware/tasks/applesmc.yml"
cp "$VARS" "$WORK/pristine"
cp "$AMBIENT" "$WORK/pristine-ambient"
cp "$APPLESMC" "$WORK/pristine-applesmc"
cp "$GATE" "$WORK/pristine-gate"
cp "$WORK/repo/site-async.yml" "$WORK/pristine-async"
cp "$WORK/repo/roles/aur/tasks/slow.yml" "$WORK/pristine-slow"

ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

restore() { cp "$WORK/pristine" "$VARS"; }
undeclare() { sed -i "/^  - $1  */d" "$VARS"; }

assert_rc() {
    _d=$1; _want=$2
    # Guarded by if so a nonzero exit is data, not a set -e abort.
    if "$GATE" "$WORK/repo" >"$WORK/out" 2>&1; then _got=0; else _got=$?; fi
    if [ "$_got" = "$_want" ]; then ok "$_d"; else bad "$_d (want rc=$_want got rc=$_got)"; cat "$WORK/out"; fi
}

assert_says() {
    _d=$1; _want=$2
    if grep -q "$_want" "$WORK/out"; then ok "$_d"; else bad "$_d (no '$_want' in output)"; fi
}

# 1. The working tree is green, or nothing below means anything. This is the
#    tree, not HEAD: the point is to check what you are about to commit.
assert_rc "the working tree exits 0" 0

# 2. An undeclared dependency is caught even though the machine still has it.
#    mailcap is reported as mime-types: the gate says what the AUR asked for,
#    not what happens to supply it.
for pair in gsl:gsl mailcap:mime-types yaml-cpp:yaml-cpp libconfig:libconfig zip:zip; do
    undeclare "${pair%:*}"
    assert_rc "undeclared ${pair%:*} exits 1" 1
    assert_says "undeclared ${pair%:*} is named" "needs ${pair#*:}"
    restore
done

# 3. A dependency the EndeavourOS install already provides needs no declaration,
#    and must not be reported just because rest_packages stopped naming it.
for pkg in gtk3 ttf-dejavu linux-api-headers; do
    undeclare "$pkg"
    assert_rc "$pkg is on the ISO, so dropping it exits 0" 0
    restore
done

# 4. The gsl failure itself: declared, but in a tier that runs after the build.
#    Reachability says yes; the machine said no.
undeclare gsl
sed -i 's/^rest_slow_packages:/rest_slow_packages:\n  - gsl/' "$VARS"
assert_rc "gsl declared in a later tier exits 1" 1
assert_says "gsl declared in a later tier is named" "needs gsl"
restore

# 5. A file that builds an AUR package but no playbook reaches is not skipped.
mkdir -p "$WORK/repo/roles/newthing/tasks"
cat > "$WORK/repo/roles/newthing/tasks/main.yml" <<'FIXTURE'
---
- name: Build something nobody reaches
  ansible.builtin.command: "{{ aur_sync_command }} mbpfan"
  changed_when: false
FIXTURE
assert_rc "an unreachable AUR build exits 1" 1
assert_says "the unreachable file is named" "roles/newthing/tasks/main.yml"
rm -rf "$WORK/repo/roles/newthing"

# 6. The dict spelling of command: is read, not silently skipped. Respelling
#    the clight build this way once made the whole gsl case vanish.
python3 - "$AMBIENT" <<'PATCH'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
p.write_text(p.read_text().replace(
    '  ansible.builtin.command: "{{ aur_sync_command }} clight"\n',
    '  ansible.builtin.command:\n    cmd: "{{ aur_sync_command }} clight"\n'))
PATCH
undeclare gsl
assert_rc "a dict-spelled command: is still checked" 1
assert_says "the dict-spelled build is named" "needs gsl"
restore
cp "$WORK/pristine-ambient" "$AMBIENT"

# 7. An aur sync line this gate cannot parse is a failure, not a quiet pass.
sed -i 's|{{ aur_sync_command }} mbpfan|{{ aur_sync_command }} --rebuild mbpfan|' "$APPLESMC"
assert_rc "an unparseable aur sync line exits 1" 1
assert_says "the unparseable line is named" "cannot tell which packages"
cp "$WORK/pristine-applesmc" "$APPLESMC"

# 8. Order comes from site-async.yml, not from a constant in the gate. Building
#    the hardware tier before the system tier that installs its dependencies is
#    the original bug, wholesale.
python3 - "$WORK/repo/site-async.yml" <<'PATCH'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
text = p.read_text()
start = text.index('    - name: Converge the network-dependent system tier')
mid = text.index('    - name: Converge hardware-specific configuration')
end = text.index('- name: User configuration')
system, hardware = text[start:mid], text[mid:end]
p.write_text(text[:start] + hardware + system + text[end:])
PATCH
assert_rc "hardware before the system tier exits 1" 1
assert_says "the reordered tier is reported" "needs"
cp "$WORK/pristine-async" "$WORK/repo/site-async.yml"

# 9. `when:` is honoured: an install behind one hardware gate has not satisfied
#    a build behind a different one.
undeclare yaml-cpp
python3 - "$APPLESMC" <<'PATCH'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
p.write_text('---\n- name: Install yaml-cpp somewhere unrelated\n'
             '  community.general.pacman:\n    name: yaml-cpp\n'
             '    state: present\n\n' + p.read_text().replace('---\n', '', 1))
PATCH
assert_rc "an install behind another hardware gate does not count" 1
assert_says "the cross-gated dependency is named" "needs yaml-cpp"
restore
cp "$WORK/pristine-applesmc" "$APPLESMC"

# 10. `state: removed` removes, the same as absent -- so it must not be read as
#     an install. (ansible-doc community.general.pacman: "V(absent) and
#     V(removed) remove the specified package".)
sed -i 's/^    state: present$/    state: removed/' "$AMBIENT"
assert_rc "state: removed is not an install" 1
assert_says "the un-installed AUR dependency is named" "clight needs clightd"
cp "$WORK/pristine-ambient" "$AMBIENT"

# 11. Infrastructure trouble is rc=2, so it can never be mistaken for a repo
#     that violates the rule. Port 1 refuses at once, so this is the
#     connection-refused half of "the AUR is unreachable".
# A cold cache, or the fetch never happens and the breakage is invisible.
AUR_SRCINFO='http://127.0.0.1:1/' XDG_CACHE_HOME="$WORK/cold" \
    assert_rc "an unreachable AUR exits 2, not 1" 2

# 12. A build must be guarded, and by a guard with the same when: it has. The
#     AVX guard once ran unconditionally in front of a `when: has_avx` build,
#     which on a pre-AVX machine failed the tier over a build that never ran.
python3 - "$WORK/repo/roles/aur/tasks/slow.yml" <<'PATCH'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
p.write_text(p.read_text().replace(
    """        aur_assert_targets: "{{ aur_slow_avx_packages }}"
      # Same gate as the build below. Without it a pre-AVX machine fails this
      # tier's whole block over a build it was never going to run.
      when: has_avx
""",
    """        aur_assert_targets: "{{ aur_slow_avx_packages }}"
"""))
PATCH
assert_rc "a guard that outlives its build exits 1" 1
assert_says "the condition mismatch is reported" "the build under"
cp "$WORK/pristine-slow" "$WORK/repo/roles/aur/tasks/slow.yml"

# 13. And a build with no guard at all.
python3 - "$AMBIENT" <<'PATCH'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
p.write_text(p.read_text().replace(
    """- name: Check the build dependencies of clight
  ansible.builtin.include_tasks: tasks/assert_aur_deps.yml
  vars:
    aur_assert_targets: ['clight']

""", ""))
PATCH
assert_rc "an unguarded build exits 1" 1
assert_says "the unguarded build is named" "no assert_aur_deps guard"
cp "$WORK/pristine-ambient" "$AMBIENT"

# 14. Which failures are the AUR's and which are ours. The gate's header
#     promises "1 on violations, 2 if the check could not be run", and CLAUDE.md
#     turns on the same line: an unreachable AUR is weather, a target the AUR
#     has never heard of is this repo naming a package wrong. Both directions
#     have to be pinned, because collapsing them is silent either way -- a
#     misspelt package excused as an outage forever, or every 429 reported as a
#     repo bug, which is what sent tests/gates red on a day nothing had changed.
#
#     Against a local stand-in for the AUR, not the real one: none of these
#     states can be asked of aur.archlinux.org on demand, and a suite that
#     waited for a real 429 would be a suite nobody could run.
STUB="$TESTSDIR/fixtures/stub-aur.py"
python3 "$STUB" "$WORK" &
STUB_PID=$!
# `|| :` because `set -e` applies inside the trap: once the stub has already
# been reaped, kill exits 1, the trap aborts before the rm, and the suite exits
# 1 having printed "0 failed" and leaked its temporary directory. Measured --
# adding cases after the explicit kill below was enough to make the child
# reapable in time, and a green run came out as rc=1.
trap 'kill "$STUB_PID" 2>/dev/null || :; rm -rf "$WORK"' EXIT

_waited=0
while [ ! -s "$WORK/stub-port" ]; do
    _waited=$((_waited + 1))
    [ "$_waited" -gt 100 ] && { bad "the stub AUR never came up"; break; }
    sleep 0.1
done
STUB_URL="http://127.0.0.1:$(cat "$WORK/stub-port" 2>/dev/null || echo 1)"

# `aur query` reads AUR_LOCATION itself and the gate derives its .SRCINFO URL
# from the same variable, so this points both halves at the stub. A cold cache
# per case, or a cached .SRCINFO answers instead of the mode under test.
# `timeout` so a gate that will not give up is a FAILING case rather than a
# suite that never finishes -- which is the very defect the hang modes below
# pin. 60s is twice the gate's own default bound, so it can only fire when the
# bound does not.
stub() {
    _d=$1; _want=$2; _mode=$3; _absent=${4:-}
    printf '%s' "$_mode" > "$WORK/stub-mode"
    printf '%s' "$_absent" > "$WORK/stub-absent"
    rm -rf "$WORK/stubcache"
    if AUR_LOCATION="$STUB_URL" XDG_CACHE_HOME="$WORK/stubcache" \
        GATHERD_AUR_TIMEOUT="${STUB_TIMEOUT:-30}" \
        timeout 60 "$GATE" "$WORK/repo" >"$WORK/out" 2>&1; then _got=0; else _got=$?; fi
    if [ "$_got" = "$_want" ]; then ok "$_d"; else bad "$_d (want rc=$_want got rc=$_got)"; sed 's/^/       /' "$WORK/out"; fi
}

# The stub has to be a good enough AUR that the failures below mean something:
# every target resolves, every .SRCINFO parses, nothing is declared, so a green
# run here is the control.
stub "a healthy stub AUR exits 0" 0 healthy

stub "an RPC 429 exits 2, not 1" 2 rpc429
assert_says "the 429 is named" "429"

# The measured original bug. curl -f turns a 429 STATUS into a failed `aur
# query`, which was already rc=2 -- but a rate limiter that answers 200 with an
# HTML page does not, and json.loads raised straight out of main() as an
# uncaught traceback, which is exit 1.
stub "a 200 carrying HTML exits 2, not 1" 2 rpchtml
assert_says "the unparseable reply is described" "JSON aurweb sends"

# aurweb reports its own rate limit in the body. Its results list is empty, so
# without reading `type: error` every target reads as "not in the AUR" -- the
# outage arriving as the one verdict that must mean the repo is wrong.
stub "aurweb's own error body exits 2, not 1" 2 rpcjson
assert_says "the AUR's reason is quoted" "Rate limit reached"

stub "a cgit 429 exits 2, not 1" 2 cgit429
assert_says "the cgit failure is named" "would not serve .SRCINFO"

# And the direction that must NOT fail open. rclone left the AUR for [extra]
# and captive-browser is only a provides of captive-browser-git; both were this
# repo naming a package the AUR does not have.
stub "a package the AUR does not have exits 1" 1 healthy clight
assert_says "the missing target is named" "clight"
assert_says "the missing target is called a missing target" "no such target"

stub "a cgit 404 exits 1, not 2" 1 cgit404
assert_says "the 404 says the package is gone" "no such package"

# 15. A server that completes the TCP handshake and then says nothing. That is
#     a captive portal -- the thing this repo builds captive-browser-git for --
#     and it is not the same as the refused connection case 11 covers: nothing
#     ever comes back to react to, so an unbounded client waits for it forever.
#
#     Measured before this was bounded, against a socket that accepts and never
#     answers: the cgit half exited 2 after 31s on urlopen(timeout=30), and the
#     RPC half never returned at all -- still running when `timeout 90` killed
#     it, because `aur query` shells out to `curl -A aurutils -fgLsSq` with no
#     --max-time and the subprocess call had no timeout=. tests/gates runs this
#     gate live, so tests/gates hung with it instead of exiting 2.
#
#     Two seconds rather than the default thirty for the same reason the stub
#     exists at all: this suite has to reach the branch without waiting out a
#     real bound.
STUB_TIMEOUT=2
stub "an RPC that never answers exits 2" 2 rpchang
assert_says "the RPC timeout says what did not answer" "did not answer within"

stub "a cgit that never answers exits 2" 2 cgithang
assert_says "the cgit timeout is weather, not a missing package" "cannot read .SRCINFO"

# 16. And nothing still holding the dead connection afterwards. `aur query`
#     shells out to `curl -A aurutils -fgLsSq` with neither --max-time nor
#     --connect-timeout, so the curl is a grandchild that outlives its parent:
#     measured against this same never-answering socket,
#     subprocess.run(['aur','query',...], timeout=3) left one curl alive two
#     seconds later and `timeout 3 aur query` left none, because timeout(1)
#     signals the process group. Case 15 above just timed one out, so a leak
#     shows up right here.
sleep 1
_leaked=$(pgrep -f "curl -A aurutils.*${STUB_URL#http://}" | wc -l)
if [ "$_leaked" -eq 0 ]; then
    ok "a timed-out RPC leaves no curl behind"
else
    bad "a timed-out RPC left $_leaked curl(s) holding the dead connection"
    pgrep -af "curl -A aurutils.*${STUB_URL#http://}" | sed 's/^/       /'
fi

STUB_TIMEOUT=30

kill "$STUB_PID" 2>/dev/null || :

# 17. A bound the environment set to something that is not a bound. Measured
#     before this was handled: `abc` and `` (which
#     `export GATHERD_AUR_TIMEOUT=$SOMETHING_UNSET` produces) each ended in a
#     ValueError traceback and exit 1 -- this gate's spelling of "the repo
#     declares a dependency it does not install", sending a committer hunting a
#     violation that is not there. `0` and `-5` are here because they must not
#     become permissive: `timeout 0` means no timeout at all, so the value that
#     used to fail closed would otherwise buy back the unbounded wait.
#
#     `inf` and `1e9` are the same hazard wearing a number. Both pass a
#     more-than-zero test, and both were measured ending the run in an
#     OverflowError traceback and exit 1:
#
#         GATHERD_AUR_TIMEOUT=inf -> OverflowError: cannot convert float
#                                    infinity to integer
#         GATHERD_AUR_TIMEOUT=1e9 -> OverflowError: timeout is too large
#
#     Clamping instead of refusing would be worse than the traceback, for the
#     reason `0` is here: `timeout inf true` exits 0 on this machine (GNU
#     coreutils 9.11), and `timeout 1e+09 true` -- the `%g` rendering of 1e9 --
#     exits 0 too, so either value spends thirty-one years not being a bound.
#     No stub needed: none of these reaches the network.
for _bad in abc '' 0 -5 inf 1e9; do
    if GATHERD_AUR_TIMEOUT="$_bad" "$GATE" "$WORK/repo" >"$WORK/out" 2>&1; then
        _got=0
    else
        _got=$?
    fi
    if [ "$_got" = 2 ]; then
        ok "GATHERD_AUR_TIMEOUT='$_bad' is could-not-run, not a violation"
    else
        bad "GATHERD_AUR_TIMEOUT='$_bad' exited $_got, wanted 2"
        sed 's/^/       /' "$WORK/out"
    fi
    assert_says "and says which variable is wrong for '$_bad'" 'GATHERD_AUR_TIMEOUT'
    if grep -q 'Traceback' "$WORK/out"; then
        bad "GATHERD_AUR_TIMEOUT='$_bad' still reports by traceback"
    else
        ok "and does not report it by traceback"
    fi
done

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
