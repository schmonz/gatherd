# 38. A launch nested inside a backslash-escaped quote (`eval "start_now
#     \"$bin/x\""`) is genuinely, unambiguously inside the outer quote by the
#     time the escape is even seen -- no per-character quote tracker can both
#     handle the escape correctly AND keep it visible. It must not be
#     silently hidden either way: falling back to the raw line for this one
#     restores round 1's already-proven-correct handling of it.
helpers <<'EOF'
start_now()   { sh -c "$1" & }
start_later() { sh -c "$1" & }
eval "start_now \"$bin/wayvnc\""
{
    "$bin/gatherd-await-async"
    start_later "$bin/other"
} &
EOF
assert_rc "a launch nested inside an escaped quote is not silently hidden" 1
assert_says "and says it does not begin its line" "does not begin its line"

# 39. An escaped single quote inside a single-quoted string, used to embed a
