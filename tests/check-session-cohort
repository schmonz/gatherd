helpers <<'EOF'
start_now()   { sh -c "$1" & }
start_later() { sh -c "$1" & }
eval "start_now $bin/wayvnc"
{
    "$bin/gatherd-await-async"
    start_later "$bin/other"
} &
EOF
assert_rc "a launch inside an unescaped eval string is not silently hidden" 1
assert_says "and says it does not begin its line" "does not begin its line"

# 42. Same mechanism through the other spelling, and with single quotes, so
