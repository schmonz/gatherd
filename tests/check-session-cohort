#     characters -- a naive toggle-per-character scanner (no escape handling
#     at all) ends the line permanently "inside a quote", swallowing every
#     launch after it, including one that is genuinely unquoted code.
helpers <<'EOF'
start_now()   { sh -c "$1" & }
start_later() { sh -c "$1" & }
echo 'don'\''t' && start_now "$bin/wayvnc"
{
    "$bin/gatherd-await-async"
    start_later "$bin/other"
} &
EOF
assert_rc "an escaped single quote does not swallow a later launch" 1
assert_says "and says it does not begin its line" "does not begin its line"

# 40. Regression guard: a backslash escaping something OTHER than a quote
#     (`\n` inside a single-quoted string) is not a quoting ambiguity and
#     must keep using normal sanitization -- test 31 depends on this exact
#     shape staying hidden.
helpers <<'EOF'
start_now()   { sh -c "$1" & }
start_later() { sh -c "$1" & }
printf 'start_later is the default\n' >&2
start_now "$bin/watcher"  # needs: fuzzel
{
    "$bin/gatherd-await-async"
    start_later "$bin/other"
