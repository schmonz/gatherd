#!/bin/sh
# Unit tests for gatherd-check-vault-units.
#
# The flag is a declaration, and a declaration can drift from what it describes.
# Both directions are failures: a playbook that reads the vault but whose unit
# forgot the flag dies at parse time with "Attempting to decrypt but no vault
# secrets found", and a unit that passes the flag for a playbook with no vault
# vars silently reinstates the coupling this whole change removed.
#
# Usage: tests/check-vault-units

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
GATE="$REPO/scripts/gatherd-check-vault-units"
PASS=0
FAIL=0

ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/services/system"

assert_rc() {
    _d=$1; _want=$2
    if "$GATE" "$WORK" >"$WORK/out" 2>&1; then _got=0; else _got=$?; fi
    if [ "$_got" = "$_want" ]; then ok "$_d"; else bad "$_d (want rc=$_want got rc=$_got)"; sed 's/^/       /' "$WORK/out"; fi
}
assert_says() {
    _d=$1; _want=$2
    if grep -q -- "$_want" "$WORK/out"; then ok "$_d"; else bad "$_d (no '$_want' in output)"; fi
}

unit() {
    printf '[Service]\nExecStart=/usr/local/lib/gatherd/scripts/gatherd-await-and-run %s /usr/local/lib/gatherd/%s\n' \
        "$2" "$3" > "$WORK/services/system/$1"
}

# 1. Matched pair: the vault play declares vault vars and its unit passes the
#    flag; the async play declares none and its unit does not.
printf -- '---\n- hosts: localhost\n  vars_files:\n    - vault/vault.yml\n' > "$WORK/site-vault.yml"
printf -- '---\n- hosts: localhost\n' > "$WORK/site-async.yml"
unit gatherd-vault.service '--needs-vault /etc/gatherd/vault-complete' site-vault.yml
unit gatherd-async.service '/etc/gatherd/async-complete' site-async.yml
assert_rc "a matched pair exits 0" 0

# 2. A playbook reads the vault and its unit forgot the flag.
unit gatherd-vault.service '/etc/gatherd/vault-complete' site-vault.yml
assert_rc "vault vars without the flag fails" 1
assert_says "and names the playbook" "site-vault.yml"

# 3. A unit passes the flag for a playbook with no vault vars, quietly putting
#    the coupling back.
unit gatherd-vault.service '--needs-vault /etc/gatherd/vault-complete' site-vault.yml
unit gatherd-async.service '--needs-vault /etc/gatherd/async-complete' site-async.yml
assert_rc "the flag on a vault-free playbook fails" 1
assert_says "and names that playbook" "site-async.yml"

# 4. A unit naming a playbook that is not in the repo is a could-not-run, never a
#    pass -- a gate that returns 0 when it could not look is worse than no gate.
unit gatherd-async.service '/etc/gatherd/async-complete' site-missing.yml
assert_rc "a missing playbook is rc=2" 2

# 5. No units at all is also rc=2, not a clean bill of health.
rm -f "$WORK/services/system"/*.service
assert_rc "no units to check is rc=2" 2

# The async unit stays a harmless, correctly-matched bystander for the rest of
# this file: unchanged playbook, unchanged unit, never touched again.
unit gatherd-async.service '/etc/gatherd/async-complete' site-async.yml

# 6. A quoted scalar is ordinary YAML. An exact-anchor match that only
#    recognizes a bare, unquoted list item reads this as "no vars_files" and
#    lets the missing flag through clean -- exactly the failure mode this gate
#    exists to catch.
printf -- '---\n- hosts: localhost\n  vars_files:\n    - "vault/vault.yml"\n' > "$WORK/site-vault.yml"
unit gatherd-vault.service '/etc/gatherd/vault-complete' site-vault.yml
assert_rc "a double-quoted vars_files entry without the flag still fails" 1

printf -- '---\n- hosts: localhost\n  vars_files:\n    - '"'"'vault/vault.yml'"'"'\n' > "$WORK/site-vault.yml"
unit gatherd-vault.service '/etc/gatherd/vault-complete' site-vault.yml
assert_rc "a single-quoted vars_files entry without the flag still fails" 1

unit gatherd-vault.service '--needs-vault /etc/gatherd/vault-complete' site-vault.yml
assert_rc "a single-quoted vars_files entry with the flag is clean" 0

printf -- '---\n- hosts: localhost\n  vars_files:\n    - "vault/vault.yml"\n' > "$WORK/site-vault.yml"
assert_rc "a double-quoted vars_files entry with the flag is clean" 0

# 7. Flow style (vars_files: [vault/vault.yml]) is also ordinary YAML and hits
#    the same gap.
printf -- '---\n- hosts: localhost\n  vars_files: [vault/vault.yml]\n' > "$WORK/site-vault.yml"
unit gatherd-vault.service '/etc/gatherd/vault-complete' site-vault.yml
assert_rc "a flow-style vars_files entry without the flag still fails" 1

unit gatherd-vault.service '--needs-vault /etc/gatherd/vault-complete' site-vault.yml
assert_rc "a flow-style vars_files entry with the flag is clean" 0

# 8. A trailing inline comment after the value is also ordinary YAML. It broke
#    the old regex's trailing "$" anchor, which both flagged a
#    correctly-configured pair as a spurious FAIL and let an unflagged unit's
#    missing flag pass as a spurious clean bill of health.
printf -- '---\n- hosts: localhost\n  vars_files:\n    - vault/vault.yml  # decrypted with .vault_pass\n' > "$WORK/site-vault.yml"
unit gatherd-vault.service '--needs-vault /etc/gatherd/vault-complete' site-vault.yml
assert_rc "a trailing comment on a correctly-configured pair is not a false FAIL" 0

unit gatherd-vault.service '/etc/gatherd/vault-complete' site-vault.yml
assert_rc "a trailing comment does not hide a missing flag" 1

# 9. A line-continued ExecStart (valid systemd syntax) must not be reported as
#    an unrecognized playbook path -- that buries the real, parseable problem
#    behind a confusing "names \, which is not in this repo".
printf '[Service]\nExecStart=/usr/local/lib/gatherd/scripts/gatherd-await-and-run \\\n    --needs-vault /etc/gatherd/vault-complete /usr/local/lib/gatherd/site-vault.yml\n' \
    > "$WORK/services/system/gatherd-vault.service"
assert_rc "a line-continued ExecStart is rc=2" 2
assert_says "and names the real problem, not just 'not in this repo'" "continues"

# 10. A list item elsewhere that happens to equal "vault/vault.yml" is not a
#     vars_files entry. Unscoped block-style matching read it as one -- in
#     both directions: it spuriously failed a unit correctly omitting the
#     flag, and it would give a false clean to a unit wrongly carrying the
#     flag for a playbook with no real vault vars.
printf -- '---\n- hosts: localhost\n  some_other_list:\n    - vault/vault.yml\n' > "$WORK/site-vault.yml"
unit gatherd-vault.service '/etc/gatherd/vault-complete' site-vault.yml
assert_rc "a same-named entry under an unrelated key without the flag stays clean" 0

unit gatherd-vault.service '--needs-vault /etc/gatherd/vault-complete' site-vault.yml
assert_rc "the flag on that unrelated-key entry still fails" 1

# 11. Multi-line flow style -- the brackets on separate lines from the
#     entries -- is valid YAML that a single-line-only flow match misses.
printf -- '---\n- hosts: localhost\n  vars_files: [\n    vault/vault.yml\n  ]\n' > "$WORK/site-vault.yml"
unit gatherd-vault.service '/etc/gatherd/vault-complete' site-vault.yml
assert_rc "multi-line flow-style vars_files without the flag still fails" 1

unit gatherd-vault.service '--needs-vault /etc/gatherd/vault-complete' site-vault.yml
assert_rc "multi-line flow-style vars_files with the flag is clean" 0

# 12. A CRLF-terminated playbook is valid YAML. The bare "vars_files:" line
#     ending "\r\n" left a stray "\r" that made it compare unequal to "",
#     so block mode was never entered -- dark in both directions.
printf -- '---\r\n- hosts: localhost\r\n  vars_files:\r\n    - vault/vault.yml\r\n' > "$WORK/site-vault.yml"
unit gatherd-vault.service '/etc/gatherd/vault-complete' site-vault.yml
assert_rc "a CRLF playbook without the flag still fails" 1

unit gatherd-vault.service '--needs-vault /etc/gatherd/vault-complete' site-vault.yml
assert_rc "a CRLF playbook with the flag is clean" 0

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
