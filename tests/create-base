#!/usr/bin/env bash
# Create a reusable EOS Sway base image for tests/test.
# Run this once (per machine); tests/test uses the result as a clean snapshot source.
#
# Usage: tests/create-base /path/to/EndeavourOS.iso
#
# Files are stored in GATHERD_VM_DIR (default: ~/.local/share/gatherd).
# Set that variable to override, e.g. on a machine with a specific fast disk.
set -euo pipefail

VM_DIR="${GATHERD_VM_DIR:-$HOME/.local/share/gatherd}"
BASE="$VM_DIR/eos-base.qcow2"
KEY="$VM_DIR/key"
PORT=2225

[[ $# -eq 1 ]] || { echo "Usage: $0 /path/to/EndeavourOS.iso" >&2; exit 1; }
ISO="$(realpath "$1")"
[[ -f "$ISO" ]] || { echo "ISO not found: $ISO" >&2; exit 1; }
[[ -f "$BASE" ]] && { echo "$BASE already exists; delete it to recreate" >&2; exit 1; }

mkdir -p "$VM_DIR"
[[ -f "$KEY" ]] || ssh-keygen -t ed25519 -f "$KEY" -N "" -q

qemu-img create -f qcow2 "$BASE" 40G

# ── Install ───────────────────────────────────────────────────────────────────

cat <<'EOF'

Starting EOS installer:
  • Online install → Sway desktop
  • Create a regular user (any name — the playbook detects first UID ≥ 1000)
  • No need to configure SSH — that happens automatically after you shut down

Shut down the VM when installation is complete.

EOF

qemu-system-x86_64 \
    -enable-kvm -m 4096 -smp 2 \
    -drive "file=$BASE,if=virtio,format=qcow2" \
    -cdrom "$ISO" \
    -boot d \
    -net nic,model=virtio \
    -net "user,hostfwd=tcp::${PORT}-:22" \
    -display gtk

# ── Inject SSH key via NBD (no boot needed) ───────────────────────────────────

echo "Injecting SSH key..."
sudo modprobe nbd max_part=8
sudo qemu-nbd --disconnect /dev/nbd0 2>/dev/null || true
sudo qemu-nbd --connect=/dev/nbd0 "$BASE"
sleep 1

MNTDIR=$(mktemp -d)
# EOS uses Btrfs with @ subvolume for root
_fs=$(sudo blkid -o value -s TYPE /dev/nbd0p1)
[[ "$_fs" == "btrfs" ]] || { echo "Expected btrfs on /dev/nbd0p1, got: $_fs" >&2; exit 1; }
sudo mount -o subvol=@ /dev/nbd0p1 "$MNTDIR"
sudo mkdir -p "$MNTDIR/root/.ssh"
cat "${KEY}.pub" | sudo tee "$MNTDIR/root/.ssh/authorized_keys" >/dev/null
sudo chmod 700 "$MNTDIR/root/.ssh"
sudo chmod 600 "$MNTDIR/root/.ssh/authorized_keys"
sudo systemctl --root="$MNTDIR" enable sshd
sudo umount "$MNTDIR"
rmdir "$MNTDIR"
sudo qemu-nbd --disconnect /dev/nbd0

# ── Update packages ───────────────────────────────────────────────────────────

echo "Booting to update packages..."

qemu-system-x86_64 \
    -enable-kvm -m 4096 -smp 2 \
    -drive "file=$BASE,if=virtio,format=qcow2" \
    -net nic,model=virtio \
    -net "user,hostfwd=tcp::${PORT}-:22" \
    -nographic </dev/null &
QEMU_PID=$!
trap 'kill $QEMU_PID 2>/dev/null || true' EXIT

SSH=(ssh -p "$PORT" -i "$KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=3 -o BatchMode=yes root@localhost)

until "${SSH[@]}" true 2>/dev/null; do sleep 5; done

"${SSH[@]}" pacman -Syu --noconfirm

"${SSH[@]}" systemctl poweroff || true
wait "$QEMU_PID" || true

echo ""
echo "Base image ready: $BASE"
echo "Run vm/test to use it."
