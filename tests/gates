#!/bin/sh
# Run every static gate and its unit tests. The one command to type before
# committing.
#
# It also enforces the pairing that made this file necessary: a gate nothing
# exercises is a gate nobody trusts, and gatherd-check-package-tiers -- which
# carries the whole offline-cache promise -- went untested until this check
# went looking. So every scripts/gatherd-{check,assert}-* must have a
# tests/<same-name> beside it, with no exemption list. Writing the test is
# always cheaper than the exemption.
#
# Excludes the VM suites (tests/test, tests/create-base, tests/measure-migrations):
# those boot a machine and take minutes. Everything here is seconds.
#
# Needs the network and a synced pacman db, because the AUR gates do, and a C
# compiler, because tests/assert-sonames builds the ELFs it checks.
#
# Usage: tests/gates

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
PASS=0
FAIL=0

ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

run() {
    if "$@" >/tmp/gates.$$ 2>&1; then
        ok "$1"
    else
        bad "$1 (exit $?)"
        sed 's/^/       /' /tmp/gates.$$
    fi
    rm -f /tmp/gates.$$
}

printf '== every gate has a test ==\n'
for gate in "$REPO"/scripts/gatherd-check-* "$REPO"/scripts/gatherd-assert-*; do
    name=$(basename "$gate" | sed 's/^gatherd-//')
    if [ -f "$REPO/tests/$name" ]; then
        ok "$name is exercised by tests/$name"
    else
        bad "$name has no tests/$name -- write one rather than excusing it"
    fi
done

printf '\n== gates, against this working tree ==\n'
run "$REPO/scripts/gatherd-check-package-tiers" "$REPO"
run "$REPO/scripts/gatherd-check-migrations" "$REPO"
run "$REPO/scripts/gatherd-check-aur-deps" "$REPO"
run "$REPO/scripts/gatherd-check-vault-units" "$REPO"
run "$REPO/scripts/gatherd-check-session-cohort" "$REPO"

printf '\n== unit tests ==\n'
# assert-sonames is here and not in the block above for the same reason
# assert-aur-deps is: this file is the static suite, and both of those scripts
# read the machine rather than the working tree. Their fixtures belong here;
# their live answers belong where they run -- assert-aur-deps in front of every
# aur sync, assert-sonames after a converge, from the post-setup verify list.
for suite in check-package-tiers check-migrations check-aur-deps assert-aur-deps \
             assert-sonames census-removals migration-checks run-core await-and-run \
             check-vault-units needs-run await-async check-session-cohort \
             post-setup-notes; do
    # An `if`, not `[ -x ] && run`. The comment here used to say that && list
    # aborts the run under `set -eu`; it does not, and what it does instead is
    # worse. `set -e` is ignored for any command of an AND-OR list but the last
    # (POSIX, and bash, which is /bin/sh here):
    #
    #     $ sh -c 'set -eu; [ -x /nonexistent ] && echo ran; echo after'
    #     after
    #     rc=0
    #
    # so a `[ -x ]` that fails is simply skipped. Measured by checking out
    # bc487e7 -- the revision before this `if` landed -- and running it with
    # tests/needs-run made non-executable: rc=0, the summary printed, "23
    # passed, 0 failed", and the word needs-run nowhere in the output. A green
    # run that silently did not run a listed test is the one thing CLAUDE.md
    # will not have; a suite that cannot run is a named failure.
    #
    # Reproduce it at bc487e7 and nowhere else. That number is one per suite
    # plus the static gates above, so patching a LATER revision back to the &&
    # form counts whatever the list has grown to and gives 24 -- a6c75d3 added
    # post-setup-notes in the same commit as the `if`. A reviewer read the
    # sentence that way, got 24, and reported this number as wrong; it is not,
    # but a measurement nobody can re-run is only luckier than a wrong one.
    if [ -x "$REPO/tests/$suite" ]; then
        run "$REPO/tests/$suite"
    else
        bad "tests/$suite is listed here but not executable"
    fi
done

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
