#!/bin/sh
# eos-latest-iso -- print the URL to what we think is the latest EndeavourOS install ISO.
#
# Approach: scrape endeavouros.com (the canonical download page), extract the
# ISO filename from the sha512sum check hint, then construct a URL against a
# chosen mirror. Optionally HEAD-check the URL to confirm it resolves.
#
# Why not just hard-code a mirror's directory listing? Because (a) the home
# page is the source of truth maintained by the project, (b) several mirrors
# are out of sync at any given moment (the upstream page itself currently
# shows a Swedish mirror pointing at a stale date), and (c) mirror path
# layouts vary ("/endeavouros/iso", "/EndeavourOS/iso", "/mirror/endeavouros/iso").
#
# Defaults to the Gigenet mirror (USA), the only North American mirror on the
# official download page. Override with EOS_MIRROR_BASE if you prefer another.

set -eu

: "${EOS_PAGE_URL:=https://endeavouros.com/}"
: "${EOS_MIRROR_BASE:=https://mirrors.gigenet.com/endeavouros/iso}"
: "${EOS_FETCH:=curl}"
: "${EOS_VERIFY:=1}"          # set to 0 to skip the HEAD check
# The default curl UA can get a 403 from endeavouros.com. Send something innocuous.
: "${EOS_UA:=Mozilla/5.0 (X11; Linux x86_64) eos-latest-iso/1}"

warn() {
    echo "eos-latest-iso: $*" >&2
}

die() {
    rc=$1; shift
    warn "$@"
    exit "$rc"
}

fetch_download_page() {
    "$EOS_FETCH" -fsSL --retry 2 -A "$EOS_UA" "$EOS_PAGE_URL"
}

# Extract all ISO-filename candidates from the page. The home page mentions
# the current filename in multiple places (magnet link, sha512sum hint,
# mirror table); dedupe and let the caller pick.
iso_filename_candidates() {
    grep -oE 'EndeavourOS_[A-Za-z][A-Za-z0-9]*(-Neo)?-[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.iso' \
        | sort -u
}

# Pick the filename with the newest embedded date. A naive reverse string
# sort would mis-rank across codenames (e.g. "Titan-…04.27" beats
# "Mercury-…05.01" alphabetically), so re-key by the date portion.
newest_by_embedded_date() {
    awk '{
        if (match($0, /[0-9]{4}\.[0-9]{2}\.[0-9]{2}/)) {
            print substr($0, RSTART, RLENGTH) "\t" $0
        }
    }' \
        | sort -r \
        | head -n1 \
        | cut -f2
}

build_iso_url() {
    iso=$1
    printf '%s/%s\n' "${EOS_MIRROR_BASE%/}" "$iso"
}

# HEAD-check; emit a warning but do not fail -- a lagging mirror still tells
# you what filename to look for elsewhere.
warn_if_mirror_lacks_iso() {
    url=$1
    "$EOS_FETCH" -fsSI --retry 2 -A "$EOS_UA" -o /dev/null "$url" && return 0
    warn "WARNING: HEAD $url did not return 2xx"
    warn "the mirror may be lagging; try another via EOS_MIRROR_BASE"
}

main() {
    page=$(fetch_download_page) \
        || die 2 "failed to fetch $EOS_PAGE_URL"

    candidates=$(printf '%s\n' "$page" | iso_filename_candidates)
    [ -n "$candidates" ] \
        || die 3 "no ISO filenames found on $EOS_PAGE_URL (page layout may have changed)"

    iso=$(printf '%s\n' "$candidates" | newest_by_embedded_date)
    [ -n "$iso" ] \
        || die 3 "could not extract a date from filename candidates"

    url=$(build_iso_url "$iso")

    [ "$EOS_VERIFY" = "1" ] && warn_if_mirror_lacks_iso "$url"

    printf '%s\n' "$url"
}

main "$@"
exit $?
