#!/bin/sh
# Unit tests for the gatherd-icloud-* scripts.
#
# Fakes rclone and op on PATH so the decision logic — baseline detection, the
# refuse-on-populated-dir guard, the publish-only-if-verified guard — is
# exercised without an iCloud account or a network. Those guards are the parts
# that must not be discovered to be wrong on a fresh repave.
#
# Usage: tests/icloud

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
PASS=0
FAIL=0

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
FAKEBIN="$WORK/bin"
mkdir -p "$FAKEBIN"
PATH="$FAKEBIN:$REPO/scripts:$PATH"
export PATH

# fake_bin NAME BODY — install a fake executable that shadows the real one.
fake_bin() {
    printf '#!/bin/sh\n%s\n' "$2" > "$FAKEBIN/$1"
    chmod +x "$FAKEBIN/$1"
}

ok()   { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad()  { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

# gatherd-icloud-sync's say() calls notify-send whenever stderr is not a tty —
# which is exactly how this whole suite runs. Fake it before any other fake or
# test, or every failure-path test below pops a real notification on the
# human's desktop. $WORK is baked in literally (not read from the environment
# at run time) because the fake runs as its own process and nothing exports it.
NOTIFY_LOG="$WORK/notify.log"
fake_bin notify-send "printf '%s\n' \"\$*\" >> '$NOTIFY_LOG'"

assert_ok()   { _d=$1; shift; if "$@" >/dev/null 2>&1; then ok "$_d"; else bad "$_d (expected success)"; fi; }
assert_fail() { _d=$1; shift; if "$@" >/dev/null 2>&1; then bad "$_d (expected failure)"; else ok "$_d"; fi; }
# assert_out uses $() which strips trailing newlines; byte-exact expectations must use assert_bytes.
assert_out()  {
    _d=$1; _want=$2; shift 2
    _got=$("$@" 2>/dev/null || true)
    if [ "$_got" = "$_want" ]; then ok "$_d"; else bad "$_d (want [$_want] got [$_got])"; fi
}
# assert_bytes DESC EXPECTED CMD… — compares output byte-exactly by redirecting to files and using cmp.
assert_bytes() {
    _d=$1; _want=$2; shift 2
    _got_f="$WORK/got-bytes"
    _want_f="$WORK/want-bytes"
    printf '%s' "$_want" > "$_want_f"
    "$@" > "$_got_f" 2>/dev/null || true
    if cmp -s "$_want_f" "$_got_f"; then ok "$_d"; else bad "$_d (byte mismatch)"; fi
}

# ── gatherd-icloud-password ───────────────────────────────────────────────────

fake_bin op 'case "$*" in
    *"op://Private/rclone config/password"*) printf secret123 ;;
    *) echo "unexpected op args: $*" >&2; exit 1 ;;
esac'

assert_out 'password helper reads the default item' secret123 gatherd-icloud-password
assert_bytes 'password helper emits no trailing newline' secret123 gatherd-icloud-password

# Exported, not prefixed: a `VAR=x func` prefix does not reliably scope to a
# shell function the way it does to an external command.
export GATHERD_OP_VAULT=Other GATHERD_OP_PASSWORD_ITEM='other item'
assert_fail 'password helper honours item overrides' gatherd-icloud-password
unset GATHERD_OP_VAULT GATHERD_OP_PASSWORD_ITEM

fake_bin op 'echo "[ERROR] authorization timeout" >&2; exit 1'
assert_fail 'password helper fails when op is locked' gatherd-icloud-password

# ── gatherd-icloud-sync ───────────────────────────────────────────────────────

sync_env() {
    HOME_DIR="$WORK/h$1"
    rm -rf "$HOME_DIR"
    mkdir -p "$HOME_DIR/conf" "$HOME_DIR/state" "$HOME_DIR/filters" "$HOME_DIR/backup" "$HOME_DIR/root/FSNotes"
    cat > "$HOME_DIR/conf/icloud.conf" <<EOF
ICLOUD_REMOTE=icloud
ICLOUD_ROOT=$HOME_DIR/root
ICLOUD_FOLDERS="FSNotes"
EOF
    : > "$HOME_DIR/filters/FSNotes.filter"
    export GATHERD_ICLOUD_CONF="$HOME_DIR/conf/icloud.conf"
    export GATHERD_ICLOUD_STATE="$HOME_DIR/state"
    export GATHERD_ICLOUD_FILTERS="$HOME_DIR/filters"
    export GATHERD_ICLOUD_BACKUPS="$HOME_DIR/backup"
    export GATHERD_ICLOUD_MIN_INTERVAL=300
}

# rclone fake: `lsd` succeeds, `bisync` records its argv and succeeds.
fake_rclone_ok() {
    fake_bin rclone 'case "$1" in
    lsd) exit 0 ;;
    bisync) printf "%s\n" "$*" >> "$GATHERD_ICLOUD_STATE/bisync.argv"; exit 0 ;;
    *) exit 0 ;;
esac'
}

sync_env 1; fake_rclone_ok
assert_ok 'resyncs into an empty local dir' gatherd-icloud-sync --init-if-empty
assert_ok 'used --resync on first run' grep -q -- --resync "$WORK/h1/state/bisync.argv"

sync_env 2; fake_rclone_ok
echo note > "$WORK/h2/root/FSNotes/a.md"
rm -f "$NOTIFY_LOG"
assert_fail 'refuses to resync a populated local dir' gatherd-icloud-sync --init-if-empty
assert_fail 'ran no bisync when refusing' test -f "$WORK/h2/state/bisync.argv"
# rclone bisync refuses to preview without a baseline unless told --resync;
# the remedy must be a command the human can actually paste and run, using
# the same workdir/filters this script uses — not rclone's untouched defaults.
assert_ok 'refusal remedy is pasteable: --resync and --dry-run together' \
    grep -qE -- '--resync.*--dry-run' "$NOTIFY_LOG"
assert_ok 'refusal remedy pins the workdir this script uses' \
    grep -q -- "--workdir $WORK/h2/state/bisync/FSNotes" "$NOTIFY_LOG"
assert_ok 'refusal remedy pins the filters this script uses' \
    grep -q -- "--filters-file $WORK/h2/filters/FSNotes.filter" "$NOTIFY_LOG"

sync_env 3; fake_rclone_ok
echo note > "$WORK/h3/root/FSNotes/a.md"
assert_ok 'explicit --init resyncs a populated dir' gatherd-icloud-sync --init
assert_ok 'explicit --init used --resync' grep -q -- --resync "$WORK/h3/state/bisync.argv"

sync_env 4; fake_rclone_ok
mkdir -p "$WORK/h4/state/bisync/FSNotes"
: > "$WORK/h4/state/bisync/FSNotes/icloud_FSNotes..path1.lst"
assert_ok 'syncs when a baseline exists' gatherd-icloud-sync
assert_ok 'a bisync actually ran' test -f "$WORK/h4/state/bisync.argv"
assert_fail 'did not resync over an existing baseline' \
    grep -q -- --resync "$WORK/h4/state/bisync.argv"
# The migration's whole point is behaviour identical to the fsnotes-sync it
# replaces; pin every flag that encodes that behaviour, not just --resync.
# Value-bearing flags are pinned to their actual path/number, not just their
# name — --workdir especially, since has_baseline's directory test depends on
# it and a silent regression there makes every run look baseline-less.
# Numeric flags are anchored ( |$) so e.g. --max-delete 10 can't be satisfied
# by an argv that actually carries --max-delete 100.
assert_ok 'argv carries --workdir with the right path' \
    grep -q -- "--workdir $WORK/h4/state/bisync/FSNotes" "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --filters-file with the right path' \
    grep -q -- "--filters-file $WORK/h4/filters/FSNotes.filter" "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --conflict-resolve newer' grep -q -- '--conflict-resolve newer' "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --conflict-loser pathname' grep -q -- '--conflict-loser pathname' "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --max-delete 10' grep -qE -- '--max-delete 10( |$)' "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --resilient' grep -q -- '--resilient' "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --recover' grep -q -- '--recover' "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --transfers 2' grep -qE -- '--transfers 2( |$)' "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --checkers 4' grep -qE -- '--checkers 4( |$)' "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --tpslimit 4' grep -qE -- '--tpslimit 4( |$)' "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --backup-dir1 with the right path' \
    grep -q -- "--backup-dir1 $WORK/h4/backup/FSNotes" "$WORK/h4/state/bisync.argv"
assert_ok 'argv carries --log-file with the right path' \
    grep -q -- "--log-file $WORK/h4/state/rclone-icloud-FSNotes.log" "$WORK/h4/state/bisync.argv"

sync_env 5; fake_rclone_ok
assert_ok 'first --if-due run proceeds' gatherd-icloud-sync --init-if-empty --if-due
assert_ok 'wrote the stamp' test -f "$WORK/h5/state/icloud-sync.stamp"
cp "$WORK/h5/state/bisync.argv" "$WORK/h5/state/argv.before"
assert_ok 'second --if-due run is suppressed' gatherd-icloud-sync --if-due
assert_ok 'suppressed run did no work' cmp -s "$WORK/h5/state/argv.before" "$WORK/h5/state/bisync.argv"

sync_env 6
fake_bin rclone 'echo "Failed to load config file: password command failed" >&2; exit 1'
assert_ok 'a locked 1Password is not-ready, not failure' gatherd-icloud-sync --init-if-empty
assert_fail 'not-ready set no reauth flag' test -f "$WORK/h6/state/icloud-needs-reauth"

sync_env 7
fake_bin rclone 'case "$1" in
    lsd) echo "couldn'"'"'t list directory: 401 Unauthorized" >&2; exit 1 ;;
    *) exit 1 ;;
esac'
assert_fail 'an auth error is a real failure' gatherd-icloud-sync --init-if-empty
assert_ok 'auth error set the reauth flag' test -f "$WORK/h7/state/icloud-needs-reauth"

sync_env 8; fake_rclone_ok
: > "$WORK/h8/state/icloud-needs-reauth"
assert_ok 'a good run clears the reauth flag' gatherd-icloud-sync --init-if-empty
assert_fail 'reauth flag is gone' test -f "$WORK/h8/state/icloud-needs-reauth"

# A corrupt/truncated/missing rclone.conf also says "Failed to load config
# file", but unlike a locked 1Password it never recovers on its own — it must
# take the loud path (reauth flag, notification, non-zero exit), not the
# silent not-ready one.
sync_env 9
fake_bin rclone 'echo "Failed to load config file: yaml: line 4: did not find expected key" >&2; exit 1'
rm -f "$NOTIFY_LOG"
assert_fail 'a corrupt config file is a real failure, not not-ready' gatherd-icloud-sync --init-if-empty
assert_ok 'corrupt config set the reauth flag' test -f "$WORK/h9/state/icloud-needs-reauth"
# rclone's own error text is identical whether the config is locked (transient)
# or corrupt (permanent); the notification text is the only thing that tells a
# human which one they're looking at, so it must not just say "re-authenticate".
assert_ok 'notification names a broken config, not just reauth' \
    grep -qiE 'corrupt|broken|missing' "$NOTIFY_LOG"

sync_env 10; fake_rclone_ok
assert_fail 'plain sync mode refuses when there is no baseline' gatherd-icloud-sync
assert_fail 'ran no bisync when refusing for lack of baseline' test -f "$WORK/h10/state/bisync.argv"

sync_env 11; fake_rclone_ok
: > "$WORK/h11/root/FSNotes/.DS_Store"
assert_fail '--init-if-empty treats a dotfiles-only dir as populated' gatherd-icloud-sync --init-if-empty
assert_fail 'ran no bisync when refusing for dotfiles-only dir' test -f "$WORK/h11/state/bisync.argv"

# Every folder locked (nothing skipped is a failure, but nothing ran either)
# must still leave the stamp alone — otherwise a stuck lock becomes a
# permanent, self-renewing "nothing to do".
sync_env 12; fake_rclone_ok
mkdir -p "$WORK/h12/state/bisync/FSNotes" "$WORK/h12/state/locks"
: > "$WORK/h12/state/bisync/FSNotes/icloud_FSNotes..path1.lst"
(
    exec 9>"$WORK/h12/state/locks/FSNotes.lock"
    flock 9
    : > "$WORK/h12/state/lock.held"
    # Block on a marker the test controls rather than a fixed sleep: a fixed
    # window has to outlast however long the assertion below takes to start
    # and run, which is a guess this repo's QEMU-based test runner can blow.
    while [ ! -f "$WORK/h12/state/lock.release" ]; do sleep 0.05; done
) &
_holder_pid=$!
_waited=0
while [ ! -f "$WORK/h12/state/lock.held" ] && [ "$_waited" -lt 50 ]; do
    sleep 0.02
    _waited=$((_waited + 1))
done
assert_ok 'a run where every folder is locked still exits 0' gatherd-icloud-sync
assert_fail 'no bisync ran while every folder was locked' test -f "$WORK/h12/state/bisync.argv"
assert_fail 'stamp is not written when nothing synced' test -f "$WORK/h12/state/icloud-sync.stamp"
: > "$WORK/h12/state/lock.release"
wait "$_holder_pid"

# flock's exit 1 means "already locked" (skip, not a failure); any other
# non-zero exit is a real problem (missing binary, bad fd) and must propagate.
sync_env 13; fake_rclone_ok
mkdir -p "$WORK/h13/state/bisync/FSNotes"
: > "$WORK/h13/state/bisync/FSNotes/icloud_FSNotes..path1.lst"
fake_bin flock 'exit 2'
assert_fail 'a flock failure other than "already locked" is a real failure' gatherd-icloud-sync
rm -f "$FAKEBIN/flock"

# Concurrent bisync on one pair is how a baseline corrupts, so this guard is
# data-integrity-critical: prove a second trigger yields instead of racing.
sync_env 14
# Block on a marker the test controls rather than a fixed sleep — see the
# same reasoning above test 12.
fake_bin rclone 'case "$1" in
    lsd) exit 0 ;;
    bisync)
        : > "$GATHERD_ICLOUD_STATE/bisync.started"
        while [ ! -f "$GATHERD_ICLOUD_STATE/bisync.release" ]; do sleep 0.05; done
        printf "%s\n" "$*" >> "$GATHERD_ICLOUD_STATE/bisync.argv"
        exit 0 ;;
    *) exit 0 ;;
esac'
mkdir -p "$WORK/h14/state/bisync/FSNotes"
: > "$WORK/h14/state/bisync/FSNotes/icloud_FSNotes..path1.lst"

gatherd-icloud-sync &
_bg_pid=$!
_waited=0
while [ ! -f "$WORK/h14/state/bisync.started" ] && [ "$_waited" -lt 50 ]; do
    sleep 0.02
    _waited=$((_waited + 1))
done
assert_ok 'a second run yields to an in-progress bisync' gatherd-icloud-sync
: > "$WORK/h14/state/bisync.release"
wait "$_bg_pid"
assert_out 'only one bisync ran for a concurrent pair' 1 \
    sh -c 'wc -l < "$1" | tr -d " "' _ "$WORK/h14/state/bisync.argv"

# say()'s notify-send path is what a triggered (non-interactive) run actually
# shows a human; prove it fires once per genuine failure and honours the rate
# limit, using the notify-send fake installed at the top of this file instead
# of the real desktop notifier.
sync_env 15
fake_bin rclone 'case "$1" in
    lsd) echo "couldn'"'"'t list directory: 401 Unauthorized" >&2; exit 1 ;;
    *) exit 1 ;;
esac'
rm -f "$NOTIFY_LOG"

gatherd-icloud-sync --init-if-empty >/dev/null 2>&1 || true
assert_out 'a genuine failure sends exactly one notification' 1 \
    sh -c 'wc -l < "$1" | tr -d " "' _ "$NOTIFY_LOG"
assert_ok 'the notification names the failure' grep -q 'cannot reach iCloud' "$NOTIFY_LOG"

gatherd-icloud-sync --init-if-empty >/dev/null 2>&1 || true
assert_out 'a second failure inside the interval does not notify again' 1 \
    sh -c 'wc -l < "$1" | tr -d " "' _ "$NOTIFY_LOG"

# Backdate the stamp instead of sleeping through NOTIFY_INTERVAL (3600s): this
# proves the rate limit reads elapsed time from the stamp file, not a clock
# the test would otherwise have to wait out.
echo $(( $(date +%s) - 3700 )) > "$WORK/h15/state/icloud-notified.stamp"
gatherd-icloud-sync --init-if-empty >/dev/null 2>&1 || true
assert_out 'a failure after the interval notifies again' 2 \
    sh -c 'wc -l < "$1" | tr -d " "' _ "$NOTIFY_LOG"

unset GATHERD_ICLOUD_CONF GATHERD_ICLOUD_STATE GATHERD_ICLOUD_FILTERS \
      GATHERD_ICLOUD_BACKUPS GATHERD_ICLOUD_MIN_INTERVAL

# ── summary ───────────────────────────────────────────────────────────────────

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
