# ── signal handling ──────────────────────────────────────────────────────────
# A trap shared between EXIT and a caught signal only *returns* on the
# signal — it doesn't end the script — so the run resumes after `rm -rf
# "$TMP"` with its scratch directory gone. Reproduce that by delivering
# SIGTERM while the script is genuinely blocked inside a foreground `op`
# call, and check the whole run stops right there (exit 130) instead of
# limping on to whatever unrelated thing breaks next.

cfg_env 25; fake_rclone_reachable
export SIGDIR="$C/sigtest"
mkdir -p "$SIGDIR"
# This op fake only handles "document get": it records the pid it was called
# with (its parent is the gatherd-icloud-config process itself, since
# doc_get() runs `op` directly with no intervening subshell) and then blocks,
# bounded the same way and for the same reason as the lock tests above — an
# unbounded wait would hang forever instead of failing if the signal handling
# regresses and nothing ever unblocks it.
fake_bin op 'case "$1 $2" in
"document get")
    echo "$PPID" > "$SIGDIR/target.pid"
    _w=0
    while [ ! -f "$SIGDIR/proceed" ] && [ "$_w" -lt 200 ]; do
        sleep 0.05
        _w=$((_w + 1))
    done
    echo "not found" >&2
    exit 1 ;;
*) exit 0 ;;
esac'

gatherd-icloud-config status >"$SIGDIR/out" 2>"$SIGDIR/err" &
_sigterm_pid=$!
_waited=0
while [ ! -f "$SIGDIR/target.pid" ] && [ "$_waited" -lt 100 ]; do
    sleep 0.02
    _waited=$((_waited + 1))
done
kill -TERM "$(cat "$SIGDIR/target.pid")" 2>/dev/null || true
: > "$SIGDIR/proceed"
if wait "$_sigterm_pid"; then _sigterm_status=0; else _sigterm_status=$?; fi
if [ "$_sigterm_status" -eq 130 ]; then
    ok 'a SIGTERM mid-run exits 130 via the dedicated handler'
else
    bad "a SIGTERM mid-run exits 130 via the dedicated handler (got $_sigterm_status)"
fi
unset SIGDIR

unset GATHERD_ICLOUD_STATE RCLONE_CONFIG FAKE_OP_DIR XDG_RUNTIME_DIR \
      GATHERD_ICLOUD_CONF GATHERD_ICLOUD_REMOTE RCLONE_PASSWORD_COMMAND RCLONE_CALL_LOG

# ── summary ───────────────────────────────────────────────────────────────────

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
