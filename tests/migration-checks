#!/bin/sh
# Unit tests for gatherd-migration-checks.
#
# The verdict mapping is the part that must not be wrong: a broken check exits
# nonzero exactly like a genuine "absent" does, and "absent" is the answer that
# would license deleting a task. test(1) and grep(1) both use 1 for a false
# result and >=2 for a real error, so that boundary is what these pin.
#
# Usage: tests/migration-checks

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
CHECKS="$REPO/scripts/gatherd-migration-checks"
PASS=0
FAIL=0

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

assert_out() {
    _d=$1; _want=$2; shift 2
    _got=$("$@" 2>&1 || true)
    if [ "$_got" = "$_want" ]; then ok "$_d"; else bad "$_d (want [$_want] got [$_got])"; fi
}

cat > "$WORK/MIGRATIONS.md" <<'LEDGER'
# Migrations

## Unmeasured

- roles/a/tasks/main.yml:1 — With a check
  shape: state: absent
  check: test -e /tmp/thing
  fresh-install expectation: absent (pure migration)
- roles/a/tasks/main.yml:9 — Without a check
  shape: state: absent
LEDGER

# list: only entries that actually carry a check are runnable.
assert_out "list emits just the entries with checks" \
"roles/a/tasks/main.yml — With a check	test -e /tmp/thing" \
    "$CHECKS" list "$WORK"

# verdict: the boundary that keeps a broken check from reading as "absent".
# A multi-word field name must not truncate the entry: an earlier regex could
# not match "fresh-install expectation" and silently stopped parsing there.
assert_out "multi-word field names parse" \
"roles/a/tasks/main.yml — With a check	test -e /tmp/thing" \
    "$CHECKS" list "$WORK"

assert_out "rc 0 is present"           "present" "$CHECKS" verdict 0 ""
assert_out "rc 1 is absent"            "absent"  "$CHECKS" verdict 1 ""
assert_out "rc 2 is an error"          "error"   "$CHECKS" verdict 2 ""
assert_out "rc 127 is an error"        "error"   "$CHECKS" verdict 127 ""
assert_out "stderr makes even rc 1 an error" \
    "error" "$CHECKS" verdict 1 "grep: bad regex"
assert_out "stderr makes even rc 0 an error" \
    "error" "$CHECKS" verdict 0 "warning: something"

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
