#!/bin/sh
# Unit tests for the sheet-music picker (gatherd-music-index, gatherd-music-stand).
#
# The fold detection, rotation, input suppression and escape menu they sit on
# top of moved to their own repo (chuwi-minibook-tablet-mode) and are tested
# there. This suite fakes minibook-tablet-mode itself, rather than exercising
# the real mechanism: only its `status` and `fullscreen-viewer` verbs, and the
# config file's music-stand keys, are gatherd's concern here.
#
# Usage: tests/music-stand

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
PASS=0
FAIL=0

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
FAKEBIN="$WORK/bin"
mkdir -p "$FAKEBIN"
PATH="$FAKEBIN:$REPO/scripts:$PATH"
export PATH

XDG_RUNTIME_DIR="$WORK/run"
XDG_CONFIG_HOME="$WORK/config"
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME" "$XDG_CONFIG_HOME/minibook-tablet-mode"
export XDG_RUNTIME_DIR XDG_CONFIG_HOME

ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

assert_out() {
    _d=$1; _want=$2; shift 2
    _got=$("$@" 2>/dev/null || true)
    if [ "$_got" = "$_want" ]; then ok "$_d"; else bad "$_d (want [$_want] got [$_got])"; fi
}
assert_ok()   { _d=$1; shift; if "$@" >/dev/null 2>&1; then ok "$_d"; else bad "$_d (expected success)"; fi; }
assert_fail() { _d=$1; shift; if "$@" >/dev/null 2>&1; then bad "$_d (expected failure)"; else ok "$_d"; fi; }

# A test double, not the real mechanism: minibook-tablet-mode lives upstream
# now and has its own suite there. gatherd-music-stand only ever calls two of
# its verbs - `status` (is a score being picked while already folded?) and
# `fullscreen-viewer` (fill the screen with whatever just opened) - so that is
# all this fakes. State lives where the real command keeps it
# ($XDG_RUNTIME_DIR/minibook-tablet-mode/tablet-mode), which costs nothing and
# means a test can drive `on`/`off` exactly like the real command's callers do.
cat > "$FAKEBIN/minibook-tablet-mode" <<EOF
#!/bin/sh
WORK='$WORK'
state="\${XDG_RUNTIME_DIR:-/tmp}/minibook-tablet-mode/tablet-mode"
config="\${XDG_CONFIG_HOME:-\$HOME/.config}/minibook-tablet-mode/config"
case "\${1:-}" in
  on)
    mkdir -p "\$(dirname "\$state")"
    : > "\$state" ;;
  off)
    rm -f "\$state" ;;
  status)
    [ -f "\$state" ] ;;
  # The one side effect gatherd-music-stand's tests actually check: when
  # folded, fullscreen whatever viewer_app_id names, logged the same way the
  # real mechanism's own suite asserts it (see minibook-compositor
  # set-fullscreen upstream) so log_has works unchanged here.
  fullscreen-viewer)
    [ -f "\$state" ] || exit 0
    _app_id=\$(sed -n 's/^viewer_app_id=//p' "\$config" 2>/dev/null | tail -1)
    [ -n "\$_app_id" ] && printf '[app_id="%s"] fullscreen enable\n' "\$_app_id" >> "\$WORK/swaymsg.log"
    exit 0 ;;
  *)
    exit 0 ;;
esac
EOF
chmod +x "$FAKEBIN/minibook-tablet-mode"

log_has() { grep -qF "$1" "$WORK/swaymsg.log" 2>/dev/null; }
reset_log() { : > "$WORK/swaymsg.log"; }
# ── gatherd-music-index ────────────────────────────────────────────────────

SCORES="$WORK/scores"
mkdir -p "$SCORES"
touch "$SCORES/2 Skazki, Op. 48.pdf" "$SCORES/12 Etudes, Op. 39.pdf" "$SCORES/Untitled.pdf"
# Non-PDF residue forScore leaves in its sync folder; must never be indexed.
touch "$SCORES/syncFolderState" "$SCORES/syncFolderLog"

# Build a synthetic backup in forScore's real container format: an ASCII header,
# then gzip, then a binary plist keyed "<filename>|<field>".
python3 - "$SCORES/Automatic Backup.4sb" <<'PY'
import gzip, plistlib, sys
payload = plistlib.dumps({
    "2 Skazki, Op. 48.pdf|composer": "Medtner",
    "2 Skazki, Op. 48.pdf|title": "Two Skazki",
    "12 Etudes, Op. 39.pdf|composer": "Alkan",
    "12 Etudes, Op. 39.pdf|title": "Twelve Etudes",
    "&SYS;lastLeftMenu": 0,
}, fmt=plistlib.FMT_BINARY)
with open(sys.argv[1], "wb") as f:
    f.write(b"<--4SBV02-->" + b" " * 68)
    f.write(gzip.compress(payload))
PY

MUSIC_STAND_ROOT="$SCORES"
XDG_STATE_HOME="$WORK/state"
export MUSIC_STAND_ROOT XDG_STATE_HOME

assert_out 'index maps composer, title and filename' \
    'Alkan	Twelve Etudes	12 Etudes, Op. 39.pdf
Medtner	Two Skazki	2 Skazki, Op. 48.pdf
Unknown	Untitled	Untitled.pdf' \
    gatherd-music-index --print

assert_ok 'index writes the TSV' gatherd-music-index
assert_ok 'index TSV exists' test -f "$XDG_STATE_HOME/gatherd/music-index.tsv"
assert_out 'index covers every PDF and nothing else' '3' \
    sh -c 'wc -l < "$XDG_STATE_HOME/gatherd/music-index.tsv" | tr -d " "'

# Graceful degradation: a missing or corrupt backup must still list the scores.
mv "$SCORES/Automatic Backup.4sb" "$WORK/backup.bak"
assert_out 'a missing backup still lists every score as Unknown' \
    'Unknown	12 Etudes, Op. 39	12 Etudes, Op. 39.pdf
Unknown	2 Skazki, Op. 48	2 Skazki, Op. 48.pdf
Unknown	Untitled	Untitled.pdf' \
    gatherd-music-index --print
printf 'not a backup' > "$SCORES/Automatic Backup.4sb"
assert_ok 'a corrupt backup does not crash' gatherd-music-index --print
mv "$WORK/backup.bak" "$SCORES/Automatic Backup.4sb"

# Malformed filenames get their own directory, separate from $SCORES, so they
# don't perturb the row-count assertions above.
OLD_MUSIC_STAND_ROOT="$MUSIC_STAND_ROOT"

BADTAB="$WORK/badtab"
mkdir -p "$BADTAB"
python3 - "$BADTAB" <<'PY'
import os, sys
d = sys.argv[1]
open(os.path.join(d, "Aardvark.pdf"), "w").close()
open(os.path.join(d, "Bad\tName.pdf"), "w").close()
open(os.path.join(d, "Zebra.pdf"), "w").close()
PY

MUSIC_STAND_ROOT="$BADTAB"
export MUSIC_STAND_ROOT

if TABOUT=$(gatherd-music-index --print 2>"$WORK/badtab.err"); then
    ok 'a tab in a filename does not fail the run'
else
    bad 'a tab in a filename does not fail the run'
fi

if printf '%s\n' "$TABOUT" | grep -qF 'Bad'; then
    bad 'a filename containing a tab is skipped, not sanitized into the output'
else
    ok 'a filename containing a tab is skipped, not sanitized into the output'
fi

assert_out 'the other scores still come through intact with 3 columns' \
    'Unknown	Aardvark	Aardvark.pdf
Unknown	Zebra	Zebra.pdf' \
    gatherd-music-index --print

if [ -s "$WORK/badtab.err" ]; then
    ok 'skipping the tab-named file warns on stderr'
else
    bad 'skipping the tab-named file warns on stderr'
fi

BADUTF8="$WORK/badutf8"
mkdir -p "$BADUTF8"
python3 - "$BADUTF8" <<'PY'
import os, sys
d = sys.argv[1]
open(os.path.join(d, "Clean.pdf"), "w").close()
open(os.path.join(d.encode(), b"bad\xffName.pdf"), "w").close()
PY

MUSIC_STAND_ROOT="$BADUTF8"
export MUSIC_STAND_ROOT

if gatherd-music-index --print >"$WORK/badutf8.out" 2>"$WORK/badutf8.err"; then
    ok 'a non-UTF-8 filename does not crash the script'
else
    bad 'a non-UTF-8 filename does not crash the script'
fi

if python3 - "$BADUTF8" "$WORK/badutf8.out" <<'PY'
import os, sys
d, outpath = sys.argv[1], sys.argv[2]
with open(outpath, "rb") as f:
    lines = [l for l in f.read().split(b"\n") if l]
names = sorted(l.split(b"\t")[-1] for l in lines)
expected = sorted(os.listdir(d.encode()))
sys.exit(0 if (names == expected and len(lines) == 2) else 1)
PY
then
    ok 'the non-UTF-8 filename round-trips byte-exact and both scores appear'
else
    bad 'the non-UTF-8 filename round-trips byte-exact and both scores appear'
fi

MUSIC_STAND_ROOT="$OLD_MUSIC_STAND_ROOT"
export MUSIC_STAND_ROOT

# ── gatherd-music-stand ───────────────────────────────────────────────────────

MUSIC_STAND_VIEWER=fakeviewer
VIEWER_CHILD="$WORK/viewer-child.pid"
export MUSIC_STAND_VIEWER VIEWER_CHILD
# Reads $VIEWER_LOG rather than a fixed path, because a real viewer is
# launched with `&` and reparented — reset_picker below cannot wait() on the
# previous pick's process before starting the next one. A backgrounded
# process from pick N writing after reset_picker N+1 truncates a shared log
# is exactly the flake this avoided: giving every pick its own log file means
# a late writer from an earlier pick can never land in the current one.
# Lingers rather than exiting immediately: "Exit music stand" now stops the
# viewer it started, and a fake that exited at once would leave nothing to
# stop, so every assertion about stopping it would pass vacuously.
#
# The sleep is far LONGER than the ~2s the stop assertions poll for, and that
# margin is the point: it has to be impossible for a viewer to exit on its own
# inside the window where the test is asking "did stop_viewer kill it?". A
# short sleep would turn a genuine failure to kill into a pass. Widen this,
# never the poll budget.
#
# NOT `exec sleep` - that would replace this shell and with it the cmdline
# that gatherd-music-stand re-checks before signalling anything.
cat > "$FAKEBIN/fakeviewer" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >> "${VIEWER_LOG:-/dev/null}"
# Shaped like koreader.sh: the actual viewer is a CHILD of this wrapper, which
# never execs it. Killing only the recorded pid would leave that child running
# with the score still on screen and nothing tracking it - the exact bug the
# process-group kill exists to prevent, and invisible to a fake that is a
# single process.
sleep 60 &
echo $! > "${VIEWER_CHILD:-/dev/null}"
wait
EOF
chmod +x "$FAKEBIN/fakeviewer"

# fuzzel replays one canned answer per invocation, so a two-level picker can be
# driven end to end.
cat > "$FAKEBIN/fuzzel" <<EOF
#!/bin/sh
WORK='$WORK'
printf '%s\n' "\$*" >> "\$WORK/fuzzel.args.log"
cat >> "\$WORK/fuzzel.in"
printf -- '---\n' >> "\$WORK/fuzzel.in"
_n=\$(cat "\$WORK/fuzzel.turn" 2>/dev/null || echo 1)
printf '%s' \$((_n + 1)) > "\$WORK/fuzzel.turn"
sed -n "\${_n}p" "\$WORK/fuzzel.answers"
# \$WORK/fuzzel-fail simulates fuzzel exiting non-zero: cancelled with
# Escape, or refusing to start because another instance holds its lock.
[ -f "\$WORK/fuzzel-fail" ] && exit 1
exit 0
EOF
chmod +x "$FAKEBIN/fuzzel"

reset_picker() {
    : > "$WORK/fuzzel.in"
    : > "$WORK/fuzzel.args.log"
    _n=$(cat "$WORK/viewer.count" 2>/dev/null || echo 0)
    _n=$((_n + 1))
    printf '%s' "$_n" > "$WORK/viewer.count"
    VIEWER_LOG="$WORK/viewer-$_n.log"
    : > "$VIEWER_LOG"
    export VIEWER_LOG
    printf '1' > "$WORK/fuzzel.turn"
    printf '%s\n' "$@" > "$WORK/fuzzel.answers"
}

# The viewer is deliberately launched with `&` (a real fullscreen viewer never
# exits, so the picker cannot wait on it) — so a fake viewer's write to the log
# races the next line of this test. Poll instead of reading straight through.
# Safe to poll for absence too, now that each pick gets its own log file
# (reset_picker above): there is no earlier writer that could ever land here.
viewer_log() {
    _i=0
    while [ ! -s "$VIEWER_LOG" ] && [ "$_i" -lt 100 ]; do
        _i=$((_i + 1))
        sleep 0.02
    done
    cat "$VIEWER_LOG" 2>/dev/null
}

rm -f "$XDG_STATE_HOME/gatherd/music-stand-scores"
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds' gatherd-music-stand on
assert_out 'the viewer opened the chosen score' "$SCORES/2 Skazki, Op. 48.pdf" \
    viewer_log
# Opening a score does NOT enter tablet mode, and must not: folding is what
# makes tablet mode, and unfolding ends it. A music stand that turned it on
# from a keyboard would be asserting the opposite of what the hinge says, and
# the hinge daemon corrects that within a poll - which is exactly what
# happened in real use, leaving a score half-launched and the screen flicking
# back to landscape.
assert_fail 'opening a score does not enter tablet mode' minibook-tablet-mode status

# ...but opening one while ALREADY folded must fullscreen it. Asserted here on
# gatherd-music-stand rather than only on the verb it calls: deleting the call
# passed every test until this one existed.
_saved_conf=$(cat "$XDG_CONFIG_HOME/minibook-tablet-mode/config" 2>/dev/null || true)
printf 'viewer_app_id=luajit\n' > "$XDG_CONFIG_HOME/minibook-tablet-mode/config"
minibook-tablet-mode on >/dev/null 2>&1
reset_log
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds while already folded' gatherd-music-stand on
if log_has '[app_id="luajit"] fullscreen enable'; then
    ok 'a score opened while already folded is asked to fill the screen'
else
    bad 'a score opened while already folded is asked to fill the screen'
fi
gatherd-music-stand close >/dev/null 2>&1 || true
minibook-tablet-mode off >/dev/null 2>&1 || true
printf '%s' "$_saved_conf" > "$XDG_CONFIG_HOME/minibook-tablet-mode/config"
assert_out 'the pick was recorded in the MRU' \
    'Medtner	Two Skazki	2 Skazki, Op. 48.pdf' \
    cat "$XDG_STATE_HOME/gatherd/music-stand-scores"

# Level 1 offers composers, not scores; level 2 offers that composer's scores.
if grep -q '^Alkan$' "$WORK/fuzzel.in" && grep -q '^Medtner$' "$WORK/fuzzel.in"; then
    ok 'level 1 lists composers'
else
    bad 'level 1 lists composers'
fi
if grep -q '^Two Skazki$' "$WORK/fuzzel.in"; then
    ok 'level 2 lists that composer titles'
else
    bad 'level 2 lists that composer titles'
fi
if grep -q 'Twelve Etudes' "$WORK/fuzzel.in"; then
    bad 'level 2 excludes other composers'
else
    ok 'level 2 excludes other composers'
fi

assert_ok 'music-stand off succeeds' gatherd-music-stand off
assert_fail 'music-stand off left tablet mode off' minibook-tablet-mode status

# MRU ordering: the most recently played composer must lead level 1.
reset_picker 'Alkan' 'Twelve Etudes'
assert_ok 'second pick succeeds' gatherd-music-stand on
gatherd-music-stand off >/dev/null 2>&1 || true

# Re-pick Medtner (already in the MRU from the very first pick) so it becomes
# most recent again. Alkan is alphabetically first among the fixture's
# composers, so asserting that Alkan leads level 1 would pass identically
# whether MRU ordering works or is missing entirely — plain alphabetical
# order would produce the same result. Ending on Medtner forces the
# assertions below to actually depend on recency, not on the alphabet.
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'third pick succeeds' gatherd-music-stand on
gatherd-music-stand off >/dev/null 2>&1 || true
assert_out 'most recent composer leads the MRU' 'Medtner' \
    sh -c 'head -1 "$XDG_STATE_HOME/gatherd/music-stand-scores" | cut -f1'

# The list level 1 SHOWS during a pick is necessarily generated before that
# pick's own result lands in the MRU, so it cannot itself prove MRU ordering.
# Cancel a fresh probe pick to capture the list the *next* invocation would see.
reset_picker ''
gatherd-music-stand on >/dev/null 2>&1 || true
assert_out 'level 1 offers the most recent composer first' 'Medtner' \
    sh -c 'head -1 "'"$WORK"'/fuzzel.in"'
# Three picks were made (Medtner, Alkan, Medtner again), but the repeat of
# Medtner/Two Skazki is byte-identical to the first pick's MRU row, so it
# dedupes rather than adding a third entry.
assert_out 'the MRU holds both distinct picks without duplicates' '2' \
    sh -c 'wc -l < "$XDG_STATE_HOME/gatherd/music-stand-scores" | tr -d " "'

# ── Exit music stand stops the viewer it started ─────────────────────────────
# Reported from the piano: "Exit music stand" looked like it did nothing,
# because the fullscreen PDF stayed exactly where it was. Stopping it is the
# visible half of the entry doing anything at all.

reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on for the viewer-stop case' gatherd-music-stand on
assert_out 'the viewer opened before being stopped' "$SCORES/2 Skazki, Op. 48.pdf" \
    viewer_log
assert_ok 'on records the pid of the viewer it started' \
    test -f "$XDG_STATE_HOME/gatherd/music-stand-viewer-pid"
_viewer_pid=$(cat "$XDG_STATE_HOME/gatherd/music-stand-viewer-pid")
assert_ok 'the recorded viewer is actually running' kill -0 "$_viewer_pid"

assert_ok 'music-stand off succeeds' gatherd-music-stand off
_i=0
while kill -0 "$_viewer_pid" 2>/dev/null && [ "$_i" -lt 100 ]; do
    _i=$((_i + 1))
    sleep 0.02
done
if kill -0 "$_viewer_pid" 2>/dev/null; then
    bad 'off stops the viewer it started'
else
    ok 'off stops the viewer it started'
fi
assert_fail 'off clears the recorded viewer pid' \
    test -f "$XDG_STATE_HOME/gatherd/music-stand-viewer-pid"
# The wrapper dying is not enough: koreader's wrapper does not exec, so the
# process actually showing the score is a child. If it survives, the human is
# still looking at the score they asked to close.
_viewer_child=$(cat "$VIEWER_CHILD" 2>/dev/null || echo 0)
_i=0
while kill -0 "$_viewer_child" 2>/dev/null && [ "$_i" -lt 100 ]; do
    _i=$((_i + 1)); sleep 0.02
done
if [ "$_viewer_child" != 0 ] && ! kill -0 "$_viewer_child" 2>/dev/null; then
    ok 'off stops the viewer CHILD as well, not just the wrapper'
else
    bad "off stops the viewer CHILD as well, not just the wrapper (pid $_viewer_child)"
fi

# A stale file pointing at a pid that no longer exists at all. The earlier
# version of this suite only ever tested a stale pid belonging to a LIVE
# process, so /proc/<pid>/cmdline always existed - and the shell diagnostic
# from a failed redirection went unnoticed until it printed over a human
# opening a score.
mkdir -p "$XDG_STATE_HOME/gatherd"
printf '%s\n' 999999 > "$XDG_STATE_HOME/gatherd/music-stand-viewer-pid"
: > "$WORK/deadpid.err"
if gatherd-music-stand close 2>"$WORK/deadpid.err"; then
    ok 'music-stand close survives a pid that no longer exists'
else
    bad 'music-stand close survives a pid that no longer exists'
fi
assert_out 'a vanished pid produces no output at all' '' cat "$WORK/deadpid.err"
assert_fail 'the stale pid file is cleared' \
    test -f "$XDG_STATE_HOME/gatherd/music-stand-viewer-pid"

# A pid is a recycled number, not an identity. Nothing may be signalled
# without re-checking that the pid is still the viewer this script launched -
# a broad match has taken out unrelated processes on this machine before.
sleep 30 &
_bystander=$!
mkdir -p "$XDG_STATE_HOME/gatherd"
printf '%s\n' "$_bystander" > "$XDG_STATE_HOME/gatherd/music-stand-viewer-pid"
assert_ok 'music-stand off survives a stale pid file' gatherd-music-stand off
if kill -0 "$_bystander" 2>/dev/null; then
    ok 'a recycled pid that is not the viewer is left alone'
else
    bad 'a recycled pid that is not the viewer is left alone'
fi
kill "$_bystander" 2>/dev/null || true

# Picking another score replaces the viewer rather than stacking one behind
# the fullscreen one - and an unreplaced viewer would also be untrackable,
# since only the newest pid can be recorded.
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on for the replace case' gatherd-music-stand on
assert_out 'the first score opened' "$SCORES/2 Skazki, Op. 48.pdf" viewer_log
_first_pid=$(cat "$XDG_STATE_HOME/gatherd/music-stand-viewer-pid")
reset_picker 'Alkan' 'Twelve Etudes'
assert_ok 'picking another score succeeds' gatherd-music-stand on
assert_out 'the second score opened' "$SCORES/12 Etudes, Op. 39.pdf" viewer_log
_second_pid=$(cat "$XDG_STATE_HOME/gatherd/music-stand-viewer-pid")
if [ "$_first_pid" = "$_second_pid" ]; then
    bad 'picking another score records the new viewer, not the old one'
else
    ok 'picking another score records the new viewer, not the old one'
fi
_i=0
while kill -0 "$_first_pid" 2>/dev/null && [ "$_i" -lt 100 ]; do
    _i=$((_i + 1))
    sleep 0.02
done
if kill -0 "$_first_pid" 2>/dev/null; then
    bad 'picking another score stops the previous viewer'
else
    ok 'picking another score stops the previous viewer'
fi
gatherd-music-stand off >/dev/null 2>&1 || true

# Cancelling must not rotate the screen or open anything. Read $VIEWER_LOG
# directly rather than via viewer_log()'s poll: cancelling exits before the
# script ever reaches the viewer-launch line, so there is no background
# writer racing this read the way there is after a completed pick.
reset_picker ''
assert_ok 'cancelling at level 1 exits cleanly' gatherd-music-stand on
assert_fail 'cancelling left tablet mode off' minibook-tablet-mode status
assert_out 'cancelling opened nothing' '' cat "$VIEWER_LOG"

# Back at level 2 returns to level 1 rather than opening a score.
reset_picker 'Medtner' '‹ Back' 'Alkan' 'Twelve Etudes'
assert_ok 'back at level 2 returns to level 1' gatherd-music-stand on
assert_out 'after going back, the second choice opened' "$SCORES/12 Etudes, Op. 39.pdf" \
    viewer_log
gatherd-music-stand off >/dev/null 2>&1 || true

# ── gatherd-music-stand: cancel escape ────────────────────────────────────────
# The composer list and the score list are the only controls reachable while
# folded, so each must offer a way out that performs no action at all — not
# even Back's "go up one level". Cancel funnels into pick()'s existing
# empty-return path (the same path Escape/no-keyboard cancellation already
# uses), so there is exactly one "do nothing" path, not two.

cancel='󰅖 Cancel'

_mru_before_cancel1=$(cat "$XDG_STATE_HOME/gatherd/music-stand-scores" 2>/dev/null || true)
reset_log
# Extra answers queued behind cancel: if cancel were ever treated as a real
# composer choice instead of funnelling to empty, the picker would consume
# these next and either open a score or blow up on a bogus composer/title
# pair — either way, not the clean no-op this asserts.
reset_picker "$cancel" 'Medtner' 'Two Skazki'
assert_ok 'cancel at level 1 exits cleanly' gatherd-music-stand on
assert_out 'cancel at level 1 opened nothing' '' cat "$VIEWER_LOG"
assert_fail 'cancel at level 1 left tablet mode off' minibook-tablet-mode status
assert_out 'cancel at level 1 touched no sway state' '' cat "$WORK/swaymsg.log"
assert_out 'cancel at level 1 did not update the MRU' "$_mru_before_cancel1" \
    cat "$XDG_STATE_HOME/gatherd/music-stand-scores"
if grep -qF "$cancel" "$WORK/fuzzel.in"; then
    ok 'level 1 offers a cancel entry'
else
    bad 'level 1 offers a cancel entry'
fi

_mru_before_cancel2=$(cat "$XDG_STATE_HOME/gatherd/music-stand-scores" 2>/dev/null || true)
reset_log
reset_picker 'Medtner' "$cancel"
assert_ok 'cancel at level 2 exits cleanly' gatherd-music-stand on
assert_out 'cancel at level 2 opened nothing' '' cat "$VIEWER_LOG"
assert_fail 'cancel at level 2 left tablet mode off' minibook-tablet-mode status
assert_out 'cancel at level 2 touched no sway state' '' cat "$WORK/swaymsg.log"
assert_out 'cancel at level 2 did not update the MRU' "$_mru_before_cancel2" \
    cat "$XDG_STATE_HOME/gatherd/music-stand-scores"
if grep -qF "$cancel" "$WORK/fuzzel.in"; then
    ok 'level 2 offers a cancel entry alongside back'
else
    bad 'level 2 offers a cancel entry alongside back'
fi
if grep -qF '‹ Back' "$WORK/fuzzel.in"; then
    ok 'level 2 still offers back alongside cancel'
else
    bad 'level 2 still offers back alongside cancel'
fi

# ── gatherd-music-stand: viewer preflight ────────────────────────────────────
# papers is REST-tier and is not installed until the async play reaches the
# network, after login. Between first login and async completion, a pick must
# not rotate the screen and disable the keyboard only to find no viewer to
# hand the score to — that is exactly what the file-exists check one line
# above it in the real script exists to prevent.

_mru_before_preflight=$(cat "$XDG_STATE_HOME/gatherd/music-stand-scores" 2>/dev/null || true)
OLD_MUSIC_STAND_VIEWER="$MUSIC_STAND_VIEWER"
MUSIC_STAND_VIEWER=no-such-viewer-anywhere
export MUSIC_STAND_VIEWER
reset_picker 'Medtner' 'Two Skazki'
if gatherd-music-stand on 2>"$WORK/no-viewer.err"; then
    bad 'a missing viewer does not report success'
else
    ok 'a missing viewer does not report success'
fi
assert_fail 'a missing viewer does not enter tablet mode' minibook-tablet-mode status
if [ -s "$WORK/no-viewer.err" ]; then
    ok 'a missing viewer warns on stderr'
else
    bad 'a missing viewer warns on stderr'
fi
assert_out 'a missing viewer does not update the MRU' "$_mru_before_preflight" \
    cat "$XDG_STATE_HOME/gatherd/music-stand-scores"
MUSIC_STAND_VIEWER="$OLD_MUSIC_STAND_VIEWER"
export MUSIC_STAND_VIEWER

# ── gatherd-music-stand: stale MRU rows ──────────────────────────────────────
# forScore's library syncs from the iPad, so scores genuinely get renamed and
# deleted; the MRU persists across index refreshes, so a stale row is a matter
# of time. Isolated root/state dirs keep this fixture from perturbing the
# row/line counts asserted above.

STALE_ROOT="$WORK/stale-scores"
STALE_STATE="$WORK/stale-state"
mkdir -p "$STALE_ROOT" "$STALE_STATE/gatherd"

printf 'Bach\tPresent Work\tPresent.pdf\n' > "$STALE_STATE/gatherd/music-index.tsv"

# Ghost/Phantom Etude has no row at all in the index (renamed or deleted since
# it was played); it leads the MRU file, ahead of the still-valid Bach row.
printf 'Ghost\tPhantom Etude\tghost.pdf\nBach\tPresent Work\tPresent.pdf\n' \
    > "$STALE_STATE/gatherd/music-stand-scores"

OLD_MUSIC_STAND_ROOT2="$MUSIC_STAND_ROOT"
OLD_XDG_STATE_HOME2="$XDG_STATE_HOME"
MUSIC_STAND_ROOT="$STALE_ROOT"
XDG_STATE_HOME="$STALE_STATE"
export MUSIC_STAND_ROOT XDG_STATE_HOME

reset_picker ''
gatherd-music-stand on >/dev/null 2>&1 || true
if grep -q '^Ghost$' "$WORK/fuzzel.in"; then
    bad 'a stale MRU row is not offered at level 1'
else
    ok 'a stale MRU row is not offered at level 1'
fi
assert_out 'a live MRU row still leads level 1' 'Bach' \
    sh -c 'head -1 "'"$WORK"'/fuzzel.in"'

# Present.pdf is listed in the index but was deleted from disk after
# indexing (the index has not been refreshed yet). Picking it must not enter
# tablet mode: doing so first would strand the human folded over the keyboard
# with it disabled, facing a blank screen with no clue why.
assert_fail 'tablet mode is inactive before the deleted-file pick' minibook-tablet-mode status
reset_picker 'Bach' 'Present Work'
if gatherd-music-stand on 2>"$WORK/deleted-file.err"; then
    bad 'picking a since-deleted file does not report success'
else
    ok 'picking a since-deleted file does not report success'
fi
assert_fail 'picking a since-deleted file did not enter tablet mode' minibook-tablet-mode status
if [ -s "$WORK/deleted-file.err" ]; then
    ok 'picking a since-deleted file warns on stderr'
else
    bad 'picking a since-deleted file warns on stderr'
fi
# A viewer would never even be launched here (the missing-file exit happens
# before that line), so there is no log to check. remember() only ever
# prepends, so an unchanged MRU file is deterministic proof the missing-file
# exit happened before remember() ran, not just before tablet mode.
assert_out 'picking a since-deleted file did not update the MRU' \
    'Ghost	Phantom Etude	ghost.pdf
Bach	Present Work	Present.pdf' \
    cat "$STALE_STATE/gatherd/music-stand-scores"

MUSIC_STAND_ROOT="$OLD_MUSIC_STAND_ROOT2"
XDG_STATE_HOME="$OLD_XDG_STATE_HOME2"
export MUSIC_STAND_ROOT XDG_STATE_HOME

# ── gatherd-music-stand: viewer flag ──────────────────────────────────────────
# sway's `for_window ... fullscreen enable` rule fires but papers immediately
# restores its own persisted (non-fullscreen) window state and clobbers it;
# launching into papers' presentation mode (`-s`) is what actually sticks, and
# it taps to turn the page instead of scrolling. See
# docs/superpowers/specs/2026-08-16-tablet-mode-design.md.

MUSIC_STAND_VIEWER_FLAG=-s
export MUSIC_STAND_VIEWER_FLAG
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with a viewer flag configured' gatherd-music-stand on
assert_out 'the viewer is launched with the configured flag' \
    "-s $SCORES/2 Skazki, Op. 48.pdf" viewer_log
gatherd-music-stand off >/dev/null 2>&1 || true

unset MUSIC_STAND_VIEWER_FLAG
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with no viewer flag configured' gatherd-music-stand on
assert_out 'a viewer with no configured flag still launches, with no leading flag argument' \
    "$SCORES/2 Skazki, Op. 48.pdf" viewer_log
gatherd-music-stand off >/dev/null 2>&1 || true

# ── gatherd-music-stand: touch target font ────────────────────────────────────
# The composer/score lists are the longest lists tapped while folded, so
# pick() gets the same derived --font as the power button's escape menu — but
# ONLY while a finger, not a keyboard, is doing the tapping. turn_on() picks
# before it flips tablet mode on, so a plain keyboard-invoked `on` (tablet
# mode inactive at pick time) must stay keyboard-sized; only "Pick another
# score" from the already-folded power-button menu (tablet mode active at
# pick time) should get the touch-sized font.

reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with no menu_font configured' gatherd-music-stand on
if grep -q -- '--font' "$WORK/fuzzel.args.log"; then
    bad 'pick omits --font when menu_font is unset'
else
    ok 'pick omits --font when menu_font is unset'
fi
gatherd-music-stand off >/dev/null 2>&1 || true

printf 'transform=180\nmenu_font=JetBrainsMono-Regular:size=22\n' \
    > "$XDG_CONFIG_HOME/minibook-tablet-mode/config"

minibook-tablet-mode off >/dev/null 2>&1 || true
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with tablet mode inactive' gatherd-music-stand on
if grep -q -- '--font' "$WORK/fuzzel.args.log"; then
    bad 'pick omits --font when tablet mode is inactive, even with menu_font configured'
else
    ok 'pick omits --font when tablet mode is inactive, even with menu_font configured'
fi
gatherd-music-stand off >/dev/null 2>&1 || true

minibook-tablet-mode on >/dev/null 2>&1
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with tablet mode active' gatherd-music-stand on
if grep -q -- '--font JetBrainsMono-Regular:size=22' "$WORK/fuzzel.args.log"; then
    ok 'pick passes --font through to fuzzel when tablet mode is active'
else
    bad 'pick passes --font through to fuzzel when tablet mode is active'
fi
gatherd-music-stand off >/dev/null 2>&1 || true
printf 'transform=180\n' > "$XDG_CONFIG_HOME/minibook-tablet-mode/config"


printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
