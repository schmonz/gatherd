#!/bin/sh
# Unit tests for gatherd-post-setup-notes: the Vault section, the Libraries
# section that reports what gatherd built and cannot load, and the Packages
# section that reports what is installed and nothing accounts for.
#
# The section used to key on /etc/gatherd/vault-complete, which answers "has the
# vault PLAY finished" -- minutes after, and a different question from, "does a
# human still have to type a password". So a machine whose password was accepted
# at the console prompt spent the rest of the pave being told to enter it. The
# fix is to ask gatherd-vault-pass-needed, the same predicate both prompts use.
#
# The other half is the merge that writes the file: your edits stand, and the
# script's own lines come and go. Its cases, each found by an adversarial review
# of a version that got it wrong, are at the end.
#
# Usage: tests/post-setup-notes

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
NOTES="$REPO/scripts/gatherd-post-setup-notes"
PASS=0
FAIL=0

ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/home/.config" "$WORK/gatherd/scripts" "$WORK/gatherd/vault"

# shellcheck disable=SC2016
# The literal text of the retired bullet, backticks and all: a string to match
# against the notes file, never a command to run.
RETIRED='Run `journalctl -u gatherd-vault.service` to check progress'
OUT="$WORK/home/.config/gatherd-post-setup.md"

# A vault-gated play plus a stored password is what the real predicate reads;
# point it at a sandbox rather than stubbing it, so these tests exercise the
# actual predicate the prompts use.
cp "$REPO/scripts/gatherd-vault-pass-needed" "$WORK/gatherd/scripts/"
: > "$WORK/gatherd/site-vault.yml"

password_stored()     { : > "$WORK/gatherd/.vault_pass"; }
password_not_stored() { rm -f "$WORK/gatherd/.vault_pass"; }

# A stand-in for gatherd-assert-sonames, because the three answers that matter
# are machine states no test can ask for: a converged machine whose AUR packages
# under-declare what they link against, one where they do not, and one where the
# check cannot run at all. The real script has its own suite (tests/assert-sonames);
# what is under test here is what the notes do with each answer.
SONAMES_MODE="$WORK/soname-mode"
printf 'clean' > "$SONAMES_MODE"
cat > "$WORK/gatherd/scripts/gatherd-assert-sonames" <<'STUB'
#!/bin/sh
case "$(cat "$GATHERD_TEST_SONAMES" 2>/dev/null)" in
    broken)
        # Two rows, and the second one has a space in its path on purpose. TSV
        # is not decoration here: the reader in section_libraries splits on a
        # literal tab, and /opt is full of vendor drops that put a space in a
        # directory name. With the default IFS the same row parses as
        # exe=/opt/JetBrains and soname=Toolbox/..., which is a bullet naming a
        # file that does not exist and a soname that is not one.
        [ "${1:-}" = --tsv ] && {
            printf 'localsend-bin\t/opt/localsend/localsend\tlibayatana-indicator3.so.7\n'
            printf 'jetbrains-toolbox\t/opt/JetBrains Toolbox/jetbrains-toolbox\tlibgbm.so.1\n'
        }
        exit 1 ;;
    cannot)
        echo 'gatherd-assert-sonames: no sync database for [gatherd-aur]; run pacman -Sy' >&2
        exit 2 ;;
    mute)
        exit 2 ;;
    *)
        [ "${1:-}" = --tsv ] || echo '28 package(s), 77 executable(s): every soname resolves.'
        exit 0 ;;
esac
STUB
chmod +x "$WORK/gatherd/scripts/gatherd-assert-sonames"

# A stand-in for gatherd-assert-packages-declared. Four answers matter: clean,
# a stray named, could-not-run, and exit 1 with nothing named.
cat > "$WORK/gatherd/scripts/gatherd-assert-packages-declared" <<'STUB'
#!/bin/sh
case "${GATHERD_TEST_STRAYS:-clean}" in
    clean)  exit 0 ;;
    stray)  echo 'electron42'; exit 1 ;;
    cannot) echo 'cannot run: tests/base-manifest.txt is missing' >&2
            exit 2 ;;
    crash)  printf 'Traceback (most recent call last):\nKeyError: rest_packages\n' >&2
            exit 1 ;;
esac
STUB
chmod +x "$WORK/gatherd/scripts/gatherd-assert-packages-declared"

# The sentinel the section gates on. Present by default, because "this machine
# has converged" is the state every case below but the last one is about.
SENTINEL="$WORK/async-complete"
: > "$SENTINEL"

sonames() { printf '%s' "$1" > "$SONAMES_MODE"; }

above() {  # above <header> <header> -- true when the first comes first
    _a=$(grep -n "^# $1\$" "$OUT" | cut -d: -f1)
    _b=$(grep -n "^# $2\$" "$OUT" | cut -d: -f1)
    [ -n "$_a" ] && [ -n "$_b" ] && [ "$_a" -lt "$_b" ]
}

generate() {
    HOME="$WORK/home" XDG_CONFIG_HOME="$WORK/home/.config" GATHERD_HOME="$WORK/gatherd" \
        XDG_STATE_HOME="$WORK/state" RCLONE_CONFIG='' \
        GATHERD_ASYNC_SENTINEL="${SENTINEL_OVERRIDE:-$SENTINEL}" \
        GATHERD_TEST_SONAMES="$SONAMES_MODE" \
        GATHERD_TEST_STRAYS="${STRAYS_MODE:-clean}" sh "$NOTES" >/dev/null 2>&1
}

has()     { grep -qF -- "$1" "$OUT"; }
# Bullets are wrapped to a width, so a phrase long enough to be worth asserting
# on straddles a line break. Continuation lines are indented; join them back.
flows()   { sed -e ':a' -e 'N' -e '$!ba' -e 's/\n  */ /g' "$OUT" | grep -qF -- "$1"; }
assert()  { _d=$1; shift; if "$@"; then ok "$_d"; else bad "$_d"; fi; }
# Verify renders every run now, and one of its checks quotes the reconnect
# command, so login assertions look inside their own section.
logins()  { awk '/^# /{ on = ($0 == "# Other Logins") } on' "$OUT" | sed -e ':a' -e 'N' -e '$!ba' -e 's/\n  */ /g' | grep -qF -- "$1"; }
refute()  { _d=$1; shift; if "$@"; then bad "$_d"; else ok "$_d"; fi; }

# 1. A password is still needed: say so, once.
rm -f "$OUT"; password_not_stored; generate
assert "asks for the password when one is still needed" has 'Enter password when prompted'
assert "under a Vault header"                            grep -q '^# Vault$' "$OUT"
refute "and never mentions the vault service journal"    has "$RETIRED"

# 2. Running again does not add a second copy.
generate
_n=$(grep -cF -- 'Enter password when prompted' "$OUT")
assert "re-running does not duplicate the bullet (found $_n)" test "$_n" -eq 1

# 3. The password has been accepted: the reminder goes away, header and all.
password_stored; generate
refute "drops the reminder once a password is stored"  has 'Enter password when prompted'
refute "and drops the now-empty Vault header"          grep -q '^# Vault$' "$OUT"

# 4. A bullet the script stops rendering leaves your file, as long as it reads
#    as the script last wrote it. The base is what records that; seed it with a
#    bullet no version renders any more.
password_not_stored; rm -f "$OUT"; generate
_hist="$WORK/state/gatherd/post-setup-history"
sed -i "/^- Enter password when prompted\$/a - $RETIRED" "$_hist/base.md" "$OUT"
generate
refute "drops a bullet the script no longer renders" has "$RETIRED"
assert "while keeping the bullet that is still due" has 'Enter password when prompted'

# 5. Notes written by hand under the header survive both branches. Pruning must
#    only ever remove text this script itself wrote.
# Under the header, not at end of file: the end of the file belongs to whichever
# section is last, and that is not Vault.
sed -i '/^# Vault$/a - my own note about the vault' "$OUT"
generate
assert "keeps a hand-written note while the reminder stands" has 'my own note about the vault'
password_stored; generate
assert "and keeps it after the reminder is pruned"          has 'my own note about the vault'
assert "keeping the header alive for it"                    grep -q '^# Vault$' "$OUT"

# ---------------------------------------------------------------- Libraries
#
# This section is why gatherd-assert-sonames is not left to the verify list. A
# verify step is designed to be deleted once exercised, and the defect it
# catches -- an AUR package's `depends` changing upstream -- arrives without any
# edit to this repo. So the check has to recompute from live state at every
# login, say something only when there is something to say, and gate nothing.

# 6. Something to say.
rm -f "$OUT"; password_stored; sonames broken; generate
assert "reports a soname nothing on the machine provides" \
    has 'libayatana-indicator3.so.7'
assert "naming the package that under-declares it"  has 'localsend-bin'
assert "and the executable that cannot start"       has '/opt/localsend/localsend'
# The tab is the field separator, not whitespace. Drop the IFS from the reader
# in section_libraries and this is the assertion that goes red: the path splits
# at its space and the bullet names /opt/JetBrains as the file and
# Toolbox/jetbrains-toolbox as the library.
assert "reading a path with a space in it as one field" \
    flows '/opt/JetBrains Toolbox/jetbrains-toolbox cannot load libgbm.so.1'
assert "under a Libraries header"                   grep -q '^# Libraries$' "$OUT"
assert "above Verify, where the standing checks are" above Libraries Verify

# 7. Saying it twice is saying it wrong.
generate
# Bullets, not lines: the soname appears twice inside one bullet, once in the
# sentence and once in the `pacman -F` that finds its provider. `|| :` because
# grep -c exits 1 on a count of zero, which under set -e would abort the suite
# instead of failing this assertion.
_n=$(grep -c '^- gatherd built ' "$OUT" || :)
assert "re-running does not duplicate the findings (found $_n)" test "$_n" -eq 2

# 8. A hand-written note under the header survives the finding being there...
# Under the header, not at end of file: what is being tested is a note living
# inside the section this run rewrites.
sed -i '/^# Libraries$/a - ask upstream about the ayatana split' "$OUT"
generate
assert "keeps a hand-written note while the finding stands" \
    has 'ask upstream about the ayatana split'

# 9. ...and survives the finding going away, header and all.
sonames clean; generate
refute "drops the finding once every soname resolves" has 'libayatana-indicator3.so.7'
assert "while keeping the hand-written note"          has 'ask upstream about the ayatana split'
assert "and the header it lives under"                grep -q '^# Libraries$' "$OUT"

# 10. Nothing to say, and nothing of yours to keep: no header at all.
rm -f "$OUT"; sonames clean; generate
refute "says nothing when every soname resolves" grep -q '^# Libraries$' "$OUT"

# 11. Could not run is not clean. A login-time check that answers "fine" to a
#     machine it never looked at is worse than no check -- the same rule
#     gatherd-assert-sonames enforces on itself.
rm -f "$OUT"; sonames cannot; generate
assert "says so when the check could not run" grep -q '^# Libraries$' "$OUT"
assert "quoting the reason it could not"      has 'run pacman -Sy'

# 11a. Could not run, and would not say why. The real script always says; this
#      pins that the bullet stays a sentence if one ever does not, rather than
#      degrading to "packages nothing has checked: ."
rm -f "$OUT"; sonames mute; generate
assert "still says the machine went unchecked" grep -q '^# Libraries$' "$OUT"
refute "without an empty reason where a reason goes" has 'has checked: .'

# 12. A machine that has not converged is not a machine with an answer. REST
#     builds the AUR packages this asks about, so before it finishes there is
#     nothing to ask -- and the check would fail for that reason at every
#     login of the first pave.
rm -f "$OUT"; sonames broken
SENTINEL_OVERRIDE=/nonexistent generate
refute "stays quiet until REST has converged" grep -q '^# Libraries$' "$OUT"

# 13. And it cleans up after itself when the sentinel goes: a finding left
#     standing from a converged machine is a claim nothing is checking.
sonames broken; generate
assert "the finding is back once the sentinel is"    has 'libayatana-indicator3.so.7'
SENTINEL_OVERRIDE=/nonexistent generate
refute "and gone again when the sentinel is not"     has 'libayatana-indicator3.so.7'

# ----------------------------------------------------------------- Packages

# 14. Clean: no section at all. A gate with nothing to say says nothing.
rm -f "$OUT"; sonames clean; STRAYS_MODE=clean; generate
refute "says nothing when every package is accounted for" has 'does not account for'

# 15. A stray: named, with both of the two things a human can do about it.
rm -f "$OUT"; STRAYS_MODE=stray; generate
assert "names a stray package"            flows 'does not account for electron42'
assert "under a Packages header"          grep -q '^# Packages$' "$OUT"
assert "and offers removal"               flows 'sudo pacman -Rs electron42'
assert "or demotion, for a required one"  flows 'sudo pacman -D --asdeps electron42'
assert "and says declaring is the answer for what something uses" \
    flows 'If anything uses it'

# 16. Exit 2 is not exit 0. A check that could not look has not said it is fine.
rm -f "$OUT"; STRAYS_MODE=cannot; generate
assert "reports a check that could not run" flows 'base-manifest.txt is missing'
refute "without repeating that it could not" flows 'can run: cannot run'

# 16a. Exit 1 naming nothing is a crash, not a clean bill: it says so too.
rm -f "$OUT"; STRAYS_MODE=crash; generate
assert "reports exit 1 with no names as a check that could not run" \
    flows 'until its check can run: KeyError: rest_packages'

# 17. The bullet is derived, so a second login must not stack a second copy.
rm -f "$OUT"; STRAYS_MODE=stray; generate; generate
_n=$(grep -c 'does not account for electron42' "$OUT" || true)
assert "the stray bullet does not accumulate (found $_n)" test "$_n" -eq 1

# 18. postinstall clones the checkout before Ansible runs, so unlike Libraries
#     this answers before REST has converged rather than hiding until it does.
rm -f "$OUT"; SENTINEL_OVERRIDE=/nonexistent generate
assert "answers before REST has converged" flows 'does not account for electron42'

STRAYS_MODE=clean

# ------------------------------------------------------------- Other Logins
#
# squirrel-zapper, first login after a repave: the fleet document's iCloud token
# had expired. pull installed it (encrypted, unreachable), sync then left
# icloud-needs-reauth, and the notes told the human to run pull -- expecting
# `encrypted, verified` it could never produce -- AND to reconnect. Only the
# second was the job.

ICLOUD_STATE="$WORK/home/.local/state/gatherd"
ICLOUD_CONF="$WORK/home/.config/rclone/rclone.conf"
PULL='gatherd-icloud-config pull'
RECONNECT='gatherd-icloud-config reconnect'
icloud_reset() {
    rm -rf "$ICLOUD_STATE" "$ICLOUD_CONF"
    mkdir -p "$ICLOUD_STATE" "$(dirname "$ICLOUD_CONF")"
}
config_on_disk() { printf '# Encrypted rclone configuration File\n' > "$ICLOUD_CONF"; }

# 14. Nothing fetched yet: pull is the step.
rm -f "$OUT"; icloud_reset; generate
assert "points a machine with no config at pull"         logins "$PULL"
refute "and does not ask it to reconnect"                logins "$RECONNECT"

# 15. The squirrel-zapper state: a config on disk that sync could not reach.
rm -f "$OUT"; icloud_reset; config_on_disk; : > "$ICLOUD_STATE/icloud-needs-reauth"
generate
assert "asks for re-authentication when the config on disk cannot reach iCloud" \
    logins "$RECONNECT"
refute "without also sending the human back to pull"     logins "$PULL"

# 16. Sync with nothing to sync fails the same probe and leaves the same
#     sentinel. There is no remote to reconnect; pull is still the step.
rm -f "$OUT"; icloud_reset; : > "$ICLOUD_STATE/icloud-needs-reauth"
generate
assert "treats a reauth sentinel with no config on disk as not yet pulled" logins "$PULL"
refute "rather than asking to reconnect a remote that is not there"       logins "$RECONNECT"

# 17. Fixed: both gone.
icloud_reset; config_on_disk; : > "$ICLOUD_STATE/icloud-fleet-ok"; generate
refute "drops the pull bullet once the fleet round-trip worked" logins "$PULL"
refute "and the reconnect bullet once sync reached iCloud"      logins "$RECONNECT"

# 17a. Plaintext and dead at once: push refuses plaintext, so encryption has to
#      be read first.
rm -f "$OUT"; icloud_reset; config_on_disk
: > "$ICLOUD_STATE/icloud-needs-reauth"; : > "$ICLOUD_STATE/icloud-plaintext-config"
generate
_enc=$(awk '/^# /{ on = ($0 == "# Other Logins") } on' "$OUT" | grep -n 'rclone config encryption set' | cut -d: -f1)
_rec=$(awk '/^# /{ on = ($0 == "# Other Logins") } on' "$OUT" | grep -n 'gatherd-icloud-config reconnect' | cut -d: -f1)
assert "puts encryption ahead of reconnect when both are due" \
    test -n "$_enc" -a -n "$_rec" -a "${_enc:-0}" -lt "${_rec:-0}"

# 18. A section with your notes in it, and a section of your own after it: the
#     script's bullet lands once, under its own header, and both notes stay.
rm -f "$OUT"; icloud_reset; config_on_disk; : > "$ICLOUD_STATE/icloud-fleet-ok"
sonames clean; generate
sed -i '/^# Other Logins$/a - my own note about iCloud' "$OUT"
printf '\n# Scratch\n- something else entirely\n' >> "$OUT"
rm -f "$ICLOUD_STATE/icloud-fleet-ok"; rm -f "$ICLOUD_CONF"
generate; generate; generate
_n=$(grep -c "gatherd-icloud-config pull" "$OUT" || :)
assert "adds a bullet to a mid-file section once, not once per run (found $_n)" test "$_n" -eq 1
_ol=$(grep -n '^# Other Logins$' "$OUT" | cut -d: -f1)
_sc=$(grep -n '^# Scratch$' "$OUT" | cut -d: -f1)
_pl=$(grep -n 'gatherd-icloud-config pull' "$OUT" | head -1 | cut -d: -f1)
assert "under its own header, not the section after it" \
    test -n "$_pl" -a "${_ol:-0}" -lt "${_pl:-0}" -a "${_pl:-0}" -lt "${_sc:-0}"
# shellcheck disable=SC2016
assert "keeping the hand-written notes in both sections" \
    sh -c 'grep -q "my own note about iCloud" "$1" && grep -q "something else entirely" "$1"' _ "$OUT"

# 20. Login reminders clear themselves by asking the browser, not a sentinel.
#     A cookie's presence is not enough -- a signed-out profile can keep the name
#     with a past expiry -- and the two browsers store that expiry in different
#     units, so each is written with a real one.
seed_cookies() {  # seed_cookies <seconds-from-now>
    _when=$(( $(date +%s) + $1 ))
    mkdir -p "$WORK/home/.local/share/ice/waterfox-profiles/Duolingo" \
             "$WORK/home/.local/share/ice/profiles/iCloud/Default" \
             "$WORK/home/.config/Claude"
    sqlite3 "$WORK/home/.local/share/ice/waterfox-profiles/Duolingo/cookies.sqlite" \
        "create table if not exists moz_cookies (host text, name text, expiry integer);
         delete from moz_cookies;
         insert into moz_cookies values ('.duolingo.com', 'jwt_token', ${_when}000);"
    for _db in "$WORK/home/.local/share/ice/profiles/iCloud/Default/Cookies" \
               "$WORK/home/.config/Claude/Cookies"; do
        sqlite3 "$_db" "create table if not exists cookies (host_key text, name text, expires_utc integer); delete from cookies;"
    done
    sqlite3 "$WORK/home/.local/share/ice/profiles/iCloud/Default/Cookies" \
        "insert into cookies values ('.icloud.com', 'X-APPLE-WEBAUTH-TOKEN', $(( (_when + 11644473600) ))000000);"
    sqlite3 "$WORK/home/.config/Claude/Cookies" \
        "insert into cookies values ('.claude.ai', 'sessionKey', $(( (_when + 11644473600) ))000000);"
}

if command -v sqlite3 >/dev/null 2>&1; then
    rm -f "$OUT"; generate
    assert "asks for the Duolingo sign-in, with the reload that attaches 1Password" \
        flows 'Duolingo: open it, press Ctrl+R'
    assert "asks for one iCloud web sign-in on behalf of all four apps" \
        flows 'iCloud web apps: open Notes and sign in'
    assert "asks for the Claude Desktop sign-in"    flows 'Claude Desktop: open it from the app menu'

    seed_cookies -60; generate
    assert "an expired cookie still counts as signed out (Duolingo)" flows 'Duolingo: open it, press Ctrl+R'
    assert "an expired cookie still counts as signed out (iCloud web)" flows 'iCloud web apps: open Notes and sign in'
    assert "an expired cookie still counts as signed out (Claude Desktop)" flows 'Claude Desktop: open it from the app menu'

    seed_cookies 86400; generate
    refute "drops the Duolingo bullet once its cookie is live"    flows 'Duolingo: open it, press Ctrl+R'
    refute "drops the iCloud web bullet once its cookie is live"  flows 'iCloud web apps: open Notes and sign in'
    refute "drops the Claude Desktop bullet once its cookie is live" flows 'Claude Desktop: open it from the app menu'
else
    ok "sqlite3 absent: login-reminder cases skipped"
fi

# Hand-written notes, wherever they sit, outlive the sections that regenerate
# every login. Unmanaged WiFi once spliced itself in under line 1, which filed
# whatever you had written at the top under its own header; the next login
# wiped header-to-header, and the notes with it. They survived exactly one
# login, so nothing looked wrong until they were gone.
mkdir -p "$WORK/bin"
WIFI_SAVED="$WORK/wifi-saved"
cat > "$WORK/bin/nmcli" <<'STUB'
#!/bin/sh
while IFS= read -r ssid; do printf '%s:802-11-wireless\n' "$ssid"; done < "$GATHERD_TEST_WIFI_SAVED"
STUB
chmod +x "$WORK/bin/nmcli"
printf 'HomeNet\n' > "$WORK/managed-wifi.list"
printf 'HomeNet\nCafe Guest\n' > "$WIFI_SAVED"

generate_wifi() {
    PATH="$WORK/bin:$PATH" GATHERD_MANAGED_WIFI_LIST="$WORK/managed-wifi.list" \
        GATHERD_TEST_WIFI_SAVED="$WIFI_SAVED" generate
}
first_header_line() { grep -n '^# ' "$OUT" | head -1 | cut -d: -f1; }
note_line()         { grep -nF -- "$1" "$OUT" | head -1 | cut -d: -f1; }
above_first_header() {
    _n=$(note_line "$1"); _h=$(first_header_line)
    [ -n "$_n" ] && { [ -z "$_h" ] || [ "$_n" -lt "$_h" ]; }
}

printf 'Manual steps remaining:\n\nmy note at the top\n' > "$OUT"
generate_wifi; generate_wifi
assert "a note at the top survives two logins with an unmanaged network" has 'my note at the top'
assert "a note at the top stays above every section"  above_first_header 'my note at the top'
assert "the unmanaged network is still reported"       has '  - Cafe Guest'

printf 'Manual steps remaining:\n\n# Unmanaged WiFi\nmy note about wifi\n' > "$OUT"
generate_wifi; generate_wifi
assert "a note under Unmanaged WiFi survives two logins" has 'my note about wifi'

printf 'HomeNet\nAirport Free\n' > "$WIFI_SAVED"; generate_wifi
refute "a network no longer saved drops out of the list" has '  - Cafe Guest'
assert "a newly saved network shows up"                   has '  - Airport Free'
assert "and the note under Unmanaged WiFi is still there" has 'my note about wifi'
assert "with one Unmanaged WiFi header, not two" \
    test "$(grep -c '^# Unmanaged WiFi$' "$OUT")" -eq 1

printf 'HomeNet\n' > "$WIFI_SAVED"; generate_wifi
assert "with every network managed, the note keeps its header" has '# Unmanaged WiFi'

printf 'Manual steps remaining:\n\nmy note at the top\n' > "$OUT"
STRAYS_MODE=stray generate_wifi; STRAYS_MODE=stray generate_wifi
assert "a note at the top stays above the Packages section too" above_first_header 'my note at the top'

# ------------------------------------------------------------- The merge
#
# Every case two adversarial reviews found against the text-matching version,
# each of which lost a note or kept a stale line. The notes file is merged
# against the last render now, so none of these may.
HIST="$WORK/state/gatherd/post-setup-history"
STRAYS_MODE=clean; sonames clean; password_stored
fresh() { rm -f "$OUT"; rm -rf "$HIST"; printf 'HomeNet\nCafe Guest\n' > "$WIFI_SAVED"; generate_wifi; }
lines_in_order() {  # lines_in_order <file> <line>... -- consecutive, in order
    _f=$1; shift
    _first=$(grep -nxF -- "$1" "$_f" | head -1 | cut -d: -f1)
    [ -n "$_first" ] || return 1
    _i=$_first
    for _l in "$@"; do
        [ "$(sed -n "${_i}p" "$_f")" = "$_l" ] || return 1
        _i=$((_i + 1))
    done
}

fresh
sed -i 's/^  - Cafe Guest$/  - Cafe Guest  <- my phone hotspot\n    password is on the fridge/' "$OUT"
printf 'HomeNet\nAirport Free\n' > "$WIFI_SAVED"; generate_wifi; generate_wifi
assert "an annotation on a listed network survives the list changing" has 'my phone hotspot'
assert "and so does an indented line under it"                       has 'password is on the fridge'
assert "while the new network is listed"                             has '  - Airport Free'

fresh
sed -i 's/^  - Cafe Guest$/# Hotspots\n  - Cafe Guest/' "$OUT"
printf 'HomeNet\nAirport Free\n' > "$WIFI_SAVED"; generate_wifi; generate_wifi
refute "a forgotten network goes even under a heading of yours" has '  - Cafe Guest'
_n=$(grep -c '^- Either keep in Ansible' "$OUT" || :)
