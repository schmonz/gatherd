printf 'Ghost\tPhantom Etude\tghost.pdf\nBach\tPresent Work\tPresent.pdf\n' \
    > "$STALE_STATE/gatherd/music-stand-scores"

OLD_MUSIC_STAND_ROOT2="$MUSIC_STAND_ROOT"
OLD_XDG_STATE_HOME2="$XDG_STATE_HOME"
MUSIC_STAND_ROOT="$STALE_ROOT"
XDG_STATE_HOME="$STALE_STATE"
export MUSIC_STAND_ROOT XDG_STATE_HOME

reset_picker ''
gatherd-music-stand on >/dev/null 2>&1 || true
if grep -q '^Ghost$' "$WORK/fuzzel.in"; then
    bad 'a stale MRU row is not offered at level 1'
else
    ok 'a stale MRU row is not offered at level 1'
fi
assert_out 'a live MRU row still leads level 1' 'Bach' \
    sh -c 'head -1 "'"$WORK"'/fuzzel.in"'

# Present.pdf is listed in the index but was deleted from disk after
# indexing (the index has not been refreshed yet). Picking it must not enter
# tablet mode: doing so first would strand the human folded over the keyboard
# with it disabled, facing a blank screen with no clue why.
assert_fail 'tablet mode is inactive before the deleted-file pick' gatherd-tablet-mode status
reset_picker 'Bach' 'Present Work'
if gatherd-music-stand on 2>"$WORK/deleted-file.err"; then
    bad 'picking a since-deleted file does not report success'
else
    ok 'picking a since-deleted file does not report success'
fi
assert_fail 'picking a since-deleted file did not enter tablet mode' gatherd-tablet-mode status
if [ -s "$WORK/deleted-file.err" ]; then
    ok 'picking a since-deleted file warns on stderr'
else
    bad 'picking a since-deleted file warns on stderr'
fi
# A viewer would never even be launched here (the missing-file exit happens
# before that line), so there is no log to check. remember() only ever
# prepends, so an unchanged MRU file is deterministic proof the missing-file
# exit happened before remember() ran, not just before tablet mode.
assert_out 'picking a since-deleted file did not update the MRU' \
    'Ghost	Phantom Etude	ghost.pdf
Bach	Present Work	Present.pdf' \
    cat "$STALE_STATE/gatherd/music-stand-scores"

MUSIC_STAND_ROOT="$OLD_MUSIC_STAND_ROOT2"
XDG_STATE_HOME="$OLD_XDG_STATE_HOME2"
export MUSIC_STAND_ROOT XDG_STATE_HOME

# ── gatherd-music-stand: viewer flag ──────────────────────────────────────────
# sway's `for_window ... fullscreen enable` rule fires but papers immediately
# restores its own persisted (non-fullscreen) window state and clobbers it;
# launching into papers' presentation mode (`-s`) is what actually sticks, and
# it taps to turn the page instead of scrolling. See
# docs/superpowers/specs/2026-08-16-tablet-mode-design.md.

MUSIC_STAND_VIEWER_FLAG=-s
export MUSIC_STAND_VIEWER_FLAG
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with a viewer flag configured' gatherd-music-stand on
assert_out 'the viewer is launched with the configured flag' \
    "-s $SCORES/2 Skazki, Op. 48.pdf" viewer_log
gatherd-music-stand off >/dev/null 2>&1 || true

unset MUSIC_STAND_VIEWER_FLAG
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with no viewer flag configured' gatherd-music-stand on
assert_out 'a viewer with no configured flag still launches, with no leading flag argument' \
    "$SCORES/2 Skazki, Op. 48.pdf" viewer_log
gatherd-music-stand off >/dev/null 2>&1 || true

# ── gatherd-music-stand: touch target font ────────────────────────────────────
# The composer/score lists are the longest lists tapped while folded, so
# pick() gets the same derived --font as the power button's escape menu — but
# ONLY while a finger, not a keyboard, is doing the tapping. turn_on() picks
# before it flips tablet mode on, so a plain keyboard-invoked `on` (tablet
# mode inactive at pick time) must stay keyboard-sized; only "Pick another
# score" from the already-folded power-button menu (tablet mode active at
# pick time) should get the touch-sized font.

reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with no menu_font configured' gatherd-music-stand on
if grep -q -- '--font' "$WORK/fuzzel.args.log"; then
    bad 'pick omits --font when menu_font is unset'
else
    ok 'pick omits --font when menu_font is unset'
fi
gatherd-music-stand off >/dev/null 2>&1 || true

printf 'transform=180\nmenu_font=JetBrainsMono-Regular:size=22\n' \
    > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"

gatherd-tablet-mode off >/dev/null 2>&1 || true
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with tablet mode inactive' gatherd-music-stand on
if grep -q -- '--font' "$WORK/fuzzel.args.log"; then
    bad 'pick omits --font when tablet mode is inactive, even with menu_font configured'
else
    ok 'pick omits --font when tablet mode is inactive, even with menu_font configured'
fi
gatherd-music-stand off >/dev/null 2>&1 || true

gatherd-tablet-mode on >/dev/null 2>&1
reset_picker 'Medtner' 'Two Skazki'
assert_ok 'music-stand on succeeds with tablet mode active' gatherd-music-stand on
if grep -q -- '--font JetBrainsMono-Regular:size=22' "$WORK/fuzzel.args.log"; then
    ok 'pick passes --font through to fuzzel when tablet mode is active'
else
    bad 'pick passes --font through to fuzzel when tablet mode is active'
fi
gatherd-music-stand off >/dev/null 2>&1 || true
printf 'transform=180\n' > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"

# ── entering confirms the keyboard is really silenced ────────────────────────
# `for _id in $(builtin_keyboards)` runs zero times when the query returns
# nothing, and $() swallows the failure, so turn_on could rotate the screen and
# leave the keyboard live while looking entirely successful. A machine folded
# onto its own keys then types into whatever is focused - which is how a folded
# fuzzel menu came up with its prompt and every entry filtered away.

gatherd-tablet-mode off >/dev/null 2>&1 || true
touch "$WORK/fail-get-inputs"
: > "$WORK/tm-warn.err"
gatherd-tablet-mode on 2>"$WORK/tm-warn.err" >/dev/null || true
if [ -s "$WORK/tm-warn.err" ]; then
    ok 'entering warns when it cannot confirm the keyboard is disabled'
else
    bad 'entering warns when it cannot confirm the keyboard is disabled'
fi
if grep -q 'could not confirm' "$WORK/tm-warn.err"; then
    ok 'the warning says what is actually wrong'
else
    bad 'the warning says what is actually wrong'
fi
assert_ok 'the warning is also recorded where it can be read later' \
    test -s "$XDG_STATE_HOME/gatherd/tablet-mode.log"
# Non-fatal by design: an unreadable folded screen is worse than a live
# keyboard the human has been warned about.
assert_ok 'entering still succeeds despite the warning' gatherd-tablet-mode status
rm -f "$WORK/fail-get-inputs"
gatherd-tablet-mode off >/dev/null 2>&1 || true

# The healthy path must not warn, or the warning is noise nobody reads.
: > "$WORK/tm-warn.err"
gatherd-tablet-mode on 2>"$WORK/tm-warn.err" >/dev/null
assert_out 'entering normally warns about nothing' '' cat "$WORK/tm-warn.err"
if swaymsg -t get_inputs | jq -e '.[] | select(.identifier == "1:1:AT_Translated_Set_2_keyboard")
                                       | .libinput.send_events == "disabled"' >/dev/null; then
    ok 'entering really does disable the built-in keyboard'
else
    bad 'entering really does disable the built-in keyboard'
fi
# The pedal is the whole reason the disable side cannot just sweep by type.
if swaymsg -t get_inputs | jq -e '.[] | select(.identifier == "1234:5678:AirTurn_PEDpro")
                                       | .libinput.send_events == "enabled"' >/dev/null; then
    ok 'entering leaves the page-turner pedal alone'
else
    bad 'entering leaves the page-turner pedal alone'
fi
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── gatherd-power-button ──────────────────────────────────────────────────────

mkdir -p "$WORK/home/.config/sway/scripts"
HOME="$WORK/home"
export HOME
cat > "$HOME/.config/sway/scripts/power_menu.sh" <<EOF
#!/bin/sh
printf 'power_menu\n' >> '$WORK/powermenu.log'
EOF
chmod +x "$HOME/.config/sway/scripts/power_menu.sh"

: > "$WORK/powermenu.log"
gatherd-tablet-mode off >/dev/null 2>&1 || true
reset_picker ''
assert_ok 'power button works in laptop mode' gatherd-power-button
assert_out 'laptop mode goes straight to the power menu' 'power_menu' \
    cat "$WORK/powermenu.log"
assert_out 'laptop mode shows no tablet menu' '' cat "$WORK/fuzzel.in"

# Folded, the button offers a touch menu instead of the stock power menu -
# and that menu contains no exit at all. Folding is what starts tablet mode
# and unfolding is what ends it, so there is nothing here to toggle: an "exit"
# entry could only mean "undo the fold you are still holding", which the
# daemon corrects within a poll and which hands back a keyboard lying
# face-down on the stand.
gatherd-tablet-mode on >/dev/null 2>&1
: > "$WORK/powermenu.log"
reset_picker 'Close score'
assert_ok 'power button works in tablet mode' gatherd-power-button
assert_ok 'the folded menu leaves tablet mode running' gatherd-tablet-mode status
assert_out 'tablet mode did not open the power menu' '' cat "$WORK/powermenu.log"
if grep -qi 'exit' "$WORK/fuzzel.in"; then
    bad 'the folded menu offers no exit entry at all'
else
    ok 'the folded menu offers no exit entry at all'
fi
if grep -q 'Close score' "$WORK/fuzzel.in"; then
    ok 'the folded menu offers Close score'
else
    bad 'the folded menu offers Close score'
fi

# Pick another score must reopen the composer/score picker without ever
# leaving tablet mode: found in real use at the piano, where there was no
# touch-reachable way to switch scores while folded.
gatherd-tablet-mode on >/dev/null 2>&1
: > "$WORK/powermenu.log"
reset_picker 'Pick another score' 'Medtner' 'Two Skazki'
assert_ok 'power button offers pick another score' gatherd-power-button
assert_out 'pick another score opened the newly chosen viewer' \
    "$SCORES/2 Skazki, Op. 48.pdf" viewer_log
assert_ok 'pick another score never left tablet mode' gatherd-tablet-mode status
assert_out 'pick another score did not open the power menu' '' cat "$WORK/powermenu.log"

# The folded menu offers no way to power off. It is reached by touch with the
# keyboard disabled, so an irreversible action sitting one mis-tap from `Exit
# tablet mode` is a hazard, not a convenience; unfolding reaches the stock
# power menu with a working keyboard.
gatherd-tablet-mode on >/dev/null 2>&1
: > "$WORK/powermenu.log"
reset_picker 'Power…'
assert_ok 'power button survives a selection it no longer offers' gatherd-power-button
assert_out 'the folded menu never reaches the power menu' '' cat "$WORK/powermenu.log"
if grep -qi 'power' "$WORK/fuzzel.in"; then
    bad 'the folded menu offers no power entry at all'
else
    ok 'the folded menu offers no power entry at all'
fi
assert_ok 'an unoffered selection leaves tablet mode untouched' gatherd-tablet-mode status
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── auto-rotation is a preference; tablet mode is not ────────────────────────
# The one thing in the folded menu that IS a setting. Tablet mode is the fold
# and cannot be chosen; whether the display follows the tablet in the hands is
# a matter of taste, and gets a toggle.

gatherd-tablet-mode off >/dev/null 2>&1 || true
gatherd-tablet-mode rotation-on
assert_ok 'auto-rotation is on by default' gatherd-tablet-mode rotation-status
assert_ok 'rotation-toggle succeeds' gatherd-tablet-mode rotation-toggle
assert_fail 'toggling once turns auto-rotation off' gatherd-tablet-mode rotation-status
assert_ok 'toggling again succeeds' gatherd-tablet-mode rotation-toggle
assert_ok 'toggling twice returns to on' gatherd-tablet-mode rotation-status
assert_ok 'rotation-off is idempotent' gatherd-tablet-mode rotation-off
assert_ok 'rotation-off is still idempotent' gatherd-tablet-mode rotation-off
assert_fail 'rotation stays off after repeated rotation-off' gatherd-tablet-mode rotation-status

# The label states the current state rather than the action, so it reads like
# a checkbox instead of an instruction that means the opposite.
gatherd-tablet-mode on >/dev/null 2>&1
reset_picker 'Cancel'
assert_ok 'power button works with rotation off' gatherd-power-button
if grep -q 'Auto-rotate: off' "$WORK/fuzzel.in"; then
    ok 'the menu shows auto-rotation as off when it is off'
else
    bad 'the menu shows auto-rotation as off when it is off'
fi
gatherd-tablet-mode rotation-on
reset_picker 'Auto-rotate: on'
assert_ok 'power button toggles auto-rotation' gatherd-power-button
if grep -q 'Auto-rotate: on' "$WORK/fuzzel.in"; then
    ok 'the menu shows auto-rotation as on when it is on'
else
    bad 'the menu shows auto-rotation as on when it is on'
fi
assert_fail 'tapping the entry turned auto-rotation off' gatherd-tablet-mode rotation-status
assert_ok 'toggling auto-rotation never leaves tablet mode' gatherd-tablet-mode status
gatherd-tablet-mode rotation-on
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── the lockout: state file gone, input still disabled ───────────────────────
# The failure this whole section exists to prevent, reproduced from the real
# incident. Tablet mode was somehow off on paper while the built-in keyboard
# was still disabled in fact. The power button trusted the paper, showed the
# stock power menu (every entry of which assumes a working keyboard), and
# `off` — which returned early when the state file was missing — could not
# undo anything. There was no way out of the machine short of a hard reboot.

gatherd-tablet-mode on >/dev/null 2>&1
rm -f "$XDG_RUNTIME_DIR/gatherd/tablet-mode"
assert_fail 'the desync case really does look inactive on paper' \
    gatherd-tablet-mode status
if swaymsg -t get_inputs | jq -e '.[] | select(.identifier == "1:1:AT_Translated_Set_2_keyboard")
                                       | .libinput.send_events == "disabled"' >/dev/null; then
    ok 'the desync case really does leave the built-in keyboard disabled'
else
    bad 'the desync case really does leave the built-in keyboard disabled'
fi

: > "$WORK/powermenu.log"
reset_picker 'Exit tablet mode'
assert_ok 'power button works with the state file gone' gatherd-power-button
assert_out 'a disabled keyboard still gets the tablet escape menu, not the stock one' \
    '' cat "$WORK/powermenu.log"
if grep -q 'Pick another score' "$WORK/fuzzel.in"; then
    ok 'the folded menu is still usable with no state file'
else
    bad 'the folded menu is still usable with no state file'
fi
# Recovery from the desync itself belongs to the daemon, not to this menu:
# folded with tablet mode inactive is precisely the "enter" decision, so the
# next poll re-asserts the whole state. What the menu must not do is hand a
# folded human the stock power menu, whose every entry assumes a keyboard.
assert_out 'a disabled keyboard never reaches the stock power menu' \
    '' cat "$WORK/powermenu.log"

# `off` is a recovery command, not a state transition: it must repair a
# session it has no record of ever starting. This is the assertion that the
# old `if ! is_on; then return 0; fi` early return failed.
swaymsg input 1:1:AT_Translated_Set_2_keyboard events disabled >/dev/null
swaymsg input type:touchpad events disabled >/dev/null
rm -f "$XDG_RUNTIME_DIR/gatherd/tablet-mode"
reset_log
assert_ok 'off succeeds with no state file at all' gatherd-tablet-mode off
if swaymsg -t get_inputs | jq -e '.[] | select(.identifier == "1:1:AT_Translated_Set_2_keyboard")
                                       | .libinput.send_events == "enabled"' >/dev/null; then
    ok 'off re-enables the keyboard even with no state file'
else
    bad 'off re-enables the keyboard even with no state file'
fi
if swaymsg -t get_inputs | jq -e '[.[] | select(.type == "touchpad")
                                       | .libinput.send_events] | all(. == "enabled")' >/dev/null; then
    ok 'off re-enables the touchpad even with no state file'
else
    bad 'off re-enables the touchpad even with no state file'
fi
# Nothing was recorded, so there is no resting transform to restore - and
# guessing one would be worse than leaving the display alone (on this
# hardware "normal" is portrait, so a guess rotates a correct screen wrong).
if log_has 'output DSI-1 transform'; then
    bad 'off with no state file leaves the display alone rather than guessing'
else
    ok 'off with no state file leaves the display alone rather than guessing'
fi

# An external keyboard must survive the sweep-by-type re-enable in the sense
# that matters: it is never left disabled. (The pedal is only ever disabled by
# a test, never by tablet mode - the i8042 heuristic is what protects it.)
if swaymsg -t get_inputs | jq -e '.[] | select(.identifier == "1234:5678:AirTurn_PEDpro")
                                       | .libinput.send_events == "enabled"' >/dev/null; then
    ok 'the page-turner pedal is enabled after a recovery off'
else
    bad 'the page-turner pedal is enabled after a recovery off'
fi

# ── the folded menu records what it showed and what came back ────────────────
# Three explanations for a menu that came up with its prompt and no entries
# were argued from first principles and then falsified by measurement. This is
# the evidence that should have existed the first time.

HINGE_PB_LOG="$XDG_STATE_HOME/gatherd/power-button.log"
gatherd-tablet-mode on >/dev/null 2>&1
rm -f "$HINGE_PB_LOG"
reset_picker 'Cancel'
assert_ok 'power button works with logging on' gatherd-power-button
if grep -q 'open entries=4' "$HINGE_PB_LOG" 2>/dev/null; then
    ok 'the number of entries handed to fuzzel is recorded'
else
    bad 'the number of entries handed to fuzzel is recorded'
fi
if grep -q 'kbd=\[' "$HINGE_PB_LOG" 2>/dev/null; then
    ok 'the built-in keyboard state at menu time is recorded'
else
    bad 'the built-in keyboard state at menu time is recorded'
fi
if grep -q 'fuzzel_already_running=' "$HINGE_PB_LOG" 2>/dev/null; then
    ok 'a fuzzel already holding the single-instance lock would be recorded'
else
    bad 'a fuzzel already holding the single-instance lock would be recorded'
fi
if grep -q 'close rc=0 selection=\[.*Cancel' "$HINGE_PB_LOG" 2>/dev/null; then
    ok 'the selection that came back is recorded'
else
    bad 'the selection that came back is recorded'
fi

# The outcome most worth recording is the one where fuzzel gives nothing back.
# `selection=$(...)` followed by `_rc=$?` would abort under `set -e` before
# reaching the log, so this is the assertion that keeps the `if` form honest.
rm -f "$HINGE_PB_LOG"
touch "$WORK/fuzzel-fail"
reset_picker ''
assert_ok 'the power button survives fuzzel exiting non-zero' gatherd-power-button
if grep -q 'close rc=1' "$HINGE_PB_LOG" 2>/dev/null; then
    ok 'a fuzzel that returns nothing is still recorded'
else
    bad 'a fuzzel that returns nothing is still recorded'
fi
rm -f "$WORK/fuzzel-fail"
assert_ok 'a failed menu changes nothing' gatherd-tablet-mode status
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── gatherd-power-button: cancel escape ───────────────────────────────────────
# The tablet escape menu is the only control reachable once folded, so it must
# offer a way out that changes nothing — not even a rotation-restoring "exit
# tablet mode".

gatherd-tablet-mode on >/dev/null 2>&1
: > "$WORK/powermenu.log"
reset_log
reset_picker "$cancel"
assert_ok 'power button offers cancel' gatherd-power-button
assert_ok 'cancelling the escape menu left tablet mode on' gatherd-tablet-mode status
assert_out 'cancelling the escape menu did not open the power menu' '' cat "$WORK/powermenu.log"
assert_out 'cancelling the escape menu opened nothing' '' cat "$VIEWER_LOG"
assert_out 'cancelling the escape menu touched no sway state' '' cat "$WORK/swaymsg.log"
if grep -qF "$cancel" "$WORK/fuzzel.in"; then
    ok 'tablet escape menu offers a cancel entry'
else
    bad 'tablet escape menu offers a cancel entry'
fi
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── gatherd-power-button: touch target font ───────────────────────────────────
# The escape menu is the only control reachable while folded, so it must be
# tappable too. Confirmed comfortable at size 22 (foot_font_size=10) by hand
# at the machine; see menu_font's derivation in tablet-mode.conf.j2.

gatherd-tablet-mode on >/dev/null 2>&1
reset_picker 'Power…'
assert_ok 'power button escape menu works with no menu_font configured' gatherd-power-button
if grep -q -- '--font' "$WORK/fuzzel.args.log"; then
