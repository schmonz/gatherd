# ── gatherd-hinge-daemon ──────────────────────────────────────────────────────
# Fakes gatherd-tablet-mode itself (rather than reusing the real script's
# swaymsg fake) so these tests exercise only the daemon's decision logic —
# geometry, the lid gate, hysteresis, the degenerate pose, and exiting —
# without also depending on the compositor plumbing already covered above.

# fake_bin NAME BODY — install a fake executable that shadows the real one.
# Matches tests/icloud's helper; tests/tablet-mode had not needed it until now.
fake_bin() {
    printf '#!/bin/sh\n%s\n' "$2" > "$FAKEBIN/$1"
    chmod +x "$FAKEBIN/$1"
}

# The REAL path gatherd-tablet-mode uses, not a private one: the daemon now
# reads this file directly instead of shelling out to `gatherd-tablet-mode
# status` (20 fork+execs a second, measured at 2.1% of a core). A fake keeping
# its state somewhere else would no longer be a fake of anything.
FAKETM_STATE="$XDG_RUNTIME_DIR/gatherd/tablet-mode"
FAKETM_LOG="$WORK/faketm.log"
fake_bin gatherd-tablet-mode '
printf "%s\n" "$*" >> "'"$FAKETM_LOG"'"
case "$1" in
    on)     mkdir -p "$(dirname "'"$FAKETM_STATE"'")"
            touch "'"$FAKETM_STATE"'" ;;
    off)    rm -f "'"$FAKETM_STATE"'" ;;
    status) [ -f "'"$FAKETM_STATE"'" ] ;;
    *)      exit 2 ;;
esac
'
# Every earlier section in this suite already invoked the real
# gatherd-tablet-mode directly (not through a subprocess), so bash has this
# command name hashed to $REPO/scripts/gatherd-tablet-mode. Prepending FAKEBIN
# to $PATH does not by itself invalidate that cache — only `hash -r` does —
# so without this, every direct call below silently keeps hitting the real
# script while only gatherd-hinge-daemon's own subprocess calls (a fresh
# process, with its own PATH search) would see the fake.
hash -r

HINGE_LID="$WORK/hinge-lid"
HINGE_BASE="$WORK/hinge-base"
HINGE_LID_STATE="$WORK/hinge-lid-state"
GATHERD_HINGE_LID_DEVICE="$HINGE_LID"
GATHERD_HINGE_BASE_DEVICE="$HINGE_BASE"
GATHERD_HINGE_LID_STATE="$HINGE_LID_STATE"
export GATHERD_HINGE_LID_DEVICE GATHERD_HINGE_BASE_DEVICE GATHERD_HINGE_LID_STATE
unset GATHERD_HINGE_ENTER GATHERD_HINGE_EXIT

# write_vector DIR X Y Z — plants raw sysfs-style accelerometer counts.
write_vector() {
    mkdir -p "$1"
    printf '%s\n' "$2" > "$1/in_accel_x_raw"
    printf '%s\n' "$3" > "$1/in_accel_y_raw"
    printf '%s\n' "$4" > "$1/in_accel_z_raw"
}

# write_lid_state open|closed — mimics /proc/acpi/button/lid/LID0/state's format.
write_lid_state() {
    printf 'state:      %s\n' "$1" > "$HINGE_LID_STATE"
}

# Every fixture below shares the same lid vector and varies only the base
# vector's rotation about the hinge (y) axis, so each row isolates exactly
# the signed-angle geometry under test. Raw counts precomputed offline from
# the atan2 formula the script implements (theta itself, no further
# transform); each was checked to round-trip to its target theta to within
# 0.02 degrees before being baked in here, so a passing assertion means the
# formula, not the fixture, is right. Lid defaults to open on every reset -
# tests that care about the closed lid set it explicitly.
reset_daemon_state() {
    rm -f "$FAKETM_STATE"
    : > "$FAKETM_LOG"
    write_lid_state open
}

hinge_print() {
    gatherd-hinge-daemon --print
}

# The acting half of the same cycle. --print deliberately cannot clear the
# suppression latch (that would make a diagnostic change behaviour), so
# testing that unfolding re-arms entry needs the path that actually acts.
hinge_poll_once() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" <<'POLLONCE'
import collections, importlib.machinery, importlib.util, sys
path = sys.argv[1]
loader = importlib.machinery.SourceFileLoader("hinge_daemon", path)
spec = importlib.util.spec_from_loader("hinge_daemon", loader)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
mod.poll_once(collections.deque(maxlen=mod.window_size()), mod.RotationTracker())
POLLONCE
}

# ── the measured poses ────────────────────────────────────────────────────────
# theta is the hinge angle itself (atan2-wrapped to +-180), not "180 - theta":
# typing reads ~108, flat reads ~178, a part-folded tent reads ~-92, and fully
# folded reads ~-2. All four are exercised here so the corrected geometry, not
# just the corrected threshold, is under test.

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -920 100 449
assert_out 'a part-open tent reads theta near 154, well clear of the fold band' \
    'theta=154.0 action=hold' hinge_print

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -317 100 976
assert_out 'typing angle reads theta near 108 and does not enter' \
    'theta=108.0 action=hold' hinge_print

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -1026 100 36
assert_out 'flat reads theta near 178 and does not enter' \
    'theta=178.0 action=hold' hinge_print

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -36 100 -1023
assert_out 'a part-folded tent reads theta near 92 and does not enter' \
    'theta=92.0 action=hold' hinge_print
assert_fail 'the tent pose alone never turns tablet mode on' gatherd-tablet-mode status

# ── the fully folded pose and the lid gate ───────────────────────────────────
# theta near -2 is what a shut lid ALSO reads (atan2 wraps at +-180, not at
# zero) - the lid switch is what tells the two apart. This is the fix itself.

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 1023 100 -36
assert_out 'folded (theta near -2) with the lid open reports the enter decision' \
    'theta=2.0 action=enter' hinge_print
# --print is diagnostic only: it must report the decision it would take and
# then do nothing. This is the exact fixture that used to make --print
# itself rotate the display and disable the keyboard. The log legitimately
# holds a "status" call (decide()'s own read of the current state) - only
# "on" would prove --print acted.
if grep -qx on "$FAKETM_LOG"; then
    bad '--print issues no gatherd-tablet-mode on/off command, even for a decision that would act'
else
    ok '--print issues no gatherd-tablet-mode on/off command, even for a decision that would act'
fi
assert_fail '--print alone never turns tablet mode on' gatherd-tablet-mode status

reset_daemon_state
write_lid_state closed
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 1023 100 -36
assert_out 'the same theta with the lid closed does not enter' \
    'theta=2.0 action=hold' hinge_print
assert_fail 'a closed lid never turns tablet mode on' gatherd-tablet-mode status

reset_daemon_state
rm -f "$HINGE_LID_STATE"
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 1023 100 -36
assert_out 'an unreadable lid file is treated as not open and does not enter' \
    'theta=2.0 action=hold' hinge_print
assert_fail 'an unreadable lid file never turns tablet mode on' gatherd-tablet-mode status

# ── hysteresis: a theta between the thresholds changes nothing ──────────────
# 40 sits between the default fold_exit (50) and fold_enter (30) thresholds.
# Tested from both sides of the dead zone: falling from inactive must not
# enter, and rising from an owned-active state must not exit either.

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 784 100 658
assert_out 'a mid-band theta does not enter from inactive' 'theta=40.0 action=hold' hinge_print
assert_fail 'still inactive after a mid-band reading' gatherd-tablet-mode status

reset_daemon_state
mkdir -p "$XDG_RUNTIME_DIR/gatherd"
gatherd-tablet-mode on >/dev/null 2>&1
: > "$FAKETM_LOG"
assert_out 'a mid-band theta does not exit from an active state' \
    'theta=40.0 action=hold' hinge_print
assert_ok 'still active after a mid-band reading' gatherd-tablet-mode status
# The log legitimately holds "status" calls (the daemon's own state check,
# plus this test's direct one above) — only "off" would prove the bug.
if grep -qx off "$FAKETM_LOG"; then
    bad 'no off call was logged for the mid-band reading'
else
    ok 'no off call was logged for the mid-band reading'
fi

# ── adaptive rate: sample slowly while nothing moves ─────────────────────────
# Measured cost before this existed: 2.36% of a core and 115 i2c interrupts a
# second, forever, on a fanless machine whose accelerometers are usually
# reporting the same numbers they reported a second ago.

hinge_eval() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" "$@" <<'HINGEEVAL'
import importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader("hd", sys.argv[1])
spec = importlib.util.spec_from_loader("hd", loader)
mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
print(eval(sys.argv[2], {"mod": mod}))
HINGEEVAL
}

assert_out 'a still machine sleeps for the idle interval' '0.5' \
    hinge_eval 'mod.next_delay(False, 100.0, 0.0)[0]'
assert_out 'detected motion drops straight to the fast interval' '0.1' \
    hinge_eval 'mod.next_delay(True, 100.0, 0.0)[0]'
assert_out 'motion holds the fast rate for motion_hold_seconds afterwards' '0.1' \
    hinge_eval 'mod.next_delay(False, 101.0, 103.0)[0]'
assert_out 'once the hold expires the rate returns to idle' '0.5' \
    hinge_eval 'mod.next_delay(False, 104.0, 103.0)[0]'
assert_out 'motion while already fast extends the hold rather than resetting it' '106.0' \
    hinge_eval 'mod.next_delay(True, 103.0, 104.0)[1]'

# The thresholds have to sit above the measured noise floor, or the machine
# never sleeps - the same mistake that made three earlier thresholds in this
# project silently capture nothing.
assert_out 'the theta motion threshold clears the measured 7.77-degree noise ceiling' 'True' \
    hinge_eval 'mod.motion_theta_deg() > 7.77 * 2'
assert_out 'the rotation motion threshold clears the measured 0.65-degree ceiling' 'True' \
    hinge_eval 'mod.motion_rotation_deg() > 0.65 * 2'
# ...and below what real motion produces, or it never wakes up.
assert_out 'a fold-sized theta swing counts as motion' 'True' \
    hinge_eval 'mod.motion_theta_deg() < 100'
assert_out 'a quarter-turn counts as motion' 'True' \
    hinge_eval 'mod.motion_rotation_deg() < 90'
assert_out 'idle sampling is genuinely slower than active sampling' 'True' \
    hinge_eval 'mod.idle_poll_interval() > mod.poll_interval()'

# An unknown pose must NOT nap: with no full window there is no median to
# compare against, so nothing can be ruled still.
reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -317 100 976
assert_out 'a cold start with no baseline yet reports motion, staying fast' 'True' \
    hinge_eval 'mod.sample(__import__("collections").deque(maxlen=mod.window_size()), mod.RotationTracker())[1]'

# Threshold values being sensible is not the same as detection working. Settle
# a baseline, then move the hinge and confirm it is noticed on the very first
# sample - and that resting noise on the same baseline is not.
hinge_motion_probe() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" "$1" "$2" <<'MOTIONPROBE'
import collections, importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader("hd", sys.argv[1])
spec = importlib.util.spec_from_loader("hd", loader)
mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)

lid_path, base_path = sys.argv[2], sys.argv[3]
def write(path, x, y, z):
    for axis, val in zip("xyz", (x, y, z)):
        open(f"{path}/in_accel_{axis}_raw", "w").write(f"{int(val)}\n")

history = collections.deque(maxlen=mod.window_size())
tracker = mod.RotationTracker()
# Settle: a typing angle, held still, until both windows are full.
for _ in range(mod.window_size() + 2):
    write(lid_path, 1024, 100, 0); write(base_path, -317, 100, 976)
    mod.sample(history, tracker)
# Resting jitter, well inside the measured noise floor.
write(lid_path, 1022, 101, 3); write(base_path, -319, 99, 974)
print("jitter", mod.sample(history, tracker)[1])
# A fold: theta swings ~100 degrees.
write(lid_path, 1024, 100, 0); write(base_path, 1024, 100, -36)
print("fold", mod.sample(history, tracker)[1])
MOTIONPROBE
}

reset_daemon_state
MOTION_PROBE=$(hinge_motion_probe "$HINGE_LID" "$HINGE_BASE")
if [ "$MOTION_PROBE" = "$(printf 'jitter False\nfold True')" ]; then
    ok 'resting jitter is not motion, but folding is - on the first sample'
else
    bad "resting jitter is not motion, but folding is (got [$MOTION_PROBE])"
fi

# ── every mode change the daemon makes leaves a trace ────────────────────────
# This daemon disables the human's keyboard and rotates their display without
# being asked. When that went wrong in real use there was nothing to read
# afterwards, so the cause of an actual lockout could not be established at
# all. Logging is therefore part of the contract, not a debugging aid.

hinge_act() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" "$1" "$2" <<'HINGEACT'
import importlib.machinery, importlib.util, sys
path, action, theta = sys.argv[1], sys.argv[2], sys.argv[3]
loader = importlib.machinery.SourceFileLoader("hinge_daemon", path)
spec = importlib.util.spec_from_loader("hinge_daemon", loader)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
mod.act(action, None if theta == "none" else float(theta))
HINGEACT
}

HINGE_LOG="$XDG_STATE_HOME/gatherd/hinge-daemon.log"

reset_daemon_state
rm -f "$HINGE_LOG"
hinge_act enter 12.5
if grep -q 'enter theta=12.5' "$HINGE_LOG" 2>/dev/null; then
    ok 'entering tablet mode is logged with the theta that caused it'
else
    bad 'entering tablet mode is logged with the theta that caused it'
fi

hinge_act exit 72.0
if grep -q 'exit theta=72.0' "$HINGE_LOG" 2>/dev/null; then
    ok 'exiting tablet mode is logged with the theta that caused it'
else
    bad 'exiting tablet mode is logged with the theta that caused it'
fi
assert_out 'both mode changes are kept, not overwritten' '2' \
    sh -c 'grep -c . "$XDG_STATE_HOME/gatherd/hinge-daemon.log"'

# "hold" is the overwhelmingly common outcome (ten times a second, forever).
# Logging it would bury the two lines that matter in a hundred thousand.
hinge_act hold 40.0
assert_out 'a hold is not logged' '2' \
    sh -c 'grep -c . "$XDG_STATE_HOME/gatherd/hinge-daemon.log"'

# An unwritable log must never stop the daemon acting - least of all stop the
# exit that hands the keyboard back.
rm -f "$HINGE_LOG"
mkdir -p "$HINGE_LOG"
assert_ok 'an unwritable log does not stop the daemon exiting tablet mode' \
    hinge_act exit 72.0
rmdir "$HINGE_LOG"

# ── the degenerate pose: hinge axis parallel to gravity ──────────────────────
# Reading a score in portrait — x and z near zero on both sensors — carries
# no signal about the fold; the daemon must make no decision at all, not just
# a conservative one, and must not even touch gatherd-tablet-mode.

reset_daemon_state
write_vector "$HINGE_LID" 0 1024 0
write_vector "$HINGE_BASE" 0 1024 0
assert_out 'the degenerate pose reports no theta and no decision' \
    'theta=degenerate action=hold' hinge_print
assert_out 'the degenerate pose never calls gatherd-tablet-mode at all' '' cat "$FAKETM_LOG"

# ── unfolding always exits, however tablet mode was entered ──────────────────
# This replaces an ownership rule that let the daemon exit ONLY sessions it
# had entered itself. That rule turned unfolding into a no-op for any other
# session, leaving the edge power button as the single escape from a machine
# with no keyboard — and when that button showed the wrong menu, there was no
# way out at all short of a hard reboot. Unfolding is physical, obvious and
# always available; it must always work.

reset_daemon_state
mkdir -p "$XDG_RUNTIME_DIR/gatherd"
gatherd-tablet-mode on >/dev/null 2>&1
# Deliberately NOT entered by the daemon: nothing records who started this.
: > "$FAKETM_LOG"
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -317 100 976
assert_out 'unfolding to a typing angle exits a session the daemon did not start' \
    'theta=108.0 action=exit' hinge_print
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── thresholds are overridable ───────────────────────────────────────────────
# Required by spec: enter/exit must be tunable via environment variables
# without editing code. Raising GATHERD_HINGE_ENTER above the tent pose's
# theta proves the override is actually read, not just accepted and ignored.

reset_daemon_state
GATHERD_HINGE_ENTER=100
export GATHERD_HINGE_ENTER
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -36 100 -1023
assert_out 'a raised GATHERD_HINGE_ENTER makes the tent pose cross the threshold' \
    'theta=92.0 action=enter' hinge_print
unset GATHERD_HINGE_ENTER
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── thresholds are configurable via tablet-mode.conf ─────────────────────────
# The daemon shares gatherd-tablet-mode's config file rather than inventing
# its own. fold_enter_deg/fold_exit_deg must be read from it, an env var
# override must still win over it, and a malformed file must not crash the
# daemon - just fall back to the built-in defaults.

reset_daemon_state
printf 'transform=180\nfold_enter_deg=100\n' > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -36 100 -1023
assert_out 'a config-file fold_enter_deg makes the tent pose cross the threshold' \
    'theta=92.0 action=enter' hinge_print

reset_daemon_state
GATHERD_HINGE_ENTER=10
export GATHERD_HINGE_ENTER
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -36 100 -1023
assert_out 'GATHERD_HINGE_ENTER still overrides a config-file fold_enter_deg' \
    'theta=92.0 action=hold' hinge_print
unset GATHERD_HINGE_ENTER

reset_daemon_state
printf 'this is not a key=value config\nfold_enter_deg\n=200\n' \
    > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 1023 100 -36
assert_out 'a malformed config file falls back to the default enter threshold' \
    'theta=2.0 action=enter' hinge_print

rm -f "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── poll_interval and median_window are configurable via tablet-mode.conf ────
# These are read exactly like fold_enter_deg/fold_exit_deg above (env
# overrides config overrides built-in default, malformed input falls back
# silently) - but neither is observable through --print's decision output,
# so introspect the two accessor functions directly rather than through a
# behavioral proxy.
hinge_timing() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" "$1" <<'PY'
import importlib.machinery, importlib.util, sys
path, which = sys.argv[1], sys.argv[2]
loader = importlib.machinery.SourceFileLoader("hinge_daemon", path)
spec = importlib.util.spec_from_loader("hinge_daemon", loader)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
print(mod.poll_interval() if which == "poll_interval" else mod.window_size())
PY
}

reset_daemon_state
printf 'transform=180\npoll_interval=0.25\nmedian_window=7\n' \
    > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
assert_out 'a config-file poll_interval is read' '0.25' hinge_timing poll_interval
assert_out 'a config-file median_window is read' '7' hinge_timing window_size

GATHERD_HINGE_POLL_INTERVAL=0.05
GATHERD_HINGE_WINDOW=3
export GATHERD_HINGE_POLL_INTERVAL GATHERD_HINGE_WINDOW
assert_out 'GATHERD_HINGE_POLL_INTERVAL still overrides a config-file poll_interval' \
    '0.05' hinge_timing poll_interval
assert_out 'GATHERD_HINGE_WINDOW still overrides a config-file median_window' \
    '3' hinge_timing window_size
unset GATHERD_HINGE_POLL_INTERVAL GATHERD_HINGE_WINDOW

rm -f "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
assert_out 'a missing config file falls back to the default poll_interval' \
    '0.1' hinge_timing poll_interval
assert_out 'a missing config file falls back to the default median_window' \
    '5' hinge_timing window_size

printf 'transform=180\npoll_interval=not-a-number\nmedian_window=not-a-number\n' \
    > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
assert_out 'a malformed poll_interval falls back to the default without crashing' \
    '0.1' hinge_timing poll_interval
assert_out 'a malformed median_window falls back to the default without crashing' \
    '5' hinge_timing window_size

rm -f "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── auto-rotation ──────────────────────────────────────────────────────────
# Follows the tablet in the human's hands while folded. Reuses the same lid
# sensor already read for fold detection - no extra I2C - so the geometry,
# hysteresis and flat-pose helpers below are exercised as pure functions via
# the same importlib technique hinge_timing uses, rather than through
# --print (a fresh process per call, unable to show hysteresis/persistence
# across samples, and whose existing exact-string tests above must not gain
# a rotation field).

# rotation_probe: one ANGLE arg per sample, each an atan2(y,x) angle in
# DEGREES - the same units the calibration table's middle column is in.
# Prints the committed transform after each update() on a single tracker, so
# several args can exercise persistence across samples. Samples are passed
# as argv, not piped stdin: `python3 -` reads the SCRIPT itself from stdin
# (that is what the heredoc below is), which consumes it entirely before
# execution starts - a `for line in sys.stdin` inside the script would
# always see EOF immediately.
rotation_probe() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" "$@" <<'PY'
import importlib.machinery, importlib.util, math, sys
path = sys.argv[1]
loader = importlib.machinery.SourceFileLoader("hinge_daemon", path)
spec = importlib.util.spec_from_loader("hinge_daemon", loader)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
tracker = mod.RotationTracker()
for arg in sys.argv[2:]:
    angle = math.radians(float(arg))
    tracker.update((math.cos(angle), math.sin(angle), 0.0))
    print(tracker.transform())
PY
}

rotation_probe_one() { rotation_probe "$1"; }

# rotation_probe_target: one ROTATION-degree value per arg (not atan2) - the
# angle already run through rotation_deg()'s reference-angle subtraction.
# Used for the pure hysteresis/persistence tests below, which care about
# distance from a 45-degree boundary, not about the reference angle's exact
# value. See rotation_probe's comment for why args, not piped stdin.
rotation_probe_target() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" "$@" <<'PY'
import importlib.machinery, importlib.util, math, sys
path = sys.argv[1]
loader = importlib.machinery.SourceFileLoader("hinge_daemon", path)
spec = importlib.util.spec_from_loader("hinge_daemon", loader)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
tracker = mod.RotationTracker()
for arg in sys.argv[2:]:
    target = float(arg)
    angle = math.radians(mod.rotation_reference_deg() - target)
    tracker.update((math.cos(angle), math.sin(angle), 0.0))
    print(tracker.transform())
PY
}

rotation_reference() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" <<'PY'
import importlib.machinery, importlib.util, sys
path = sys.argv[1]
loader = importlib.machinery.SourceFileLoader("hinge_daemon", path)
spec = importlib.util.spec_from_loader("hinge_daemon", loader)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
print(mod.rotation_reference_deg())
PY
}

# ── the measured captures (calibration table) ────────────────────────────────
# Reference angle 267.0 - the atan2 reading in the PORTRAIT score-reading
# pose, which is the pose that must map to transform `normal`. The four raw
# captures below were all taken in the LANDSCAPE (open-laptop) orientation,
# 90 degrees off portrait; calling capture 1 "the reading position" is what
# put an earlier reference at 177.0 and every quadrant 90 degrees out.
# Three of the four are directly measured; the remaining quadrant was never
# captured (the human's sweep skipped one), so it is INFERRED from the linear
# fit - included anyway because the mapping (rotation -> nearest-quadrant
# transform) must still be right for it, and the daemon's own header should
# say so, which is checked separately below.
#
# An open laptop rests in landscape, i.e. at transform 90 - which is exactly
# what capture 1 yields here, and is the independent check that these labels
# are now the right way round.

assert_out 'the measured landscape/laptop pose (atan2=177.0) maps to transform 90' \
    '90' rotation_probe_one 177.0
assert_out 'the measured 180-turn (atan2=2.8) maps to transform 270' \
    '270' rotation_probe_one 2.8
assert_out 'the measured 270-turn (atan2=-94.1) maps to transform normal' \
    'normal' rotation_probe_one -94.1
assert_out 'the measured return-to-start (atan2=179.3) maps to transform 90' \
    '90' rotation_probe_one 179.3
assert_out 'the INFERRED quadrant (atan2=87.0, never captured) maps to transform 180' \
    '180' rotation_probe_one 87.0

# The portrait reading pose is the whole point of the reference: it is what
# gatherd-tablet-mode sets on entry and what the human reads music at, so it
# must come out as `normal` or auto-rotation fights the entry transform.
assert_out 'the portrait reading pose (atan2=267.0, the reference itself) maps to transform normal' \
    'normal' rotation_probe_one 267.0

if grep -qi 'inferred' "$REPO/scripts/gatherd-hinge-daemon"; then
    ok 'the daemon documents the uncaptured quadrant as inferred, not measured'
else
    bad 'the daemon documents the uncaptured quadrant as inferred, not measured'
fi

# ── the flat pose: gravity along the screen normal ───────────────────────────
# x and y (the screen plane) vanish and "down" is undefined - the tracker
# must hold whatever it last committed, not flip to some arbitrary angle.

FLAT_SEQUENCE=$(python3 - "$REPO/scripts/gatherd-hinge-daemon" <<'PY'
import importlib.machinery, importlib.util, math, sys
path = sys.argv[1]
loader = importlib.machinery.SourceFileLoader("hinge_daemon", path)
spec = importlib.util.spec_from_loader("hinge_daemon", loader)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
tracker = mod.RotationTracker()
angle = math.radians(177.0)
tracker.update((math.cos(angle), math.sin(angle), 0.0))
print(tracker.transform())
tracker.update((0.0, 0.0, 1024.0))
print(tracker.transform())
PY
)
if [ "$FLAT_SEQUENCE" = "$(printf '90\n90')" ]; then
    ok 'a flat pose holds the previously committed transform instead of flipping'
else
    bad "a flat pose holds the previously committed transform instead of flipping (got [$FLAT_SEQUENCE])"
fi

# ── hysteresis and persistence at the quadrant boundaries ────────────────────
# 45 is the naive boundary between normal (0) and 90. A held-near-boundary
# reading must not flap; a decisive, PERSISTENT excursion must still commit.
# GATHERD_HINGE_WINDOW=1 isolates the margin/persistence logic on its own -
# with the default window of 5, the median-over-samples smoothing already
# damps these sequences, which would test that smoothing a second time
# rather than the hysteresis mechanism this section is actually about.

GATHERD_HINGE_WINDOW=1
export GATHERD_HINGE_WINDOW

BOUNDARY_SEQUENCE=$(rotation_probe_target 0 43 47 43 47 43)
if [ "$(printf '%s' "$BOUNDARY_SEQUENCE" | sort -u)" = normal ]; then
    ok 'oscillating near the 45-degree boundary never flips the transform'
else
    bad "oscillating near the 45-degree boundary never flips the transform (got [$BOUNDARY_SEQUENCE])"
fi

PERSIST_SEQUENCE=$(rotation_probe_target 0 70 70 70)
assert_out 'a decisive excursion past the boundary holds until it persists, then commits' \
    "$(printf 'normal\nnormal\nnormal\n90')" printf '%s' "$PERSIST_SEQUENCE"

FLAP_RESIST_SEQUENCE=$(rotation_probe_target 0 70 200 70 200)
if [ "$(printf '%s' "$FLAP_RESIST_SEQUENCE" | sort -u)" = normal ]; then
    ok 'a challenger that keeps changing never accumulates enough persistence to commit'
else
    bad "a challenger that keeps changing never accumulates enough persistence to commit (got [$FLAP_RESIST_SEQUENCE])"
fi

unset GATHERD_HINGE_WINDOW

# ── rotation_reference_deg is configurable via tablet-mode.conf ─────────────
# Same tolerant read (env overrides config overrides built-in default,
# malformed input falls back silently) as fold_enter_deg/poll_interval
# above - required so re-calibrating on different hardware is a config edit,
# never a code change.

rm -f "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
assert_out 'a missing config file falls back to the default rotation reference' \
    '267.0' rotation_reference

printf 'transform=180\nrotation_reference_deg=90.5\n' \
    > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
assert_out 'a config-file rotation_reference_deg is read' '90.5' rotation_reference

GATHERD_HINGE_ROTATION_REFERENCE=12.0
export GATHERD_HINGE_ROTATION_REFERENCE
assert_out 'GATHERD_HINGE_ROTATION_REFERENCE still overrides a config-file rotation_reference_deg' \
    '12.0' rotation_reference
unset GATHERD_HINGE_ROTATION_REFERENCE

printf 'rotation_reference_deg=not-a-number\n' \
    > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
assert_out 'a malformed rotation_reference_deg falls back to the default without crashing' \
    '267.0' rotation_reference

rm -f "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"

# ── integration: rotation only ever calls swaymsg, gated on tablet mode ─────
# Exercised against the REAL gatherd-tablet-mode (not the fake used above)
# and the real swaymsg fake installed at the top of this file, so the
# state-file property is proven against the actual record-then-restore
# code, not a stand-in for it. Placed last in this section so nothing after
# it needs the gatherd-tablet-mode fake restored.
rm -f "$FAKEBIN/gatherd-tablet-mode"
hash -r

poll_rotation_once() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" <<'PY'
import collections, importlib.machinery, importlib.util, sys
path = sys.argv[1]
loader = importlib.machinery.SourceFileLoader("hinge_daemon", path)
spec = importlib.util.spec_from_loader("hinge_daemon", loader)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
history = collections.deque(maxlen=mod.window_size())
tracker = mod.RotationTracker()
mod.poll_once(history, tracker)
PY
}

# Rotation in isolation: the fold trigger is pinned OFF for this whole block
# by putting both thresholds out of reach, so a lid vector chosen for the
# rotation it produces cannot also enter or exit tablet mode as a side effect.
# This used to lean on the ownership rule to block "exit"; with that rule gone,
# the pinning has to be explicit rather than a happy consequence of unrelated
# state. decide()'s own thresholds are exercised on their own terms earlier in
# this section.
GATHERD_HINGE_ENTER=-1
GATHERD_HINGE_EXIT=999
export GATHERD_HINGE_ENTER GATHERD_HINGE_EXIT
write_vector "$HINGE_BASE" -317 100 976

reset_log
rm -f "$XDG_RUNTIME_DIR/gatherd/tablet-mode"
printf 'untouched' > "$WORK/transform"
write_vector "$HINGE_LID" -1023 54 0
poll_rotation_once
assert_out 'rotation issues no swaymsg call while tablet mode is inactive' \
    'untouched' cat "$WORK/transform"
if log_has 'output DSI-1 transform'; then
    bad 'rotation never rotates an unfolded (tablet-mode-inactive) laptop'
else
    ok 'rotation never rotates an unfolded (tablet-mode-inactive) laptop'
fi

printf '90' > "$WORK/transform"
reset_log
gatherd-tablet-mode on >/dev/null 2>&1
assert_out 'the resting transform recorded at entry is 90' \
    '90' cat "$XDG_RUNTIME_DIR/gatherd/tablet-mode"

# atan2(-1022, -54) = 267.0 - the reference itself, i.e. the portrait
# score-reading pose. This is the assertion that an earlier reference of
# 177.0 got wrong: it applied 270 here, leaving the display a quarter turn
# anticlockwise of what the human was holding.
write_vector "$HINGE_LID" -54 -1022 0
poll_rotation_once
assert_out 'rotation applies transform normal for the portrait reading pose' \
    'normal' cat "$WORK/transform"

# atan2(54, -1023) = 177.0 - the landscape/laptop pose, a quarter turn off
# the one above, so this both proves rotation is actually acting and pins
# the direction: landscape is transform 90, not 270.
write_vector "$HINGE_LID" -1023 54 0
poll_rotation_once
assert_out 'rotation applies transform 90 for the landscape pose, proving it is actually acting' \
    '90' cat "$WORK/transform"

# The toggle has to stop the daemon rotating, not merely relabel a menu entry.
gatherd-tablet-mode rotation-off
printf 'sentinel' > "$WORK/transform"
reset_log
write_vector "$HINGE_LID" -1023 54 0
poll_rotation_once
assert_out 'rotation off issues no transform at all' 'sentinel' cat "$WORK/transform"
if log_has 'output DSI-1 transform'; then
    bad 'rotation off makes no swaymsg call'
else
    ok 'rotation off makes no swaymsg call'
fi
gatherd-tablet-mode rotation-on
poll_rotation_once
assert_out 'turning rotation back on resumes from the current pose' \
    '90' cat "$WORK/transform"

printf '90' > "$WORK/transform"
assert_out 'the recorded resting transform is untouched by rotation while folded' \
    '90' cat "$XDG_RUNTIME_DIR/gatherd/tablet-mode"

gatherd-tablet-mode off >/dev/null 2>&1
assert_out 'exiting restores the ORIGINAL resting transform, not the last rotation' \
    '90' cat "$WORK/transform"

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
