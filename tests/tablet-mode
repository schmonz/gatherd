# ── gatherd-hinge-daemon ──────────────────────────────────────────────────────
# Fakes gatherd-tablet-mode itself (rather than reusing the real script's
# swaymsg fake) so these tests exercise only the daemon's decision logic —
# geometry, the lid gate, hysteresis, the degenerate pose, and ownership —
# without also depending on the compositor plumbing already covered above.

# fake_bin NAME BODY — install a fake executable that shadows the real one.
# Matches tests/icloud's helper; tests/tablet-mode had not needed it until now.
fake_bin() {
    printf '#!/bin/sh\n%s\n' "$2" > "$FAKEBIN/$1"
    chmod +x "$FAKEBIN/$1"
}

FAKETM_STATE="$WORK/faketm-state"
FAKETM_LOG="$WORK/faketm.log"
fake_bin gatherd-tablet-mode '
printf "%s\n" "$*" >> "'"$FAKETM_LOG"'"
case "$1" in
    on)     touch "'"$FAKETM_STATE"'" ;;
    off)    rm -f "'"$FAKETM_STATE"'" ;;
    status) [ -f "'"$FAKETM_STATE"'" ] ;;
    *)      exit 2 ;;
esac
'
# Every earlier section in this suite already invoked the real
# gatherd-tablet-mode directly (not through a subprocess), so bash has this
# command name hashed to $REPO/scripts/gatherd-tablet-mode. Prepending FAKEBIN
# to $PATH does not by itself invalidate that cache — only `hash -r` does —
# so without this, every direct call below silently keeps hitting the real
# script while only gatherd-hinge-daemon's own subprocess calls (a fresh
# process, with its own PATH search) would see the fake.
hash -r

HINGE_LID="$WORK/hinge-lid"
HINGE_BASE="$WORK/hinge-base"
HINGE_LID_STATE="$WORK/hinge-lid-state"
GATHERD_HINGE_LID_DEVICE="$HINGE_LID"
GATHERD_HINGE_BASE_DEVICE="$HINGE_BASE"
GATHERD_HINGE_LID_STATE="$HINGE_LID_STATE"
export GATHERD_HINGE_LID_DEVICE GATHERD_HINGE_BASE_DEVICE GATHERD_HINGE_LID_STATE
unset GATHERD_HINGE_ENTER GATHERD_HINGE_EXIT

# write_vector DIR X Y Z — plants raw sysfs-style accelerometer counts.
write_vector() {
    mkdir -p "$1"
    printf '%s\n' "$2" > "$1/in_accel_x_raw"
    printf '%s\n' "$3" > "$1/in_accel_y_raw"
    printf '%s\n' "$4" > "$1/in_accel_z_raw"
}

# write_lid_state open|closed — mimics /proc/acpi/button/lid/LID0/state's format.
write_lid_state() {
    printf 'state:      %s\n' "$1" > "$HINGE_LID_STATE"
}

# Every fixture below shares the same lid vector and varies only the base
# vector's rotation about the hinge (y) axis, so each row isolates exactly
# the signed-angle geometry under test. Raw counts precomputed offline from
# the atan2 formula the script implements (theta itself, no further
# transform); each was checked to round-trip to its target theta to within
# 0.02 degrees before being baked in here, so a passing assertion means the
# formula, not the fixture, is right. Lid defaults to open on every reset -
# tests that care about the closed lid set it explicitly.
reset_daemon_state() {
    rm -f "$FAKETM_STATE" "$XDG_RUNTIME_DIR/gatherd/hinge-daemon-owns"
    : > "$FAKETM_LOG"
    write_lid_state open
}

hinge_print() {
    gatherd-hinge-daemon --print
}

# ── the measured poses ────────────────────────────────────────────────────────
# theta is the hinge angle itself (atan2-wrapped to +-180), not "180 - theta":
# typing reads ~108, flat reads ~178, a part-folded tent reads ~-92, and fully
# folded reads ~-2. All four are exercised here so the corrected geometry, not
# just the corrected threshold, is under test.

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -920 100 449
assert_out 'a part-open tent reads theta near 154, well clear of the fold band' \
    'theta=154.0 action=hold' hinge_print

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -317 100 976
assert_out 'typing angle reads theta near 108 and does not enter' \
    'theta=108.0 action=hold' hinge_print

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -1026 100 36
assert_out 'flat reads theta near 178 and does not enter' \
    'theta=178.0 action=hold' hinge_print

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -36 100 -1023
assert_out 'a part-folded tent reads theta near 92 and does not enter' \
    'theta=92.0 action=hold' hinge_print
assert_fail 'the tent pose alone never turns tablet mode on' gatherd-tablet-mode status

# ── the fully folded pose and the lid gate ───────────────────────────────────
# theta near -2 is what a shut lid ALSO reads (atan2 wraps at +-180, not at
# zero) - the lid switch is what tells the two apart. This is the fix itself.

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 1023 100 -36
assert_out 'folded (theta near -2) with the lid open reports the enter decision' \
    'theta=2.0 action=enter' hinge_print
# --print is diagnostic only: it must report the decision it would take and
# then do nothing. This is the exact fixture that used to make --print
# itself rotate the display and disable the keyboard. The log legitimately
# holds a "status" call (decide()'s own read of the current state) - only
# "on" would prove --print acted.
if grep -qx on "$FAKETM_LOG"; then
    bad '--print issues no gatherd-tablet-mode on/off command, even for a decision that would act'
else
    ok '--print issues no gatherd-tablet-mode on/off command, even for a decision that would act'
fi
assert_fail '--print alone never turns tablet mode on' gatherd-tablet-mode status

reset_daemon_state
write_lid_state closed
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 1023 100 -36
assert_out 'the same theta with the lid closed does not enter' \
    'theta=2.0 action=hold' hinge_print
assert_fail 'a closed lid never turns tablet mode on' gatherd-tablet-mode status

reset_daemon_state
rm -f "$HINGE_LID_STATE"
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 1023 100 -36
assert_out 'an unreadable lid file is treated as not open and does not enter' \
    'theta=2.0 action=hold' hinge_print
assert_fail 'an unreadable lid file never turns tablet mode on' gatherd-tablet-mode status

# ── hysteresis: a theta between the thresholds changes nothing ──────────────
# 40 sits between the default fold_exit (50) and fold_enter (30) thresholds.
# Tested from both sides of the dead zone: falling from inactive must not
# enter, and rising from an owned-active state must not exit either.

reset_daemon_state
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 784 100 658
assert_out 'a mid-band theta does not enter from inactive' 'theta=40.0 action=hold' hinge_print
assert_fail 'still inactive after a mid-band reading' gatherd-tablet-mode status

reset_daemon_state
mkdir -p "$XDG_RUNTIME_DIR/gatherd"
gatherd-tablet-mode on >/dev/null 2>&1
: > "$XDG_RUNTIME_DIR/gatherd/hinge-daemon-owns"
: > "$FAKETM_LOG"
assert_out 'a mid-band theta does not exit from an owned-active state' \
    'theta=40.0 action=hold' hinge_print
assert_ok 'still active after a mid-band reading' gatherd-tablet-mode status
# The log legitimately holds "status" calls (the daemon's own state check,
# plus this test's direct one above) — only "off" would prove the bug.
if grep -qx off "$FAKETM_LOG"; then
    bad 'no off call was logged for the mid-band reading'
else
    ok 'no off call was logged for the mid-band reading'
fi

# ── the degenerate pose: hinge axis parallel to gravity ──────────────────────
# Reading a score in portrait — x and z near zero on both sensors — carries
# no signal about the fold; the daemon must make no decision at all, not just
# a conservative one, and must not even touch gatherd-tablet-mode.

reset_daemon_state
write_vector "$HINGE_LID" 0 1024 0
write_vector "$HINGE_BASE" 0 1024 0
assert_out 'the degenerate pose reports no theta and no decision' \
    'theta=degenerate action=hold' hinge_print
assert_out 'the degenerate pose never calls gatherd-tablet-mode at all' '' cat "$FAKETM_LOG"

# ── the ownership rule ────────────────────────────────────────────────────────
# The human's real workflow: trigger tablet mode manually, then fold to flat.
# At that moment theta is well above fold_exit — the exact case that must not
# flap the mode back off, because the daemon never turned this session on.

reset_daemon_state
mkdir -p "$XDG_RUNTIME_DIR/gatherd"
gatherd-tablet-mode on >/dev/null 2>&1
# Deliberately no hinge-daemon-owns marker: this session was started manually.
: > "$FAKETM_LOG"
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -317 100 976
assert_out 'a manually-started session at typing angle is left alone' \
    'theta=108.0 action=hold' hinge_print
assert_ok 'a manually-started tablet mode is still active afterward' gatherd-tablet-mode status
# Same reasoning as the mid-band case above: "status" calls are expected;
# only "off" would mean the ownership rule was violated.
if grep -qx off "$FAKETM_LOG"; then
    bad 'the daemon never issued an off call against a session it does not own'
else
    ok 'the daemon never issued an off call against a session it does not own'
fi
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── thresholds are overridable ───────────────────────────────────────────────
# Required by spec: enter/exit must be tunable via environment variables
# without editing code. Raising GATHERD_HINGE_ENTER above the tent pose's
# theta proves the override is actually read, not just accepted and ignored.

reset_daemon_state
GATHERD_HINGE_ENTER=100
export GATHERD_HINGE_ENTER
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -36 100 -1023
assert_out 'a raised GATHERD_HINGE_ENTER makes the tent pose cross the threshold' \
    'theta=92.0 action=enter' hinge_print
unset GATHERD_HINGE_ENTER
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── thresholds are configurable via tablet-mode.conf ─────────────────────────
# The daemon shares gatherd-tablet-mode's config file rather than inventing
# its own. fold_enter_deg/fold_exit_deg must be read from it, an env var
# override must still win over it, and a malformed file must not crash the
# daemon - just fall back to the built-in defaults.

reset_daemon_state
printf 'transform=180\nfold_enter_deg=100\n' > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -36 100 -1023
assert_out 'a config-file fold_enter_deg makes the tent pose cross the threshold' \
    'theta=92.0 action=enter' hinge_print

reset_daemon_state
GATHERD_HINGE_ENTER=10
export GATHERD_HINGE_ENTER
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" -36 100 -1023
assert_out 'GATHERD_HINGE_ENTER still overrides a config-file fold_enter_deg' \
    'theta=92.0 action=hold' hinge_print
unset GATHERD_HINGE_ENTER

reset_daemon_state
printf 'this is not a key=value config\nfold_enter_deg\n=200\n' \
    > "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
write_vector "$HINGE_LID" 1024 100 0
write_vector "$HINGE_BASE" 1023 100 -36
assert_out 'a malformed config file falls back to the default enter threshold' \
    'theta=2.0 action=enter' hinge_print

rm -f "$XDG_CONFIG_HOME/gatherd/tablet-mode.conf"
gatherd-tablet-mode off >/dev/null 2>&1 || true

# ── poll_interval and median_window are configurable via tablet-mode.conf ────
# These are read exactly like fold_enter_deg/fold_exit_deg above (env
# overrides config overrides built-in default, malformed input falls back
# silently) - but neither is observable through --print's decision output,
# so introspect the two accessor functions directly rather than through a
# behavioral proxy.
hinge_timing() {
    python3 - "$REPO/scripts/gatherd-hinge-daemon" "$1" <<'PY'
import importlib.machinery, importlib.util, sys
path, which = sys.argv[1], sys.argv[2]
loader = importlib.machinery.SourceFileLoader("hinge_daemon", path)
spec = importlib.util.spec_from_loader("hinge_daemon", loader)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
print(mod.poll_interval() if which == "poll_interval" else mod.window_size())
PY
}

reset_daemon_state
