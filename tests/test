#!/usr/bin/env bash
# Boot a fresh EOS Sway snapshot under QEMU, run the gatherd playbook,
# then run it again and assert the second run produces no changes.
#
# Requires tests/create-base to have been run on this machine first.
# Files are read from GATHERD_VM_DIR (default: ~/.local/share/gatherd).
set -euo pipefail

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
VM_DIR="${GATHERD_VM_DIR:-$HOME/.local/share/gatherd}"
BASE="$VM_DIR/eos-base.qcow2"
DISK="$VM_DIR/test.qcow2"
KEY="$VM_DIR/key"
PORT=2225
QEMU_PID=""

cleanup() {
    [[ -n "$QEMU_PID" ]] && kill "$QEMU_PID" 2>/dev/null || true
    rm -f "$DISK"
}
trap cleanup EXIT

ping -c1 -W1 ap-juicer.local &>/dev/null \
    || { echo "ap-juicer.local not reachable — run tests/test only when local to the NFS host" >&2; exit 1; }

[[ -f "$BASE" ]] || {
    echo "Base image not found: $BASE" >&2
    echo "Run: tests/create-base /path/to/EndeavourOS.iso" >&2
    echo "(Override location with: GATHERD_VM_DIR=/path tests/create-base ...)" >&2
    exit 1
}
[[ -f "$KEY" ]] || {
    echo "SSH key not found: $KEY" >&2
    echo "Run: tests/create-base /path/to/EndeavourOS.iso" >&2
    exit 1
}

# ── Fresh snapshot ────────────────────────────────────────────────────────────

qemu-img create -f qcow2 -b "$BASE" -F qcow2 "$DISK"

# ── Boot ──────────────────────────────────────────────────────────────────────

qemu-system-x86_64 \
    -enable-kvm -m 4096 -smp 2 \
    -drive "file=$DISK,if=virtio,format=qcow2" \
    -net nic,model=virtio \
    -net "user,hostfwd=tcp::${PORT}-:22" \
    -nographic </dev/null &
QEMU_PID=$!

SSH=(ssh -p "$PORT" -i "$KEY"
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o ConnectTimeout=3
    -o BatchMode=yes
    root@localhost)

echo "Waiting for SSH..."
until "${SSH[@]}" true 2>/dev/null; do sleep 3; done

# ── Install ansible and deploy repo ──────────────────────────────────────────

for attempt in 1 2 3 4 5; do
    "${SSH[@]}" rm -rf /var/lib/pacman/sync/
    if "${SSH[@]}" pacman -Syu --noconfirm ansible; then
        break
    elif [[ $attempt -lt 5 ]]; then
        echo "pacman attempt $attempt failed, retrying in 10s..."
        sleep 10
    else
        echo "pacman failed after 5 attempts" >&2
        exit 1
    fi
done

"${SSH[@]}" mkdir -p /usr/local/lib/gatherd
tar -C "$REPO" --exclude='.git' --exclude='tests' -c . \
    | "${SSH[@]}" tar -xC /usr/local/lib/gatherd

"${SSH[@]}" "printf 'changeme\n' > /usr/local/lib/gatherd/.vault_pass"
"${SSH[@]}" ansible-galaxy collection install \
    -r /usr/local/lib/gatherd/requirements.yml

# ── Run 1 ─────────────────────────────────────────────────────────────────────

echo "=== Run 1 ==="
"${SSH[@]}" "cd /usr/local/lib/gatherd && ansible-playbook site.yml"

# ── Run 2: idempotency check ──────────────────────────────────────────────────

echo "=== Run 2 (idempotency check) ==="
run2_log=$(mktemp)
"${SSH[@]}" "cd /usr/local/lib/gatherd && ansible-playbook site.yml" | tee "$run2_log"

if grep -qE 'changed=0[[:space:]].*failed=0' "$run2_log"; then
    echo "PASS: idempotent"
else
    echo "FAIL: second run has unexpected changes or failures"
    exit 1
fi
