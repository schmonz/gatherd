#!/usr/bin/env bash
# Boot a fresh EOS Sway snapshot under QEMU, run the gatherd playbook,
# then run it again and assert the second run produces no changes.
#
# Requires tests/create-base to have been run on this machine first.
# Files are read from GATHERD_VM_DIR (default: ~/.local/share/gatherd).
set -euo pipefail

TESTSDIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$TESTSDIR/.." && pwd)"
VM_DIR="${GATHERD_VM_DIR:-$HOME/.local/share/gatherd}"
BASE="$VM_DIR/eos-base.qcow2"
DISK="$VM_DIR/test.qcow2"
KEY="$VM_DIR/key"
PORT=2225
QEMU_PID=""

cleanup() {
    [[ -n "$QEMU_PID" ]] && kill "$QEMU_PID" 2>/dev/null || true
    rm -f "$DISK"
}
trap cleanup EXIT

ping -c1 -W1 ap-juicer.local &>/dev/null \
    || { echo "ap-juicer.local not reachable — run tests/test only when local to the NFS host" >&2; exit 1; }

[[ -f "$BASE" ]] || {
    echo "Base image not found: $BASE" >&2
    echo "Run: tests/create-base /path/to/EndeavourOS.iso" >&2
    echo "(Override location with: GATHERD_VM_DIR=/path tests/create-base ...)" >&2
    exit 1
}
[[ -f "$KEY" ]] || {
    echo "SSH key not found: $KEY" >&2
    echo "Run: tests/create-base /path/to/EndeavourOS.iso" >&2
    exit 1
}

# ── Fresh snapshot ────────────────────────────────────────────────────────────

qemu-img create -f qcow2 -b "$BASE" -F qcow2 "$DISK"

# ── Boot ──────────────────────────────────────────────────────────────────────

qemu-system-x86_64 \
    -enable-kvm -m 4096 -smp 2 \
    -drive "file=$DISK,if=virtio,format=qcow2" \
    -net nic,model=virtio \
    -net "user,hostfwd=tcp::${PORT}-:22" \
    -nographic </dev/null &
QEMU_PID=$!

SSH=(ssh -p "$PORT" -i "$KEY"
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o ConnectTimeout=3
    -o BatchMode=yes
    root@localhost)

echo "Waiting for SSH..."
until "${SSH[@]}" true 2>/dev/null; do sleep 3; done

# ── Install ansible and deploy repo ──────────────────────────────────────────

for attempt in 1 2 3 4 5; do
    "${SSH[@]}" rm -rf /var/lib/pacman/sync/
    if "${SSH[@]}" pacman -Syu --noconfirm ansible; then
        break
    elif [[ $attempt -lt 5 ]]; then
        echo "pacman attempt $attempt failed, retrying in 10s..."
        sleep 10
    else
        echo "pacman failed after 5 attempts" >&2
        exit 1
    fi
done

"${SSH[@]}" 'sed -i "s/-fLC - --retry/-fLC - --max-time 120 --retry/g" /etc/makepkg.conf'

"${SSH[@]}" mkdir -p /usr/local/lib/gatherd
# .git ships deliberately: postinstall gives a real machine the repo by cloning
# it, and site-core.yml's "Read deployed git HEAD" runs git rev-parse against
# that clone to stamp /etc/gatherd/core-complete. Excluding .git made the CORE
# play fail under any_errors_fatal, so this test could not get past it from
# 70edd16 (2026-05-28) until the exclusion was dropped. Costs ~6 MiB packed.
# --no-same-owner because tar extracting as root would otherwise restore the
# archive's uid, leaving the tree owned by the host user. git then refuses with
# "detected dubious ownership" (rc 128) and CORE's any_errors_fatal ends the
# play. postinstall clones as root on a real machine, so root-owned is what this
# is modelling.
tar -C "$REPO" --exclude='tests' -c . \
    | "${SSH[@]}" tar --no-same-owner -xC /usr/local/lib/gatherd

"${SSH[@]}" "printf 'changeme\n' > /usr/local/lib/gatherd/.vault_pass"
"${SSH[@]}" ansible-galaxy collection install --no-cache \
    -r /usr/local/lib/gatherd/requirements.yml

# ── Run 1 ─────────────────────────────────────────────────────────────────────

echo "=== Run 1 ==="
# Both tiers, in boot order: CORE gates the greeter, REST converges post-login.
"${SSH[@]}" "cd /usr/local/lib/gatherd && ansible-playbook -e sway_guard_override=true site-core.yml site-async.yml"

# ── Health assertions ─────────────────────────────────────────────────────────
#
# Run 1 exiting 0 is not the same as run 1 leaving a working machine, and the
# idempotency check below cannot tell the difference: it compares run 2 against
# run 1, so anything both runs get wrong is invisible to it. This is where an
# invariant that must hold AFTER a converge gets checked directly, rather than
# inferred from some later task happening to work.
#
# First member: pacman must still be able to prepare a transaction. Registering
# a repository in /etc/pacman.conf without downloading its database wedges every
# subsequent `pacman -S`, whatever the package, with "failed to prepare
# transaction (could not find database)". That shipped and reached a real
# machine, because the first task to trip over it was gated on
# `has_screen_backlight` -- and this VM has no backlight, so neither run touched
# it while every path they did take passed `update_cache:` and silently repaired
# the state on the way past.
echo "=== Health assertions ==="

health_rc=0
"${SSH[@]}" sh -s <<'REMOTE' || health_rc=$?
set -u
if pacman -Sp --print-format '%n' bash >/dev/null 2>/tmp/gatherd-pacman-check; then
    exit 0
fi
echo "pacman cannot prepare a transaction:"
sed 's/^/  /' /tmp/gatherd-pacman-check
echo "repositories in /etc/pacman.conf with no database in /var/lib/pacman/sync:"
sed -n 's/^\[\(.*\)\]$/\1/p' /etc/pacman.conf | grep -vx options | while read -r repo; do
    [ -f "/var/lib/pacman/sync/$repo.db" ] || echo "  $repo"
done
exit 1
REMOTE

if [[ "$health_rc" -ne 0 ]]; then
    echo "FAIL: run 1 left the machine unable to install any package"
    exit 1
fi
echo "PASS: pacman can prepare a transaction"

# Second member: pacman's copy of every local repository must be the current
# one. A converge that builds a package and then dies before installing it
# leaves the copy behind, and every AUR install task's
# `update_cache: "{{ _aur_sync_x.changed }}"` asks a per-run question of that
# durable state -- the next run builds nothing, so it refreshes nothing, so the
# built package stays invisible to pacman forever. A real machine failed
# `Install clight` for a clight sitting built in /var/cache/gatherd-aur.
# Nothing in run 1 or run 2 notices on its own: both runs are equally wrong, so
# the idempotency check below reads the wedged state as converged.
#
# Every file:// repository in /etc/pacman.conf is checked, not the one gatherd
# happens to register: naming it here would go stale on a rename, and picking
# just one would pick the wrong one the moment a second is added. A repository
# with no database file at all is a failure, not a skip -- repo-add runs behind
# a `creates:` guard, so the only way to reach here without one is that
# aurutils.yml did not run, which is exactly what this is looking for.
#
# Note what this is and is not. The VM starts from a Calamares snapshot with no
# /var/cache/gatherd-aur, so run 1 creates both databases in order and they
# agree even with the aurutils.yml fix reverted -- the wedge needs a run that
# did not finish, and `set -e` plus site-async.yml's non-zero exit abort this
# script before the assertions whenever a tier fails. So this is a tripwire for
# a future regression, not a reproduction of the bug that prompted it. That one
# was measured on a real machine, where it named clight.
sync_rc=0
"${SSH[@]}" sh -s <<'REMOTE' || sync_rc=$?
set -u
work=$(mktemp -d) || exit 1
trap 'rm -rf "$work"' EXIT
status=0

awk '/^\[/ { name = substr($0, 2, length($0) - 2) }
     /^Server *= *file:\/\// { sub(/^Server *= *file:\/\//, ""); print name "\t" $0 }' \
    /etc/pacman.conf > "$work/repos"

if [ ! -s "$work/repos" ]; then
    echo "no file:// repository is registered in /etc/pacman.conf"
    exit 1
fi

while IFS="$(printf '\t')" read -r name dir; do
    # $name.db, followed, is the path pacman fetches through -- not the
    # .db.tar.zst behind it, which can agree while the symlink is broken.
    repo="$dir/$name.db"
    synced="/var/lib/pacman/sync/$name.db"
    missing=
    for f in "$repo" "$synced"; do
        [ -f "$f" ] && continue
        echo "$name: $f does not exist"
        missing=yes
        status=1
    done
    # Per repository, not the shared $status: one bad repository must not stop
    # the next from being looked at, which is the whole reason for the loop.
    [ -z "$missing" ] || continue
    [ "$(md5sum <"$repo")" = "$(md5sum <"$synced")" ] && continue

    status=1
    echo "pacman's copy of $name is not the repository it copies:"
    echo "  $repo   $(date -r "$repo" '+%F %T')"
    echo "  $synced $(date -r "$synced" '+%F %T')"
    bsdtar -tf "$repo" | sed -n 's|^\(.*\)-[^-]*-[^-]*/$|\1|p' |
        LC_ALL=C sort -u > "$work/in-repo"
    pacman -Sl "$name" | awk '{print $2}' | LC_ALL=C sort > "$work/in-pacman"
    # Both directions. The reverse -- pacman's copy naming packages the
    # repository no longer has -- comes from the same clock and rollback cases
    # aurutils.yml names, not from paccache, which only ever reads
    # /var/cache/pacman/pkg. A failure that prints an empty list under a
    # heading is the kind people learn to ignore.
    comm -13 "$work/in-pacman" "$work/in-repo" |
        sed 's/^/  in the repository, invisible to pacman: /'
    comm -23 "$work/in-pacman" "$work/in-repo" |
        sed 's/^/  known to pacman, gone from the repository: /'
done < "$work/repos"

exit "$status"
REMOTE

if [[ "$sync_rc" -ne 0 ]]; then
    echo "FAIL: run 1 left pacman unable to see packages it built"
    exit 1
fi
echo "PASS: pacman's copy of every local repository is current"

# ── Run 2: idempotency check ──────────────────────────────────────────────────

echo "=== Run 2 (idempotency check) ==="
run2_log=$(mktemp)
"${SSH[@]}" "cd /usr/local/lib/gatherd && ansible-playbook -e sway_guard_override=true site-core.yml site-async.yml" | tee "$run2_log"

# One PLAY RECAP per playbook, so run 2 emits two. A grep for a clean recap
# passes as soon as *any* of them is clean, which let site-async.yml report
# changed=5 while site-core.yml's changed=0 satisfied the test. Require every
# recap to be clean, and require the expected number of them, so a run that
# dies before emitting one cannot pass by silence either.
expected_recaps=2
# || true on both: grep -c exits 1 when it counts zero, and under set -e that
# aborts the script -- so the check died precisely when the run was clean.
recaps=$(grep -cE '^localhost +:' "$run2_log" || true)
dirty=$(grep -E '^localhost +:' "$run2_log" | grep -vcE 'changed=0[[:space:]].*failed=0[[:space:]]' || true)

if [[ "$recaps" -ne "$expected_recaps" ]]; then
    echo "FAIL: expected $expected_recaps play recaps in run 2, saw $recaps"
    grep -E '^localhost +:' "$run2_log"
    exit 1
elif [[ "$dirty" -ne 0 ]]; then
    echo "FAIL: $dirty of $recaps run-2 recaps report changes or failures"
    grep -E '^localhost +:' "$run2_log" | grep -vE 'changed=0[[:space:]].*failed=0[[:space:]]'
    exit 1
else
    echo "PASS: idempotent ($recaps clean recaps)"
fi
